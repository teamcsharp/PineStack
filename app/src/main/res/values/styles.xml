<resources>
    <!-- A route chip. borderlessButtonStyle rather than the default button
         so AppCompat does not wrap it in its own inset background and undo
         @drawable/chip. -->
    <style name="PineChip" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/chip_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/chip</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PineCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/rail_card</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_marginBottom">@dimen/rail_gap</item>
    </style>

    <style name="PineCaption">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pine_dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
