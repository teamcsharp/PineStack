<?xml version="1.0" encoding="utf-8"?>
<!-- [airplayers] A Playing it row. Pressed draws on the very next frame (no
     animator); SELECTED is the active radio, an amber edge. A write in
     flight is said in amber on the row itself ("switching off…"), not with
     ACTIVATED, which would turn the row's chip_text ink dark. Separate from
     chip.xml so no route chip changes. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pine_press" />
            <stroke android:width="2dp" android:color="@color/pine_amber" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pine_chip" />
            <stroke android:width="2dp" android:color="@color/pine_amber" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pine_chip" />
            <stroke android:width="1dp" android:color="@color/pine_rule" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
