<!-- THE MARK: the readout itself.

     Pine Box's icon is a tree. This one is what the app actually is — a row
     of gauges, in the overlays' own colours: the per-core bars, with the two
     hot ones in the same amber and red the widgets use for a core under
     load. Nothing about it resembles a pine, which is the whole requirement.

     Everything sits inside the adaptive icon's safe zone (the middle 72 of
     108), so no launcher mask can crop a bar to a stub. A vector, because
     the repo carries no binaries. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The baseline the bars stand on. -->
    <path
        android:fillColor="#2B3742"
        android:pathData="M28,76 L80,76 L80,79 L28,79 Z" />

    <!-- Five bars, four heights. Cyan is the module's own accent. -->
    <path
        android:fillColor="#65C7DA"
        android:pathData="M28,58 L37,58 L37,74 L28,74 Z" />
    <path
        android:fillColor="#54D18B"
        android:pathData="M39.5,48 L48.5,48 L48.5,74 L39.5,74 Z" />
    <!-- The two under load, in the same amber and red a hot core gets. -->
    <path
        android:fillColor="#E8C65A"
        android:pathData="M51,34 L60,34 L60,74 L51,74 Z" />
    <path
        android:fillColor="#FF6B7F"
        android:pathData="M62.5,26 L71.5,26 L71.5,74 L62.5,74 Z" />
    <path
        android:fillColor="#65C7DA"
        android:pathData="M74,52 L83,52 L83,74 L74,74 Z" />
</vector>
