<?xml version="1.0" encoding="utf-8"?>
<!-- One group of controls. The panel's own cards are a hair lighter than
     the ground with a thin rule; the rail copies that so the two halves of
     the terminal look like one program. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pine_card" />
    <stroke android:width="1dp" android:color="@color/pine_rule" />
    <corners android:radius="10dp" />
</shape>
