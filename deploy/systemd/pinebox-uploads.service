[Unit]
Description=Pine Box - carry listener uploads to QuickSwap samples_grabbed/user ([listener-uploads])
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=ehm_eckx
WorkingDirectory=/home/ehm_eckx/pinevoice-stack/spark-agent
ExecStart=/usr/bin/python3 /home/ehm_eckx/pinevoice-stack/spark-agent/tools/uploads_courier.py --loop
Restart=always
RestartSec=5
Nice=10

[Install]
WantedBy=multi-user.target
