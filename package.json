{
  "name": "pinebox-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pine Box — the station, on this PC.",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "desktop:setup": "npm install",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder",
    "desktop:dist:win": "electron-builder --win nsis portable",
    "desktop:dist:linux": "electron-builder --linux AppImage deb tar.gz"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.lilspark.pinebox",
    "productName": "Pine Box",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "app.py",
        "to": "agent/app.py"
      },
      { "from": "script_diagnostics.py", "to": "agent/script_diagnostics.py" },
      { "from": "script_report_store.py", "to": "agent/script_report_store.py" },
      { "from": "video_editor.py", "to": "agent/video_editor.py" },
      { "from": "desktop/renderer/video-editor.html", "to": "agent/desktop/renderer/video-editor.html" },
      { "from": "desktop/renderer/video-editor.js", "to": "agent/desktop/renderer/video-editor.js" },
      { "from": "desktop/renderer/video-editor.css", "to": "agent/desktop/renderer/video-editor.css" },
      { "from": "desktop/renderer/video-edit-model.js", "to": "agent/desktop/renderer/video-edit-model.js" },
      {
        "from": "station_flow.py",
        "to": "agent/station_flow.py"
      },
      {
        "from": "line_review.py",
        "to": "agent/line_review.py"
      },
      {
        "from": "line_review_runtime.py",
        "to": "agent/line_review_runtime.py"
      },
      { "from": "rejection_workbench.py", "to": "agent/rejection_workbench.py" },
      { "from": "system2.py", "to": "agent/system2.py" },
      { "from": "system2_runtime.py", "to": "agent/system2_runtime.py" },
      { "from": "system2_media.py", "to": "agent/system2_media.py" },
      { "from": "system2_writing.py", "to": "agent/system2_writing.py" },
      { "from": "rejection_lab.py", "to": "agent/rejection_lab.py" },
      { "from": "rejection_lab_runtime.py", "to": "agent/rejection_lab_runtime.py" },
      { "from": "crystal_contract.py", "to": "agent/crystal_contract.py" },
      { "from": "crystal_prompts.py", "to": "agent/crystal_prompts.py" },
      { "from": "crystal_rhyme.py", "to": "agent/crystal_rhyme.py" },
      { "from": "rhyme_assistance.py", "to": "agent/rhyme_assistance.py" },
      { "from": "vendor/wordnet", "to": "agent/vendor/wordnet", "filter": ["**/*"] },
      { "from": "vendor/cmudict", "to": "agent/vendor/cmudict", "filter": ["**/*"] },
      { "from": "crystal_source.py", "to": "agent/crystal_source.py" },
      { "from": "segment_contract.py", "to": "agent/segment_contract.py" },
      { "from": "crystal_acceptance.py", "to": "agent/crystal_acceptance.py" },
      { "from": "prompt_learning.py", "to": "agent/prompt_learning.py" },
      { "from": "nabu_audio.py", "to": "agent/nabu_audio.py" },
        { "from": "sfx_speech_bank.py", "to": "agent/sfx_speech_bank.py" },
        { "from": "sfx_cadence.py", "to": "agent/sfx_cadence.py" },
        {
          "from": "response_bank.py",
          "to": "agent/response_bank.py"
        },
        {
          "from": "tint_recovery.py",
          "to": "agent/tint_recovery.py"
        },
      {
        "from": "resource_guard.py",
        "to": "agent/resource_guard.py"
      },
      {
        "from": "newspaper_city.py",
        "to": "agent/newspaper_city.py"
      },
      {
        "from": "frontend",
        "to": "agent/frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "requirements.txt",
        "to": "agent/requirements.txt"
      },
      {
        "from": "tools",
        "to": "agent/tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data/vendor",
        "to": "agent/data/vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "desktop/assets/pinebox.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "AudioVideo"
    }
  }
}
