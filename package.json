{
  "name": "pinebox-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Pine Box — the station, on this PC.",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron .",
    "desktop:setup": "npm install",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder",
    "desktop:dist:win": "electron-builder --win nsis portable",
    "desktop:dist:linux": "electron-builder --linux AppImage deb tar.gz",
    "predesktop": "node tools/sync_station_tools.cjs",
    "predesktop:pack": "node tools/sync_station_tools.cjs",
    "predesktop:dist": "node tools/sync_station_tools.cjs",
    "predesktop:dist:win": "node tools/sync_station_tools.cjs",
    "predesktop:dist:linux": "node tools/sync_station_tools.cjs"
  },
  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.lilspark.pinebox",
    "productName": "Pine Box",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {"from": "sfx_supercut_video.py", "to": "agent/sfx_supercut_video.py"},
      {
        "from": "system3.py",
        "to": "agent/system3.py"
      },
      {
        "from": "system3_runtime.py",
        "to": "agent/system3_runtime.py"
      },
      {
        "from": "system3_handoff.py",
        "to": "agent/system3_handoff.py"
      },
      {
        "from": "pantry_lifecycle.py",
        "to": "agent/pantry_lifecycle.py"
      },
      {
        "from": "pantry_lifecycle_runtime.py",
        "to": "agent/pantry_lifecycle_runtime.py"
      },
      {
        "from": "orchestrator_visuals.py",
        "to": "agent/orchestrator_visuals.py"
      },
      {
        "from": "system3_tables.py",
        "to": "agent/system3_tables.py"
      },
      {
        "from": "conversation_graph.py",
        "to": "agent/conversation_graph.py"
      },
      {
        "from": "book_mode.py",
        "to": "agent/book_mode.py"
      },
      {
        "from": "book_preview.py",
        "to": "agent/book_preview.py"
      },
      {
