      },
      {
        "from": "desktop/renderer/book-preview.css",
        "to": "agent/desktop/renderer/book-preview.css"
      },
      {
        "from": "library.py",
        "to": "agent/library.py"
      },
      {
        "from": "library_extract.py",
        "to": "agent/library_extract.py"
      },
      {
        "from": "live_session.py",
        "to": "agent/live_session.py"
      },
      {
        "from": "pinelens.py",
        "to": "agent/pinelens.py"
