      },
      {
        "from": "frontend",
        "to": "agent/frontend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "requirements.txt",
        "to": "agent/requirements.txt"
      },
      {
        "from": "tools",
        "to": "agent/tools",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "data/vendor",
        "to": "agent/data/vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "desktop/assets/pinebox.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "AudioVideo"
    }
  }
}
