let deckSignature = "";

function renderDeck(state) {
  const host = document.getElementById("musicDeck");
  if (!host) return;
  const played = (state.played || []).slice(0, 5);
  const now = state.now;
  const next = (state.upcoming || []).slice(0, 5);

  // Rebuilding on every poll would restart every lazy image load.
  const signature = [played.map((t) => t.id).join(), (now || {}).id,
                     next.map((t) => t.id).join()].join("|");
  if (signature === deckSignature) return;
  deckSignature = signature;

  host.textContent = "";
  if (!now && !played.length && !next.length) {
    host.appendChild(el("div", "muted",
      "Tune in and the last five and next five tracks appear here."));
    return;
  }

  if (played.length) host.appendChild(deckLabel("just played"));
  played.slice().reverse().forEach((track) => {
    const {tile, frame} = artTile(track);
    frame.style.opacity = ".55";
    host.appendChild(tile);
  });

  if (now) {
    host.appendChild(deckLabel("on air"));
    const {tile, frame} = artTile(now);
    sleeveInto(frame, now, 138);
    tile.style.flex = "0 0 138px";
    frame.style.cssText += ";width:138px;height:138px;border-color:#4bb3ff;"
      + "box-shadow:0 0 0 1px #4bb3ff55,0 6px 20px #4bb3ff22";
    frame.style.width = "138px";
    frame.style.height = "138px";
    host.appendChild(tile);
    // Keep the current track in view as the deck advances.
    setTimeout(() => {
      tile.scrollIntoView({block: "nearest", inline: "center"});
    }, 60);
  }

  if (next.length) host.appendChild(deckLabel("coming up"));
  next.forEach((track) => host.appendChild(artTile(track).tile));
}

async function renderNowTags(state) {
  const host = document.getElementById("musicNowTags");
  if (!host) return;
  const now = state.now;
  if (!now || !now.id) { host.textContent = ""; return; }
  if (host.dataset.id === now.id) return;
  host.dataset.id = now.id;
  try {
    const info = await api("/api/music/track/" + now.id);
    const tags = info.tags || {};
    const bits = [
      info.album, tags.TDRC || tags.date || tags["©day"],
      tags.TCON || tags.genre,
      tags.bitrate ? Math.round(tags.bitrate / 1000) + " kbps" : "",
      tags.sample_rate ? (tags.sample_rate / 1000) + " kHz" : "",
      info.ext.replace(".", "").toUpperCase(),
      info.stats.artist_tracks + " by this artist in the library",
    ].filter(Boolean);
    host.textContent = bits.join(" · ");
  } catch (error) {
    host.textContent = "";
  }
}

