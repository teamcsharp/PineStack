@app.get("/api/models/loaded")
async def models_loaded(
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Everything currently occupying memory: Ollama models and ComfyUI's
    resident checkpoints."""
    out: list[dict[str, Any]] = []
    require_read_auth(authorization)
    async with httpx.AsyncClient(timeout=8) as client:
        try:
            ps = (await client.get(f"{OLLAMA_URL}/api/ps")).json() or {}
            for m in ps.get("models", []):
                out.append({
                    "host": "ollama",
                    "name": m.get("name", "?"),
                    "gb": round((m.get("size_vram") or m.get("size") or 0) / 1e9, 1),
                    "expires": str(m.get("expires_at") or "")[:19],
                    "unloadable": True,
                })
        except Exception:
            pass
        try:
            st = (await client.get(f"{COMFYUI_URL}/system_stats")).json() or {}
            dev = (st.get("devices") or [{}])[0]
            total = dev.get("vram_total") or 0
            free = dev.get("vram_free") or 0
            used = total - free
            if total:
                out.append({
                    "host": "comfyui",
                    "name": "ComfyUI resident models",
                    "gb": round(used / 1e9, 1),
                    "expires": "",
                    "unloadable": True,
                })
        except Exception:
            pass
    return {"models": out}


@app.post("/api/models/unload")
async def models_unload(
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Drop a model out of memory: Ollama honours keep_alive 0, ComfyUI has
    its own /free endpoint."""
    require_auth(authorization)
    payload = await request.json()
    host = str(payload.get("host") or "")
    name = str(payload.get("name") or "")
    async with httpx.AsyncClient(timeout=30) as client:
        if host == "ollama":
            if not name:
                raise HTTPException(status_code=400, detail="No model named")
            response = await client.post(
                f"{OLLAMA_URL}/api/generate",
                json={"model": name, "keep_alive": 0, "prompt": ""},
            )
            response.raise_for_status()
            return {"unloaded": name}
        if host == "comfyui":
            response = await client.post(
                f"{COMFYUI_URL}/free",
                json={"unload_models": True, "free_memory": True},
            )
            response.raise_for_status()
            return {"unloaded": "comfyui models"}
    raise HTTPException(status_code=400, detail="Unknown host")


@app.post("/api/service/restart")
async def service_restart(
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Restart a service. Only spark-agent itself is reachable from inside
    this container — exiting lets docker's restart policy bring it back."""
    require_auth(authorization)
    payload = await request.json()
    name = str(payload.get("name") or "")
    if name != "spark-agent":
        raise HTTPException(
            status_code=400,
            detail="Only spark-agent can restart itself from here; other "
            "services need docker on the host.",
        )

    async def _die() -> None:
        await asyncio.sleep(0.5)
        os._exit(3)  # docker restart: unless-stopped revives us

    asyncio.create_task(_die())
    return {"restarting": name}


