                        easing: "cubic-bezier(.18,.7,.3,1)", fill: "forwards"});
  }
  setTimeout(() => layer.remove(), 2400);
}

function save() {
  const note = document.getElementById("note");
  if (!trackUrl) { note.textContent = "Nothing is playing."; return; }
  const link = document.createElement("a");
  link.href = trackUrl + "&download=1";
  link.download = "";
  document.body.appendChild(link);
  link.click();
  link.remove();
  note.textContent = "Downloading…";
}

async function vote(v) {
  const note = document.getElementById("note");
  burst(event.currentTarget, v > 0);
  if (!trackId) { note.textContent = "Nothing is playing."; return; }
  try {
    const result = await api("/api/music/vote", {
      method: "POST", body: JSON.stringify({id: trackId, vote: v}),
    });
    note.textContent = (result.title || "track") + " · "
      + (v > 0 ? "👍 noted" : "👎 never again");
  } catch (error) {
    note.textContent = error.message;
  }
}

// Tuning in is arriving somewhere: tell the DJ, and he says hello (#127).
async function signIn() {
  const note = document.getElementById("note");
  note.textContent = "Signing you in…";
  try {
    const result = await api("/api/dj/join", {
      method: "POST",
      body: JSON.stringify({listener: ME, name: localStorage.getItem("pbfmName") || ""}),
    });
    note.textContent = result.welcome
      ? "DJ: " + result.welcome
      : "Signed in. Request a song any time.";
  } catch (error) {
    note.textContent = "Tuned in. (The DJ is off air.)";
  }
}

async function request() {
  const input = document.getElementById("req");
  const note = document.getElementById("note");
  const query = input.value.trim();
  if (!query) return;
  input.value = "";
  note.textContent = "Calling the request line…";
  try {
    const result = await api("/api/dj/request", {
      method: "POST", body: JSON.stringify({q: query}),
    });
    note.textContent = "Queued: " + result.title
      + (result.artist ? " · " + result.artist : "");
  } catch (error) {
    note.textContent = error.message;
  }
}

poll();
setInterval(poll, 3000);
</script>
</body>
