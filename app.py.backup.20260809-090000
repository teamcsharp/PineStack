// A record with no artwork still needs a face, and a WebGL texture cannot be
// a DOM node — so paint the same generated sleeve onto a canvas.
function boothSleeveTexture(THREE, track) {
  const canvas = document.createElement("canvas");
  canvas.width = canvas.height = 320;
  const ctx = canvas.getContext("2d");
  let hash = 0;
  const key = (track.artist || "") + "|" + (track.album || track.title || "");
  for (let i = 0; i < key.length; i++) hash = (hash * 31 + key.charCodeAt(i)) >>> 0;
  const hue = hash % 360;
  const grad = ctx.createLinearGradient(0, 0, 320, 320);
  grad.addColorStop(0, "hsl(" + hue + ",42%,26%)");
  grad.addColorStop(1, "hsl(" + ((hue + 50) % 360) + ",38%,13%)");
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, 320, 320);
  ctx.fillStyle = "hsla(" + hue + ",70%,84%,.92)";
  ctx.font = "700 104px system-ui, sans-serif";
  ctx.textAlign = "center";
  ctx.textBaseline = "middle";
  const words = String(track.title || "?").trim().split(/\s+/);
  ctx.fillText(((words[0] || "?")[0] + (words[1] ? words[1][0] : ""))
    .toUpperCase(), 160, 160);
  const texture = new THREE.CanvasTexture(canvas);
  texture.colorSpace = THREE.SRGBColorSpace;
  return texture;
}

