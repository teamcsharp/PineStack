/* ---- Document browser (#23) + page viewer with research chat (#15/#17) ---- */

let dbDevices = [];
let dbDoc = null;
let dbMode = "docs";
let dbCurrentPage = 0;
let pvChatBusy = false;

async function openDocBrowser(slug, pageN, withChat) {
  const body = openModal();

  const side = el("div", "db-side");
  const sideHead = el("div", "db-side-head");
  const tabs = el("div", "db-tabs");
  const tabDocs = el("button", "on", "Documents");
  const tabToc = el("button", "", "Contents");
  tabs.appendChild(tabDocs);
  tabs.appendChild(tabToc);
  const filter = el("input");
  filter.placeholder = "filter…";
  sideHead.appendChild(tabs);
  sideHead.appendChild(filter);
  const list = el("div", "db-list");
  side.appendChild(sideHead);
  side.appendChild(list);

  const main = el("div", "db-main");
  const mainHead = el("div", "db-main-head");
  const title = el("b", "", "Documentation");
  const meta = el("span", "muted", "");
  const search = el("input");
  search.placeholder = "search in document…";
  search.style.cssText =
    "margin-left:auto;width:240px;padding:6px 10px;font-size:13px";
  mainHead.appendChild(title);
  mainHead.appendChild(meta);
  const pdfBtn = el("button", "hp-restart", "📄 PDF");
  pdfBtn.style.display = "none";
  pdfBtn.onclick = () => togglePdf();
  mainHead.appendChild(pdfBtn);
  const prev = el("button", "hp-restart", "◀ prev");
  const next = el("button", "hp-restart", "next ▶");
  prev.onclick = () => jumpTo(Math.max(1, (dbCurrentPage || 2) - 1));
  next.onclick = () => jumpTo((dbCurrentPage || 0) + 1);
  mainHead.appendChild(prev);
  mainHead.appendChild(next);
  mainHead.appendChild(search);
  const pages = el("div", "db-pages");
  main.appendChild(mainHead);
  main.appendChild(pages);

  body.appendChild(side);
  body.appendChild(main);

  let chatLog = null;
  if (withChat) body.appendChild(buildChatRail(() => dbDoc, () => dbCurrentPage));

  tabDocs.onclick = () => { dbMode = "docs"; tabDocs.classList.add("on");
    tabToc.classList.remove("on"); renderSide(); };
  tabToc.onclick = () => { dbMode = "toc"; tabToc.classList.add("on");
    tabDocs.classList.remove("on"); renderSide(); };
  filter.oninput = renderSide;
  search.oninput = () => renderPages(search.value.trim().toLowerCase());

  function renderSide() {
    const needle = filter.value.trim().toLowerCase();
    list.textContent = "";
    if (dbMode === "docs") {
      dbDevices.forEach((d) => {
        if (needle && (d.slug + " " + d.title).toLowerCase().indexOf(needle) < 0)
          return;
        const row = el("div", "db-item" + (dbDoc && dbDoc.slug === d.slug ? " on" : ""));
        row.appendChild(el("span", "", d.title || d.slug));
        const s = el("small", "", (d.has_pdf ? "📄 " : "") + d.pages + "p");
        row.appendChild(s);
        row.onclick = () => loadManual(d.slug, 0);
        list.appendChild(row);
      });
    } else if (dbDoc) {
      (dbDoc.pages || []).forEach((p) => {
        const head = p.heading || ("page " + p.n);
        if (needle && head.toLowerCase().indexOf(needle) < 0) return;
        const row = el("div", "db-item");
        row.appendChild(el("span", "", head));
        row.appendChild(el("small", "", "p." + p.n));
        row.onclick = () => jumpTo(p.n);
        list.appendChild(row);
      });
    } else {
      list.appendChild(el("div", "db-item", "Open a document first"));
    }
  }

  // Manuals arrive as one long run of prose (web guides) or hard-wrapped
  // lines (PDFs). Turn either into headings, steps and short paragraphs.
  function renderDocText(host, text, needle) {
    const paras = [];
    const lines = text.split(/\n+/).map((l) => l.trim()).filter(Boolean);
    if (lines.length > 2) {
      paras.push.apply(paras, lines);
    } else {
      // One long run: break on numbered steps first, then group sentences.
      const chunks = text.split(/(?=\b(?:Step\s+\d+|\d+\s+[A-Z]))/g);
      chunks.forEach((chunk) => {
        chunk = chunk.trim();
        if (!chunk) return;
        if (chunk.length < 260) { paras.push(chunk); return; }
        const sentences = chunk.match(/[^.!?]+[.!?]+[\s]*|[^.!?]+$/g) || [chunk];
        let buf = "";
        sentences.forEach((sentence) => {
          buf += sentence;
          if (buf.length > 240) { paras.push(buf.trim()); buf = ""; }
        });
        if (buf.trim()) paras.push(buf.trim());
      });
    }

    let list = null;
    const flush = () => { if (list) { host.appendChild(list); list = null; } };
    paras.forEach((para) => {
      const isStep = /^(Step\s+\d+|\d+[\.\)]\s|\d+\s+[A-Z])/.test(para);
      let marked = false;
      if (para.indexOf("## ") === 0) { para = para.slice(3); marked = true; }
      const words = para.split(/\s+/).length;
      const isHeading = !isStep && (marked ||
        (/^\d+(\.\d+)*\s+\S/.test(para) && words <= 7) ||
        (para.length < 42 && words >= 2 && words <= 6 &&
         !/[.!?,;:]$/.test(para) && /^[A-Z0-9]/.test(para) &&
         para === para.toUpperCase()));
      if (isStep) {
        if (!list) list = document.createElement("ol");
        const li = document.createElement("li");
        setDocHtml(li, para.replace(/^\d+[\.\)]?\s*/, ""), needle);
        list.appendChild(li);
        return;
      }
      flush();
      const node = document.createElement(isHeading ? "h4" : "p");
      setDocHtml(node, para, needle);
      host.appendChild(node);
    });
    flush();
  }

  function setDocHtml(node, text, needle) {
    let safe = escapeHtml(text);
    // Button and key names in TE/HiChord manuals read as (FX), (KNOBX), M3.
    safe = safe.replace(/\((?=[A-Z0-9+\-\s]{1,12}\))([^)]{1,12})\)/g,
      "<code>$1</code>");
    if (needle) {
      safe = safe.replace(
        new RegExp("(" + needle.replace(/[.*+?^${}()|[\]\\]/g, "\\$&") + ")", "gi"),
        "<mark>$1</mark>");
    }
    node.innerHTML = safe;
  }

  function escapeHtml(s) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
  }

  let pdfOpen = false;
  function togglePdf() {
    pdfOpen = !pdfOpen;
    pdfBtn.textContent = pdfOpen ? "🗂 Pages" : "📄 PDF";
    if (!pdfOpen) { renderPages(search.value.trim().toLowerCase()); return; }
    pages.textContent = "";
    const frame = document.createElement("iframe");
    frame.src = "/api/te/pdf/" + dbDoc.slug;
    frame.style.cssText = "width:100%;height:100%;border:0;border-radius:10px";
    pages.appendChild(frame);
    meta.textContent = "scrolling the source PDF";
  }

  function renderPages(needle) {
    if (pdfOpen) return;
    pages.textContent = "";
    if (!dbDoc) {
      pages.appendChild(el("div", "muted", "Pick a document from the sidebar."));
      return;
    }
    let shown = 0;
    (dbDoc.pages || []).forEach((p) => {
      const text = p.text || "";
      if (!p.image && !text.trim()) return;   // nothing to show
      if (needle && text.toLowerCase().indexOf(needle) < 0 &&
          (p.heading || "").toLowerCase().indexOf(needle) < 0) return;
      shown += 1;
      const card = el("div", "db-page");
      card.id = "db-pg-" + p.n;
      const head = el("div", "pg-head");
      head.appendChild(el("span", "", (p.heading || "page") + " · p." + p.n));
      const ops = el("span", "ops", "focus ⤢");
      ops.title = "Discuss this page";
      ops.onclick = () => { dbCurrentPage = p.n; highlightCurrent(); };
      head.appendChild(ops);
      card.appendChild(head);
      if (p.image) {
        const img = document.createElement("img");
        img.loading = "lazy";
        img.src = "/api/te/asset/" + dbDoc.slug + "/" + p.image;
        if (dbDoc.page_bg) img.style.background = dbDoc.page_bg;
        img.style.cursor = "zoom-in";
        img.onclick = (e) => {      // #31: full resolution + pan by scroll
          e.stopPropagation();
          const zoomed = img.style.maxWidth === "none";
          img.style.maxWidth = zoomed ? "" : "none";
          img.style.width = zoomed ? "" : "auto";
          img.parentElement.style.overflow = zoomed ? "" : "auto";
          img.style.cursor = zoomed ? "zoom-in" : "zoom-out";
          dbCurrentPage = p.n;
          highlightCurrent();
        };
        card.appendChild(img);
      }
      if (text) {
        const txt = el("div", "pg-txt");
        renderDocText(txt, text, needle);
        card.appendChild(txt);
      }
      if (p.source_url) {
        const src = el("div", "pg-src");
        const a = document.createElement("a");
        a.href = p.source_url;
        a.target = "_blank";
        a.textContent = "source: " + p.source_url.replace(/^https?:\/\//, "").slice(0, 60);
        src.appendChild(a);
        card.appendChild(src);
      }
      card.onclick = () => { dbCurrentPage = p.n; highlightCurrent(); };
      pages.appendChild(card);
    });
    meta.textContent = shown + " pages" + (needle ? " matching" : "");
  }

  function highlightCurrent() {
    pages.querySelectorAll(".db-page").forEach((c) => {
      c.style.outline = c.id === "db-pg-" + dbCurrentPage
        ? "2px solid var(--accent)" : "";
    });
  }

  function jumpTo(n) {
    dbCurrentPage = n;
    highlightCurrent();
    const target = document.getElementById("db-pg-" + n);
    if (target) target.scrollIntoView({behavior: "smooth", block: "start"});
  }

  async function loadManual(slugWanted, jump) {
    title.textContent = "Loading…";
    try {
      dbDoc = await api("/api/te/manual/" + slugWanted);
    } catch (error) {
      title.textContent = error.message;
      return;
    }
    dbCurrentPage = jump || 0;
    title.textContent = dbDoc.title || slugWanted;
    pdfOpen = false;
    pdfBtn.textContent = "📄 PDF";
    pdfBtn.style.display = dbDoc.has_pdf ? "" : "none";
    renderPages("");
    renderSide();
    if (jump) setTimeout(() => jumpTo(jump), 120);
  }

  try {
    dbDevices = (await api("/api/te/devices")).devices || [];
    dbDevices.sort((a, b) => (a.title || "").localeCompare(b.title || ""));
  } catch (error) { dbDevices = []; }
  renderSide();
  if (slug) loadManual(slug, pageN || 0);
  else renderPages("");
}

function buildChatRail(getDoc, getPage) {
  const rail = el("div", "pv-chat");
  const log = el("div", "pv-chat-log");
  const hint = el("div", "pv-msg bot",
    "Ask about the page you're viewing — I'll answer from the manual and " +
    "pull in live links and videos.");
  log.appendChild(hint);
  const inWrap = el("div", "pv-chat-in");
  const input = el("input");
  input.placeholder = "discuss this page…";
  const send = el("button", "", "Ask");
  inWrap.appendChild(input);
  inWrap.appendChild(send);
  rail.appendChild(log);
  rail.appendChild(inWrap);

  async function go() {
    const text = input.value.trim();
    const doc = getDoc();
    if (!text || pvChatBusy || !doc) return;
    pvChatBusy = true;
    input.value = "";
    log.appendChild(el("div", "pv-msg you", "you · " + text));
    const wait = el("div", "pv-msg bot", "…thinking + searching…");
    log.appendChild(wait);
    log.scrollTop = log.scrollHeight;
    try {
      const res = await api("/api/te/chat", {
        method: "POST",
        body: JSON.stringify({slug: doc.slug, page: getPage(), text}),
      });
      wait.textContent = res.answer || "(no answer)";
      if ((res.links || []).length) {
        const links = el("div", "links");
        res.links.forEach((l) => {
          const a = document.createElement("a");
          a.href = l.url; a.target = "_blank";
          a.textContent =
            (/youtube|youtu\.be/i.test(l.url) ? "▶ " : "↗ ") +
            (l.title || l.url);
          links.appendChild(a);
        });
        wait.appendChild(links);
      }
    } catch (error) {
      wait.textContent = error.message;
    }
    pvChatBusy = false;
    log.scrollTop = log.scrollHeight;
  }
  send.onclick = go;
  input.onkeydown = (e) => { if (e.key === "Enter") go(); };
  return rail;
}

