// Enough markdown for chat replies: headings, lists, code, bold/italic, links.
function mdToHtml(src) {
  const esc = (t) => t.replace(/&/g, "&amp;").replace(/</g, "&lt;")
    .replace(/>/g, "&gt;");
  const blocks = [];
  let text = esc(src || "").replace(/```([\s\S]*?)```/g, (m, code) => {
    blocks.push("<pre><code>" + code.replace(/^\n/, "") + "</code></pre>");
    return "\u0000" + (blocks.length - 1) + "\u0000";
  });
  text = text
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<b>$1</b>")
    .replace(/(^|[\s(])\*([^*\n]+)\*/g, "$1<i>$2</i>")
    .replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g,
             '<a href="$2" target="_blank">$1</a>');

  const out = [];
  let list = null;
  text.split(/\n/).forEach((line) => {
    const trimmed = line.trim();
    const bullet = /^[-*+]\s+(.*)/.exec(trimmed);
    const numbered = /^\d+[.)]\s+(.*)/.exec(trimmed);
    const heading = /^(#{1,3})\s+(.*)/.exec(trimmed);
    const quote = /^>\s?(.*)/.exec(trimmed);
    if (bullet || numbered) {
      const tag = bullet ? "ul" : "ol";
      if (!list || list.tag !== tag) {
        if (list) out.push("</" + list.tag + ">");
        out.push("<" + tag + ">");
        list = {tag: tag};
      }
      out.push("<li>" + (bullet ? bullet[1] : numbered[1]) + "</li>");
      return;
    }
    if (list) { out.push("</" + list.tag + ">"); list = null; }
    if (!trimmed) return;
    if (heading) { out.push("<h3>" + heading[2] + "</h3>"); return; }
    if (quote) { out.push("<blockquote>" + quote[1] + "</blockquote>"); return; }
    out.push("<p>" + trimmed + "</p>");
  });
  if (list) out.push("</" + list.tag + ">");
  return out.join("").replace(/\u0000(\d+)\u0000/g, (m, i) => blocks[i]);
}

function convTitles() {
  try { return JSON.parse(localStorage.getItem("convTitles") || "{}"); }
  catch (e) { return {}; }
}

async function ensureConvTitle(group) {
  const cache = convTitles();
  if (cache[group.id]) return cache[group.id];
  try {
    const r = await api("/api/conversations/title", {
      method: "POST",
      body: JSON.stringify({turns: group.turns.slice(0, 6)}),
    });
    cache[group.id] = r.title;
    localStorage.setItem("convTitles", JSON.stringify(cache));
    return r.title;
  } catch (error) {
    return (group.turns[0] || {}).user || "Conversation";
  }
}

// Renders made during a conversation, matched by time.
function convImages(group) {
  const start = (group.turns[0] || {}).ts || 0;
  const end = group.end || start;
  return (lastGenerations || [])
    .filter((g) => (g.files || []).length &&
      (g.ts || 0) >= start - 120 && (g.ts || 0) <= end + 900)
    .sort((a, b) => (a.ts || 0) - (b.ts || 0));
}

function buildSlideshow(gens) {
  const box = el("div", "conv-slides");
  const imgs = [];
  gens.forEach((g) => {
    const file = (g.files || [])[0];
    const node = mediaElement(file);
    node.title = g.tags || g.request || "";
    node.onclick = () => showLightbox(file, g);
    fetchImageInto(node, file);
    box.appendChild(node);
    imgs.push(node);
  });
  const dots = el("div", "conv-slide-dots");
  box.appendChild(dots);
  let at = 0;
  const show = (i) => {
    imgs.forEach((n, j) => {
      n.classList.toggle("on", j === i);
      n.classList.toggle("out", j < i);
    });
    dots.textContent = imgs.length > 1
      ? (i + 1) + " / " + imgs.length : "";
  };
  show(0);
  if (imgs.length > 1) {
    box._timer = setInterval(() => { at = (at + 1) % imgs.length; show(at); },
      3800);
  }
  return box;
}

