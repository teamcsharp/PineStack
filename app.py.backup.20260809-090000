/* ---- Resizable 50/50 split (system prompt | Pine Chat) ---- */
function initGutter() {
  const gutter = document.getElementById("gutter");
  const main = document.querySelector("main");
  if (!gutter || !main) return;
  const saved = localStorage.getItem("splitPct");
  if (saved) main.style.setProperty("--split", saved);
  let dragging = false;
  const onMove = (e) => {
    if (!dragging) return;
    const rect = main.getBoundingClientRect();
    const clientX = e.touches ? e.touches[0].clientX : e.clientX;
    let pct = ((clientX - rect.left - 20) / (rect.width - 40)) * 100;
    pct = Math.max(25, Math.min(75, pct));
    main.style.setProperty("--split", pct.toFixed(1) + "%");
  };
  const stop = () => {
    if (!dragging) return;
    dragging = false;
    gutter.classList.remove("dragging");
    document.body.style.userSelect = "";
    const cur = main.style.getPropertyValue("--split");
    if (cur) localStorage.setItem("splitPct", cur);
  };
  gutter.addEventListener("mousedown", (e) => {
    dragging = true;
    gutter.classList.add("dragging");
    document.body.style.userSelect = "none";
    e.preventDefault();
  });
  window.addEventListener("mousemove", onMove);
  window.addEventListener("mouseup", stop);
  gutter.addEventListener("touchstart", () => {
    dragging = true;
    gutter.classList.add("dragging");
  }, { passive: true });
  window.addEventListener("touchmove", onMove, { passive: true });
  window.addEventListener("touchend", stop);
}

