let trayItems = [];

function trayPush(kind, title, subtitle, open, ref) {
  trayItems.unshift({
    kind: kind, title: title, subtitle: subtitle || "",
    when: Date.now(), open: open,
  });
  // Kept server-side so the bell survives reloads and other machines (#60).
  api("/api/notifications", {
    method: "POST",
    body: JSON.stringify({kind: kind, title: title, subtitle: subtitle || "",
                          ref: ref || {}}),
  }).catch(() => {});
  trayItems = trayItems.slice(0, 40);
  const count = document.getElementById("trayCount");
  count.textContent = String(Math.min(trayItems.length, 99));
  renderTray();
}

function toggleTray() {
  const panel = document.getElementById("trayPanel");
  const showing = panel.style.display !== "none";
  panel.style.display = showing ? "none" : "block";
  if (!showing) {
    renderTray();
    document.getElementById("trayCount").textContent = "";
  }
}

// Re-open whatever a stored notification pointed at.
function trayReopen(item) {
  const ref = item.ref || {};
  if (ref.video) { openVideoPopup(ref.video); return; }
  if (ref.slug) { openDocBrowser(ref.slug, ref.page || 0, true); return; }
  if (ref.file) { showLightbox(ref.file, ref.gen || {}); return; }
  openHealthPopup();
}

async function loadTrayHistory() {
  let items = [];
  try { items = (await api("/api/notifications?limit=60")).items || []; }
  catch (error) { return; }
  const stored = items.map((it) => ({
    kind: it.kind, title: it.title, subtitle: it.subtitle,
    when: (it.ts || 0) * 1000, open: () => trayReopen(it),
  }));
  // Anything raised this session stays on top of the stored history.
  const seen = new Set(trayItems.map((t) => t.title + t.when));
  trayItems = trayItems.concat(
    stored.filter((t) => !seen.has(t.title + t.when))
  ).slice(0, 80);
  renderTray();
}

function renderTray() {
  const list = document.getElementById("trayList");
  if (!list) return;
  list.textContent = "";
  if (!trayItems.length) {
    list.appendChild(el("div", "muted", "Nothing yet — ask for gear docs, a "
      + "song, a walkthrough or a render."));
    return;
  }
  trayItems.forEach((item) => {
    const row = el("div", "tray-item");
    const ico = el("div", "tray-ico");
    const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
    svg.setAttribute("viewBox", "0 0 24 24");
    svg.setAttribute("width", "21");
    svg.setAttribute("height", "21");
    const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
    path.setAttribute("fill", "currentColor");
    path.setAttribute("d", TRAY_GLYPHS[item.kind] || TRAY_GLYPHS.doc);
    svg.appendChild(path);
    ico.appendChild(svg);
    const txt = el("div", "tray-txt");
    txt.appendChild(el("b", "", item.title));
    txt.appendChild(el("small", "",
      new Date(item.when).toLocaleTimeString() +
      (item.subtitle ? " · " + item.subtitle : "")));
    row.appendChild(ico);
    row.appendChild(txt);
    row.onclick = () => {
      document.getElementById("trayPanel").style.display = "none";
      item.open();
    };
    list.appendChild(row);
  });
}

/* ---- Documentation beacon + popup (#46) ---- */

let beaconEntry = null;

function showDocBeacon(entry) {
  if (!entry) return;
  if (entry.slug === "web") {
    // Web research still belongs in the tray, just without a beacon.
    trayPush("web", entry.title || "Web research", entry.query,
      () => openDocPopup(entry), {slug: entry.slug});
    return;
  }
  beaconEntry = entry;
  trayPush("doc", entry.title || entry.slug, entry.query,
    () => openDocPopup(entry),
    {slug: entry.slug, page: ((entry.pages || [{}])[0] || {}).n || 0});
  const beacon = document.getElementById("docBeacon");
  document.getElementById("docBeaconLabel").textContent =
    (entry.title || entry.slug) + (entry.topic ? " · " + entry.topic : "");

  // Show the device's own manual artwork; fall back to the generic doc glyph.
  const art = document.getElementById("docBeaconArt");
  const glyph = document.getElementById("docBeaconSvg");
  const withArt = (entry.pages || []).find((p) => p.image);
  if (withArt) {
    art.src = "/api/te/asset/" + entry.slug + "/" + withArt.image;
    if (entry.page_bg) art.style.background = entry.page_bg;
    art.style.display = "block";
    glyph.style.display = "none";
    art.onerror = () => {
      art.style.display = "none";
      glyph.style.display = "block";
    };
  } else {
    art.style.display = "none";
    glyph.style.display = "block";
  }

  beacon.style.display = "flex";
  beacon.style.animation = "none";      // restart the 3-pulse run
  void beacon.offsetWidth;
  beacon.style.animation = "";
  beacon.onclick = () => {
    beacon.style.display = "none";
    openDocPopup(beaconEntry);
  };
  clearTimeout(showDocBeacon._t);
  showDocBeacon._t = setTimeout(() => { beacon.style.display = "none"; }, 45000);
}

async function openDocPopup(entry) {
  const body = openModal();
  const wrap = el("div", "dp-wrap");
  const main = el("div", "dp-main");
  const head = el("div", "db-main-head");
  head.appendChild(el("b", "", entry.title || entry.slug));
  head.appendChild(el("span", "muted", "“" + (entry.query || "") + "”"));
  const full = el("button", "hp-restart", "📚 open full manual");
  full.onclick = () => openDocBrowser(entry.slug, (entry.pages || [{}])[0].n, true);
  head.appendChild(full);
  main.appendChild(head);

  const pages = el("div", "dp-pages");
  (entry.pages || []).forEach((page) => {
    const card = el("div", "db-page");
    const ph = el("div", "pg-head");
    ph.appendChild(el("span", "", (page.heading || "page") + " · p." + page.n));
    card.appendChild(ph);
    if (page.image) {
      const img = document.createElement("img");
      img.src = "/api/te/asset/" + entry.slug + "/" + page.image;
      if (entry.page_bg) img.style.background = entry.page_bg;
      img.style.cursor = "zoom-in";
      img.onclick = () => {
        const zoomed = img.style.maxWidth === "none";
        img.style.maxWidth = zoomed ? "" : "none";
        img.style.width = zoomed ? "" : "auto";
        img.parentElement.style.overflow = zoomed ? "" : "auto";
      };
      card.appendChild(img);
    }
    if (page.blurb) {
      const txt = el("div", "pg-txt");
      txt.textContent = page.blurb;
      card.appendChild(txt);
    }
    pages.appendChild(card);
  });
  main.appendChild(pages);

  const side = el("div", "dp-side");
  side.appendChild(el("h4", "", "Loading related links…"));
  wrap.appendChild(main);
  wrap.appendChild(side);
  body.appendChild(wrap);

  // Chat rail along the bottom of the main column, speaking replies aloud.
  const chat = el("div", "pv-chat");
  chat.style.cssText = "flex:0 0 190px;border-left:0;border-top:1px solid var(--border)";
  const log = el("div", "pv-chat-log");
  log.appendChild(el("div", "pv-msg bot",
    "Ask me anything about this — I'll answer here and speak it out of the " +
    "Pine Box."));
  const inWrap = el("div", "pv-chat-in");
  const input = el("input");
  input.placeholder = "keep the conversation going…";
  const speakToggle = document.createElement("label");
  speakToggle.style.cssText = "font-size:11px;color:var(--muted);display:flex;gap:4px;align-items:center";
  const speakBox = document.createElement("input");
  speakBox.type = "checkbox";
  // Off by default: reading the manual should be silent unless asked (#66).
  speakBox.checked = localStorage.getItem("docSpeak") === "1";
  speakBox.onchange = () =>
    localStorage.setItem("docSpeak", speakBox.checked ? "1" : "0");
  speakBox.style.width = "auto";
  speakToggle.appendChild(speakBox);
  speakToggle.appendChild(document.createTextNode("speak"));
  const send = el("button", "", "Ask");
  inWrap.appendChild(input);
  inWrap.appendChild(speakToggle);
  inWrap.appendChild(send);
  chat.appendChild(log);
  chat.appendChild(inWrap);
  main.appendChild(chat);

  async function ask(text, silent) {
    if (!text) return;
    log.appendChild(el("div", "pv-msg you", "you · " + text));
    const wait = el("div", "pv-msg bot", "…researching…");
    log.appendChild(wait);
    log.scrollTop = log.scrollHeight;
    let res;
    try {
      res = await api("/api/te/chat", {
        method: "POST",
        body: JSON.stringify({
          slug: entry.slug,
          page: (entry.pages || [{}])[0].n || 0,
          text: text,
          speak: speakBox.checked && !silent,
        }),
      });
    } catch (error) {
      wait.textContent = error.message;
      return;
    }
    wait.textContent = res.answer || "(no answer)";
    log.scrollTop = log.scrollHeight;
    renderSide(res);
  }

  function renderSide(res) {
    side.textContent = "";
    if ((res.videos || []).length) {
      side.appendChild(el("h4", "", "Videos"));
      res.videos.forEach((v) => {
        const frame = document.createElement("iframe");
        frame.className = "dp-vid";
        frame.src = "https://www.youtube-nocookie.com/embed/" + v.id;
        frame.allow = "accelerometer; encrypted-media; picture-in-picture";
        frame.title = v.title || "video";
        side.appendChild(frame);
        const cap = el("div", "muted", v.title || "");
        cap.style.cssText = "font-size:11px;margin:-4px 0 12px";
        side.appendChild(cap);
      });
    }
    if ((res.links || []).length) {
      side.appendChild(el("h4", "", "On the web"));
      res.links.forEach((l) => {
        const a = document.createElement("a");
        a.href = l.url;
        a.target = "_blank";
        a.textContent = "↗ " + (l.title || l.url);
        side.appendChild(a);
      });
    }
    if (!side.children.length)
      side.appendChild(el("div", "muted", "No related links found."));
  }

  send.onclick = () => { const t = input.value.trim(); input.value = ""; ask(t); };
  input.onkeydown = (e) => {
    if (e.key === "Enter") { const t = input.value.trim(); input.value = ""; ask(t); }
  };

  // Seed the sidebar from the question that triggered the beacon — silently,
  // so opening documentation never starts talking at you (#66).
  ask(entry.query || ("tell me about " + (entry.topic || entry.title)), true);
}

/* ---- Music videos (#48) ---- */

