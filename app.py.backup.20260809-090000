  const tile = el("div", "", "");
  tile.style.cssText = "flex:0 0 108px;cursor:pointer";

  const frame = el("div", "", "");
  frame.style.cssText = "width:108px;height:108px;border-radius:8px;"
    + "overflow:hidden;border:1px solid var(--border);"
    + "display:flex;align-items:center;justify-content:center";
  sleeveInto(frame, track, 108);

  const name = el("div", "", track.title || "");
  name.style.cssText = "font-size:11px;margin-top:5px;overflow:hidden;"
    + "text-overflow:ellipsis;white-space:nowrap";
  const who = el("div", "muted", track.artist || "");
  who.style.cssText = "font-size:11px;overflow:hidden;text-overflow:ellipsis;"
    + "white-space:nowrap";

  tile.appendChild(frame);
  tile.appendChild(name);
