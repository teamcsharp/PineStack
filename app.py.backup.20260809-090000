# --- Things to spring on the other host ------------------------------------
# The built-in angles keep the pair talking. These are yours: one of them
# drops it cold and the other has to deal with it on air, unprepared.

BOMBSHELL_PATH = Path("/app/data/banter_topics.json")
_BOMBSHELL_LOCK = RLock()
BOMBSHELL_MAX = 300


def read_bombshells() -> list[dict[str, Any]]:
    try:
        data = json.loads(BOMBSHELL_PATH.read_text())
        return data if isinstance(data, list) else []
    except Exception:
        return []


def write_bombshells(rows: list[dict[str, Any]]) -> None:
    with _BOMBSHELL_LOCK:
        try:
            BOMBSHELL_PATH.parent.mkdir(parents=True, exist_ok=True)
            BOMBSHELL_PATH.write_text(json.dumps(rows[:BOMBSHELL_MAX], indent=2))
        except Exception:
            pass


def add_bombshell(text: str, kind: str = "topic") -> dict[str, Any]:
    """A line or a topic to drop on air."""
    with _BOMBSHELL_LOCK:
        rows = read_bombshells()
        row = {
            "id": uuid.uuid4().hex[:8],
            "text": text.strip()[:400],
            "kind": kind if kind in ("topic", "line") else "topic",
            "added": int(time.time()),
            "used": 0,
        }
        rows.insert(0, row)
        write_bombshells(rows)
        return row


def bombshell_angle(text: str) -> str:
    """Hand it to one of them to drop cold on the other."""
    first = random.choice(["A", "B"])
    other = "B" if first == "A" else "A"
    return (
        f"{first} brings this up out of nowhere, cold, mid-show, as though it "
        f"were the most ordinary thing in the world: \"{text}\". {other} is "
        "completely blindsided and has to react live — genuinely thrown, "
        "derailed, scrambling to keep the show on the rails. No lead-up, no "
        "explaining it first. Drop it and let the other one flounder."
    )


def use_bombshell(topic_id: str) -> None:
    with _BOMBSHELL_LOCK:
        rows = read_bombshells()
        for row in rows:
            if row.get("id") == topic_id:
                row["used"] = int(row.get("used") or 0) + 1
                row["last"] = int(time.time())
        write_bombshells(rows)


def drop_bombshell() -> dict[str, Any]:
    """Pick one, favouring whatever has had the least air time."""
    rows = read_bombshells()
    if not rows:
        return {}
    fewest = min(int(r.get("used") or 0) for r in rows)
    chosen = random.choice(
        [r for r in rows if int(r.get("used") or 0) == fewest])
    use_bombshell(chosen["id"])
    return chosen


# --- Call-ins --------------------------------------------------------------
# Somebody rings the station with a topic. Before it goes to air the pair get
# briefed: what the web says right now, and anything the gear manuals on disk
# have to say about it. Then they take it apart on air, each from a different
# angle.

# How each of them might be feeling about it. Picking two different ones is
# what stops the exchange being two people nodding along.
CALLIN_MOODS = [
    "delighted, treating it as the best thing they have heard all week",
    "deeply unimpressed, as though the caller has wasted everyone's time",
    "genuinely unsettled by it, and trying not to show it on air",
    "frustrated, because this is the third caller about this",
    "fascinated, going far too deep for a music show",
    "suspicious that the caller is winding them up",
    "nostalgic, reminded of something from years ago",
    "professionally neutral while very obviously having an opinion",
]


def manual_notes(topic: str, limit: int = 3) -> str:
    """Anything the cached gear manuals know about the topic."""
    words = [w for w in re.findall(r"[a-z0-9]+", topic.lower()) if len(w) > 3]
    if not words:
        return ""

    found: list[str] = []
    try:
        slugs = sorted(p.name for p in TE_DIR.iterdir() if p.is_dir())
    except OSError:
        return ""

    for slug in slugs:
        doc = te_doc(slug)
        if not doc:
            continue
        name = str(doc.get("name") or slug)
        # The device itself being named is the strongest signal there is.
        if any(word in slug.lower() or word in name.lower() for word in words):
            found.append(f"- the {name} manual is on the station computer")
        for page in (doc.get("pages") or [])[:60]:
            text = " ".join(str(page.get("text") or "").split())
            low = text.lower()
            if sum(1 for word in words if word in low) >= 2:
                found.append(f"- from the {name} manual: {text[:220]}")
                break
        if len(found) >= limit:
            break
    return "\n".join(found[:limit])


async def callin_brief(topic: str) -> dict[str, Any]:
    """What the pair get told before the caller goes to air."""
    web: list[dict[str, str]] = []
    try:
        web = await search_searxng(topic)
    except Exception:
        web = []                        # off air beats no show

    lines = [
        f"- {r['title']}: {r['snippet'][:240]}"
        for r in web[:4] if r.get("title") or r.get("snippet")
    ]
    manuals = await asyncio.to_thread(manual_notes, topic)
    return {
        "web": "\n".join(lines),
        "manuals": manuals,
        "sources": [r.get("url", "") for r in web[:4] if r.get("url")],
    }


async def dj_callin(topic: str, caller: str = "") -> dict[str, Any]:
    """Put a caller on air and let the pair take the topic apart."""
    brief = await callin_brief(topic)
    moods = random.sample(CALLIN_MOODS, 2)
    who = caller.strip() or random.choice(
        ["a caller", "a listener", "someone on line one",
         "a caller who would not give a name"])

    angle = (
        f"{who} has just rung the station about this, and it is now on air: "
        f"\"{topic}\". Take the call seriously as a topic and actually "
        f"discuss it — do not simply mock the caller. A is {moods[0]}. "
        f"B is {moods[1]}. Let those two dispositions rub against each other. "
        "Refer to real specifics from the briefing below rather than talking "
        "in generalities."
    )
    if brief["web"]:
        angle += f"\n\nWhat is being said about it right now:\n{brief['web']}"
    if brief["manuals"]:
        angle += (f"\n\nWhat the gear manuals on the station computer say:"
                  f"\n{brief['manuals']}")

    _RADIO["chat"].append({
        "ts": int(time.time()), "who": "host", "kind": "callin",
        "text": f"Call-in: {topic}",
    })
    lines = await dj_banter(_RADIO.get("now"), angle=angle, lines=5)
    return {
        "lines": lines, "topic": topic, "caller": who,
        "researched": bool(brief["web"]), "from_manuals": bool(brief["manuals"]),
        "sources": brief["sources"],
    }


async def dj_banter(track: dict[str, Any] | None = None,
                    angle: str = "", lines: int = 4) -> list[str]:
    """A short exchange between the two, spoken in their own voices.

    `angle` overrides the usual random pick — that is how one particular
    topic gets sprung on them on demand."""
    dj = dj_settings()
    if not dj["banter"]:
        return []

    material = banter_material()
    pictures = banter_pictures()
    host_name = "the host"
    playing = ""
    if track:
        playing = (f"\nPlaying next: {track.get('title')}"
                   + (f" by {track['artist']}" if track.get("artist") else ""))

    # Something out of your bank takes precedence over the stock angles —
    # that is the point of having put it there. Otherwise a different angle
    # each round, so the pair do not tell the same joke every three tracks.
    dropped = {} if angle else (
        drop_bombshell() if random.random() < 0.6 else {})
    if angle:
        pass                            # you chose this one yourself
    elif dropped:
        angle = bombshell_angle(dropped["text"])
    else:
        angle = random.choice([
            "gossip about a request he made, as though it were scandalous",
            "one of you claims to have heard someone else ask for the same "
            "thing",
            "be theatrically appalled by one of the pictures he had generated",
            "argue about which of his requests was the strangest",
            "pretend one of his requests has become a station in-joke",
            "wonder aloud, in mock concern, what he is going to ask for next",
        ])

    try:
        script = await ask_model(
            f"{dj['persona']}\n\nYour co-host: {dj['cohost_persona']}\n\n"
            f"Write a SHORT exchange for {dj['station_name']} between the two "
            f"of you — {max(2, lines - 1)} to {lines} lines total, "
            f"strictly alternating. This time: "
            f"{angle}. Name the actual thing you are talking about. Play it "
            "straight and let the specifics be the joke — mock outrage, "
            "raised eyebrows, 'can you believe what he asked us for'. Keep "
            "each line under 25 words. No markdown, no emoji, no URLs, no "
            "stage directions, no asterisks.\n"
            f"Format each line as 'A: ...' for you and 'B: ...' for "
            f"{dj['cohost_name']}.{playing}\n\n"
            f"Things he keeps asking for:\n{material or '- (nothing yet)'}\n\n"
            f"Pictures he had us make:\n{pictures or '- (none yet)'}",
            limit=700,
        )
    except Exception:
        return []

    # The model often returns "A: … B: … A: …" on a single line, so split on
    # the speaker markers wherever they appear rather than line by line.
    parts = re.split(r"(?:^|\s)([AB])\s*[:\-]\s*", " " + str(script or ""),
                     flags=re.I)
    turns: list[tuple[str, str]] = []
    for i in range(1, len(parts) - 1, 2):
        turns.append((parts[i].upper(), parts[i + 1]))

    female, male = await banter_voices()
    # Which of the pair is which is fixed for the round, so a listener can
    # follow the conversation.
    if random.random() < 0.5:
        voices = {"dj": female, "cohost": male}
    else:
        voices = {"dj": male, "cohost": female}

    spoken: list[str] = []
    for marker, said in turns:
        who = "dj" if marker == "A" else "cohost"
        text = spoken_text(said)[:300]
        if not text:
            continue
        said = await dj_speak("interject", track, line=text, who=who,
                              voice=voices.get(who) or None)
        if said:
            spoken.append(f"{who}: {said}")
        # dj_speak now returns only once the line has actually been spoken,
        # so this is just a beat between turns rather than a guess at length.
        await asyncio.sleep(0.35)
        if len(spoken) >= lines:
            break
    return spoken



# --- Getting the box unstuck (#134) ----------------------------------------


async def pinebox_recover(restart_agent: bool = True) -> dict[str, Any]:
    """Stop everything that could be holding the satellite, then reload it.

    An assist satellite exposes no stop service, so a long or failed announce
    leaves it lit with nothing able to interrupt it. Reloading its config
    entry is the one call that reliably clears that state."""
    steps: list[str] = []

    try:
        dj_stop()
        steps.append("radio stopped")
    except Exception as exc:
        steps.append(f"radio: {exc}")

    try:
        result = await stop_speaking()
        steps.append(f"dropped {result.get('cancelled_queued', 0)} queued lines")
    except Exception as exc:
        steps.append(f"speech: {exc}")

    token, player = _ha_creds()
    if token and player:
        async with httpx.AsyncClient(timeout=20) as client:
            headers = {"Authorization": f"Bearer {token}"}
            # Find the config entry behind the entity, then reload it.
            try:
                states = await client.get(
                    f"{HA_URL}/api/states/{player}", headers=headers)
                steps.append(f"satellite was {(states.json() or {}).get('state')}")
            except Exception:
                pass
            for service, payload in (
                ("homeassistant/update_entity", {"entity_id": player}),
                ("homeassistant/reload_config_entry", {"entity_id": player}),
            ):
                try:
                    response = await client.post(
                        f"{HA_URL}/api/services/{service}",
                        headers=headers, json=payload)
                    steps.append(
                        f"{service.split('/')[-1]}: "
                        f"{'ok' if response.status_code < 400 else response.status_code}")
                except Exception as exc:
                    steps.append(f"{service}: {exc}")
    else:
        steps.append("no Home Assistant credentials — skipped the satellite")

    if restart_agent:
        steps.append("restarting spark-agent")
        fire_and_forget(_restart_self())
    return {"ok": True, "steps": steps}


async def _restart_self() -> None:
    """Exit after the response has gone out; the container policy restarts."""
    await asyncio.sleep(1.0)
    os._exit(3)



def dropped_subject(name: str, caption: str = "") -> tuple[str, str]:
    """What the DJ can honestly say about a dropped file: (subject, source).

    A generated image carries its own prompt, which is a real description. A
    file we have never seen is only a filename, and the DJ should not invent
    a scene it cannot see."""
    if caption.strip():
        return caption.strip()[:200], "you told us what it is"

    stem = Path(name).stem
    for gen in read_generations(400):
        for field in ("file", "filename"):
            if str(gen.get(field) or "") and Path(
                    str(gen[field])).stem == stem:
                subject = " ".join(str(
                    gen.get("request") or gen.get("tags") or "").split())
                if subject:
                    return subject[:200], "your own generated image"

    pretty = re.sub(r"[-_]+", " ", stem)
    pretty = re.sub(r"\b\d{6,}\b", " ", pretty)
    return " ".join(pretty.split())[:200] or "an untitled picture", "its filename"



# --- Bringing the stack back (#136) ----------------------------------------

DOCKER_SOCK = Path("/var/run/docker.sock")
STACK_SERVICES = ("wyoming-piper", "wyoming-whisper", "homeassistant")


async def _docker_restart(name: str) -> str:
    """Only possible when the socket is mounted, which it is not by default."""
    if not DOCKER_SOCK.exists():
        return "no docker socket (see the note)"
    try:
        transport = httpx.AsyncHTTPTransport(uds=str(DOCKER_SOCK))
        async with httpx.AsyncClient(transport=transport, timeout=30) as client:
            response = await client.post(
                f"http://docker/containers/{name}/restart")
            return "restarted" if response.status_code < 400 else (
                f"docker said {response.status_code}")
    except Exception as exc:
        return f"failed: {exc}"


async def stack_reconnect(restart_agent: bool = True) -> dict[str, Any]:
    """Probe everything, reload the Home Assistant side, then restart us."""
    report: dict[str, Any] = {"services": {}, "steps": []}

    # Is Piper actually answering, or only running?
    try:
        voices = await asyncio.wait_for(piper_voices(), 8)
        report["services"]["wyoming-piper"] = (
            f"ok · {len(voices)} voices" if voices else "up but silent")
    except Exception as exc:
        report["services"]["wyoming-piper"] = f"down: {exc}"

    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(PIPER_HOST, 10300), 5)
        writer.close()
        report["services"]["wyoming-whisper"] = "ok"
    except Exception as exc:
        report["services"]["wyoming-whisper"] = f"down: {exc}"

    token, player = _ha_creds()
    if token:
        async with httpx.AsyncClient(timeout=20) as client:
            headers = {"Authorization": f"Bearer {token}"}
            try:
                response = await client.get(
                    f"{HA_URL}/api/config", headers=headers)
                report["services"]["home-assistant"] = (
                    "ok" if response.status_code < 400
                    else f"HTTP {response.status_code}")
            except Exception as exc:
                report["services"]["home-assistant"] = f"down: {exc}"

    # Reloading by config entry is the call that actually re-runs setup.
    link = await satellite_reconnect()
    report["satellite"] = link
    report["steps"] += link.get("reloaded", [])
    if link.get("advice"):
        report["steps"].append(link["advice"])
    else:
        report["services"]["home-assistant"] = "no token"

    for name in STACK_SERVICES:
        outcome = await _docker_restart(name)
        if outcome != "no docker socket (see the note)":
            report["steps"].append(f"{name}: {outcome}")
    if not DOCKER_SOCK.exists():
        report["note"] = (
            "Container restarts are off: the agent has no docker socket, and "
            "granting one lets anyone who reaches this API control the host. "
            "To allow it anyway, add '- /var/run/docker.sock:/var/run/"
            "docker.sock' to spark-agent's volumes and recreate it."
        )

    try:
        dj_stop()
        await stop_speaking()
        report["steps"].append("radio and queued speech stopped")
    except Exception:
        pass

    if restart_agent:
        report["steps"].append("restarting spark-agent")
        fire_and_forget(_restart_self())
    return report



# --- The satellite link ----------------------------------------------------
# Reloading by entity id does nothing useful; the config-entry endpoint is the
# one that re-runs setup. Everything here reports what is actually true rather
# than claiming success, because a satellite that is switched off stays off.

SATELLITE_HOST = os.getenv("SATELLITE_HOST", "")
SATELLITE_PORT = int(os.getenv("SATELLITE_PORT", "10700"))


async def ha_config_entries() -> list[dict[str, Any]]:
    token, _player = _ha_creds()
    if not token:
        return []
    try:
        async with httpx.AsyncClient(timeout=15) as client:
            response = await client.get(
                f"{HA_URL}/api/config/config_entries/entry",
                headers={"Authorization": f"Bearer {token}"},
            )
            response.raise_for_status()
            data = response.json()
            return data if isinstance(data, list) else []
    except Exception:
        return []


async def ha_reload_entry(entry_id: str) -> str:
    token, _player = _ha_creds()
    if not (token and entry_id):
        return "no token"
    try:
        async with httpx.AsyncClient(timeout=30) as client:
            response = await client.post(
                f"{HA_URL}/api/config/config_entries/entry/{entry_id}/reload",
                headers={"Authorization": f"Bearer {token}"},
            )
            return "reloaded" if response.status_code < 400 else (
                f"HTTP {response.status_code}")
    except Exception as exc:
        return f"failed: {exc}"


async def satellite_reachable(host: str = "", port: int = 0) -> bool:
    """A TCP probe of the satellite itself — the ground truth."""
    host = host or SATELLITE_HOST
    if not host:
        return False
    try:
        reader, writer = await asyncio.wait_for(
            asyncio.open_connection(host, port or SATELLITE_PORT), 3)
        writer.close()
        return True
    except Exception:
        return False


async def satellite_status() -> dict[str, Any]:
    """Everything known about the link, in one place."""
    entries = await ha_config_entries()
    wyoming = [e for e in entries if e.get("domain") == "wyoming"]
    broken = [e for e in wyoming if e.get("state") != "loaded"]

    token, player = _ha_creds()
    entity_state = ""
    if token and player:
        try:
            async with httpx.AsyncClient(timeout=10) as client:
                response = await client.get(
                    f"{HA_URL}/api/states/{player}",
                    headers={"Authorization": f"Bearer {token}"})
                entity_state = (response.json() or {}).get("state", "")
        except Exception:
            entity_state = "unknown"

    return {
        "entity": player,
        "entity_state": entity_state,
        "online": entity_state not in ("unavailable", "unknown", ""),
        "entries": [
            {"title": e.get("title"), "state": e.get("state"),
             "reason": e.get("reason"), "id": e.get("entry_id")}
            for e in wyoming
        ],
        "broken": [e.get("title") for e in broken],
        "host": SATELLITE_HOST,
        "reachable": await satellite_reachable() if SATELLITE_HOST else None,
    }



async def _probe(host: str, port: int, timeout: float = 0.6) -> bool:
    try:
        _reader, writer = await asyncio.wait_for(
            asyncio.open_connection(host, port), timeout)
        writer.close()
        return True
    except Exception:
        return False


def local_subnet() -> str:
    """The /24 this box lives on, taken from the address we already know."""
    host = SATELLITE_HOST or VOICE_PUBLIC_URL.split("//")[-1].split(":")[0]
    parts = host.split(".")
    if len(parts) == 4 and all(p.isdigit() for p in parts):
        return ".".join(parts[:3])
    return ""


async def satellite_discover(subnet: str = "") -> list[str]:
    """Sweep the subnet for anything answering the satellite port.
    ponytail: a bounded TCP sweep, not mDNS — avahi is not in this container
    and 254 short connects finish in a couple of seconds."""
    subnet = subnet or local_subnet()
    if not subnet:
        return []

    found: list[str] = []
    semaphore = asyncio.Semaphore(64)

    async def look(address: str) -> None:
        async with semaphore:
            if await _probe(address, SATELLITE_PORT):
                found.append(address)

    try:
        await asyncio.wait_for(asyncio.gather(*(
            look(f"{subnet}.{n}") for n in range(1, 255)
        ), return_exceptions=True), 25)
    except asyncio.TimeoutError:
        pass                    # partial results are still useful
    return sorted(found)


async def ha_add_wyoming(host: str, port: int) -> str:
    """Add a Wyoming device through the config-flow API, which is how the
    integration is normally set up."""
    token, _player = _ha_creds()
    if not token:
        return "no token"
    headers = {"Authorization": f"Bearer {token}"}
    try:
        async with httpx.AsyncClient(timeout=30) as client:
            start = await client.post(
                f"{HA_URL}/api/config/config_entries/flow",
                headers=headers,
                json={"handler": "wyoming", "show_advanced_options": False},
            )
            start.raise_for_status()
            flow = start.json() or {}
            flow_id = flow.get("flow_id")
            if not flow_id:
                return "no flow"
            step = await client.post(
                f"{HA_URL}/api/config/config_entries/flow/{flow_id}",
                headers=headers, json={"host": host, "port": port},
            )
            body = step.json() or {}
            if body.get("type") == "create_entry":
                return f"added {body.get('title') or host}"
            return f"{body.get('reason') or body.get('errors') or body.get('type')}"
    except Exception as exc:
        return f"failed: {exc}"


async def satellite_find_and_fix() -> dict[str, Any]:
    """The whole recovery: look for the box, and wire it up if it moved."""
    status = await satellite_status()
    if status["online"]:
        return {**status, "action": "already online"}

    hosts = await satellite_discover()
    known = SATELLITE_HOST
    action = ""

    if not hosts:
        action = (
            "Swept the local network and nothing is answering the satellite "
            f"port ({SATELLITE_PORT}). The Pine Box is not on this network at "
            "all — check that it powered up, that it joined the Wi-Fi, and "
            "that its satellite service is running."
        )
    else:
        moved = [h for h in hosts if h != known]
        if moved:
            # Deliberately NOT auto-added. Wyoming has no reconfigure flow, so
            # adding it again mints a new entry_id and every entity is renamed
            # (assist_satellite.pinevoice -> ..._2), which silently breaks
            # every announce call in this file. Report it; the durable fix is
            # a DHCP reservation for the box's MAC.
            action = (
                f"The Pine Box has MOVED: it is answering at {moved[0]}, but "
                f"Home Assistant is configured for {known or 'nothing'}. I "
                "have not re-added it automatically — Wyoming has no "
                "reconfigure step, so re-adding renames every entity and "
                "would break the voice calls. Give it a DHCP reservation at "
                f"{known} on the router, or call /api/satellite/repoint with "
                "confirm=true if you accept the rename."
            )
        else:
            action = (
                f"{known} answers the port but Home Assistant still reports "
                "the entity unavailable — reloading the entry."
            )
            await satellite_reconnect(watch=False)

    return {**await satellite_status(), "found": hosts, "action": action}


_SAT_RETRY: list[Any] = []


async def satellite_watch(minutes: int = 30) -> None:
    """Keep retrying so the box rejoins on its own once it is powered up
    again — nobody should have to come back and press a button.
    ponytail: two minutes between rounds, not thirty seconds. A full-subnet
    sweep is 254 sockets; doing that twice a minute is how you make the
    server look broken while looking for something that is switched off."""
    deadline = time.time() + minutes * 60
    rounds = 0
    while time.time() < deadline:
        await asyncio.sleep(120)
        rounds += 1
        status = await satellite_status()
        if status["online"]:
            return
        for entry in status["entries"]:
            if entry["state"] != "loaded":
                await ha_reload_entry(entry["id"])
        # Every third round, look for it at a new address as well. Finding
        # it is worth knowing; acting on it is not automatic (see above).
        if rounds % 3:
            continue
        try:
            hosts = await satellite_discover()
            if [h for h in hosts if h != SATELLITE_HOST]:
                return              # a human decision from here
        except Exception:
            pass


async def satellite_reconnect(watch: bool = True) -> dict[str, Any]:
    """Reload every wyoming entry that is not loaded, then tell the truth."""
    status = await satellite_status()
    reloaded: list[str] = []
    for entry in status["entries"]:
        if entry["state"] != "loaded":
            reloaded.append(
                f"{entry['title']}: {await ha_reload_entry(entry['id'])}")

    # If reloading will not do it, the box may simply have moved.
    if not status["online"]:
        try:
            moved = await satellite_find_and_fix()
            if moved.get("action"):
                reloaded.append(moved["action"])
        except Exception:
            pass

    await asyncio.sleep(3)
    after = await satellite_status()

    if not after["online"] and watch and not _SAT_RETRY:
        task = asyncio.create_task(satellite_watch())
        _SAT_RETRY.append(task)
        task.add_done_callback(lambda _t: _SAT_RETRY.clear())

    advice = ""
    if not after["online"]:
        where = SATELLITE_HOST or "its configured address"
        advice = (
            f"The satellite at {where} is not answering — Home Assistant "
            "reports 'Unable to connect'. Piper and Whisper are both fine, so "
            "this is the Pine Box device itself: check that it has power and "
            "is on the Wi-Fi. I will keep retrying for half an hour, and it "
            "will rejoin on its own once it is back."
        )

    return {**after, "reloaded": reloaded, "advice": advice,
            "retrying": bool(_SAT_RETRY)}



# --- The Pine Box troubleshooter -------------------------------------------

SATELLITE_MAC = os.getenv("SATELLITE_MAC", "b4:0e:cf:2a:89:5f")
SATELLITE_SSID = os.getenv("SATELLITE_SSID", "TacoNet_2.4")
GUIDE_PDF = Path("/app/data/pinebox-recovery.pdf")


async def _arp_state(host: str) -> str:
    """What the kernel's neighbour table thinks. FAILED/incomplete means the
    device is not answering at the link layer at all — it is not on the LAN."""
    try:
        proc = await asyncio.create_subprocess_exec(
            "ip", "neigh", "show", host,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
        out, _ = await asyncio.wait_for(proc.communicate(), 5)
        line = out.decode().strip()
        return line or "no entry"
    except Exception:
        return "unknown"


async def pinebox_diagnose() -> dict[str, Any]:
    """Work down the chain and stop at the first thing that is actually
    broken, so the advice is about that and not about everything."""
    checks: list[dict[str, str]] = []

    def add(name: str, ok: bool | None, detail: str) -> None:
        checks.append({"name": name, "ok": ok, "detail": detail})

    # The parts that are ours before the parts that are the device's.
    try:
        voices = await asyncio.wait_for(piper_voices(), 8)
        add("Speech engine (wyoming-piper)", bool(voices),
            f"{len(voices)} voices" if voices else "not answering on :10200")
    except Exception as exc:
        add("Speech engine (wyoming-piper)", False, str(exc)[:120])

    token, player = _ha_creds()
    add("Home Assistant token", bool(token),
        "configured" if token else "missing — set it in the Speak panel")

    link = await satellite_status()
    entries = {e["title"]: e for e in link["entries"]}
    entry = entries.get("PineVoice") or {}
    add("Home Assistant ↔ Pine Box", link["online"],
        f"{link['entity']} is {link['entity_state']}"
        + (f" · entry {entry.get('state')}" if entry else ""))

    reachable = await satellite_reachable()
    add(f"Pine Box on the network ({SATELLITE_HOST}:{SATELLITE_PORT})",
        reachable, "answering" if reachable else "no answer on the satellite port")

    # `ip` is not in this image, so ARP is informational only — it must not
    # decide the diagnosis, or an unknown reads as "everything is fine".
    arp = await _arp_state(SATELLITE_HOST) if SATELLITE_HOST else ""
    known = arp not in ("", "unknown", "no entry")
    on_lan = known and "FAILED" not in arp.upper() and "INCOMPLETE" not in arp.upper()
    add("Answers at the link layer (ARP)", on_lan if known else None,
        arp if known else "not checkable from inside the container")

    elsewhere = []
    if not reachable:
        elsewhere = await satellite_discover()
    add("Found at another address", None,
        ", ".join(elsewhere) if elsewhere else "no")

    # One diagnosis, and the steps that follow from it.
    if link["online"]:
        cause = "Nothing is wrong — the Pine Box is connected."
        steps = ["Say something to it, or start Pine Box FM."]
    elif elsewhere:
        cause = (f"The Pine Box is alive at {elsewhere[0]}, but Home "
                 f"Assistant is looking for it at {SATELLITE_HOST}. DHCP "
                 "moved it.")
        steps = [
            f"Give it a fixed address: on the router, reserve "
            f"{SATELLITE_HOST} for MAC {SATELLITE_MAC}.",
            "Reboot the Pine Box so it takes the reserved lease.",
            "Press 🛠 in the panel to reload the link.",
            "Only if a reservation is impossible: POST /api/satellite/repoint "
            "with confirm=true — it renames every entity, which is why it is "
            "not automatic.",
        ]
    elif reachable and not link["online"]:
        cause = ("The Pine Box is answering, but Home Assistant has not "
                 "picked it up.")
        steps = ["Press 🛠 in the panel — it reloads the Wyoming entry.",
                 "If that does not take, restart Home Assistant."]
    elif not reachable:
        cause = ("The Pine Box is not on the network — nothing answers for it"
                 + (", not even at the link layer" if known and not on_lan
                    else "") +
                 ". It is powered off, or it never joined the Wi-Fi.")
        steps = [
            "If the box itself says \"Wi-Fi is disconnected\" when you press "
            "its button, it is alive and booting — this is not dead hardware, "
            "it simply cannot join the network. Work through the next two "
            "steps in order.",
            f"Confirm it is provisioned for {SATELLITE_SSID}. This is the "
            "usual cause: the radio is 2.4 GHz only and cannot see the 5 GHz "
            "network of the same name.",
            "Power-cycle it: unplug for 10 seconds, plug back in, wait 60.",
            "If it still does not appear, factory reset and re-provision — "
            "see the guide.",
            "Last resort: connect it by USB and use the serial console; that "
            "is the only way to see why it is failing to associate.",
        ]
    else:
        cause = "The device answers but is not speaking Wyoming."
        steps = ["Power-cycle it.",
                 "Check the serial console — see section 5 of the guide.",
                 "Re-flash the firmware if it persists."]

    return {
        "online": link["online"],
        "checks": checks,
        "cause": cause,
        "steps": steps,
        "host": SATELLITE_HOST,
        "mac": SATELLITE_MAC,
        "ssid": SATELLITE_SSID,
        "guide": "/guide/pinebox",
        "pdf": "/api/pinebox/guide.pdf" if GUIDE_PDF.is_file() else "",
    }



# --- USB serial, bridged to the browser ------------------------------------
# The device is a Bouffalo BL-series MCU: 115200 8N1, and the console is the
# only place it will tell you why it cannot join the Wi-Fi.

SERIAL_BAUD = int(os.getenv("SERIAL_BAUD", "115200"))
_SERIAL: dict[str, Any] = {
    "port": "", "link": None, "buffer": [], "reader": None, "open_at": 0.0,
}
_SERIAL_LOCK = RLock()
_SERIAL_MAX_LINES = 800


# USB bridges that turn up on this class of board. Anything here is worth
# pointing at; everything else is almost certainly a mouse or a hub.
SERIAL_VIDS = {
    "1a86": "CH340/CH34x bridge",
    "10c4": "CP210x bridge",
    "0403": "FTDI bridge",
    "067b": "Prolific bridge",
    "303a": "Espressif native USB",
    "349e": "Bouffalo Lab native USB",
    "2e8a": "Raspberry Pi RP2040",
}


def usb_devices() -> list[dict[str, Any]]:
    """Every USB device the kernel sees, minus its own root hubs.

    This is what separates "nothing is plugged in" from "something is plugged
    in but no serial driver bound to it" — two problems with two fixes."""
    found: list[dict[str, Any]] = []
    try:
        nodes = sorted(Path("/sys/bus/usb/devices").iterdir())
    except OSError:
        return found

    for node in nodes:
        if not (node / "idVendor").is_file():
            continue

        def field(name: str) -> str:
            try:
                return (node / name).read_text().strip()
            except OSError:
                return ""

        vid, pid = field("idVendor"), field("idProduct")
        if vid == "1d6b":                      # the kernel's own root hubs
            continue
        found.append({
            "port": node.name,
            "vid_pid": f"{vid}:{pid}",
            "maker": field("manufacturer"),
            "product": field("product"),
            "serial_like": vid in SERIAL_VIDS,
            "note": SERIAL_VIDS.get(vid, ""),
        })
    return found


def serial_ports() -> list[dict[str, str]]:
    """Everything that looks like a serial device, with whatever the kernel
    knows about it — enough to tell a Pine Box from a mouse."""
    found: list[dict[str, str]] = []
    try:
        from serial.tools import list_ports        # type: ignore

        for port in list_ports.comports():
            found.append({
                "device": port.device,
                "description": port.description or "",
                "manufacturer": getattr(port, "manufacturer", "") or "",
                "vid_pid": (f"{port.vid:04x}:{port.pid:04x}"
                            if port.vid and port.pid else ""),
                "serial": getattr(port, "serial_number", "") or "",
            })
    except Exception:
        # pyserial missing or no permission — fall back to the device nodes.
        for pattern in ("ttyUSB*", "ttyACM*"):
            for node in sorted(Path("/dev").glob(pattern)):
                found.append({"device": str(node), "description": "",
                              "manufacturer": "", "vid_pid": "", "serial": ""})

    # This board has 32 onboard UARTs and none of them can ever be the Pine
    # Box, which arrives as a USB device. Offering them is worse than
    # offering nothing: an empty list is the truthful answer to "what is
    # plugged in", and the panel says so.
    return [p for p in found
            if "ttyUSB" in p["device"] or "ttyACM" in p["device"]]


def _serial_pump() -> None:
    """Blocking reader. Lines land in a bounded buffer the panel polls."""
    link = _SERIAL["link"]
    pending = b""
    while link is not None and _SERIAL["link"] is link:
        try:
            chunk = link.read(512) or b""
        except Exception:
            break
        if not chunk:
            continue
        pending += chunk
        while b"\n" in pending:
            line, pending = pending.split(b"\n", 1)
            text = line.decode("utf-8", "replace").rstrip("\r")
            with _SERIAL_LOCK:
                _SERIAL["buffer"].append(
                    {"ts": time.time(), "text": text})
                del _SERIAL["buffer"][:-_SERIAL_MAX_LINES]
    try:
        if link is not None:
            link.close()
    except Exception:
        pass


def serial_open(device: str, baud: int = 0) -> dict[str, Any]:
    with _SERIAL_LOCK:
        if _SERIAL["link"] is not None:
            serial_close()
        try:
            import serial                          # type: ignore
        except Exception as exc:
            raise HTTPException(
                status_code=503,
                detail=f"pyserial is not available in the agent: {exc}")
        try:
            link = serial.Serial(device, baud or SERIAL_BAUD, timeout=1)
        except Exception as exc:
            raise HTTPException(status_code=400, detail=str(exc)[:200])

        _SERIAL.update({
            "port": device, "link": link, "buffer": [],
            "open_at": time.time(),
        })
        reader = Thread(target=_serial_pump, name="serial-pump", daemon=True)
        _SERIAL["reader"] = reader
        reader.start()
        return {"port": device, "baud": baud or SERIAL_BAUD, "open": True}


def serial_close() -> dict[str, Any]:
    with _SERIAL_LOCK:
        link = _SERIAL["link"]
        _SERIAL["link"] = None
        try:
            if link is not None:
                link.close()
        except Exception:
            pass
        _SERIAL.update({"port": "", "reader": None})
    return {"open": False}


def serial_write(text: str, newline: bool = True) -> int:
    with _SERIAL_LOCK:
        link = _SERIAL["link"]
        if link is None:
            raise HTTPException(status_code=409, detail="No port is open")
        payload = (text + ("\r\n" if newline else "")).encode()
        try:
            return int(link.write(payload) or 0)
        except Exception as exc:
            raise HTTPException(status_code=502, detail=str(exc)[:200])


def serial_read(since: float = 0.0) -> list[dict[str, Any]]:
    with _SERIAL_LOCK:
        return [line for line in _SERIAL["buffer"] if line["ts"] > since]


def play_search_sound() -> None:
    """Fire-and-forget the 'reading the internet' sound effect on the Home
    Assistant media player. Needs HA_TOKEN + HA_MEDIA_PLAYER +
    SEARCH_SOUND_URL configured; silently does nothing otherwise, and never
    delays the actual search."""
    token, player = _ha_creds()
    if not (token and player and SEARCH_SOUND_URL):
        return

    async def _play() -> None:
        try:
            async with httpx.AsyncClient(timeout=10) as client:
                await client.post(
                    f"{HA_URL}/api/services/media_player/play_media",
                    headers={"Authorization": f"Bearer {token}"},
                    json={
                        "entity_id": player,
                        "media_content_id": SEARCH_SOUND_URL,
                        "media_content_type": "music",
                        "announce": True,
                    },
                )
        except Exception:
            pass

    try:
        asyncio.create_task(_play())
    except RuntimeError:
        pass  # no running loop (self-check context)


