@app.post("/api/music/vote")
async def music_vote(
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """1 = play it more, -1 = never again, 0 = forget I said anything."""
    require_auth(authorization)
    payload = await request.json()

    track_id = str(payload.get("id") or "")
    track = music_track(track_id) if track_id else None
    if not track:
        hits = music_search(str(payload.get("q") or ""), limit=1)
        track = hits[0] if hits else None
        track_id = track["id"] if track else ""
    if not track_id:
        raise HTTPException(status_code=404, detail="No such track")

    try:
        vote = int(payload.get("vote", 0))
    except (TypeError, ValueError):
        vote = 0
    result = set_vote(track_id, vote, track)

    # Banning what is playing means it should stop playing.
    if vote < 0:
        _RADIO["queue"] = [t for t in _RADIO["queue"] if t["id"] != track_id]
        _RADIO["requests"] = [
            t for t in _RADIO["requests"] if t["id"] != track_id]
        if (_RADIO.get("now") or {}).get("id") == track_id and _RADIO["on"]:
            dj_skip()

    return {"id": track_id, "title": (track or {}).get("title", ""), **result}


