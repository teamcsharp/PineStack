// 0 = colour by frequency, 1 = colour by recency. Blended, so the middle of
// the slider shows both: a word that is common AND recent glows hardest.
function cloudBlend() {
  const slider = document.getElementById("cloudRecency");
  return slider ? Number(slider.value) / 100 : 0;
}

function cloudRecolour() {
  const label = document.getElementById("cloudRecencyVal");
  if (label) label.textContent = Math.round(cloudBlend() * 100) + "%";
  if (cloud && cloud.words) cloudFill(cloud.words);
}

function cloudDockLit(on) {
  ["cloudDockBtn", "cloudBarBtn"].forEach((id) => {
    const button = document.getElementById(id);
    if (button) button.style.color = on ? "#7fd1ff" : "";
  });
}

// The dock is the default view of this area (#117); the toggle only turns
// it off, and that choice sticks.
function cloudDockStart() {
  if (localStorage.getItem("cloudDock") === "off") {
    document.getElementById("cloudDock").style.display = "none";
    return;
  }
  const dock = document.getElementById("cloudDock");
  dock.style.display = "block";
  cloudDockLit(true);
  cloudMount(dock).catch(() => {
    dock.style.display = "none";
    cloudDockLit(false);
  });
}

function cloudDockToggle() {
  const dock = document.getElementById("cloudDock");
  const on = dock.style.display === "none";
  localStorage.setItem("cloudDock", on ? "on" : "off");
  dock.style.display = on ? "block" : "none";
  cloudDockLit(on);
  if (!on) {
    if (cloud && cloud.host === dock) destroyCloud();
    return;
  }
  // The gallery has to be open for an overlay on it to be visible.
  const activity = document.getElementById("activity");
  if (activity) activity.classList.remove("collapsed");
  cloudMount(dock).catch((error) => {
    dock.style.display = "none";
    cloudDockLit(false);
    setStatus("Word cloud failed: " + error.message, true);
  });
}

// Every request reshapes the cloud. Pulse on an actual change, not on a
// timer — a cloud that throbs when nothing was said is just noise.
function cloudSignature(words) {
  return words.length + ":" + words.slice(0, 12)
    .map((w) => w.word + w.count).join(",");
}

let cloudPulseAt = 0;
async function cloudPulse() {
  if (!cloud) return;
  if (Date.now() - cloudPulseAt < 2000) return;
  try {
    const words = await cloudWords();
    const signature = cloudSignature(words);
    if (signature === cloud.signature) return;    // nothing new was said
    cloud.signature = signature;
    cloudPulseAt = Date.now();
    cloudFill(words);                             // re-ranks and re-places
    cloudStatus(words);
    cloud.pulse = 1;                              // and swells on the way in
  } catch (error) { /* the cloud keeps turning */ }
}

