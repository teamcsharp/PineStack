/* ---- Levels (#153, #154) ---- */

// An <audio> element's own `volume` is capped at 1.0, so anything above 100%
// has to be a GainNode. Both the music and the DJ voice get one, which also
// gives us a single place to duck from.
const gains = {music: null, voice: null};

function gainFor(player, which) {
  if (!player) return null;
  if (gains[which] && gains[which].player === player) return gains[which];
  const scope = audioScope(player);          // creates the shared AudioContext
  if (!scope) return null;
  try {
    const node = scope.context.createGain();
    // Re-route: analyser -> gain -> speakers, instead of analyser -> speakers.
    try { scope.analyser.disconnect(); } catch (error) { /* first time */ }
    scope.analyser.connect(node);
    node.connect(scope.context.destination);
    gains[which] = {node, player, context: scope.context};
    return gains[which];
  } catch (error) {
    return null;
  }
}

function djLevels() {
  const read = (id, fallback) => {
    const el_ = document.getElementById(id);
    return el_ ? Number(el_.value) : fallback;
  };
  return {
    music: read("djGainMusic", 100) / 100,
    voice: read("djGainVoice", 160) / 100,
    duck: read("djDuck", 70) / 100,
  };
}

let djSpeaking = false;

function djApplyGain() {
  const level = djLevels();
  ["djGainMusic", "djGainVoice", "djDuck"].forEach((id) => {
    const out = document.getElementById(id + "Val");
    const input = document.getElementById(id);
    if (out && input) out.textContent = input.value + "%";
  });
  localStorage.setItem("djLevels", JSON.stringify({
    music: level.music, voice: level.voice, duck: level.duck,
  }));

  const music = gainFor(document.getElementById("musicPlayer"), "music");
  const voice = gainFor(document.getElementById("djVoiceAudio"), "voice");
  // Ramp rather than jump: a step change in gain is an audible click.
  if (music) {
    const target = level.music * (djSpeaking ? (1 - level.duck) : 1);
    music.node.gain.setTargetAtTime(target, music.context.currentTime, 0.12);
  }
  if (voice) {
    voice.node.gain.setTargetAtTime(level.voice, voice.context.currentTime, 0.05);
  }
}

function djGainReset() {
  const set = (id, v) => {
    const el_ = document.getElementById(id);
    if (el_) el_.value = String(v);
  };
  set("djGainMusic", 100); set("djGainVoice", 160); set("djDuck", 70);
  djApplyGain();
}

function djLoadLevels() {
  try {
    const saved = JSON.parse(localStorage.getItem("djLevels") || "null");
    if (saved) {
      const set = (id, v) => {
        const el_ = document.getElementById(id);
        if (el_ && v !== undefined) el_.value = String(Math.round(v * 100));
      };
      set("djGainMusic", saved.music);
      set("djGainVoice", saved.voice);
      set("djDuck", saved.duck);
    }
  } catch (error) { /* defaults are fine */ }
  djApplyGain();
}

/* ---- Sleeves (#126) ---- */

// A record always has a cover. When the file carries none, draw one: the
// colour is a hash of artist+album, so the same record looks the same every
// time and an album's tracks sit together visually.
function sleeveHash(text) {
  let hash = 0;
  const source = String(text || "?");
  for (let i = 0; i < source.length; i++) {
    hash = (hash * 31 + source.charCodeAt(i)) >>> 0;
  }
  return hash;
}

function sleeveInitials(track) {
  const words = String(track.title || track.id || "?")
    .replace(/^\d+\s*[-.]?\s*/, "").trim().split(/\s+/);
  const first = (words[0] || "?").charAt(0);
  const second = words.length > 1 ? words[1].charAt(0) : "";
  return (first + second).toUpperCase();
}

// Paint a generated cover into a frame, then swap in real art if it exists.
function sleeveInto(frame, track, size) {
  const hash = sleeveHash((track.artist || "") + "|" + (track.album || track.title || ""));
  const hue = hash % 360;
  const hue2 = (hue + 40 + (hash >> 8) % 60) % 360;
  const tilt = 20 + (hash >> 4) % 130;

  frame.style.background =
    "linear-gradient(" + tilt + "deg,"
    + "hsl(" + hue + ",42%,26%),hsl(" + hue2 + ",38%,14%))";
  frame.style.position = "relative";
  frame.style.color = "hsl(" + hue + ",70%,82%)";
  frame.textContent = "";

  // A faint centre label, so it reads as a record rather than a swatch.
  const ring = document.createElement("div");
  const ringSize = Math.round((size || 108) * 0.42);
  ring.style.cssText = "position:absolute;left:50%;top:50%;width:" + ringSize
    + "px;height:" + ringSize + "px;margin:" + (-ringSize / 2) + "px 0 0 "
    + (-ringSize / 2) + "px;border-radius:50%;"
    + "background:radial-gradient(circle,hsla(" + hue + ",60%,70%,.20) 0 38%,"
    + "transparent 39%);"
    + "box-shadow:inset 0 0 0 1px hsla(" + hue + ",60%,80%,.16)";
  frame.appendChild(ring);

  const letters = document.createElement("div");
  letters.textContent = sleeveInitials(track);
  letters.style.cssText = "position:relative;font-weight:800;letter-spacing:"
    + ".04em;font-size:" + Math.round((size || 108) * 0.30) + "px;"
    + "text-shadow:0 2px 10px rgba(0,0,0,.45)";
  frame.appendChild(letters);

  if (!track.art) return;
  const image = document.createElement("img");
  image.src = track.art;
  image.alt = "";
  image.loading = "lazy";
  image.style.cssText = "position:absolute;inset:0;width:100%;height:100%;"
    + "object-fit:cover";
  // Only replace the generated sleeve once a real one has actually decoded.
  image.onload = () => {
    frame.textContent = "";
    frame.style.background = "#0d1520";
    frame.appendChild(image);
  };
}

/* ---- Downloads (#125) ---- */

// Right-click any sleeve or row to save it. The signed media URL already
// authorises the fetch, so ?download=1 only changes the disposition header.
function downloadTrack(id, title) {
  const track = id || djNowId || musicLastId;
  if (!track) {
    setStatus("Nothing is playing to download.");
    return;
  }
  const link = document.createElement("a");
  link.href = "/music/" + track + "?t=" + encodeURIComponent(mediaSig(track))
    + "&download=1";
  link.download = "";                 // the server names it
  document.body.appendChild(link);
  link.click();
  link.remove();
  const status = document.getElementById("musicStatus");
  if (status) status.textContent = "Downloading " + (title || "track") + "…";
}

// The signature travels with every URL the server hands us; keep the last one
// per track so a download can be built without another round trip.
const mediaSigs = {};
let musicLastId = "";

function rememberSig(url) {
  const match = String(url || "").match(/\/music\/([a-f0-9]{16})\?t=([a-f0-9]+)/);
  if (match) mediaSigs[match[1]] = match[2];
}

function mediaSig(id) {
  return mediaSigs[id] || "";
}

function wireDownload(node, track) {
  rememberSig(track.url);
  node.addEventListener("contextmenu", (event) => {
    event.preventDefault();
    downloadTrack(track.id, track.title);
  });
  node.title = (node.title ? node.title + " · " : "") + "right-click to download";
}

/* ---- Vote burst (#124) ---- */

// Arrows spiral out of whatever you clicked and fade over two seconds.
// Web Animations rather than CSS keyframes: each particle owns its curve and
// removes itself on finish, so nothing accumulates in the DOM.
function voteBurst(anchor, vote) {
  const box = (anchor && anchor.getBoundingClientRect)
    ? anchor.getBoundingClientRect() : null;
  const x = box ? box.left + box.width / 2 : window.innerWidth / 2;
  const y = box ? box.top + box.height / 2 : window.innerHeight / 2;

  const up = vote >= 0;
  const glyph = up ? "▲" : "▼";
  const tint = up ? "#43d17c" : "#ef6461";
  const layer = document.createElement("div");
  layer.style.cssText = "position:fixed;inset:0;pointer-events:none;z-index:200";
  document.body.appendChild(layer);

  const count = 16;
  for (let i = 0; i < count; i++) {
    const bit = document.createElement("div");
    bit.textContent = glyph;
    const size = 11 + Math.random() * 13;
    bit.style.cssText = "position:absolute;left:" + x + "px;top:" + y + "px;"
      + "font-size:" + size + "px;color:" + tint + ";"
      + "text-shadow:0 0 10px " + tint + "aa;will-change:transform,opacity";
    layer.appendChild(bit);

    // Each arrow rides its own spiral: angle sweeps as the radius grows.
    const turn = (i / count) * Math.PI * 2 + Math.random() * 0.6;
    const spin = (up ? 1 : -1) * (2.2 + Math.random() * 1.6);
    const reach = 55 + Math.random() * 85;
    const rise = up ? -1 : 1;
    const steps = [];
    for (let s = 0; s <= 10; s++) {
      const t = s / 10;
      const angle = turn + spin * t;
      const radius = reach * Math.sin(t * Math.PI * 0.62);
      steps.push({
        transform: "translate(" + (Math.cos(angle) * radius).toFixed(1)
          + "px," + (Math.sin(angle) * radius * 0.55
                     + rise * t * 90).toFixed(1)
          + "px) rotate(" + (spin * t * 120).toFixed(0) + "deg) scale("
          + (0.6 + t * 0.8).toFixed(2) + ")",
        opacity: t < 0.15 ? 1 : (1 - (t - 0.15) / 0.85),
      });
    }
    bit.animate(steps, {
      duration: 2000,
      delay: Math.random() * 220,
      easing: "cubic-bezier(.18,.7,.3,1)",
      fill: "forwards",
    });
  }

  setTimeout(() => layer.remove(), 2400);
}

