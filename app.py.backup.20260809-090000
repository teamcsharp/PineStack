async function loadConversations() {
  let turns = [];
  try { turns = (await api("/api/history?limit=400")).turns || []; }
  catch (error) {
    document.getElementById("convList").textContent = error.message;
    return;
  }
  turns.sort((a, b) => (a.ts || 0) - (b.ts || 0));
  convGroups = [];
  let group = null;
  turns.forEach((t) => {
    if (!group || (t.ts || 0) - group.end > CONV_GAP) {
      group = {id: String(t.ts || convGroups.length), turns: [], end: 0};
      convGroups.push(group);
    }
    group.turns.push(t);
    group.end = t.ts || group.end;
  });
  convGroups.reverse();   // newest conversation first

  const filterSel = document.getElementById("convFolderFilter");
  const folders = convFolders();
  const names = Array.from(new Set(Object.values(folders))).sort();
  filterSel.textContent = "";
  ["all conversations"].concat(names).forEach((name, i) => {
    const opt = document.createElement("option");
    opt.value = i === 0 ? "" : name;
    opt.textContent = name;
    filterSel.appendChild(opt);
  });
  renderConvList();
}

function renderConvList() {
  const list = document.getElementById("convList");
  const needle =
    (document.getElementById("convSearch").value || "").toLowerCase();
  const folderWanted = document.getElementById("convFolderFilter").value;
  const folders = convFolders();
  list.textContent = "";
  convGroups.forEach((g, i) => {
    const first = g.turns[0] || {};
    const cachedTitle = convTitles()[g.id];
    const label = cachedTitle || (first.user || "(no text)").slice(0, 60);
    const folder = folders[g.id] || "";
    if (folderWanted && folder !== folderWanted) return;
    if (needle && !g.turns.some((t) =>
      ((t.user || "") + " " + (t.answer || "")).toLowerCase().includes(needle)
    )) return;
    const row = el("div", "conv-item" + (i === convSelected ? " on" : ""));
    const when = el("div", "when",
      new Date((first.ts || 0) * 1000).toLocaleString() +
      " · " + g.turns.length + " turns");
    row.appendChild(when);
    const text = el("div", "conv-title", label);
    if (folder) text.appendChild(el("span", "folder", folder));
    if (!cachedTitle) {
      ensureConvTitle(g).then((t) => {
        if (t) { text.textContent = t; if (folder) text.appendChild(
          el("span", "folder", folder)); }
      });
    }
    row.appendChild(text);
    row.onclick = () => { convSelected = i; renderConvList(); renderConvView(g); };
    list.appendChild(row);
  });
  if (!list.children.length)
    list.appendChild(el("div", "muted", "No conversations match."));
