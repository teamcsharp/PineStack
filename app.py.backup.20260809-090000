  --bg: #0c0d0f; --panel: #16181c; --panel2: #202329; --border: #333740;
  --text: #eef1f5; --muted: #8992a0; --accent: #ffd23f; --danger: #ff4d4d;
  --radius: 4px; --radius-sm: 3px;
}
:root[data-theme="ob4"] {           /* OB-4: cream radio, warm dial */
  --bg: #211d18; --panel: #2c2721; --panel2: #38312a; --border: #4d443a;
  --text: #f4ece0; --muted: #b0a48f; --accent: #e0a458; --danger: #c0563b;
  --radius: 12px; --radius-sm: 9px;
}
:root[data-theme="pocketoperator"] { /* PO series: bare PCB, LCD */
  --bg: #101512; --panel: #17201b; --panel2: #1e2a22; --border: #2f4235;
  --text: #e8f3ea; --muted: #8aa392; --accent: #f2c14e; --danger: #e2603f;
  --radius: 0px; --radius-sm: 0px;
}

/* The device itself, rendered behind everything. */
#deviceSkin {
  position: fixed; inset: 0; z-index: -1; pointer-events: none;
  opacity: .85;
}
/* With a machine behind them the panels need to read as panels. */
:root[data-skin] .panel {
  background: color-mix(in srgb, var(--panel) 88%, transparent);
  backdrop-filter: blur(9px);
}
:root[data-skin] body { background: transparent; }

/* Structure that follows the hardware, not just the colours. */
:root[data-theme="nes"] .panel,
:root[data-theme="pocketoperator"] .panel { box-shadow: var(--shadow); }
:root[data-theme="tp7"] button,
:root[data-theme="tp7"] input,
:root[data-theme="tp7"] select { border-radius: 999px; }
:root[data-theme="gameboy"] body::after,
:root[data-theme="nes"] body::after {
  content: ""; position: fixed; inset: 0; pointer-events: none; z-index: 999;
  background: var(--grain);
}
/* The light themes need their inputs to stop being dark-on-dark. */
:root[data-theme="tp7"] input, :root[data-theme="tp7"] textarea,
:root[data-theme="tp7"] select, :root[data-theme="op1"] input,
:root[data-theme="op1"] textarea, :root[data-theme="op1"] select {
  background: #fff; color: var(--text);
}
:root[data-theme="tp7"], :root[data-theme="op1"] { color-scheme: light; }
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, sans-serif;
}
header {
  padding: 22px 28px;
  border-bottom: 1px solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}
h1 { margin: 0; font-size: 24px; }
small, .muted { color: var(--muted); }
main {
  display: flex;
  align-items: flex-start;
  gap: 0;
  padding: 20px;
}
main > .col-left {
  flex: 0 0 var(--split, 50%);
  min-width: 320px;
}
main > aside {
  flex: 1 1 auto;
  min-width: 320px;
}
#gutter {
  flex: 0 0 14px;
  align-self: stretch;
  cursor: col-resize;
  position: relative;
}
#gutter::before {
  content: "";
  position: absolute;
  left: 6px; top: 0; bottom: 0; width: 2px;
  background: var(--border);
  border-radius: 2px;
  transition: background .15s ease;
}
#gutter:hover::before, #gutter.dragging::before { background: var(--accent); }
.panel {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 18px;
}
label {
  display: block;
  margin: 12px 0 6px;
  color: var(--muted);
}
input, select, textarea, button {
  font: inherit;
}
input, select, textarea {
  width: 100%;
  background: var(--panel2);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 11px;
}
textarea {
  min-height: 390px;
  resize: vertical;
  line-height: 1.45;
}
button {
  border: 1px solid var(--border);
  border-radius: var(--radius-sm);
  padding: 10px 14px;
  background: var(--panel2);
  color: var(--text);
  cursor: pointer;
}
button.primary {
  background: var(--accent);
  color: #001018;
  border-color: var(--accent);
  font-weight: 700;
}
button.danger {
  color: #fff;
  background: var(--danger);
  border-color: var(--danger);
}
.row {
  display: flex;
  gap: 10px;
  align-items: center;
}
.row > * { flex: 1; }
/* An icon button is a square, not a slab. `.row > *` above would stretch it
   across the row, so transport controls opt out of the flex share. */
.row > .tbtn, .tbtn {
  flex: 0 0 auto;
  width: 46px; height: 46px; padding: 0;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 16px; line-height: 1;
  border-radius: var(--radius-sm);
}
.tbtn:hover { background: var(--panel); border-color: var(--accent); }
/* The playback strip: full width, and tall enough to read at a glance. */
.player-strip {
  display: flex; align-items: center; gap: 10px;
  margin: 10px -18px 0; padding: 12px 18px;
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
  background: linear-gradient(#0a121c, #05070b);
}
.player-strip audio { flex: 1; min-width: 0; height: 44px; }
.player-strip .sleeve-now {
  flex: 0 0 auto; width: 46px; height: 46px; border-radius: 4px;
  overflow: hidden; background: #0d1520;
  box-shadow: 0 0 0 1px rgba(255,255,255,.07);
}
.arrows button {
  flex: 0 0 54px;
  font-size: 22px;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 14px;
}
.status {
  min-height: 24px;
  color: var(--muted);
  margin-top: 12px;
}
.test-output {
  white-space: pre-wrap;
  min-height: 120px;
  background: #0e1117;
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  margin-top: 10px;
}
.toggle {
  display: flex;
  align-items: center;
  gap: 10px;
}
.toggle input { width: auto; }
@media (max-width: 950px) {
  main { flex-direction: column; }
  main > .col-left { flex-basis: auto !important; width: 100%; }
  #gutter { display: none; }
}

/* ---- Live activity bar (top): scrolling gallery + status ---- */
#activity {
  position: sticky; top: 0; z-index: 30;
  background: linear-gradient(180deg, #0c1017, #0a0c10);
  border-bottom: 1px solid var(--border);
  padding: 12px 18px 14px;
}
.act-head {
  display: flex; align-items: center; gap: 11px; margin-bottom: 10px;
}
.act-title { font-weight: 700; letter-spacing: .02em; font-size: 15px; }
.live-dot {
  width: 9px; height: 9px; border-radius: 50%; background: #28d17c;
  animation: livepulse 2s infinite;
}
@keyframes livepulse {
  0%   { box-shadow: 0 0 0 0 rgba(40,209,124,.55); }
  70%  { box-shadow: 0 0 0 9px rgba(40,209,124,0); }
  100% { box-shadow: 0 0 0 0 rgba(40,209,124,0); }
}
.act-status { color: var(--muted); font-size: 13px; }
.act-status .busy { color: #ffd479; font-weight: 700; }
.act-count { color: var(--muted); font-size: 12px; }
.cf {
  position: relative; overflow: hidden; border-radius: 10px;
  background:
    radial-gradient(120% 78% at 50% -10%, #12202f 0%, transparent 62%),
    linear-gradient(#070c14 0%, #04070c 55%, #010306 100%);
  border: 1px solid var(--border);
  perspective: 900px; perspective-origin: 50% 38%;
  touch-action: pan-y; cursor: grab; user-select: none;
}
/* The floor the covers stand on, and a vignette to sink the edges. */
.cf::before {
  content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 46%;
  background: linear-gradient(to bottom, transparent, rgba(80,140,200,.07));
  pointer-events: none;
}
.cf::after {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: radial-gradient(70% 60% at 50% 45%, transparent 55%,
    rgba(0,0,0,.55) 100%);
}
.cf.dragging { cursor: grabbing; }
/* Albums drifting past behind the stage (#162). Kept dim and desaturated so
   the album on the stage is unmistakably the one in focus. */
.cf-swirl { position: absolute; inset: 0; overflow: hidden; z-index: 0; }
.cf-swirl-tile {
  position: absolute; top: 0; left: 0; border-radius: 3px; overflow: hidden;
  will-change: transform, opacity; opacity: 0; cursor: pointer;
  filter: saturate(.7) brightness(.75);
  box-shadow: 0 10px 26px rgba(0,0,0,.55);
  transition: filter .2s ease;
}
.cf-swirl-tile:hover { filter: none; }
.cf-focus {
  position: absolute; inset: 0; z-index: 220; display: flex; gap: 14px;
  padding: 14px; background: rgba(3,6,12,.9); backdrop-filter: blur(7px);
  cursor: default;
}
.cf-focus .sleeve {
  width: min(38%, 220px); aspect-ratio: 1; flex: none; border-radius: 4px;
  overflow: hidden; align-self: flex-start;
  box-shadow: 0 20px 44px rgba(0,0,0,.7), 0 0 0 1px rgba(255,255,255,.09);
}
.cf-focus .list { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.cf-focus .tracks { overflow-y: auto; margin-top: 8px; padding-right: 4px; }
.cf-focus .tracks div {
  display: flex; gap: 8px; padding: 6px 8px; border-radius: 6px;
  font-size: 13px; cursor: pointer; align-items: baseline;
}
.cf-focus .tracks div:hover { background: rgba(75,179,255,.14); }
.cf-focus .tracks .n { color: var(--muted); font-size: 11px; min-width: 20px; }
.cf-focus .tracks .t { flex: 1; min-width: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.cf-focus .tracks .d { color: var(--muted); font-size: 11px; }
.cf-stage { position: absolute; inset: 0; transform-style: preserve-3d; }
.cf-item {
  position: absolute; top: 12px; left: 50%; transform-style: preserve-3d;
  transition: transform .42s cubic-bezier(.22,.72,.24,1),
              opacity .42s ease;
  will-change: transform;
}
.cf-face {
  position: relative; border-radius: 3px; overflow: hidden; background: #0d1520;
  box-shadow: 0 14px 30px rgba(0,0,0,.6), 0 0 0 1px rgba(255,255,255,.06);
  display: flex; align-items: center; justify-content: center;
}
/* A sheen across the sleeve, like light off a printed jacket. */
.cf-face::after {
  content: ""; position: absolute; inset: 0; pointer-events: none;
  background: linear-gradient(112deg, rgba(255,255,255,.16) 0%,
    rgba(255,255,255,.04) 26%, transparent 46%);
}
.cf-item.on .cf-face {
  box-shadow: 0 0 0 1px rgba(255,255,255,.22), 0 26px 54px rgba(0,0,0,.75),
              0 0 60px rgba(75,179,255,.13);
}
/* The mirrored copy: a real element, because Firefox has no box-reflect. */
.cf-mirror {
  transform: scaleY(-1); opacity: .42; margin-top: 2px;
  -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,.9), transparent 58%);
  mask-image: linear-gradient(to top, rgba(0,0,0,.9), transparent 58%);
  pointer-events: none; box-shadow: none;
}
.cf-mirror::after { display: none; }
.cf-label {
  position: absolute; left: 0; right: 0; bottom: 10px; text-align: center;
  font-size: 13px; line-height: 1.4; pointer-events: none; z-index: 3;
  text-shadow: 0 2px 10px #000, 0 0 22px #000;
}
.cf-label b { display: block; }
.cf-label span { color: #9ba6b7; font-size: 12px; }
.cf-empty {
  position: absolute; inset: 0; display: flex; align-items: center;
  justify-content: center; color: #6c7c92; font-size: 13px;
}
.cf-rail {
  position: absolute; left: 50%; transform: translateX(-50%); bottom: 52px;
  width: min(62%, 420px); appearance: none; height: 4px; border-radius: 4px;
  background: linear-gradient(#0d1622, #16222f); outline: none; z-index: 3;
  box-shadow: inset 0 1px 2px rgba(0,0,0,.7), 0 1px 0 rgba(255,255,255,.05);
}
.cf-rail::-webkit-slider-thumb {
  appearance: none; width: 26px; height: 11px; border-radius: 6px;
  background: #4bb3ff; cursor: pointer;
}
.cf-rail::-moz-range-thumb {
  width: 26px; height: 11px; border: 0; border-radius: 6px;
  background: #4bb3ff; cursor: pointer;
}
.film-size {
  display: flex; align-items: center; gap: 8px; margin-left: auto;
  color: var(--muted); font-size: 12px; white-space: nowrap;
}
.film-size input[type="range"] {
  width: 130px; padding: 0; margin: 0; background: transparent;
  border: none; accent-color: var(--accent); cursor: pointer;
}
.film-size .val { min-width: 34px; text-align: right; color: var(--text); }
.act-refresh {
  padding: 4px 10px; font-size: 12px; width: auto; margin: 0;
  border-radius: 7px; cursor: pointer;
}

.film {
  position: relative; overflow: hidden;
  height: calc(90px * var(--film-scale) + 18px);
  border: 1px solid var(--border); border-radius: 10px; background: #05070b;
  -webkit-mask-image: linear-gradient(90deg,
    transparent, #000 4%, #000 96%, transparent);
  mask-image: linear-gradient(90deg,
    transparent, #000 4%, #000 96%, transparent);
}
.film-track {
  display: flex; gap: 8px; padding: 9px; height: 100%; width: max-content;
  animation: scroll-film 60s linear infinite;
}
.film:hover .film-track { animation-play-state: paused; }
@keyframes scroll-film {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }
}
.film-item {
  position: relative; height: calc(90px * var(--film-scale));
  aspect-ratio: 1; flex: 0 0 auto;
  border-radius: 8px; overflow: hidden; cursor: pointer;
  border: 1px solid var(--border); background: #0e1117;
  transition: transform .2s ease, border-color .2s ease;
}
.film-item:hover { transform: scale(1.04); border-color: var(--accent); }
.film-item img, .film-item video {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.film-item.enter { animation: film-pop .75s cubic-bezier(.2,.9,.25,1); }
.film-item .newbadge {
  position: absolute; top: 6px; right: 6px; z-index: 3;
  background: var(--accent); color: #001018; font-size: 10px;
  font-weight: 800; padding: 2px 8px; border-radius: 999px;
  letter-spacing: .06em; box-shadow: 0 2px 10px rgba(0,0,0,.55);
  animation: newpulse 2.4s ease-in-out infinite;
}
@keyframes newpulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.12); }
}
/* Lightbox */
.lb-card { max-width: 900px; margin: 0 auto; }
.lb-imgwrap {
  position: relative; border-radius: 10px; overflow: hidden;
  border: 1px solid #2c3a4f; background: #0b1016; min-height: 60px;
}
#lightboxImg, .lb-mosaic { width: 100%; display: block; }
.lb-meta { margin-top: 12px; color: #dfe7f2; font-size: 14px; line-height: 1.6; }
.lb-meta b { color: var(--muted); font-weight: 600; }
.lb-actions { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
@keyframes film-pop {
  0%   { transform: scale(0.1); opacity: 0; filter: brightness(2.4); }
  55%  { transform: scale(1.14); opacity: 1; filter: brightness(1.5); }
  100% { transform: scale(1); filter: brightness(1); }
}
.film-empty {
  color: var(--muted); font-size: 13px; padding: 42px 20px;
  text-align: center; width: 100%;
}

/* ---- Technical feed: manual pages splashed on screen ---- */
#techfeed { padding: 16px 20px 8px; }
.tf-head {
  display: flex; align-items: center; gap: 10px;
  margin-bottom: 12px; padding: 4px 2px; flex-wrap: wrap; row-gap: 8px;
  color: var(--muted); font-size: 12px; text-transform: uppercase;
  letter-spacing: .06em;
}
.tf-head .tf-device {
  color: var(--accent); font-weight: 700; letter-spacing: .02em;
}
.tf-ask {
  margin-left: auto; display: flex; gap: 8px; align-items: center;
  text-transform: none; letter-spacing: 0; padding: 2px 0;
}
.tf-ask input {
  width: 240px; padding: 5px 10px; font-size: 12px; margin: 0;
  border-radius: 7px; background: var(--panel); color: var(--text);
  border: 1px solid var(--border);
}
.tf-ask button {
  padding: 5px 12px; font-size: 12px; width: auto; margin: 0;
  border-radius: 7px; cursor: pointer;
}
/* ---- Notification tray (#49 / #50) ---- */
.phrase-list { margin-bottom: 6px; }
.phrase-row { display: flex; gap: 6px; margin-bottom: 6px; }
.phrase-row input { flex: 1; margin: 0; }
.phrase-row button {
  width: auto; padding: 5px 10px; border-radius: 7px; cursor: pointer;
}
.phrase-add {
  width: auto; padding: 1px 9px; margin-left: 8px; border-radius: 6px;
  font-size: 13px; font-weight: 700; cursor: pointer;
}

.prompt-quick { position: relative; flex: 0 0 auto; }
.prompt-quick > button {
  width: auto; padding: 5px 10px; border-radius: 7px; cursor: pointer;
  font-size: 13px;
}
.prompt-menu {
  position: absolute; left: 0; top: 34px; z-index: 60; width: 260px;
  background: var(--panel); border: 1px solid var(--border);
  border-radius: 10px; padding: 6px; box-shadow: 0 14px 34px rgba(0,0,0,.55);
  max-height: 320px; overflow-y: auto;
}
.prompt-opt {
  padding: 7px 9px; border-radius: 7px; cursor: pointer; font-size: 12.5px;
  color: #c3cfdd; position: relative;
}
.prompt-opt:hover { background: var(--panel2); color: var(--text); }
.prompt-opt.on { outline: 1px solid var(--accent); color: var(--accent); }
/* Hover preview: the prompt text scrolling endlessly. */
.prompt-peek {
  position: fixed; z-index: 120; width: 320px; height: 150px; overflow: hidden;
  background: #05070b; border: 1px solid var(--accent); border-radius: 10px;
  padding: 10px 12px; font-size: 12px; line-height: 1.6; color: #c9d4e2;
  box-shadow: 0 16px 40px rgba(0,0,0,.6); pointer-events: none;
}
.prompt-peek div { animation: peek-roll 18s linear infinite; }
@keyframes peek-roll {
  0% { transform: translateY(100%); }
  100% { transform: translateY(-100%); }
}

.key-chip {
  flex: 0 0 auto; width: auto; padding: 5px 10px; border-radius: 7px;
  cursor: pointer; font-size: 13px;
}
.key-chip.needed {
  border-color: var(--danger); color: var(--danger);
  animation: newpulse 1.8s ease-in-out infinite;
}

.tray-btn {
  position: relative; width: auto; padding: 7px 10px; border-radius: 10px;
  cursor: pointer; color: var(--muted); background: var(--panel);
  border: 1px solid var(--border); display: flex; align-items: center;
}
.tray-btn:hover { color: var(--accent); border-color: var(--accent); }
.tray-count {
  position: absolute; top: -6px; right: -6px; min-width: 17px;
  font-size: 10px; font-weight: 800; color: #001018; background: var(--accent);
  border-radius: 999px; padding: 1px 5px;
}
.tray-count:empty { display: none; }
.tray-panel {
  position: fixed; right: 18px; top: 68px; z-index: 95; width: 330px;
  max-height: 70vh; overflow-y: auto; background: var(--panel);
  border: 1px solid var(--border); border-radius: 14px; padding: 10px;
  box-shadow: 0 18px 44px rgba(0,0,0,.6);
}
.tray-head {
  font-size: 11px; text-transform: uppercase; letter-spacing: .06em;
  color: var(--muted); margin-bottom: 8px; padding: 0 4px;
}
.tray-item {
  display: flex; gap: 11px; align-items: center; padding: 8px;
  border-radius: 10px; cursor: pointer;
}
.tray-item:hover { background: var(--panel2); }
/* HTC-style: monochrome glyph, rounded tile, soft glow behind it. */
.tray-ico {
  flex: 0 0 40px; width: 40px; height: 40px; border-radius: 11px;
  display: flex; align-items: center; justify-content: center;
  background: #11151d; border: 1px solid var(--border);
  color: #dfe7f2; filter: grayscale(1);
  box-shadow: 0 0 12px rgba(32,185,232,.28), inset 0 1px 0 rgba(255,255,255,.05);
}
.tray-item:hover .tray-ico {
  filter: none; color: var(--accent);
  box-shadow: 0 0 18px rgba(32,185,232,.5);
}
.tray-txt { min-width: 0; }
.tray-txt b { display: block; font-size: 12.5px; color: var(--text); }
.tray-txt small { color: var(--muted); font-size: 11px; }
.tray-txt b, .tray-txt small {
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  display: block; max-width: 240px;
}

/* ---- Documentation beacon (#46) ---- */
.doc-beacon {
  position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);
  z-index: 90; display: flex; flex-direction: column; align-items: center;
  gap: 8px; padding: 22px 26px; cursor: pointer;
  color: #dfe7f2; background: rgba(10, 12, 16, .92);
  border: 1px solid var(--border); border-radius: 16px;
  box-shadow: 0 18px 50px rgba(0, 0, 0, .6);
  animation: beacon-pulse 1.9s ease-in-out infinite;
  filter: grayscale(1);
}
.doc-beacon:hover { filter: none; border-color: var(--accent); }
.doc-beacon span {
  font-size: 12px; letter-spacing: .05em; text-transform: uppercase;
  max-width: 220px; text-align: center; color: var(--muted);
}
@keyframes beacon-pulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: .82; }
  50% { transform: translate(-50%, -50%) scale(1.09); opacity: 1; }
}
/* Pulse three times, then hold steady until dismissed. */
.doc-beacon { animation-iteration-count: 3; }
.doc-beacon:hover { animation-play-state: paused; }
.doc-beacon img {
  width: 190px; max-height: 190px; object-fit: contain; border-radius: 10px;
  background: #f0efea; padding: 8px;
}
.doc-beacon.tune { filter: grayscale(1); color: #dfe7f2; }
.doc-beacon.tune:hover { filter: none; color: #ff4444; }

/* Video popup */
.vp-wrap { flex: 1; display: flex; flex-direction: column; min-height: 0; }
.vp-frame { flex: 1; width: 100%; border: 0; background: #000; }
.vp-bar {
  display: flex; gap: 10px; align-items: center; padding: 10px 52px 10px 14px;
  border-top: 1px solid var(--border); flex-wrap: wrap;
