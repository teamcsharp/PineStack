@app.get("/healthz")
async def healthz() -> dict[str, str]:
    """Liveness only — no disk, no network, no auth.

    The point of it is the event loop itself. If something has starved the
    loop the process still accepts connections but never answers, which a TCP
    port check happily calls healthy; this coroutine simply never runs, the
    probe times out, and the watchdog sees the hang for what it is.

    /health is the wrong thing to probe: it queries Ollama and runs a live
    SearXNG search, and returns 200 even when they fail."""
    return {"status": "ok"}


