@app.put("/api/settings")
async def api_put_settings(
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    require_auth(authorization)

    try:
        payload = await request.json()
        # The mask (or an empty field) means "keep the stored token".
        if isinstance(payload, dict):
            # A tab opened before a model switch still holds the old name in
            # its settings object; saving anything would silently revert the
            # live model. Model changes go through /api/model only.
            payload["model"] = load_settings().get("model") or payload.get("model")
            stored = load_settings().get("voice_out") or {}
            backup = _ha_token_stored()
            incoming = payload.get("voice_out") or {}
            if incoming.get("ha_token", "") in ("", _TOKEN_MASK):
                payload.setdefault("voice_out", {})["ha_token"] = (
                    stored.get("ha_token") or backup["token"]
                )
            if not incoming.get("media_player"):
                payload.setdefault("voice_out", {})["media_player"] = (
                    stored.get("media_player") or backup["player"]
                )
        settings = save_settings(payload)
        voice = settings.get("voice_out") or {}
        if voice.get("ha_token"):
            _ha_token_persist(voice["ha_token"], voice.get("media_player", ""))
        else:
            # Settings arrived without a token (reset, or an old client):
            # heal them from the standalone copy rather than losing voice out.
            backup = _ha_token_stored()
            if backup["token"]:
                settings["voice_out"] = {
                    "ha_token": backup["token"],
                    "media_player": voice.get("media_player")
                    or backup["player"],
                }
                settings = save_settings(settings)
    except (ValueError, TypeError, json.JSONDecodeError) as exc:
        raise HTTPException(status_code=400, detail=str(exc)) from exc

    return _mask_voice(settings)


