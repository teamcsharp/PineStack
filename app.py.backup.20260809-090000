let voiceEngines = [];

// A path means an audio file exists. speak_locally means this browser has to
// do the talking. Neither, and the sound already left through Home Assistant.
function speakResult(result) {
  const audio = document.getElementById("sayAudio");
  const here = document.getElementById("voicePlayHere");

  if (result && result.speak_locally) {
    if (!("speechSynthesis" in window)) {
      return "This browser has no speech synthesis.";
    }
    speechSynthesis.cancel();
    speechSynthesis.speak(new SpeechSynthesisUtterance(result.spoken || ""));
    return "Spoken by this browser.";
  }

  if (result && result.path) {
    if (!here || here.checked) {
      audio.src = result.path + (result.sig ? "?t=" + result.sig : "");
      audio.style.display = "block";
      audio.play().catch(() => {});   // autoplay may be blocked; controls stay
    }
    return "Generated in " + (result.ms || 0) + " ms · "
      + (result.engine || "") + (result.voice ? " · " + result.voice : "")
      + (result.played_on ? " · playing on " + result.played_on : "");
  }

  return "Sent to voice output.";
}

