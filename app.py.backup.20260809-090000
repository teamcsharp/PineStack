// Runs the checks and shows what they mean. The guide it links to runs the
// same checks itself, so the printed copy is never out of date.
async function pineDoctor() {
  let report;
  try {
    report = await api("/api/pinebox/diagnose");
  } catch (error) {
    alert(error.message);
    return;
  }

  const shade = el("div", "", "");
  shade.style.cssText = "position:fixed;inset:0;background:#020409d9;z-index:150;"
    + "display:flex;align-items:center;justify-content:center";
  shade.onclick = (event) => { if (event.target === shade) shade.remove(); };

  const card = el("div", "panel", "");
  card.style.cssText = "max-width:640px;width:94%;max-height:86vh;"
    + "overflow-y:auto;margin:0";

  const head = el("h2", "", report.online
    ? "Pine Box · connected" : "Pine Box · not answering");
  head.style.marginTop = "0";
  card.appendChild(head);

  (report.checks || []).forEach((check) => {
    const row = el("div", "", "");
    row.style.cssText = "display:flex;gap:10px;padding:4px 0;font-size:13px";
    const mark = el("span", "", check.ok === null ? "—"
      : (check.ok ? "✅" : "❌"));
    mark.style.flex = "0 0 20px";
    const name = el("span", "", check.name);
    name.style.flex = "1";
    const detail = el("span", "muted", check.detail || "");
    detail.style.cssText = "flex:1;font-size:12px;text-align:right";
    [mark, name, detail].forEach((n) => row.appendChild(n));
    card.appendChild(row);
  });

  const verdict = el("div", "", report.cause || "");
  verdict.style.cssText = "margin-top:12px;padding:11px 13px;border-radius:8px;"
    + "background:var(--panel2);border-left:4px solid var(--accent);"
    + "font-size:13px;line-height:1.5";
  card.appendChild(verdict);

  if ((report.steps || []).length) {
    const list = document.createElement("ol");
    list.style.cssText = "margin:10px 0 0;padding-left:20px;font-size:13px;"
      + "line-height:1.6";
    report.steps.forEach((step) => {
      const item = document.createElement("li");
      item.textContent = step;
      list.appendChild(item);
    });
    card.appendChild(list);
  }

  const row = el("div", "row", "");
  row.style.marginTop = "14px";
  const guide = el("button", "primary", "📘 Full guide");
  guide.onclick = () => window.open("/guide/pinebox", "_blank");
  const pdf = el("button", "", "⤓ PDF");
  pdf.title = "The printed recovery guide";
  pdf.onclick = () => window.open("/api/pinebox/guide.pdf", "_blank");
  const retry = el("button", "", "↻ Re-check");
  retry.onclick = () => { shade.remove(); pineDoctor(); };
  const usb = el("button", "", "🔌 USB console");
  usb.title = "Talk to it over USB — the only channel that works when Wi-Fi does not";
  usb.onclick = () => { shade.remove(); usbConsole(); };
  const fix = el("button", "", "\U0001F6E0 Try to reconnect");
  fix.onclick = () => { shade.remove(); stackReconnect(); };
  const shut = el("button", "danger", "Close");
  shut.onclick = () => shade.remove();
  [guide, pdf, usb, retry, fix, shut].forEach((b) => row.appendChild(b));
  card.appendChild(row);

  shade.appendChild(card);
  document.body.appendChild(shade);
}

/* ---- Bringing the stack back (#136) ---- */

async function stackReconnect() {
  const button = document.getElementById("stackReconnect");
  if (!confirm("Probe the voice services, reload the Home Assistant links "
      + "and restart the agent?")) return;
  const was = button.textContent;
  button.textContent = "⏳";
  setStatus("Reconnecting the stack…");
  try {
    const report = await api("/api/stack/reconnect", {
      method: "POST", body: JSON.stringify({restart: true}),
    });
    const services = Object.entries(report.services || {})
      .map(([name, state]) => name + ": " + state).join(" · ");
    setStatus(services + (report.note ? " — " + report.note : ""));
    if (report.note) console.info("[pinebox]", report.note);
    setTimeout(() => location.reload(), 12000);
  } catch (error) {
    setStatus(error.message, true);
    button.textContent = was;
  }
}

/* ---- Recovery (#134) ---- */

// The satellite can end up lit and unresponsive after an announcement that
// never finished. This stops the show, clears queued speech, reloads the
// speaker in Home Assistant and restarts the agent.
async function pineRecover() {
  const button = document.getElementById("pineRecover");
  if (!confirm("Stop the radio, unstick the Pine Box speaker and restart the "
      + "agent?")) return;
  const was = button.textContent;
  button.textContent = "⏳";
  setStatus("Recovering the Pine Box…");
  try {
    const result = await api("/api/pinebox/recover", {
      method: "POST", body: JSON.stringify({restart: true}),
    });
    setStatus((result.steps || []).join(" · "));
    // The agent is on its way down; give it time to come back up.
    setTimeout(() => location.reload(), 12000);
  } catch (error) {
    setStatus(error.message, true);
    button.textContent = was;
  }
}

/* ---- The device behind the page (#144-#147) ---- */

// Themes that come with a machine. Everything else stays flat.
const SKINS = ["tp7", "op1", "ko2", "pocketoperator"];
let skin = null;

function skinLevel() {
  // Borrow the spectrogram's analyser so the hardware moves with the music.
  const player = document.getElementById("musicPlayer");
  const scope = player && scopes.get(player);
  if (!scope) return 0;
  scope.analyser.getByteFrequencyData(scope.bins);
  let sum = 0;
  for (let i = 0; i < 40; i++) sum += scope.bins[i];
  return (sum / 40) / 255;
}

function skinStop() {
  if (!skin) return;
  skin.stop();
  skin = null;
  document.documentElement.removeAttribute("data-skin");
  const canvas = document.getElementById("deviceSkin");
  if (canvas) canvas.remove();
}

async function deviceSkin(theme) {
  skinStop();
  if (SKINS.indexOf(theme) < 0) return;

  const THREE = await import("/vendor/three.module.js");
  const host = document.createElement("div");
  host.id = "deviceSkin";
  document.body.appendChild(host);
  document.documentElement.setAttribute("data-skin", theme);

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(
    40, window.innerWidth / window.innerHeight, 0.1, 200);
  camera.position.set(0, 2.2, 14);
  camera.lookAt(0, 0, 0);

  const renderer = new THREE.WebGLRenderer({antialias: true, alpha: true});
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
  renderer.setSize(window.innerWidth, window.innerHeight);
  host.appendChild(renderer.domElement);

  const style = getComputedStyle(document.documentElement);
  const accent = new THREE.Color(style.getPropertyValue("--accent").trim()
    || "#ff5c00");
  const shellColour = new THREE.Color(style.getPropertyValue("--panel2").trim()
    || "#20242c");

  scene.add(new THREE.AmbientLight(0xffffff, 0.75));
  const key = new THREE.DirectionalLight(0xffffff, 1.35);
  key.position.set(5, 9, 8);
  scene.add(key);
  const glow = new THREE.PointLight(accent.getHex(), 60, 40);
  glow.position.set(-6, 3, 5);
  scene.add(glow);

  const rig = new THREE.Group();
  scene.add(rig);
  const movers = [];

  function shell(w, h, d, colour) {
    return new THREE.Mesh(
      new THREE.BoxGeometry(w, h, d),
      new THREE.MeshStandardMaterial({
        color: colour !== undefined ? colour : shellColour,
        roughness: 0.55, metalness: 0.35}));
  }

  if (theme === "tp7") {
    // A reel-to-reel: two spools, a capstan, tape between them.
    rig.add(shell(15, 9, 0.8));
    [-3.9, 3.9].forEach((x, i) => {
      const reel = new THREE.Group();
      reel.position.set(x, 1.1, 0.5);
      const disc = new THREE.Mesh(
        new THREE.CylinderGeometry(2.5, 2.5, 0.28, 48),
        new THREE.MeshStandardMaterial({color: 0x1b1b1e, roughness: 0.5,
                                        metalness: 0.6}));
      disc.rotation.x = Math.PI / 2;
      reel.add(disc);
      const hub = new THREE.Mesh(
        new THREE.CylinderGeometry(0.75, 0.75, 0.34, 32),
        new THREE.MeshStandardMaterial({color: 0xd7d7d2, metalness: 1,
                                        roughness: 0.25}));
      hub.rotation.x = Math.PI / 2;
      reel.add(hub);
      // Three windows in the spool, so the rotation is visible.
      for (let s = 0; s < 3; s++) {
        const slot = new THREE.Mesh(
          new THREE.TorusGeometry(1.65, 0.16, 8, 24, Math.PI / 2.4),
          new THREE.MeshStandardMaterial({color: 0x0d0d0f, roughness: 0.7}));
        slot.rotation.z = (s / 3) * Math.PI * 2;
        slot.position.z = 0.16;
        reel.add(slot);
      }
      rig.add(reel);
      movers.push({node: reel, kind: "reel", dir: i ? -1 : 1});
    });
    const tape = new THREE.Mesh(
      new THREE.BoxGeometry(7.8, 0.09, 0.02),
      new THREE.MeshStandardMaterial({color: 0x3a2c22, roughness: 0.9}));
    tape.position.set(0, -1.6, 0.62);
    rig.add(tape);
    const capstan = new THREE.Mesh(
      new THREE.CylinderGeometry(0.16, 0.16, 1.1, 20),
      new THREE.MeshStandardMaterial({color: 0xe6e6e2, metalness: 1,
                                      roughness: 0.2}));
    capstan.position.set(0, -1.2, 0.7);
    rig.add(capstan);
    movers.push({node: capstan, kind: "spin", dir: 1});
  }

  if (theme === "op1") {
    // The keyboard: white body, a strip of coloured keys, four encoders.
    rig.add(shell(16, 6.4, 0.9, 0xf2f2ee));
    const keyColours = [0xe03b3b, 0x23a455, 0x2f6fe0, 0xe8b93c];
    for (let i = 0; i < 24; i++) {
      const white = new THREE.Mesh(
        new THREE.BoxGeometry(0.56, 1.5, 0.3),
        new THREE.MeshStandardMaterial({color: 0xfbfbf8, roughness: 0.45}));
      white.position.set(-7.1 + i * 0.6, -1.9, 0.6);
      rig.add(white);
      movers.push({node: white, kind: "key", seed: i});
    }
    keyColours.forEach((colour, i) => {
      const knob = new THREE.Mesh(
        new THREE.CylinderGeometry(0.62, 0.62, 0.5, 32),
        new THREE.MeshStandardMaterial({color: colour, roughness: 0.35,
                                        metalness: 0.25}));
      knob.rotation.x = Math.PI / 2;
      knob.position.set(-5.4 + i * 1.7, 1.5, 0.7);
      rig.add(knob);
      movers.push({node: knob, kind: "spin", dir: i % 2 ? -1 : 1});
    });
    const screen = new THREE.Mesh(
      new THREE.PlaneGeometry(5.2, 2.2),
      new THREE.MeshBasicMaterial({color: accent, transparent: true,
                                   opacity: 0.22}));
    screen.position.set(3.6, 1.2, 0.62);
    rig.add(screen);
    movers.push({node: screen, kind: "screen"});
  }

  if (theme === "ko2") {
    // The K.O. II slab: a numeric pad grid and a bright strip.
    rig.add(shell(11, 9.5, 0.8));
    for (let r = 0; r < 4; r++) {
      for (let c = 0; c < 3; c++) {
        const pad = new THREE.Mesh(
          new THREE.BoxGeometry(1.5, 1.1, 0.22),
          new THREE.MeshStandardMaterial({color: 0x2f3238, roughness: 0.6}));
        pad.position.set(-2.1 + c * 2.1, -2.6 + r * 1.5, 0.55);
        rig.add(pad);
        movers.push({node: pad, kind: "pad", seed: r * 3 + c,
                     base: pad.material.color.clone()});
      }
    }
    const strip = new THREE.Mesh(
      new THREE.PlaneGeometry(9.4, 0.5),
      new THREE.MeshBasicMaterial({color: accent}));
    strip.position.set(0, 3.9, 0.62);
    rig.add(strip);
    movers.push({node: strip, kind: "screen"});
  }

  if (theme === "pocketoperator") {
    // A bare board: exposed PCB, an LCD, and a row of buttons.
    const board = shell(12, 7, 0.28, 0x123024);
    rig.add(board);
    const lcd = new THREE.Mesh(
      new THREE.PlaneGeometry(5.6, 2.6),
      new THREE.MeshBasicMaterial({color: 0x9bbc0f, transparent: true,
                                   opacity: 0.55}));
    lcd.position.set(0, 1.4, 0.2);
    rig.add(lcd);
    movers.push({node: lcd, kind: "screen"});
    for (let i = 0; i < 16; i++) {
      const button = new THREE.Mesh(
        new THREE.CylinderGeometry(0.26, 0.26, 0.16, 20),
        new THREE.MeshStandardMaterial({color: 0xd8d8d2, roughness: 0.5}));
      button.rotation.x = Math.PI / 2;
      button.position.set(-4.8 + (i % 8) * 1.37, -1.4 - Math.floor(i / 8) * 1.4,
                          0.2);
      rig.add(button);
      movers.push({node: button, kind: "pad", seed: i,
                   base: button.material.color.clone()});
    }
  }

  let frame = 0;
  function tick(now) {
    frame = requestAnimationFrame(tick);
    const level = skinLevel();
    const t = now / 1000;

    movers.forEach((mover) => {
      if (mover.kind === "reel") {
        mover.node.rotation.z += mover.dir * (0.004 + level * 0.09);
      } else if (mover.kind === "spin") {
        mover.node.rotation.y += mover.dir * (0.006 + level * 0.06);
      } else if (mover.kind === "key") {
        const hit = Math.max(0, Math.sin(t * 2.2 + mover.seed * 0.7) - 0.82);
        mover.node.position.z = 0.6 - hit * level * 3.2;
      } else if (mover.kind === "pad") {
        const pulse = Math.max(0, Math.sin(t * 3 + mover.seed) ) * level;
        mover.node.material.color.copy(mover.base).lerp(accent, pulse * 0.85);
      } else if (mover.kind === "screen") {
        mover.node.material.opacity = 0.18 + level * 0.5;
      }
    });

    // A slow parallax so it reads as an object in a room, not a wallpaper.
    rig.rotation.y = Math.sin(t * 0.18) * 0.09;
    rig.rotation.x = -0.12 + Math.sin(t * 0.13) * 0.03;
    renderer.render(scene, camera);
  }
  frame = requestAnimationFrame(tick);

  function onResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
  }
  window.addEventListener("resize", onResize);

  skin = {
    theme,
    stop() {
      cancelAnimationFrame(frame);
      window.removeEventListener("resize", onResize);
      scene.traverse((node) => {
        if (node.geometry) node.geometry.dispose();
        if (node.material) node.material.dispose();
      });
      renderer.dispose();
    },
  };
}

