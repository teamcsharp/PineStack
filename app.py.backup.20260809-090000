@app.post("/api/te/chat")
async def te_chat(
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Documentation chat: answer about one manual page, plus live web
    links/videos on the topic."""
    require_auth(authorization)
    payload = await request.json()
    slug = safe_key(str(payload.get("slug") or ""))
    page_n = int(payload.get("page") or 0)
    text = str(payload.get("text") or "").strip()
    if not text:
        raise HTTPException(status_code=400, detail="Say something first")

    doc = te_doc(slug) or {}
    page = next((p for p in doc.get("pages", []) if p.get("n") == page_n), {})
    settings = load_settings()
    speak = bool(payload.get("speak"))

    links: list[dict[str, str]] = []
    videos: list[dict[str, str]] = []
    if settings["web_search"]:
        try:
            found = await search_searxng(f"{doc.get('title', slug)} {text}")
            links = [
                {"title": r.get("title", ""), "url": r.get("url", "")}
                for r in found[:6]
                if r.get("url")
            ]
        except Exception:
            links = []
        try:
            videos = await search_videos(f"{doc.get('title', slug)} {text}")
        except Exception:
            videos = []

    context = (
        f"You are discussing the manual '{doc.get('title', slug)}'"
        + (f", page {page_n} ({page.get('heading', '')})" if page else "")
        + ". Page text:\n"
        + (page.get("text", "")[:3000] or "(no text on this page)")
        + (
            "\n\nLive web results on the topic:\n"
            + "\n".join(f"- {l['title']} — {l['url']}" for l in links)
            if links
            else ""
        )
        + "\n\nAnswer the user's question conversationally. Cite page details "
        "where relevant, and mention the most useful links by name."
    )
    try:
        result = await call_ollama(
            model=settings["model"],
            messages=[
                {"role": "system", "content": context},
                {"role": "user", "content": text},
            ],
            temperature=0.6,
            max_tokens=400,
            num_ctx=8192,
        )
        answer = str(result.get("message", {}).get("content") or "").strip()
    except Exception as exc:
        answer = f"(model unavailable: {exc})"
    if speak and answer:
        # Voice replies out of the Pine Box speaker while you keep typing.
        fire_and_forget_speech(speak(answer[:600], event="doc"))
    return {"answer": answer, "links": links, "videos": videos}


@app.get("/api/perf")
async def perf(
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Light polling endpoint for the header performance HUD."""
    require_read_auth(authorization)
    mem = _read_meminfo()
    total = mem.get("MemTotal", 0)
    avail = mem.get("MemAvailable", 0)
    out: dict[str, Any] = {
        "ram_pct": round(100 * (total - avail) / total, 1) if total else 0,
        "ram_used_gb": round((total - avail) / 1048576, 1),
        "ram_total_gb": round(total / 1048576, 1),
    }
    try:
        load1 = float(Path("/proc/loadavg").read_text().split()[0])
        cores = os.cpu_count() or 1
        out["cpu_pct"] = round(min(100.0, 100.0 * load1 / cores), 1)
        out["load1"] = load1
        out["cores"] = cores
    except Exception:
        out["cpu_pct"] = 0
    gpu_line = await asyncio.to_thread(_gpu_stats)
    m = re.search(
        r"(\d+)% utilization, (\d+) of (\d+) MB VRAM, (\d+) C", gpu_line
    )
    if m:
        util, used, total_v, temp = (int(x) for x in m.groups())
        out["gpu_pct"] = util
        out["vram_pct"] = round(100 * used / total_v, 1) if total_v else 0
        out["vram_used_gb"] = round(used / 1024, 1)
        out["vram_total_gb"] = round(total_v / 1024, 1)
        out["gpu_temp_c"] = temp
    therm = _read_gpu_temp()
    temp_c = out.get("gpu_temp_c") or therm.get("temp_c")
    if temp_c:
        out["temp_c"] = round(float(temp_c), 1)
        out["temp_f"] = round(float(temp_c) * 9 / 5 + 32, 1)
        out["temp_zone"] = therm.get("temp_zone", "gpu")
    return out


@app.get("/api/health/details")
async def health_details(
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Everything the health popup shows: per-service state, loaded models,
    system stats, and recent operation timings."""
    require_read_auth(authorization)
    services: dict[str, Any] = {}
    token, _player = _ha_creds()

    async def probe(
        client: httpx.AsyncClient, name: str, url: str, **kw: Any
    ) -> tuple[str, Any]:
        try:
            response = await client.get(url, **kw)
            services[name] = {
                "ok": response.status_code < 500,
                "detail": f"HTTP {response.status_code}",
                "url": url,
                "facts": [],
            }
            return name, response
        except Exception as exc:
            services[name] = {
                "ok": False, "detail": str(exc)[:120], "url": url, "facts": [],
            }
            return name, None

    def fact(name: str, line: str) -> None:
        if name in services and line:
            services[name]["facts"].append(line)

    async with httpx.AsyncClient(timeout=8) as client:
        results = dict(
            await asyncio.gather(
                probe(client, "ollama", f"{OLLAMA_URL}/api/version"),
                probe(client, "searxng", f"{SEARXNG_URL}/config"),
                probe(client, "comfyui", f"{COMFYUI_URL}/system_stats"),
                probe(
                    client, "home-assistant", f"{HA_URL}/api/config",
                    headers={"Authorization": f"Bearer {token}"} if token else None,
                ),
                probe(client, "open-webui", f"{OPENWEBUI_URL}/health"),
            )
        )

        # --- ollama: version, what's resident, what's installed
        try:
            fact("ollama", "version " + (results["ollama"].json() or {}).get(
                "version", "?"))
        except Exception:
            pass
        try:
            ps = (await client.get(f"{OLLAMA_URL}/api/ps")).json() or {}
            loaded = [m.get("name") for m in ps.get("models", [])]
            services["ollama"]["loaded"] = loaded
            for m in ps.get("models", []):
                size = m.get("size_vram") or m.get("size") or 0
                fact("ollama", f"resident: {m.get('name')} "
                               f"({size / 1e9:.1f} GB VRAM)")
            if not loaded:
                fact("ollama", "no model resident (loads on first request)")
            tags = (await client.get(f"{OLLAMA_URL}/api/tags")).json() or {}
            fact("ollama", f"{len(tags.get('models', []))} models installed")
        except Exception:
            pass

        # --- searxng: which engines are actually answering
        try:
            cfg = results["searxng"].json() or {}
            engines = cfg.get("engines") or []
            enabled = [e for e in engines if not e.get("disabled")]
            fact("searxng", f"{len(enabled)} of {len(engines)} engines enabled")
            data = await _searxng_query(
                client, "pine box status", SEARXNG_ENGINES)
            hits = len(data.get("results", []))
            dead = [e[0] for e in (data.get("unresponsive_engines") or [])]
            fact("searxng", f"agent engines ({SEARXNG_ENGINES}) → {hits} results")
            services["searxng"]["ok"] = hits > 0
            if dead:
                fact("searxng", "blocked from this IP: " + ", ".join(dead[:6]))
            if not hits:
                fact("searxng", "no engine answered — searches will fall back "
                                "to DuckDuckGo scraping")
        except Exception as exc:
            fact("searxng", f"probe failed: {str(exc)[:60]}")

        # --- comfyui: hardware + queue depth
        try:
            st = results["comfyui"].json() or {}
            dev = (st.get("devices") or [{}])[0]
            total = dev.get("vram_total") or 0
            free = dev.get("vram_free") or 0
            fact("comfyui", f"{dev.get('name', 'gpu')}")
            if total:
                fact("comfyui", f"VRAM {(total - free) / 1e9:.1f} / "
                                f"{total / 1e9:.1f} GB in use")
            sysinfo = st.get("system") or {}
            fact("comfyui", f"comfyui {sysinfo.get('comfyui_version', '?')} · "
                            f"python {(sysinfo.get('python_version') or '?')[:6]}")
            queue = (await client.get(f"{COMFYUI_URL}/queue")).json() or {}
            running = len(queue.get("queue_running") or [])
            waiting = len(queue.get("queue_pending") or [])
            fact("comfyui", f"queue: {running} running, {waiting} waiting")
        except Exception:
            pass

        # --- home assistant: version + what it can actually do for us
        if results.get("home-assistant") is not None:
            try:
                cfg = results["home-assistant"].json() or {}
                fact("home-assistant", f"core {cfg.get('version', '?')} · "
                                       f"{cfg.get('location_name', '?')}")
                states = (
                    await client.get(
                        f"{HA_URL}/api/states",
                        headers={"Authorization": f"Bearer {token}"},
                    )
                ).json()
                kinds: dict[str, int] = {}
                for st in states:
                    kinds[str(st["entity_id"]).split(".")[0]] = kinds.get(
                        str(st["entity_id"]).split(".")[0], 0) + 1
                fact("home-assistant", f"{len(states)} entities")
                for want in ("assist_satellite", "media_player", "tts"):
                    got = [
                        s["entity_id"] for s in states
                        if str(s["entity_id"]).startswith(want + ".")
                    ]
                    if got:
                        fact("home-assistant", f"{want}: " + ", ".join(got[:4]))
                fact("home-assistant", "voice out → " + (_ha_creds()[1] or "not set"))
            except Exception as exc:
                fact("home-assistant",
                     "token missing or rejected — paste one in Speak → "
                     "Voice-out setup" if not token else str(exc)[:70])
                if not token:
                    services["home-assistant"]["ok"] = False

        # --- open webui
        try:
            ow = (await client.get(f"{OPENWEBUI_URL}/api/config")).json() or {}
            fact("open-webui", f"version {ow.get('version', '?')} · "
                               f"{ow.get('name', 'Open WebUI')}")
            fact("open-webui", "auth " + ("on" if ow.get("features", {}).get(
                "auth") else "off"))
            fact("open-webui",
                 "api key " + ("set" if OPENWEBUI_API_KEY else "missing"))
        except Exception:
            pass

    gens = _read_all_generations()
    services["spark-agent"] = {
        "ok": True,
        "detail": "serving this request",
        "url": "http://lilspark.local:8096",
        "facts": [
            f"{len(gens)} renders · "
            f"{sum(1 for g in gens if g.get('status') == 'queued')} in flight",
            f"{len(te_devices())} manuals cached",
            f"voice out → {_ha_creds()[1] or 'not set'}"
            f"{' (token set)' if token else ' (no token)'}",
        ],
        "loaded": [],
    }

    # Last operations: the three newest turns and renders, with timings.
    ops: dict[str, list[str]] = {"agent": [], "comfyui": []}
    for turn in read_history(limit=3):
        when = time.strftime("%H:%M:%S", time.localtime(turn.get("ts", 0)))
        ops["agent"].append(
            f"{when} · {(turn.get('user') or '')[:60]} → "
            f"{turn.get('model', '')}"
        )
    for gen in read_generations(3):
        when = time.strftime("%H:%M:%S", time.localtime(gen.get("ts", 0)))
        dur = gen.get("duration")
        ops["comfyui"].append(
            f"{when} · {gen.get('status', '?')}"
            + (f" in {dur:.0f}s" if isinstance(dur, (int, float)) else "")
            + f" · {(gen.get('tags') or '')[:50]}"
        )

    mem = _read_meminfo()
    total = mem.get("MemTotal", 0)
    avail = mem.get("MemAvailable", 0)
    gpu = _read_gpu_temp()
    marquee = []
    for turn in read_history(limit=8):
        marquee.append(
            time.strftime("%H:%M", time.localtime(turn.get("ts", 0)))
            + " " + (turn.get("user") or "")[:40]
        )
    for gen in read_generations(8):
        marquee.append(
            time.strftime("%H:%M", time.localtime(gen.get("ts", 0)))
            + " 🖼 " + (gen.get("tags") or gen.get("request") or "")[:40]
        )
    # --- the voice chain and the DJ, as first-class services (#109)
    engine = voice_engine()
    _token, player = _ha_creds()
    voices = list(_VOICE_CATALOG.get("piper", (0, []))[1])
    ledger = _voice_ledger()
    services["voice chain"] = {
        "ok": bool(_token) or engine in ("piper", "browser"),
        "detail": f"engine: {engine}",
        "url": f"{PIPER_HOST}:{PIPER_PORT} (wyoming)",
        "virtual": True,
        "facts": [
            "piper · wyoming TCP on this DGX Spark, ONNX voice models from "
            "./piper-data — the only engine with no network hop",
            "ha · Home Assistant tts.speak, which itself calls the same piper",
            "ha_file · Home Assistant synthesises, we keep the file",
            "browser · your device's own voices, NOT the Spark",
            f"{len(voices) or len(PIPER_VOICES)} voices available",
            f"speaking to → {player or 'no speaker set'}",
            f"budget {ledger['chars']}/{VOICE_DAILY_CHARS} chars today, "
