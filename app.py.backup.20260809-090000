# --- Memory: short-term conversation context + long-term remembered facts ---


def has_client_history(messages: list[dict[str, Any]]) -> bool:
    # If the voice client already sends prior turns, trust those instead of
    # stitching in the server-side recent conversation.
    return sum(1 for m in messages if m.get("role") == "user") > 1


def prompt_just_changed(current: str) -> bool:
    """True when the last thing we answered was written under a different
    personality. A switch is a clean slate (#135) — otherwise the client's
    own history keeps feeding the model replies in the old voice and the
    change appears to lag by a turn or two."""
    try:
        recent = read_history(limit=1)
    except Exception:
        return False
    if not recent:
        return False
    previous = recent[-1].get("prompt")
    return bool(previous) and previous != current


def drop_stale_history(
    messages: list[dict[str, Any]], current: str
) -> list[dict[str, Any]]:
    """Keep only the newest user message when the personality just changed."""
    if not prompt_just_changed(current):
        return messages
    for message in reversed(messages):
        if message.get("role") == "user":
            return [message]
    return messages


MEMORY_COMMAND = re.compile(
    r"^\s*(?:please\s+)?(?:remember|note|keep in mind|don'?t forget|"
    r"make a note)\b(?:\s+that)?[:,]?\s*(.+)$",
    re.IGNORECASE | re.DOTALL,
)


def is_memory_command(text: str) -> str | None:
    match = MEMORY_COMMAND.match(text)
    if not match:
        return None
    return match.group(1).strip().rstrip(".") or None


def save_memory(text: str) -> None:
    try:
        MEMORIES_PATH.parent.mkdir(parents=True, exist_ok=True)
        with MEMORIES_PATH.open("a") as handle:
            handle.write(
                json.dumps({"ts": int(time.time()), "text": text}) + "\n"
            )
    except Exception:
        pass


def read_memories(limit: int = 100) -> list[dict[str, Any]]:
    try:
        lines = MEMORIES_PATH.read_text().splitlines()
    except Exception:
        return []
    out: list[dict[str, Any]] = []
    for line in lines[-limit:]:
        try:
            out.append(json.loads(line))
        except Exception:
            continue
    return out


def delete_memory(ts: int) -> None:
    try:
        lines = MEMORIES_PATH.read_text().splitlines()
    except Exception:
        return
    kept: list[str] = []
    for line in lines:
        try:
            if json.loads(line).get("ts") == ts:
                continue
        except Exception:
            pass
        kept.append(line)
    try:
        MEMORIES_PATH.write_text("\n".join(kept) + ("\n" if kept else ""))
    except Exception:
        pass


def update_memory(ts: int, text: str) -> None:
    try:
        lines = MEMORIES_PATH.read_text().splitlines()
    except Exception:
        return
    out: list[str] = []
    for line in lines:
        try:
            obj = json.loads(line)
            if obj.get("ts") == ts:
                obj["text"] = text
                out.append(json.dumps(obj))
                continue
        except Exception:
            pass
        out.append(line)
    try:
        MEMORIES_PATH.write_text("\n".join(out) + ("\n" if out else ""))
    except Exception:
        pass


def format_memory_context(memories: list[dict[str, Any]]) -> str:
    facts = "\n".join(f"- {m.get('text', '')}" for m in memories if m.get("text"))
    return (
        "Things you remember about the user and past conversations:\n"
        f"{facts}\n"
        "Use these when relevant. Do not recite them unless the user asks."
    )


def format_recent_conversation(turns: list[dict[str, Any]]) -> str:
    lines = ["Recent conversation so far (oldest first):"]
    for turn in turns:
        user = (turn.get("user") or "").strip()
        answer = (turn.get("answer") or "").strip()
        if user:
            lines.append(f"User: {user}")
        if answer:
            lines.append(f"Assistant: {answer}")
    lines.append("Continue naturally, keeping this context in mind.")
    return "\n".join(lines)


async def ask_model(prompt: str, limit: int = 300) -> str:
    """A plain model call for the agent's own voice lines — no web search, no
    gear manuals, no technical feed, and nothing written to history. Routing
    an internal prompt through generate_answer makes it look like something
    the user asked, which is how "ACKNOWLEDGE THIS REQUEST…" ended up on the
    Pine Box screen."""
    settings = load_settings()
    result = await call_ollama(
        model=settings["model"],
        messages=[{"role": "user", "content": prompt}],
        temperature=settings["temperature"],
        max_tokens=min(220, settings["max_tokens"]),
        top_p=settings["top_p"],
        num_ctx=settings["num_ctx"],
    )
    answer = ((result.get("message") or {}).get("content") or "").strip()
    answer = re.sub(r"<think>.*?</think>", " ", answer, flags=re.S)
    return " ".join(answer.split())[:limit]


async def call_ollama(
    *,
    model: str,
    messages: list[dict[str, str]],
    temperature: float,
    max_tokens: int,
    top_p: float = 0.9,
    num_ctx: int = 8192,
) -> dict[str, Any]:
    async with httpx.AsyncClient(timeout=300) as client:
        response = await client.post(
            f"{OLLAMA_URL}/api/chat",
            json={
                "model": model,
                "messages": messages,
                "stream": False,
                "think": False,
                "keep_alive": "30m",
                "options": {
                    "temperature": temperature,
                    "top_p": top_p,
                    "num_predict": max_tokens,
                    "num_ctx": num_ctx,
                },
            },
        )
        response.raise_for_status()
        return response.json()


async def generate_answer(
    incoming_messages: list[dict[str, Any]],
    requested_model: str | None = None,
    requested_max_tokens: int | None = None,
) -> tuple[str, dict[str, Any]]:
    settings = load_settings()
    user_text = latest_user_text(incoming_messages)

    if not user_text:
        raise HTTPException(
            status_code=400,
            detail="No user message was supplied.",
        )

    prompt_entry = settings["prompts"][settings["active_prompt"]]
    # Applies to what the client sent us, not only to our own stitching.
    incoming_messages = drop_stale_history(
        incoming_messages, prompt_entry["name"])

    feature_meta = {
        "web_search_used": False,
        "weather_used": False,
        "tv_lookup_used": False,
        "game_lookup_used": False,
        "gear_manual_used": False,
        "gear_device": "",
        "from_library": False,
        "system_status_used": False,
        "image_requested": False,
        "video_requested": False,
        "tune_requested": False,
        "openwebui_used": False,
        "memory_used": False,
        "memory_saved": False,
    }

    # Explicit "open web ui ..." routes the question to Open WebUI and returns.
    if is_openwebui_request(user_text):
        ow_model = requested_model or settings["model"]
        answer = await ask_openwebui(user_text, ow_model)
        feature_meta["openwebui_used"] = True
        return answer, {
            **feature_meta,
            "active_prompt": prompt_entry["name"],
            "model": ow_model,
            "prompt_tokens": 0,
            "completion_tokens": 0,
        }

    memory_command = (
        is_memory_command(user_text)
        if settings.get("long_term_memory", True)
        else None
    )

    system_used = (not memory_command) and is_system_query(user_text)
    tune_requested = (
        not is_music_request(user_text)
        and
        not memory_command and not system_used and is_tune_request(user_text)
    )
    video_requested = (
        not memory_command
        and not system_used
        and not tune_requested
        and is_video_request(user_text)
    )
    image_requested = (
        not memory_command
        and not system_used
        and not tune_requested
        and not video_requested
        and is_image_request(user_text)
    )
    weather_used = (
        not memory_command
        and not system_used
        and not tune_requested
        and not video_requested
        and not image_requested
        and is_weather_query(user_text)
    )
    # While the show is on, "request X" is aimed at the DJ, not at the box.
    dj_used = (
        not memory_command
        and not system_used
        and is_dj_request(user_text)
    )
    # "play <thing>" that the library can satisfy beats the YouTube path —
    # your own files should win over a music video of the same song.
    music_used = (
        not dj_used
        and not memory_command
        and not system_used
        and is_music_request(user_text)
    )
    # A named song beats every other lookup: the crystal is already local
    # and nobody asks about "Square One" hoping for a gear manual.
    song_used = (
        not music_used
        and not memory_command
        and not system_used
        and not tune_requested
        and not video_requested
        and not image_requested
        and not weather_used
        and is_song_query(user_text)
    )
    te_used = (
        not memory_command
        and not system_used
        and not tune_requested
        and not video_requested
        and not image_requested
        and not weather_used
        and not song_used
        and settings.get("gear_manuals", True)
        and is_te_query(user_text)
    )
    # One named episode goes to the discussion threads; anything vaguer about
    # the show goes down the ordinary TV path.
    episode_used = (
        not memory_command
        and not system_used
        and not tune_requested
        and not video_requested
        and not image_requested
        and not weather_used
        and not song_used
        and not te_used
        and settings["web_search"]
        and is_episode_talk(user_text)
    )
    tv_used = (
        not memory_command
        and not system_used
        and not tune_requested
        and not video_requested
        and not image_requested
        and not weather_used
        and not song_used
        and not te_used
        and not episode_used
        and settings["web_search"]
        and is_tv_query(user_text)
    )
    game_used = (
        not memory_command
        and not system_used
        and not tune_requested
        and not video_requested
        and not image_requested
        and not weather_used
        and not song_used
        and not te_used
        and not episode_used
        and not tv_used
        and settings.get("game_search", True)
        and (is_game_query(user_text) or is_research_query(user_text))
    )
    search_used = (
        not memory_command
        and not system_used
        and not tune_requested
        and not video_requested
        and not image_requested
        and not weather_used
        and not song_used
        and not te_used
        and not episode_used
        and not tv_used
        and not game_used
        and settings["web_search"]
        and needs_web_search(user_text)
    )

    messages: list[dict[str, str]] = [
        {
            "role": "system",
            "content": prompt_entry["prompt"],
        }
    ]

    # Long-term memories are available to every answer when enabled.
    if settings.get("long_term_memory", True):
        memories = read_memories()
        if memories:
            feature_meta["memory_used"] = True
            messages.append(
                {"role": "system", "content": format_memory_context(memories)}
            )

    # Short-term: stitch in recent conversation when the client sends no history.
    if settings.get("conversation_memory", True) and not has_client_history(
        incoming_messages
    ):
        recent = read_history(limit=MEMORY_TURNS)
        # A prompt switch is a clean slate: replies made under another
        # personality would drown out the new one (#79).
        recent = [
            t for t in recent
            if t.get("prompt") in (None, prompt_entry["name"])
        ]
        if recent:
            messages.append(
                {
                    "role": "system",
                    "content": format_recent_conversation(recent),
                }
            )
            messages.append(
                {
                    "role": "system",
                    "content": (
                        "The current system prompt is authoritative and may "
                        "have just been edited — follow it, not the style of "
                        "earlier replies. Do not reuse stage directions, "
                        "catchphrases or mannerisms that already appear in "
                        "the recent conversation (no repeating the same "
                        "actions, like lighting a cigarette, reply after "
                        "reply). Vary your delivery so each reply feels "
                        "fresh."  # 75/#79
                    ),
                }
            )

    # Votes steer style: downvoted phrasings are banned, upvoted are liked (#76).
    fb = read_feedback()
    if fb:
        downs = [
            f["text"] for f in fb if f.get("vote") == "down" and f.get("text")
        ][-8:]
        ups = [
            f["text"] for f in fb if f.get("vote") == "up" and f.get("text")
        ][-5:]
        parts = []
        if downs:
            parts.append(
                "The user DOWNVOTED these earlier replies — never repeat "
                "their style, phrasing or clichés:\n"
                + "\n".join("- " + d[:200] for d in downs)
            )
        if ups:
            parts.append(
                "The user UPVOTED these replies — build on what works "
                "without copying them:\n"
                + "\n".join("- " + u[:200] for u in ups)
            )
        if parts:
            messages.append(
                {"role": "system", "content": "\n\n".join(parts)}
            )

    if memory_command:
        save_memory(memory_command)
        feature_meta["memory_saved"] = True
        messages.append(
            {
                "role": "system",
                "content": (
                    f"You just saved this to long-term memory: '{memory_command}'. "
                    "Briefly confirm to the user that you'll remember it."
                ),
            }
        )
    elif system_used:
        feature_meta["system_status_used"] = True
        messages.append(
            {"role": "system", "content": format_system_context(system_stats())}
        )
    elif tune_requested:
        feature_meta["tune_requested"] = True
        messages.append(
            {"role": "system", "content": await play_tune(user_text)}
        )
    elif video_requested:
        feature_meta["video_requested"] = True
        outcome = await comfyui_generate(user_text, settings, kind="video")
        messages.append({"role": "system", "content": outcome})
    elif image_requested:
        feature_meta["image_requested"] = True
        outcome = await comfyui_generate(user_text, settings)
        messages.append({"role": "system", "content": outcome})
    elif weather_used:
        feature_meta["weather_used"] = True
        play_search_sound()
        try:
            weather_context = await get_weather_context(user_text)
        except Exception as exc:
            weather_context = (
                "The live weather lookup failed. Tell the user weather "
                f"information is temporarily unavailable. Error: {exc}"
            )
        messages.append({"role": "system", "content": weather_context})
    elif dj_used:
        feature_meta["dj_request"] = True
        query = dj_request_query(user_text)
        now = bool(re.search(r"\b(now|immediately|right away|next)\b",
                             user_text, re.I))
        result = await dj_request(query, now=now)
        if not result.get("ok"):
            return result["detail"], {**feature_meta,
                                      "model": settings["model"]}
        who = f" by {result['artist']}" if result.get("artist") else ""
        where = "playing next" if now else "in the queue"
        return (
            f"Request taken — {result['title']}{who} is {where} on "
            f"{dj_settings()['station_name']}."
        ), {**feature_meta, "model": settings["model"]}
    elif music_used:
        feature_meta["music_played"] = True
        try:
            spoken = await play_music_request(user_text)
        except Exception as exc:
            spoken = f"Could not play that — {exc}"
        return spoken, {**feature_meta, "model": settings["model"]}
    elif song_used:
        crystal = crystal_match(user_text)
        feature_meta["crystal_used"] = True
        feature_meta["crystal"] = (crystal or {}).get("slug", "library")
        messages.append({
            "role": "system",
            "content": (
                format_crystal_context(crystal, user_text) if crystal
                else format_crystal_library(user_text)
            ),
        })
    elif te_used:
        hit = te_lookup(user_text)
        if hit:
            feature_meta["gear_manual_used"] = True
            feature_meta["gear_device"] = hit["slug"]
            feature_meta["gear_icon"] = te_has_icon(hit["slug"])
            # "how do I…" wants to watch someone do it, not read about it.
            if TE_SHOW_ME.search(user_text) and settings["web_search"]:
                videos = await te_media(hit, user_text)
                if videos:
                    feature_meta["gear_videos"] = videos
                    hit = {**hit, "videos": videos}
            te_feed_push(user_text, hit)
            messages.append(
                {"role": "system", "content": format_te_context(hit)}
            )
            # Manuals document controls; tricks are community knowledge.
            if TE_TIPS.search(user_text) and settings["web_search"]:
                feature_meta["web_search_used"] = True
                play_search_sound()
                try:
                    results = await search_searxng(
                        f"{hit['title']} {clean_search_query(user_text)}"
                    )
                    if results:
                        messages.append(
                            {
                                "role": "system",
                                "content": format_search_context(
                                    user_text, results
                                ),
                            }
                        )
                except Exception:
                    pass  # The manual pages alone still answer the question.
        else:
            # Device recognised but nothing cached: fall back to the web.
            te_used = False
            feature_meta["web_search_used"] = True
            play_search_sound()
            try:
                results = await search_searxng(clean_search_query(user_text))
                context = format_search_context(user_text, results)
            except Exception as exc:
                context = (
                    "The web search service failed. Tell the user gear "
                    f"documentation is temporarily unavailable. Error: {exc}"
                )
            messages.append({"role": "system", "content": context})
    elif episode_used:
        feature_meta["episode_talk_used"] = True
        play_search_sound()
        try:
            episode_context = await get_episode_context(user_text)
        except Exception as exc:
            episode_context = (
                "The episode discussion lookup failed. Tell the user you "
                "could not reach the discussion threads. Error: "
                f"{exc}"
            )
        messages.append({"role": "system", "content": episode_context})
    elif tv_used:
        feature_meta["tv_lookup_used"] = True
        play_search_sound()
        try:
            tv_context = await get_tv_context(user_text)
        except Exception as exc:
            tv_context = (
                "The TV show lookup failed. Tell the user TV show info is "
                f"temporarily unavailable. Technical error: {exc}"
            )
        messages.append({"role": "system", "content": tv_context})
    elif game_used:
        try:
            game_context, game_flags = await get_game_context(user_text)
            feature_meta["game_lookup_used"] = game_flags["game_lookup_used"]
            feature_meta["from_library"] = game_flags["from_library"]
        except Exception as exc:
            game_context = (
                "The game lookup service failed. Tell the user game help is "
                f"temporarily unavailable. Technical error: {exc}"
            )

        messages.append(
            {
                "role": "system",
                "content": game_context,
            }
        )
    elif search_used:
        feature_meta["web_search_used"] = True
        play_search_sound()
        query = clean_search_query(user_text)

        try:
            search_results = await search_searxng(query)
            search_context = format_search_context(
                query,
                search_results,
            )
        except Exception as exc:
            search_context = (
                "The web search service failed. Tell the user search is "
                f"temporarily unavailable. Technical error: {exc}"
            )

        messages.append(
            {
                "role": "system",
                "content": search_context,
            }
        )

    # Ignore incoming system messages. The control-panel prompt is authoritative.
    for message in incoming_messages:
        role = message.get("role")
        content = message.get("content")

        if role not in {"user", "assistant"}:
            continue

        if not isinstance(content, str) or not content.strip():
            continue

        messages.append(
            {
                "role": role,
                "content": content.strip(),
            }
        )

    model = requested_model or settings["model"]
    max_tokens = requested_max_tokens or settings["max_tokens"]
    max_tokens = max(20, min(1000, int(max_tokens)))

    t0 = time.monotonic()
    try:
        result = await call_ollama(
            model=model,
            messages=messages,
            temperature=settings["temperature"],
            max_tokens=max_tokens,
            top_p=settings["top_p"],
            num_ctx=settings["num_ctx"],
        )
    except httpx.HTTPStatusError as exc:
        raise HTTPException(
            status_code=502,
            detail={
                "message": "Ollama rejected the request.",
                "status": exc.response.status_code,
                "response": exc.response.text[:1500],
            },
        ) from exc
    except (httpx.RequestError, ValueError) as exc:
        raise HTTPException(
            status_code=502,
            detail=f"Could not obtain an Ollama response: {exc}",
        ) from exc

    answer = result.get("message", {}).get("content")

    if not isinstance(answer, str) or not answer.strip():
        raise HTTPException(
            status_code=502,
            detail="Ollama returned an empty response.",
        )

    metadata = {
        **feature_meta,
        "active_prompt": prompt_entry["name"],
        "model": model,
        "prompt_tokens": int(result.get("prompt_eval_count") or 0),
        "completion_tokens": int(result.get("eval_count") or 0),
        # Per-reply analytics for the conversation popup (#78).
        "stats": {
            "duration_ms": int((time.monotonic() - t0) * 1000),
            "load_ms": int((result.get("load_duration") or 0) / 1e6),
            "prompt_eval_ms": int(
                (result.get("prompt_eval_duration") or 0) / 1e6
            ),
            "eval_ms": int((result.get("eval_duration") or 0) / 1e6),
            "prompt_tokens": int(result.get("prompt_eval_count") or 0),
            "completion_tokens": int(result.get("eval_count") or 0),
        },
    }

    return answer.strip(), metadata


