    const result = await api("/api/say", {
      method: "POST", body: JSON.stringify({text, event}),
    });
    if (result.speak_locally && "speechSynthesis" in window) {
      speechSynthesis.cancel();
      speechSynthesis.speak(new SpeechSynthesisUtterance(result.spoken || ""));
      status.textContent = "Spoken by this browser · " + event + " voice";
      return;
    }
    if (result.path) {
      const player = voiceTestPlayer();
      player.src = result.path + (result.sig ? "?t=" + result.sig : "");
      player.style.display = "block";
      player.play().catch(() => {});
      status.textContent = event + " voice · " + (result.voice || "default")
        + " · " + (result.ms || 0) + " ms · " + (result.bytes || 0) + " bytes"
        + (result.played_on ? " · also on " + result.played_on : "");
      return;
    }
    status.textContent = "Sent to " + (result.engine || "voice output")
      + " · " + event + " voice";
  } catch (error) {
    status.textContent = error.message;
  }
}

