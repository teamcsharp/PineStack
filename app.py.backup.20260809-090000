def _workflow_model_name(graph: dict[str, Any]) -> str:
    """Human-readable model name pulled from the graph's loader node."""
    for node in graph.values():
        inputs = node.get("inputs") if isinstance(node, dict) else None
        if not isinstance(inputs, dict):
            continue
        for key in ("unet_name", "ckpt_name"):
            name = inputs.get(key)
            if isinstance(name, str) and name:
                return re.sub(r"\.(safetensors|gguf|ckpt)$", "", name)
    return "unknown model"


async def image_tags(user_text: str, settings: dict[str, Any]) -> str:
    """Turn a spoken image request into the comma-separated tag prompt that
    is actually submitted to ComfyUI — and read back to the user."""
    subject = extract_image_prompt(user_text)
    try:
        result = await call_ollama(
            model=settings["model"],
            messages=[
                {
                    "role": "system",
                    "content": (
                        "Convert the user's image request into one "
                        "comma-separated tag list for a text-to-image model: "
                        "subject first, then style, lighting, composition, "
                        "and quality tags. 8 to 16 tags, lowercase, no "
                        "sentences, no quotes. Reply with the tag list only."
                    ),
                },
                {"role": "user", "content": user_text},
            ],
            temperature=0.4,
            max_tokens=120,
            num_ctx=2048,
        )
        tags = " ".join(
            str(result.get("message", {}).get("content") or "").split()
        ).strip().strip('"').rstrip(".")
        if _tags_are_sane(tags):
            return tags
    except Exception:
        pass
    return subject


# A small or confused model answers with prose ("Here's how you can generate
# an image: 1. Open a new tab…") instead of tags. That text used to go
# straight to ComfyUI and get rendered literally, so reject it.
_TAG_JUNK = re.compile(
    r"\b(here('s| is)|you can|follow these|instructions?|step \d|click|"
    r"open a new|search bar|press enter|i cannot|as an ai|sure[,!]|"
    r"generate an image|type ['\"])",
    re.IGNORECASE,
)


def _tags_are_sane(tags: str) -> bool:
    if not 0 < len(tags) <= 500:
        return False
    if _TAG_JUNK.search(tags):
        return False
    if re.search(r"\b\d\.\s", tags):        # numbered instructions
        return False
    # Real tag lists are commas, not sentences.
    sentences = len(re.findall(r"[.!?]\s+[A-Z]", tags))
    return sentences < 2


# --- Image generation memory (the PineBox gallery's data) -------------------

_generations_lock = asyncio.Lock()


def _read_all_generations() -> list[dict[str, Any]]:
    if not GENERATIONS_PATH.exists():
        return []
    records: list[dict[str, Any]] = []
    for line in GENERATIONS_PATH.read_text().splitlines():
        try:
            rec = json.loads(line)
        except Exception:
            continue
        if isinstance(rec, dict):
            records.append(rec)
    return records


def read_generations(limit: int = 100) -> list[dict[str, Any]]:
    """Newest-first slice of the generation log."""
    records = _read_all_generations()
    return records[-max(1, min(1000, limit)):][::-1]


def append_generation(rec: dict[str, Any]) -> None:
    try:
        GENERATIONS_PATH.parent.mkdir(parents=True, exist_ok=True)
        with GENERATIONS_PATH.open("a") as fh:
            fh.write(json.dumps(rec) + "\n")
    except Exception:
        pass  # never let bookkeeping break the voice reply


async def remove_generation_by_file(filename: str) -> None:
    """Drop a filename from every generation record; delete records left with
    no images. Keeps the gallery log in sync when an image is deleted."""
    async with _generations_lock:
        records = _read_all_generations()
        kept: list[dict[str, Any]] = []
        changed = False
        for rec in records:
            files = rec.get("files") or []
            if filename in files:
                changed = True
                rec["files"] = [f for f in files if f != filename]
                if not rec["files"]:
                    continue
            kept.append(rec)
        if changed:
            try:
                GENERATIONS_PATH.write_text(
                    "".join(json.dumps(r) + "\n" for r in kept)
                )
            except Exception:
                pass


async def update_generation(prompt_id: str, **fields: Any) -> None:
    if not prompt_id:
        return
    async with _generations_lock:
        records = _read_all_generations()
        changed = False
        for rec in records:
            if rec.get("prompt_id") == prompt_id:
                rec.update(fields)
                changed = True
        if changed:
            try:
                GENERATIONS_PATH.write_text(
                    "".join(json.dumps(r) + "\n" for r in records)
                )
            except Exception:
                pass


def _workflow_complexity(graph: dict[str, Any]) -> dict[str, int]:
    nodes = [n for n in graph.values()
             if isinstance(n, dict) and n.get("class_type")]
    return {"nodes": len(nodes),
            "node_types": len({n["class_type"] for n in nodes})}


async def _comfy_system_stats() -> dict[str, Any]:
    try:
        async with httpx.AsyncClient(timeout=6) as client:
            response = await client.get(f"{COMFYUI_URL}/system_stats")
            response.raise_for_status()
            return response.json() or {}
    except Exception:
        return {}


def _summarize_system_stats(js: dict[str, Any]) -> dict[str, Any]:
    """Pull the human-meaningful numbers out of ComfyUI /system_stats."""
    out: dict[str, Any] = {}
    sysm = js.get("system") or {}
    if sysm.get("ram_total"):
        total = sysm["ram_total"] / 1e9
        free = (sysm.get("ram_free") or 0) / 1e9
        out["ram_total_gb"] = round(total, 1)
        out["ram_used_gb"] = round(total - free, 1)
    if sysm.get("comfyui_version"):
        out["comfyui_version"] = sysm["comfyui_version"]
    devices = js.get("devices") or []
    if devices:
        dev = devices[0]
        out["device"] = dev.get("name")
        if dev.get("vram_total"):
            vtotal = dev["vram_total"] / 1e9
            vfree = (dev.get("vram_free") or 0) / 1e9
            out["vram_total_gb"] = round(vtotal, 1)
            out["vram_used_gb"] = round(vtotal - vfree, 1)
    return out


def _read_gpu_temp() -> dict[str, Any]:
    """Best-effort DGX Spark thermals. /sys/class/thermal isn't namespaced,
    so the container can usually read the host's zones. Returns the hottest
    zone in °C; empty if unreadable."""
    try:
        import glob
        hottest = 0.0
        label = ""
        for path in glob.glob("/sys/class/thermal/thermal_zone*/temp"):
            try:
                milli = int(open(path).read().strip())
                celsius = milli / 1000.0
                if 0 < celsius < 150 and celsius > hottest:
                    hottest = celsius
                    try:
                        label = open(
                            path.replace("/temp", "/type")).read().strip()
                    except Exception:
                        label = ""
            except Exception:
                continue
        if hottest > 0:
            return {"temp_c": round(hottest, 1), "temp_zone": label}
    except Exception:
        pass
    return {}


async def _track_generation(prompt_id: str, started_at: float | None = None,
                            base_stats: dict[str, Any] | None = None) -> None:
    """Poll ComfyUI /history until the render lands, then record the output
    filenames + capture render stats so the gallery can show the image."""
    for _ in range(120):  # ~6 minutes at 3 s
        await asyncio.sleep(3)
        try:
            async with httpx.AsyncClient(timeout=10) as client:
                response = await client.get(
                    f"{COMFYUI_URL}/history/{prompt_id}"
                )
                response.raise_for_status()
                hist = (response.json() or {}).get(prompt_id) or {}
        except Exception:
            continue
        outputs = hist.get("outputs") or {}
        files = [
            entry["filename"]
            for out in outputs.values()
            if isinstance(out, dict)
            for group in out.values()
            if isinstance(group, list)
            for entry in group
            if isinstance(entry, dict)
            and entry.get("type") == "output"
            and entry.get("filename")
        ]
        if files:
            stats = dict(base_stats or {})
            if started_at:
                stats["duration_s"] = round(time.time() - started_at, 1)
            stats.update(_summarize_system_stats(await _comfy_system_stats()))
            stats.update(_read_gpu_temp())
            await update_generation(
                prompt_id, files=files, status="done", stats=stats)
            await announce_render_complete()
            return
        status = hist.get("status") or {}
        if status.get("completed"):
            await update_generation(prompt_id, status="done")
            return
    await update_generation(prompt_id, status="unknown")


async def reconcile_generations() -> dict[str, int]:
    """Repair renders whose tracker died (agent restart mid-render): finish the
    ones ComfyUI already produced, re-attach to the ones still running, and
    retire the rest so the gallery never shows a permanent 'rendering…'."""
    counts = {"finished": 0, "tracking": 0, "lost": 0}
    pending = [
        g for g in _read_all_generations()
        if g.get("status") in ("queued", "unknown") and g.get("prompt_id")
    ]
    if not pending:
        return counts
    try:
        async with httpx.AsyncClient(timeout=15) as client:
            queued_ids: set[str] = set()
            try:
                queue = (await client.get(f"{COMFYUI_URL}/queue")).json() or {}
                for key in ("queue_running", "queue_pending"):
                    for item in queue.get(key) or []:
                        if len(item) > 1 and isinstance(item[1], str):
                            queued_ids.add(item[1])
            except Exception:
                pass

            for gen in pending:
                pid = str(gen["prompt_id"])
                try:
                    hist = (
                        await client.get(f"{COMFYUI_URL}/history/{pid}")
                    ).json() or {}
                except Exception:
                    continue
                entry = hist.get(pid) or {}
                files = _comfy_output_files({pid: entry}) if entry else []
                if files:
                    await update_generation(pid, files=files, status="done")
                    counts["finished"] += 1
                elif pid in queued_ids:
                    fire_and_forget(_track_generation(pid, gen.get("ts")))
                    counts["tracking"] += 1
                elif time.time() - float(gen.get("ts") or 0) > 900:
                    # Not on disk, not queued, and long past: it will never land.
                    await update_generation(pid, status="lost")
                    counts["lost"] += 1
    except Exception:
        pass
    return counts


