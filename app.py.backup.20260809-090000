  } catch (error) {
    if (status) status.textContent = error.message;
  }
}

/* ---- Move a panel between the columns (#161) ---- */

// Each panel gets a dot in its corner. Clicking it sends the panel to the
// other column; the choice is remembered by the panel's heading, which is
// stable across reloads in a way that DOM order is not.
function panelKey(panel) {
  const head = panel.querySelector(":scope > h2");
  return "col:" + ((head && head.textContent) || "").trim().slice(0, 40);
}

function panelPlace(panel, side) {
  const left = document.querySelector("main > .col-left");
  const main = document.querySelector("main");
  if (!left || !main) return;
  if (side === "left") left.appendChild(panel);
  else main.appendChild(panel);
