/* ---- The booth, overheard (#151) ---- */

// When the pair start talking, put their conversation on screen. It opens on
// a new line, keeps the whole history, and stays where you leave it.
let djTalkSeen = 0;
let djTalkPinned = false;

function djTalkClose(manual) {
  const box = document.getElementById("djTalkPopup");
  if (box) box.remove();
  if (manual) djTalkPinned = true;     // do not reopen until the next session
}

function djTalkPopup() {
  let box = document.getElementById("djTalkPopup");
  if (box) return box;

  box = el("div", "panel", "");
  box.id = "djTalkPopup";
  const saved = JSON.parse(localStorage.getItem("djTalkBox") || "null") || {};
  box.style.cssText = "position:fixed;z-index:130;width:min(420px,92vw);"
    + "max-height:52vh;display:flex;flex-direction:column;padding:10px 12px;"
    + "box-shadow:0 20px 50px rgba(0,0,0,.6);"
    + "left:" + (saved.left ?? Math.max(12, window.innerWidth - 450)) + "px;"
    + "top:" + (saved.top ?? 96) + "px";

  const head = el("div", "", "");
  head.style.cssText = "display:flex;align-items:center;gap:8px;"
    + "margin-bottom:6px;cursor:grab";
  const title = el("b", "", "In the booth");
  title.style.cssText = "flex:1;font-size:13px";
  const mute = el("button", "", "🔇");
  mute.title = "Stop showing this until the next session";
  mute.onclick = () => djTalkClose(true);
  // Just put it away — it reappears the next time the two of them talk.
  const shut = el("button", "", "✕");
  shut.id = "djTalkShut";
  shut.title = "Close";
  shut.onclick = () => djTalkClose();
  head.appendChild(title);
  head.appendChild(mute);
  head.appendChild(shut);

  head.addEventListener("pointerdown", (event) => {
    if (event.target.closest("button")) return;    // the buttons are not a handle
    const from = {x: event.clientX, y: event.clientY,
                  left: box.offsetLeft, top: box.offsetTop};
    head.setPointerCapture(event.pointerId);
    const move = (e) => {
      box.style.left = Math.max(0, Math.min(window.innerWidth - 120,
        from.left + e.clientX - from.x)) + "px";
      box.style.top = Math.max(0, Math.min(window.innerHeight - 60,
        from.top + e.clientY - from.y)) + "px";
    };
    const drop = () => {
      head.removeEventListener("pointermove", move);
      head.removeEventListener("pointerup", drop);
      localStorage.setItem("djTalkBox", JSON.stringify(
        {left: box.offsetLeft, top: box.offsetTop}));
    };
    head.addEventListener("pointermove", move);
    head.addEventListener("pointerup", drop);
  });

  const log = el("div", "", "");
  log.id = "djTalkLog";
  log.style.cssText = "flex:1;overflow-y:auto;font-size:12px;line-height:1.5";

  box.appendChild(head);
  box.appendChild(log);
  document.body.appendChild(box);
  return box;
}

function djTalkRender(state) {
  const lines = (state.chat || []).filter(
    (line) => line.who === "dj" || line.who === "cohost");
  if (!lines.length) return;

  const newest = lines[lines.length - 1].ts || 0;
  const fresh = newest > djTalkSeen;
  djTalkSeen = Math.max(djTalkSeen, newest);

  // Only conjure the window when something new was actually said.
  if (!document.getElementById("djTalkPopup")) {
    if (!fresh || djTalkPinned) return;
    djTalkPopup();
  }

  const log = document.getElementById("djTalkLog");
  if (!log) return;
  const atBottom = log.scrollHeight - log.scrollTop - log.clientHeight < 40;
  log.textContent = "";
  lines.slice(-80).forEach((line) => {
    const row = el("div", "", "");
    row.style.padding = "3px 0";
    const who = el("b", "", (line.name || "DJ") + " ");
    who.style.color = line.who === "cohost" ? "#b48cff" : "#7fd1ff";
    row.appendChild(who);
    row.appendChild(document.createTextNode(line.text || ""));
    log.appendChild(row);
  });
  // Only autoscroll if they were already at the bottom — otherwise reading
  // back through the history would be yanked away every poll.
  if (atBottom) log.scrollTop = log.scrollHeight;
}

/* ---- One button, five things to say (#156) ---- */

function djSayMenuClose() {
  const open = document.getElementById("djSayMenu");
  if (open) open.remove();
  document.removeEventListener("click", djSayMenuAway, true);
}

function djSayMenuAway(event) {
  const menu = document.getElementById("djSayMenu");
  if (menu && !menu.contains(event.target)) djSayMenuClose();
}

// Each option is a different call, but from here it is one question: what do
// you want him to talk about?
const DJ_SAYS = [
  ["🖼", "Product placement", "product",
   "What is being placed? (a painting from your gallery, or anything)"],
  ["📣", "Ad read", "ad", "What is the advert for?"],
  ["👋", "Shout out", "shout", "Who or what is getting the shout out?"],
  ["🎵", "Music request", "request", "Which song?"],
  ["💬", "Specific message", "exact",
   "The exact words you want said, verbatim"],
  ["🗣", "Just say something", "riff", ""],
];

function djSayMenu(event) {
  event.stopPropagation();
  if (document.getElementById("djSayMenu")) { djSayMenuClose(); return; }

  const anchor = event.currentTarget.getBoundingClientRect();
  const menu = el("div", "panel", "");
  menu.id = "djSayMenu";
  menu.style.cssText = "position:fixed;z-index:150;min-width:260px;padding:8px;"
    + "box-shadow:0 18px 44px rgba(0,0,0,.6);"
    + "left:" + Math.max(8, Math.min(window.innerWidth - 280,
        anchor.left - 120)) + "px;"
    + "top:" + (anchor.bottom + 8) + "px";

  DJ_SAYS.forEach(([icon, label, kind, ask]) => {
    const row = el("div", "", "");
    row.style.cssText = "display:flex;gap:9px;align-items:center;padding:7px 8px;"
      + "border-radius:var(--radius-sm);cursor:pointer;font-size:13px";
    row.onmouseenter = () => { row.style.background = "var(--panel2)"; };
    row.onmouseleave = () => { row.style.background = ""; };
    row.appendChild(el("span", "", icon));
    row.appendChild(el("span", "", label));
    row.onclick = () => { djSayMenuClose(); djSayDo(kind, ask); };
    menu.appendChild(row);
  });

  document.body.appendChild(menu);
  document.addEventListener("click", djSayMenuAway, true);
}

async function djSayDo(kind, ask) {
  const status = document.getElementById("djStatus")
    || document.getElementById("musicStatus");
  const say = (text) => { if (status) status.textContent = text; };

  let text = "";
  if (ask) {
    text = window.prompt(ask, "");
    if (text === null) return;
    text = text.trim();
    if (!text) return;
  }

  say("Handing it to the DJ…");
  try {
    let result;
    if (kind === "request") {
      result = await api("/api/dj/request", {
        method: "POST", body: JSON.stringify({q: text}),
      });
      say("Queued: " + result.title + (result.line ? " — " + result.line : ""));
      pollDJ();
      return;
    }
    if (kind === "ad" || kind === "product") {
      result = await api("/api/dj/ad", {
        method: "POST",
        body: JSON.stringify({product: text, gallery: kind === "product" && !text}),
      });
      say("“" + result.ad + "”");
      loadAds();
      return;
    }
    if (kind === "shout") {
      result = await api("/api/dj/announce", {
        method: "POST",
        body: JSON.stringify({
          text: "give a warm shout out to: " + text, mode: "riff"}),
      });
    } else if (kind === "exact") {
      result = await api("/api/dj/announce", {
        method: "POST", body: JSON.stringify({text, mode: "exact"}),
      });
    } else {
      result = await api("/api/dj/interject", {method: "POST"});
      say("“" + (result.line || "") + "”");
      return;
    }
    say("“" + (result.said || "") + "”");
  } catch (error) {
    say(error.message);
  }
}

