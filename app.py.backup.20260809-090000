    limit: int = 40,
    seed: int = 0,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """A handful of the library to look through. 35,000 tracks is too many to
    list, so this is a stable random sample — pass a new seed for a new one."""
    require_read_auth(authorization)
    tracks = music_index()
    if not tracks:
        return {"results": [], "total": 0}

    count = max(1, min(120, int(limit)))
    picker = random.Random(int(seed) or int(time.time() // 3600))
    chosen = picker.sample(tracks, min(count, len(tracks)))
    return {
        "total": len(tracks),
        "results": [
            {**{k: v for k, v in t.items() if k not in ("path", "search")},
             "url": f"/music/{t['id']}?t={media_sign(t['id'])}",
             "art": f"/music/{t['id']}/art?t={media_sign(t['id'])}"}
            for t in chosen
        ],
    }


