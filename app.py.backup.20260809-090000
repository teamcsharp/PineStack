      + (track.artist ? " · " + track.artist : ""));
    name.style.cssText = "flex:1;overflow:hidden;text-overflow:ellipsis;"
      + "white-space:nowrap";
    if (index < state.requests) name.style.color = "#ffd479";   // requested
    row.appendChild(n);
    row.appendChild(name);
    host.appendChild(row);
  });
}

function djRenderChat(state) {
  const host = document.getElementById("djChatLog");
  if (!host || document.getElementById("djChat").style.display === "none") return;
  host.textContent = "";
  (state.chat || []).forEach((line) => {
    const row = el("div", "", "");
    row.style.cssText = "padding:3px 0;line-height:1.4";
    const label = line.who === "host" ? "You "
      : (line.name && line.who === "cohost" ? line.name + " " : "DJ ");
    const who = el("b", "", label);
    who.style.color = line.who === "host" ? "#ffd479"
      : line.who === "cohost" ? "#b48cff" : "#7fd1ff";
    row.appendChild(who);
    row.appendChild(document.createTextNode(line.text));
    host.appendChild(row);
  });
  host.scrollTop = host.scrollHeight;
}

function djRender(state) {
  djOn = !!state.on;
  document.getElementById("djBar").style.display = djOn ? "flex" : "none";
  document.getElementById("djIcon").style.color = djOn ? "#7fd1ff" : "";
  document.getElementById("djIcon").title = djOn
    ? "Pine Box FM is on air" : "Start a Pine Box FM session";
  const button = document.getElementById("djSessionBtn");
  if (button) {
    button.textContent = djOn ? "Send the DJ home" : "Start the session";
  }
  const now = state.now || {};
  djNowId = now.id || "";
  djNowTrack = now;
  if (now.url) rememberSig(now.url);
  if (djOn && djOutputMode() !== "box" && now.id && now.id !== djLastTrack) {
    djLastTrack = now.id;
    const player = document.getElementById("musicPlayer");
    if (player && now.url) {
      musicRadioOn = false;             // the server sequences, not the page
      player.src = now.url;
      // Join where the show already is, so a late tab is not a restart.
      player.currentTime = Math.max(0, Math.min(state.elapsed || 0,
        (now.seconds || 0) - 1));
      player.play().catch(() => {});
    }
  }
  document.getElementById("djNow").textContent = djOn
    ? (now.title || "…") + (now.artist ? " · " + now.artist : "")
    : "off air";
  djMiniRender(state);
  djRenderQueue(state);
  djRenderChat(state);
  djTalkRender(state);
  renderDeck(state);
  renderDJFlow(state);
  renderNowTags(state);
  if (state.now && state.now.id) {
    if (stage) stage.show(state.now);
    stageSheet(state.now);
  }
}

async function pollDJ() {
  try {
    djRender(await api("/api/dj"));
  } catch (error) { /* the panel works without it */ }
}

// #108: one button, and it does whatever it takes — reindex if the library
// is empty, pick a station that has tracks, go on air, open the lines, and
// start audio in this page too so something is playing either way.
// #112: where the show comes out. "box" is the satellite speaker, "here" is
// this page, "both" is both. Stored per browser — the DJ is one session but
// each listener chooses where they hear it.
function djOutputMode() {
  return localStorage.getItem("djOutput") || "here";   // browser by default
}

function djVoiceMode() {
  return localStorage.getItem("djVoiceOut") || "box";  // the AI is the box
}

const WHERE = {box: "the Pine Box", here: "this page", both: "both"};

async function djSetOutput() {
  const music = document.getElementById("djOutput").value;
  const voice = document.getElementById("djVoiceOut").value;
  localStorage.setItem("djOutput", music);
  localStorage.setItem("djVoiceOut", voice);
  const status = document.getElementById("musicStatus");
  try {
    await api("/api/dj/output", {
      method: "POST", body: JSON.stringify({music, voice}),
    });
    if (status) {
      status.textContent = "Music → " + WHERE[music]
        + " · DJ voice → " + WHERE[voice];
    }
    if (voice !== "box") djVoicePoll();
  } catch (error) {
    if (status) status.textContent = error.message;
  }
}

// When the show plays in this page, the DJ's lines arrive as audio files and
// are played over the track, the same way a real one talks over the intro.
let djVoiceSeen = 0;
function djVoicePlay(clip) {
  let player = document.getElementById("djVoiceAudio");
  if (!player) {
    player = document.createElement("audio");
    player.id = "djVoiceAudio";
    player.playsInline = true;
    document.body.appendChild(player);
  }
  // Ducking is driven by the gain stage and released on ended/error, so a
  // track change mid-sentence can no longer strand the music at 25%.
  const release = () => { djSpeaking = false; djApplyGain(); };
  player.onended = release;
  player.onerror = release;
  player.onpause = release;
  djSpeaking = true;
  djApplyGain();
  player.src = clip.url;
  player.play().catch(release);
}

async function djVoicePoll() {
  if (djVoiceMode() === "box") return;   // the box is doing the talking
  try {
    const data = await api("/api/dj/voice?since=" + djVoiceSeen);
    (data.clips || []).forEach((clip) => {
      djVoiceSeen = Math.max(djVoiceSeen, clip.ts);
      if (clip.url) djVoicePlay(clip);
    });
  } catch (error) { /* the show goes on */ }
}

async function djGo() {
  const button = document.getElementById("djGoBtn");
  const status = document.getElementById("musicStatus");
  const was = button.textContent;
  button.textContent = "⏳";
  if (status) status.textContent = "Getting Pine Box FM on air…";
  try {
    const state = await api("/api/dj/start", {
      method: "POST",
      body: JSON.stringify({
        force: true,
        station: (document.getElementById("djStation") || {}).value || "",
      }),
    });
    djRender(state);
    const select = document.getElementById("radioStation");
    if (select && state.station) select.value = state.station;
    // djRender follows state.now and loads the track itself; driving
    // radioNext() here as well is what made the show skip (#122).
    musicRadioOn = false;
    if (status) {
      status.textContent = (state.fallback ? state.fallback + " " : "")
        + "📻 " + (state.station_name || "Pine Box FM")
        + " · " + (state.station || "") + " · " + (state.tracks || 0)
        + " tracks";
    }
  } catch (error) {
    if (status) status.textContent = error.message;
  } finally {
    button.textContent = was;
  }
}

async function djToggleSession() {
  const status = document.getElementById("djStatus");
  try {
    if (djOn) {
      djRender(await api("/api/dj/stop", {method: "POST"}));
      if (status) status.textContent = "The DJ has gone home.";
      return;
    }
    const station = (document.getElementById("djStation") || {}).value || "all";
    // Whatever the output selectors say is what the session should use.
    await djSetOutput().catch(() => {});
    const state = await api("/api/dj/start", {
      method: "POST", body: JSON.stringify({station}),
    });
    djTalkPinned = false;
    djRender(state);
    if (status) {
      status.textContent = state.fallback
        || ("On air — music → " + WHERE[state.music_to]
            + ", DJ voice → " + WHERE[state.voice_to]);
    }
  } catch (error) {
    if (status) status.textContent = error.message; else alert(error.message);
  }
}

function voteNowPlaying(vote) {
  const anchor = window.event && window.event.currentTarget;
  if (!djNowId) { voteBurst(anchor, vote); return; }
  voteTrack(djNowId, vote, "", anchor);
}

async function djCall(what) {
  try {
    const result = await api("/api/dj/" + what, {method: "POST"});
    if (result.station_name !== undefined) djRender(result);
    else pollDJ();
  } catch (error) {
    const status = document.getElementById("djStatus");
    if (status) status.textContent = error.message;
  }
}

async function djRequest(now) {
  const input = document.getElementById("djRequest");
  const status = document.getElementById("djStatus");
  const query = input.value.trim();
  if (!query) return;
  try {
    const result = await api("/api/dj/request", {
      method: "POST", body: JSON.stringify({q: query, now: !!now}),
    });
    status.textContent = (result.queued ? "Queued: " : "Playing now: ")
      + result.title + (result.artist ? " · " + result.artist : "")
      + (result.line ? " — “" + result.line + "”" : "");
