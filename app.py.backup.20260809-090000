</head>
<body>
<div id="toasts"></div>
<header>
  <div style="display:flex;align-items:center;gap:12px">
    <button id="pineDoctor" class="pine-restart"
            title="Pine Box not answering? Diagnose it and open the guide."
            onclick="pineDoctor()"
            style="font-size:15px;line-height:1">🩺</button>
    <button id="stackReconnect" class="pine-restart"
            title="Services down? Probe everything, reload the Home Assistant
links and restart the agent."
            onclick="stackReconnect()"
            style="font-size:15px;line-height:1">🛠</button>
    <button id="pineRestart" class="pine-restart"
            title="Restart Pine Chat — reloads and reinitializes everything"
            onclick="location.reload()">🌲</button>
    <div id="appTitle" style="cursor:pointer;user-select:none"
         title="Click to change the theme"
         onclick="themeMenu(event)">
      <h1 style="display:flex;align-items:center;gap:7px">PineBoxAgent
        <span id="themeCaret" style="font-size:13px;opacity:.55">▾</span>
      </h1>
      <small id="themeNow">PineVoice intelligence · Pine Box control</small>
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:14px">
    <button id="voiceTestBtn" class="pine-restart"
            title="Test the current speech settings"
            onclick="voiceTestOpen()"
            style="font-size:15px;line-height:1">🎙</button>
    <button id="boothBtn" class="pine-restart"
            title="The DJ booth — turntable, records, requests"
            onclick="boothOpen()"
            style="font-size:15px;line-height:1">🎛</button>
    <button id="pineRecover" class="pine-restart"
            title="Pine Box stuck or flashing? Stop the show, unstick the
speaker and restart the agent."
            onclick="pineRecover()"
            style="font-size:15px;line-height:1">🔄</button>
    <button id="cloudHeadBtn" class="pine-restart"
            title="Word cloud — closed, half, full"
            onclick="cloudCycle()"
            style="font-size:15px;line-height:1">☁</button>
    <button id="voicePresetBtn" class="pine-restart"
            title="Speak the saved test sequence — every event voice in order"
            onclick="voicePresetRun()"
            style="font-size:15px;line-height:1">▶︎</button>
    <select id="fontSelect" title="Interface font"
            onchange="applyFont(this.value)"
            style="width:auto;max-width:170px;padding:6px 10px;font-size:13px">
    </select>
    <select id="headerModel" title="Active model — switches immediately"
            onchange="switchModel(this.value)"
            style="width:auto;padding:6px 10px;font-size:13px"></select>
    <select id="headerEngine" title="Voice system — how the Pine Box speaks"
            onchange="switchVoiceEngine(this.value)"
            style="width:auto;max-width:150px;padding:6px 10px;font-size:13px">
    </select>
    <select id="headerVoice" title="Voice model — switches immediately"
            onchange="switchVoice(this.value)"
            style="width:auto;max-width:150px;padding:6px 10px;font-size:13px">
    </select>
    <button id="trayBtn" class="tray-btn" title="Everything that popped up"
            onclick="toggleTray()">
      <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor"
        d="M12 22a2.1 2.1 0 0 0 2.1-2.1H9.9A2.1 2.1 0 0 0 12 22zm6.3-6.3v-5.2c0
        -3.2-1.7-5.9-4.7-6.6v-.7a1.6 1.6 0 0 0-3.2 0v.7c-3 .7-4.7 3.4-4.7
        6.6v5.2L3.6 17.8v1h16.8v-1z"/></svg>
      <span id="trayCount" class="tray-count"></span>
    </button>
    <div id="health" class="muted" style="cursor:pointer"
         title="Service details" onclick="openHealthPopup()">Checking services…</div>
  </div>
</header>

<div id="perfHud" class="perf-hud" onclick="openHealthPopup()"
     title="Click for full service details">
  <button id="cloudDockBtn" class="act-refresh"
          title="Word cloud — live, beside the gallery"
          onclick="event.stopPropagation();cloudDockToggle()"
          style="margin-left:auto;font-size:15px">☁</button>
  <div class="ph-pie" id="phPie"></div>
  <div class="ph-bars">
    <div class="ph-bar"><span>CPU</span>
      <div class="track"><div id="phCpu" class="fill"></div></div>
      <b id="phCpuV">–</b></div>
    <div class="ph-bar"><span>RAM</span>
      <div class="track"><div id="phRam" class="fill"></div></div>
      <b id="phRamV">–</b></div>
    <div class="ph-bar"><span>GPU</span>
      <div class="track"><div id="phGpu" class="fill"></div></div>
      <b id="phGpuV">–</b></div>
    <div class="ph-bar"><span>VRAM</span>
      <div class="track"><div id="phVram" class="fill"></div></div>
      <b id="phVramV">–</b></div>
  </div>
  <div class="ph-temp" id="phTemp">–</div>
  <div class="ph-scroll"><span id="phProfile">gathering profile…</span></div>
</div>

<div id="trayPanel" class="tray-panel" style="display:none">
  <div class="tray-head">Recent pop-ups</div>
  <div id="trayList" class="tray-list"></div>
</div>

<div id="docBeacon" class="doc-beacon" style="display:none"
     title="Documentation found — click to open">
  <img id="docBeaconArt" alt="" style="display:none">
  <svg id="docBeaconSvg" viewBox="0 0 24 24" width="46" height="46"
       aria-hidden="true">
    <path fill="currentColor" d="M6 2h7l5 5v15a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1
      1 0 0 1 1-1zm7 1.5V8h4.5L13 3.5zM8 12h8v1.6H8V12zm0 3.4h8V17H8v-1.6zM8
      8.6h3v1.6H8V8.6z"/>
  </svg>
  <span id="docBeaconLabel"></span>
</div>

<div id="tuneBeacon" class="doc-beacon tune" style="display:none"
     title="Music video found — click to play">
  <svg viewBox="0 0 24 24" width="52" height="52" aria-hidden="true">
    <path fill="currentColor" d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12
      5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8
      2.5 2.5 0 0 0 1.8 1.8C5.8 19 12 19 12 19s6.2 0 7.8-.4a2.5 2.5 0 0 0
      1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8zM10 15V9l5.2 3L10 15z"/>
  </svg>
  <span id="tuneBeaconLabel"></span>
</div>

<!-- Shared full-screen popup -->
<div id="pbModal" class="pb-modal" style="display:none"
     onclick="if(event.target===this)closeModal()">
  <div class="pb-modal-card">
    <button class="pb-modal-x" onclick="closeModal()">✕</button>
    <div id="pbModalBody" class="pb-modal-body"></div>
  </div>
</div>

<section id="activity" style="position:relative;min-height:300px">
  <div class="act-head">
    <span class="live-dot"></span>
    <span class="act-title">Pine Box · Live</span>
    <button class="act-refresh" title="Documentation library"
            onclick="openDocBrowser(null, 0, true)">📚</button>
    <button class="act-refresh" title="Show the last rendered image"
            onclick="showLastRender()">🖼</button>
    <span id="actStatus" class="act-status">Idle</span>
    <button class="act-refresh" title="Good reply — more like this"
            onclick="sendVote('up')">▲</button>
    <button class="act-refresh" title="Bad reply — never talk like this again"
            onclick="sendVote('down')">▼</button>
    <button id="filmRefresh" class="act-refresh"
            onclick="refreshFilmstrip()">↻ Refresh gallery</button>
    <button id="cloudBarBtn" class="act-refresh"
            title="Word cloud — half the gallery, live"
            onclick="cloudDockToggle()">☁</button>
    <button id="djIcon" class="act-refresh"
            title="Start a Pine Box FM session"
            onclick="djToggleSession()">🎧</button>
    <!-- iTunes-style mini transport: only visible while the show is on. -->
    <!-- MiniPlayer: sleeve, transport, scrubber, remaining time (#129). -->
    <span id="djBar" style="display:none;align-items:center;gap:8px;flex:1;
          min-width:0;max-width:620px;padding:4px 8px;
          border:1px solid var(--border);border-radius:9px;
          background:linear-gradient(#0a121c,#05070b);
          box-shadow:inset 0 1px 0 rgba(255,255,255,.04)">
      <span id="djMiniArt" style="flex:0 0 38px;width:38px;height:38px;
            border-radius:4px;overflow:hidden;display:flex;
            align-items:center;justify-content:center;cursor:pointer"
            title="Everything about this track"></span>
      <button class="act-refresh" title="Previous track"
              onclick="djCall('prev')">⏮</button>
      <button class="act-refresh" id="djMiniPlay" title="Pause"
              onclick="djMiniPlayPause()">⏸</button>
      <button class="act-refresh" title="Next track"
              onclick="djCall('next')">⏭</button>
      <span style="flex:1;min-width:0;display:flex;flex-direction:column;
                   gap:2px">
        <span id="djNow" style="overflow:hidden;text-overflow:ellipsis;
              white-space:nowrap;font-size:12px;font-weight:600">—</span>
        <span style="display:flex;align-items:center;gap:6px">
          <input id="djSeek" type="range" min="0" max="1000" value="0"
                 class="cf-rail"
                 style="position:static;transform:none;width:100%;
                        flex:1;bottom:auto"
                 oninput="djSeekTo()">
          <span id="djClock" class="muted"
                style="font-size:11px;font-variant-numeric:tabular-nums"></span>
        </span>
      </span>
      <button class="act-refresh" title="More like this"
              onclick="voteNowPlaying(1)">👍</button>
      <button class="act-refresh" title="Never play this again"
              onclick="voteNowPlaying(-1)">👎</button>
      <button class="act-refresh" title="Have the DJ say something"
              onclick="djSayMenu(event)">🗣</button>
      <button class="act-refresh" title="Play that last line again"
              onclick="djReplay()">⟲</button>
      <button class="act-refresh" title="Up next"
              onclick="djPanel('djQueue')">▤</button>
      <button class="act-refresh" title="Talk to the DJ"
              onclick="djPanel('djChat')">💬</button>
      <button class="act-refresh" title="Send the DJ home"
              onclick="djToggleSession()">✕</button>
    </span>
    <label class="film-size">Size
      <input id="filmScale" type="range" min="1" max="6" step="0.25">
      <span id="filmScaleVal" class="val"></span>
    </label>
    <span id="actCount" class="act-count"></span>
  </div>
  <div class="film">
    <div id="filmTrack" class="film-track">
      <div class="film-empty">Images you generate will scroll by here…</div>
    </div>
  </div>
  <!-- Right half of the whole Live section, not just the filmstrip: the
       cloud gets real height to be readable (#110). -->
  <div id="cloudDock" class="act-overlay"
       style="display:block;position:absolute;top:38px;right:0;bottom:6px;
              width:50%;min-height:260px;background:#04060bf2;
              border-left:1px solid var(--border);border-radius:0 10px 10px 0;
              z-index:5"></div>
  <div id="djQueue" class="act-overlay"
       style="display:none;position:absolute;top:38px;left:0;bottom:6px;
              width:50%;min-height:260px;z-index:6;background:#04060bf5;
              border-right:1px solid var(--border);overflow-y:auto;
              padding:8px 10px;font-size:12px"></div>
  <div id="djChat" class="act-overlay"
       style="display:none;position:absolute;top:38px;left:0;bottom:6px;
              width:50%;min-height:260px;z-index:6;background:#04060bf5;
              border-right:1px solid var(--border);flex-direction:column;
              padding:8px 10px">
    <div id="djChatLog" style="flex:1;overflow-y:auto;font-size:12px"></div>
    <div class="row" style="margin-top:6px">
      <input id="djChatInput" placeholder="Say something to the DJ…"
             onkeydown="if(event.key==='Enter')djSay()">
      <button class="primary" onclick="djSay()">Send</button>
    </div>
  </div>
  <div class="console">
    <div class="cx-title">
      <span class="live-dot"></span>
      Behind the scenes · live activity
    </div>
    <div id="consoleFeed" class="cx-feed">
      <div class="cx-entry cx-empty">Watching Pine Box activity…</div>
    </div>
  </div>
</section>

<section id="techfeed">
  <div class="tf-head">
    <span class="live-dot"></span>
    <span>Technical feed</span>
    <span id="tfDevice" class="tf-device"></span>
    <span id="tfMeta" class="muted"></span>
    <span class="tf-ask">
      <span class="tf-histwrap">
        <button onclick="toggleTechHistory()" title="Past lookups">▾</button>
        <div id="tfHistory" class="tf-history" style="display:none">
          <input id="tfHistFilter" placeholder="filter…"
                 oninput="renderTechHistory()">
          <div id="tfHistList"></div>
        </div>
      </span>
      <input id="tfQuery" placeholder="show me the OP-XY filter"
             onkeydown="if(event.key==='Enter')techShow()">
      <button onclick="techShow()">Show</button>
    </span>
  </div>
  <div id="tfStrip" class="tf-strip">
    <div class="tf-empty">
      Ask about your gear — manual pages land here.
    </div>
  </div>
</section>

<main>
  <div class="col-left">
  <section class="panel">
    <div class="db-tabs">
      <span class="prompt-quick">
        <button id="promptQuick" title="Switch system prompt"
                onclick="togglePromptMenu()">▤</button>
        <div id="promptMenu" class="prompt-menu" style="display:none"></div>
      </span>
      <button id="tabPrompt" class="on"
              onclick="showLeftTab('prompt')">System prompt</button>
      <button id="tabConvs"
              onclick="showLeftTab('convs')">Conversations</button>
      <button id="keyToggle" class="key-chip" title="API key"
              onclick="toggleKeyRow()">🔑</button>
    </div>

    <div id="keyRow" style="display:none">
      <label>API key</label>
      <div class="row">
        <input id="apiKey" type="password"
               placeholder="Paste SPARK_AGENT_API_KEY">
        <button onclick="connect()">Connect</button>
      </div>
    </div>

    <div id="promptTab">
    <label>Stored system prompt</label>
    <div class="row arrows">
      <button onclick="previousPrompt()" title="Previous">◀</button>
      <select id="promptSelect" onchange="selectPrompt()"></select>
      <button onclick="nextPrompt()" title="Next">▶</button>
    </div>

    <label>Prompt name</label>
    <input id="promptName" oninput="autoSavePrompt()">

    <label>System prompt</label>
    <textarea id="promptText" oninput="autoSavePrompt()"></textarea>

    <div class="actions">
      <button class="primary" onclick="saveSettings()">Save</button>
      <button onclick="newPrompt()">New</button>
      <button onclick="duplicatePrompt()">Duplicate</button>
      <button onclick="renamePrompt()">Rename</button>
      <button class="danger" onclick="deletePrompt()">Delete</button>
    </div>
    </div>

    <div id="convsTab" style="display:none">
      <div class="row" style="margin-top:8px">
        <select id="convFolderFilter" onchange="renderConvList()"
                style="flex:0 0 150px"></select>
        <input id="convSearch" placeholder="search conversations…"
               oninput="renderConvList()">
      </div>
      <div class="conv-wrap">
        <div id="convList" class="conv-list"></div>
        <div id="convView" class="conv-view">
          <div class="muted">Pick a conversation.</div>
        </div>
      </div>
    </div>

    <div id="status" class="status"></div>
  </section>

    <section class="panel">
      <h2>Agent settings</h2>

      <label>Model</label>
      <select id="modelSelect"
              onchange="document.getElementById('model').value=this.value">
        <option value="">— installed models —</option>
      </select>
      <input id="model" onchange="switchModel(this.value.trim())">

      <label>Temperature</label>
      <input id="temperature" type="number"
             min="0" max="2" step="0.05">

      <label>Top P</label>
      <input id="topP" type="number"
             min="0" max="1" step="0.05">

      <label>Maximum response tokens</label>
      <input id="maxTokens" type="number"
             min="20" max="1000" step="10">

      <label class="toggle">
        <input id="webSearch" type="checkbox">
        Automatic internet search
      </label>

      <label class="toggle">
        <input id="gameSearch" type="checkbox">
        Game cheats &amp; guides
      </label>

      <label class="toggle">
        <input id="gearManuals" type="checkbox">
        Gear manuals &amp; tech feed
      </label>

      <label class="toggle">
        <input id="readBackPrompts" type="checkbox">
        Read render prompts back aloud
      </label>

      <label class="toggle">
        <input id="conversationMemory" type="checkbox">
        Conversation memory
      </label>

      <label class="toggle">
        <input id="longTermMemory" type="checkbox">
        Long-term memory (recall)
      </label>

      <label class="toggle">
        <input id="openwebuiLogging" type="checkbox">
        Log conversations to Open WebUI (Pinebox)
      </label>

      <label>Context window (num_ctx)</label>
      <input id="numCtx" type="number"
             min="2048" max="32768" step="1024">

      <button class="primary" style="margin-top:16px"
              onclick="saveSettings()">Save all settings</button>
    </section>

  </div>

  <div id="gutter" title="Drag to resize"></div>

  <aside>
    <section class="panel pine-panel">
      <details id="pineChat" open>
        <summary class="pine-summary">Pine Chat
          <span id="pineCount" class="pine-count"></span>
        </summary>
        <p class="muted" style="margin:8px 0 10px;font-size:13px">
          Send a request to the Pine Box inbox from any computer. It's
          resolved behind the scenes; the reply lands in your history and
          the request clears from the inbox.
        </p>
        <textarea id="pineInput" style="min-height:80px"
          placeholder="Ask the Borg to do something…"></textarea>
        <button class="primary" style="margin-top:10px"
                onclick="submitPine()">Send request</button>
        <div id="pineStatus" class="status"></div>
        <div id="pineInbox"></div>

        <details class="pine-customize">
          <summary class="muted" style="cursor:pointer;margin-top:6px">
            Customize Pine Chat
          </summary>

          <div class="db-tabs" style="margin:8px 0">
            <button id="pcTabPhrases" class="on"
                    onclick="showPineTab('phrases')">Replies</button>
            <button id="pcTabVoices"
                    onclick="showPineTab('voices')">Voices</button>
          </div>

          <div id="pineVoicesTab" style="display:none">
            <p class="muted" style="font-size:12px;margin:0 0 8px">
              Give each kind of spoken line its own voice. Blank follows the
              default.
            </p>
            <div id="eventVoiceRows"></div>
            <button class="primary" style="margin-top:8px"
                    onclick="saveEventVoices()">Save voices</button>
          </div>

          <div id="pinePhrasesTab">
          <label>Saved reply sets</label>
          <div class="row">
            <select id="phraseSetName"></select>
            <button onclick="loadPhraseSet()" title="Load this set">Load</button>
            <button onclick="savePhraseSet()" title="Save current as a set">Save as…</button>
            <button class="danger" onclick="deletePhraseSet()">✕</button>
          </div>
          <label>Spoken when a request is submitted
            <button class="phrase-add" onclick="addPhrase('submit')">+</button>
          </label>
          <div id="pineSubmitList" class="phrase-list"></div>
          <label>Spoken when a request is completed
            <button class="phrase-add" onclick="addPhrase('complete')">+</button>
          </label>
          <div id="pineCompleteList" class="phrase-list"></div>
          </div>

          <label>Behavior / system notes for the Borg resolver</label>
          <textarea id="pineBehavior" style="min-height:70px"
            placeholder="How should the Borg handle these requests?"></textarea>
          <button class="primary" style="margin-top:10px"
                  onclick="savePineChat()">Save Pine Chat settings</button>
        </details>
      </details>
    </section>



    <section class="panel" style="margin-top:20px">
      <h2>Test active prompt</h2>
      <textarea id="testInput" style="min-height:100px"
        placeholder="Ask Spark Agent something…"></textarea>
      <button class="primary" style="margin-top:10px"
              onclick="testPrompt()">Run test</button>
      <div id="testOutput" class="test-output"></div>
    </section>

    <section class="panel" style="margin-top:20px">
      <h2>Conversation history</h2>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button onclick="loadHistory()">Refresh</button>
        <button onclick="exportHistory()">Export</button>
        <button class="danger" onclick="clearHistory()">Clear</button>
      </div>
      <!-- Ten lines, then it scrolls in place instead of pushing the rest of
           the panel off the screen. -->
      <div id="historyOutput" class="test-output"
           style="margin-top:10px;max-height:calc(10 * 1.5em);
                  overflow-y:auto;overscroll-behavior:contain"></div>
    </section>

    <section class="panel" style="margin-top:20px">
      <h2>Speak (voice out)</h2>
      <textarea id="sayInput" style="min-height:70px"
        placeholder="Type a reply for the assistant to speak…"></textarea>
      <div class="row" style="margin-top:10px">
        <button class="primary" onclick="sayText()">Speak</button>
        <button class="danger" onclick="stopSpeaking()"
                title="Cancel queued speech">■ Stop</button>
        <label class="toggle" style="margin:0 0 0 auto;align-self:center">
          <input id="voicePlayHere" type="checkbox" checked>
          Play in this page
        </label>
      </div>
      <audio id="sayAudio" controls playsinline
             style="display:none;width:100%;margin-top:10px"></audio>
      <div id="sayOutput" class="test-output"></div>

      <details class="pine-customize">
        <summary class="muted" style="cursor:pointer">Voice-out setup</summary>
        <p class="muted" style="font-size:12px;margin:8px 0">
          Paste a Home Assistant long-lived token (HA → Profile → Security →
          Long-lived access tokens). Works instantly — no restart. HomeKit /
          AirPlay speakers show up in the list once HA knows them.
        </p>
        <label>Engine</label>
        <div class="row">
          <select id="voiceEngine" onchange="describeEngine()"></select>
          <button onclick="loadVoiceEngines()"
                  title="Re-check which engines are up">↻</button>
        </div>
        <div id="voiceEngineNote" class="muted"
             style="font-size:12px;margin:6px 0"></div>
        <div id="voiceBudget" class="muted"
             style="font-size:12px;margin:0 0 10px"></div>

        <label>Home Assistant token</label>
        <input id="voiceToken" type="password"
               placeholder="paste long-lived access token">
        <label>Speaker</label>
        <div class="row">
          <select id="voicePlayer"></select>
          <button onclick="loadVoicePlayers()" title="Refresh speakers">↻</button>
        </div>

        <label>Voice</label>
        <div class="row">
          <select id="voiceName"></select>
          <button onclick="previewVoice()" title="Hear it">▶</button>
        </div>

        <label>Personality — said before every line</label>
        <input id="voicePrefix" placeholder="e.g. Yo boss,">
        <label>…and after</label>
        <input id="voiceSuffix" placeholder="e.g. capisce?">
        <button class="primary" style="margin-top:10px"
                onclick="saveVoiceOut()">Save voice-out</button>
        <div id="voiceStatus" class="status"></div>
      </details>
    </section>

    <section class="panel" style="margin-top:20px">
      <h2>Render replies</h2>
