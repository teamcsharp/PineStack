async function voteTrack(id, vote, query, anchor) {
  const status = document.getElementById("musicStatus");
  voteBurst(anchor || (window.event && window.event.currentTarget), vote);
  try {
    const result = await api("/api/music/vote", {
      method: "POST",
      body: JSON.stringify({id: id || "", q: query || "", vote}),
    });
    if (status) {
      status.textContent = (result.title || "track") + " · "
        + (vote > 0 ? "👍 more of this"
           : vote < 0 ? "👎 never again" : "vote cleared");
    }
    loadVotes();
    return result;
  } catch (error) {
    if (status) status.textContent = error.message;
    return null;
  }
}

function voteAddTrack(vote) {
  const input = document.getElementById("voteAdd");
  const query = input.value.trim();
  if (!query) return;
  input.value = "";
  return voteTrack("", vote, query);
}

async function loadVotes() {
  const host = document.getElementById("votesOutput");
  if (!host) return;
  try {
    const data = await api("/api/music/votes");
    host.textContent = "";
    if (!(data.votes || []).length) {
      host.textContent = "Nothing voted on yet.";
      return;
    }
    const head = el("div", "muted", data.up + " up · " + data.down
      + " down — a thumbs down never plays again");
    head.style.cssText = "font-size:12px;margin-bottom:6px";
    host.appendChild(head);

    data.votes.forEach((row) => {
      const line = el("div", "phrase-row");
      line.style.cssText = "align-items:baseline;gap:8px";
      const mark = el("span", "", row.vote > 0 ? "👍" : "👎");
      mark.style.flex = "0 0 20px";
      const name = el("span", "", row.title || row.id);
      name.style.cssText = "flex:1;overflow:hidden;text-overflow:ellipsis;"
        + "white-space:nowrap"
        + (row.vote < 0 ? ";opacity:.6;text-decoration:line-through" : "");
      const who = el("span", "muted", row.artist || "");
      who.style.cssText = "font-size:12px;max-width:34%;overflow:hidden;"
        + "text-overflow:ellipsis;white-space:nowrap";
      const flip = el("button", "", row.vote > 0 ? "👎" : "👍");
      flip.title = "Switch this vote";
      flip.onclick = () => voteTrack(
        row.id, row.vote > 0 ? -1 : 1, "", flip);
      const drop = el("button", "danger", "✕");
      drop.title = "Remove from the list";
      drop.onclick = () => voteTrack(row.id, 0);
      [mark, name, who, flip, drop].forEach((n) => line.appendChild(n));
      host.appendChild(line);
    });
  } catch (error) {
    host.textContent = error.message;
  }
}

