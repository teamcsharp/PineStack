CLOUD_STOPWORDS = frozenset("""
about all also and any are because been before being but can cant come could
did does doing dont down each even ever every for from get gets getting give
going gonna good got had has have having her here hers him his how ill its
ive just keep kind know let like made make many may maybe more most much must
need never new not now off one only other our out over own please put really
right said same say says see should show similar since some something still
such sure take tell than that the their them then there these they thing
things think this those through too try use used using very want was way well
went were what when where which while who why will with without wont would
yeah yes yet you your youre yours
""".split())

CLOUD_WORD = re.compile(r"[a-z][a-z'\-]{2,}")


def word_cloud(limit: int = 140, sides: str = "user") -> list[dict[str, Any]]:
    """Word frequencies across the conversation log, each with when it was
    last said — so the cloud can colour by recency as well as by size.
    ponytail: a full recount per request. The log is a few hundred turns;
    cache on mtime if it ever reaches tens of thousands."""
    counts: dict[str, int] = {}
    last_seen: dict[str, int] = {}

    for turn in read_history(limit=100000):
        stamp = int(turn.get("ts") or 0)
        text = ""
        if sides in ("user", "both"):
            text += " " + str(turn.get("user") or "")
        if sides in ("agent", "both"):
            text += " " + str(turn.get("answer") or "")
        for word in CLOUD_WORD.findall(text.lower()):
            word = word.strip("'-")
            if len(word) < 3 or word in CLOUD_STOPWORDS:
                continue
            counts[word] = counts.get(word, 0) + 1
            if stamp > last_seen.get(word, 0):
                last_seen[word] = stamp

    ranked = sorted(counts.items(), key=lambda item: (-item[1], item[0]))
    chosen = ranked[:limit]
    if not chosen:
        return []

    # Normalise recency across the words actually shown, so the newest is
    # always 1.0 and the oldest 0.0 no matter how long the log is.
    stamps = [last_seen.get(word, 0) for word, _n in chosen]
    newest, oldest = max(stamps), min(stamps)
    span = max(1, newest - oldest)

    return [
        {
            "word": word,
            "count": n,
            "last": last_seen.get(word, 0),
            "recency": round((last_seen.get(word, 0) - oldest) / span, 4),
        }
        for word, n in chosen
    ]



# --- Music: index, search, serve, play -------------------------------------

_MUSIC: dict[str, Any] = {
    "at": 0.0, "tracks": [], "by_id": {}, "scanned": 0,
    "scanning": False, "loaded": False,
}
_MUSIC_LOCK = RLock()
_TRACK_NUMBER = re.compile(r"^\s*\d{1,3}\s*[-._)]?\s+")


def _track_id(path: Path) -> str:
    """Stable, opaque, fixed shape — the same guarantees as a media key."""
    return hashlib.sha1(str(path).encode("utf-8", "replace")).hexdigest()[:16]


def _track_meta(path: Path, root: Path) -> dict[str, Any]:
    """Title/artist/album from tags when mutagen is available, otherwise from
    the filename and the folders around it.
    ponytail: no transcoding, no artwork, no duration probe for untagged
    files — the radio falls back to an estimate. Add ffprobe if that drifts."""
    title = _TRACK_NUMBER.sub("", path.stem).strip() or path.stem
    artist = album = ""
    seconds = 0.0

    try:
        from mutagen import File as MutagenFile      # type: ignore

        tags = MutagenFile(path, easy=True)
        if tags is not None:
            if tags.info is not None:
                seconds = float(getattr(tags.info, "length", 0) or 0)
            title = (tags.get("title") or [title])[0] or title
            artist = (tags.get("artist") or [""])[0] or ""
            album = (tags.get("album") or [""])[0] or ""
    except Exception:
        pass                      # tags are a bonus; the filename always works

    # "Artist - Title.mp3" is the other convention people actually use.
    if not artist and " - " in path.stem:
        left, right = path.stem.split(" - ", 1)
        if not _TRACK_NUMBER.match(path.stem):
            artist, title = left.strip(), _TRACK_NUMBER.sub("", right).strip()

    # iTunes on disk is <root>/Artist/Album/01 Title.m4a.
    relative = path.relative_to(root).parts
    if not album and len(relative) >= 2:
        album = relative[-2]
    if not artist and len(relative) >= 3:
        artist = relative[-3]

    if not seconds:
        # A rough guess beats no guess: the radio only needs to know roughly
        # when to queue the next track.
        try:
            seconds = path.stat().st_size * 8 / 192_000
        except Exception:
            seconds = 210.0

    return {
        "id": _track_id(path),
        "title": title[:200],
        "artist": artist[:120],
        "album": album[:160],
        "ext": path.suffix.lower(),
        "seconds": round(seconds, 1),
        "station": relative[0] if len(relative) > 1 else root.name,
        "path": str(path),
        "search": " ".join([title, artist, album, path.stem]).lower(),
    }


def _music_walk(root: Path) -> list[Path]:
    """rglob, minus the folders a music library never keeps music in."""
    found: list[Path] = []
    stack = [root]
    while stack:
        folder = stack.pop()
        try:
            entries = list(folder.iterdir())
        except Exception:
            continue
        for entry in entries:
            try:
                if entry.is_dir():
                    if entry.name.lower() not in MUSIC_SKIP_DIRS:
                        stack.append(entry)
                elif entry.suffix.lower() in MUSIC_TYPES:
                    found.append(entry)
                    if len(found) >= MUSIC_MAX_TRACKS:
                        return found
            except Exception:
                continue
    return found


def _music_cache_read() -> dict[str, dict[str, Any]]:
    try:
        rows = json.loads(MUSIC_CACHE_PATH.read_text())
        return {str(r["path"]): r for r in rows if isinstance(r, dict)}
    except Exception:
        return {}


def _music_cache_write(tracks: list[dict[str, Any]]) -> None:
    try:
        MUSIC_CACHE_PATH.parent.mkdir(parents=True, exist_ok=True)
        temporary = MUSIC_CACHE_PATH.with_suffix(".tmp")
        temporary.write_text(json.dumps(tracks))
        temporary.replace(MUSIC_CACHE_PATH)
        # When the index was built, so a restart does not rescan 36,000 files
        # over CIFS just because the in-memory timestamp reset to zero.
        MUSIC_CACHE_PATH.with_suffix(".stamp").write_text(str(int(time.time())))
    except Exception:
        pass


def _music_publish(tracks: list[dict[str, Any]], save: bool,
                   final: bool = False) -> None:
    """Checkpoint the scan.

    A partial scan only becomes the live index when there is nothing better:
    the walk is alphabetical, so publishing partials over a complete index
    would make everything after the current folder vanish until the scan
    finished. Disk is written either way, so a restart still resumes."""
    with _MUSIC_LOCK:
        replace = final or not _MUSIC["tracks"]
        if replace:
            _MUSIC["tracks"] = list(tracks)
            _MUSIC["by_id"] = {t["id"]: t for t in tracks}
        _MUSIC["scanned"] = len(tracks)
    if save:
        _music_cache_write(tracks)


def _music_scan() -> None:
    """The expensive part, on a worker thread. Reading tags off a NAS is what
    costs — so a file whose mtime and size are unchanged keeps the metadata
    already on disk and is never opened again."""
    known = _music_cache_read()
    tracks: list[dict[str, Any]] = []
    checkpoint = 0
    try:
        for root in MUSIC_ROOTS:
            if not root.is_dir():
                continue
            for path in sorted(_music_walk(root)):
                try:
                    stat = path.stat()
                except Exception:
                    continue
                cached = known.get(str(path))
                if (cached and cached.get("mtime") == int(stat.st_mtime)
                        and cached.get("size") == stat.st_size):
                    tracks.append(cached)
                    continue
                try:
                    meta = _track_meta(path, root)
                except Exception:
                    continue   # one unreadable file cannot empty a library
                meta["mtime"] = int(stat.st_mtime)
                meta["size"] = stat.st_size
                tracks.append(meta)
                _MUSIC["scanned"] = len(tracks)

                if len(tracks) - checkpoint >= MUSIC_CHECKPOINT:
                    checkpoint = len(tracks)
                    _music_publish(tracks, save=True)
    finally:
        if tracks:
            _music_publish(tracks, save=True, final=True)
        with _MUSIC_LOCK:
            _MUSIC["at"] = time.time()
            _MUSIC["scanning"] = False


def music_index(force: bool = False) -> list[dict[str, Any]]:
    """Always returns immediately. A stale index refreshes on a background
    thread, so a six-minute NAS walk never holds up a request."""
    with _MUSIC_LOCK:
        if not _MUSIC.get("loaded"):
            cached = list(_music_cache_read().values())
            built = 0.0
            try:
                built = float(
                    MUSIC_CACHE_PATH.with_suffix(".stamp").read_text().strip())
            except Exception:
                built = 0.0
            _MUSIC.update({
                "loaded": True,
                "tracks": cached,
                "by_id": {t["id"]: t for t in cached},
                "scanned": len(cached),
                # Inherit the age of what we just loaded.
                "at": built if cached else 0.0,
            })

        stale = time.time() - _MUSIC["at"] >= MUSIC_INDEX_TTL
        if (force or stale or not _MUSIC["tracks"]) and not _MUSIC["scanning"]:
            _MUSIC["scanning"] = True
            Thread(target=_music_scan, name="music-scan", daemon=True).start()

        return _MUSIC["tracks"]


def music_track(track_id: str) -> dict[str, Any] | None:
    music_index()
    return _MUSIC["by_id"].get(track_id)


def music_search(query: str, limit: int = 12) -> list[dict[str, Any]]:
    """Loose match on title, artist, album and filename. An exact title hit
    always wins, so "play Marsh Pipe" lands on the track, not the album."""
    words = [w for w in re.findall(r"[a-z0-9']+", query.lower()) if len(w) > 1]
    if not words:
        return []
    wanted = query.lower().strip()

    scored: list[tuple[float, int, dict[str, Any]]] = []
    for track in music_index():
        hay = track["search"]
        hits = sum(1 for word in words if word in hay)
        if not hits:
            continue
        score = hits / len(words)
        if wanted == track["title"].lower():
            score += 2.0
        elif wanted in track["title"].lower():
            score += 1.0
        scored.append((score, -len(track["title"]), track))

    scored.sort(key=lambda row: (-row[0], row[1]))
    return [track for _score, _len, track in scored[:limit]]


def music_stations() -> list[dict[str, Any]]:
    """One station per top folder, plus the whole library. Folders are how
    people already organise music, so that is the grouping worth having."""
    counts: dict[str, int] = {}
    for track in music_index():
        counts[track["station"]] = counts.get(track["station"], 0) + 1
    stations = [{"id": "all", "name": "Everything", "tracks": len(music_index())}]
    for name, n in sorted(counts.items()):
        stations.append({"id": name, "name": name.replace("_", " ").title(),
                         "tracks": n})
    return stations


def music_url(track: dict[str, Any]) -> str:
    signature = media_sign(track["id"])
    return (f"{VOICE_PUBLIC_URL}/music/{track['id']}"
            + (f"?t={signature}" if signature else ""))


async def music_play_on_box(track: dict[str, Any]) -> str:
    """Play through the Pine Box. The satellite has no media_player entity,
    so announce with a media_id is the route — the same one a generated
    voice clip takes.
    ponytail: no pause, seek or volume on the box; the panel player has all
    three. Wire a real media_player entity in Home Assistant if you want
    transport control from the box itself."""
    token, player = _ha_creds()
    if not (token and player):
        return ""
    if not await satellite_ready():
        return ""                    # nothing to play it on
    url = music_url(track)
    if player.startswith("assist_satellite."):
        service = "assist_satellite/announce"
        payload: dict[str, Any] = {"entity_id": player, "media_id": url}
    else:
        service = "media_player/play_media"
        payload = {"entity_id": player, "media_content_id": url,
                   "media_content_type": "music"}

    async def _dispatch() -> None:
        # announce does not return until the audio has finished playing, so a
        # six-minute track would hold this request open for six minutes. Fire
        # it and walk away; the timeout is the track length plus slack.
        try:
            async with httpx.AsyncClient(
                timeout=max(60.0, float(track.get("seconds") or 0) + 30)
            ) as client:
                await client.post(
                    f"{HA_URL}/api/services/{service}",
                    headers={"Authorization": f"Bearer {token}"}, json=payload,
                )
        except Exception:
            pass

    fire_and_forget_speech(_dispatch())
    return player


# --- Radio: continuous stations over the same library ----------------------
# Not subwave's Icecast/Liquidsoap/Navidrome stack — the Pine Box already has
# a library, an LLM and a voice, so a station here is a shuffled queue plus a
# spoken intro. No extra containers, no stream to keep alive.

_RADIO: dict[str, Any] = {
    "station": "", "queue": [], "now": None, "started": 0.0, "dj": True,
}
_RADIO_TASK: list[Any] = []


def radio_state() -> dict[str, Any]:
    now = _RADIO.get("now")
    elapsed = time.time() - _RADIO["started"] if now else 0.0
    return {
        "station": _RADIO["station"],
        "playing": bool(now),
        "dj": _RADIO["dj"],
        "now": now,
        "elapsed": round(elapsed, 1),
        "queued": len(_RADIO["queue"]),
    }


def radio_fill(station: str) -> list[dict[str, Any]]:
    banned = banned_ids()                 # a thumbs down is permanent (#116)
    tracks = [
        t for t in music_index()
        if (station in ("all", "") or t["station"] == station)
        and t["id"] not in banned
    ]
    random.shuffle(tracks)
    return tracks


def radio_next_track() -> dict[str, Any] | None:
    if not _RADIO["queue"]:
        _RADIO["queue"] = radio_fill(_RADIO["station"])
    if not _RADIO["queue"]:
        return None
    track = _RADIO["queue"].pop(0)
    _RADIO["now"] = track
    _RADIO["started"] = time.time()
    return track


async def radio_intro(track: dict[str, Any]) -> str:
    """The DJ line. One sentence, from the model that is already loaded."""
    who = f" by {track['artist']}" if track["artist"] else ""
    fallback = f"Next up, {track['title']}{who}."
    if not _RADIO["dj"]:
        return ""
    try:
        line, _meta = await generate_answer([{
            "role": "user",
            "content": (
                "You are the DJ on a private radio station. In ONE short "
                f"spoken sentence, introduce the track \"{track['title']}\""
                f"{who}. No emoji, no markdown, no URLs."
            ),
        }])
        line = " ".join(str(line or "").split())[:200]
        return line or fallback
    except Exception:
        return fallback


async def _radio_loop() -> None:
    """Play a track, speak over the gap, play the next. Track length comes
    from the file's tags where they exist and an estimate where they do not,
    so the box can drift a few seconds either way on untagged files."""
    try:
        while _RADIO["station"]:
            track = radio_next_track()
            if not track:
                break
            intro = await radio_intro(track)
            if intro:
                try:
                    await speak(intro, event="default")
                    await asyncio.sleep(min(12.0, 1.5 + len(intro) / 14))
                except Exception:
                    pass
            _RADIO["started"] = time.time()
            await music_play_on_box(track)
            await asyncio.sleep(max(20.0, float(track["seconds"])) + 1.5)
    except asyncio.CancelledError:
        raise
    except Exception:
        pass
    finally:
        _RADIO["now"] = None


def radio_stop() -> None:
    _RADIO.update({"station": "", "queue": [], "now": None, "started": 0.0})
    for task in _RADIO_TASK:
        if not task.done():
            task.cancel()
    _RADIO_TASK.clear()


def radio_tune(station: str, dj: bool = True) -> dict[str, Any]:
    radio_stop()
    _RADIO.update({"station": station or "all", "dj": bool(dj)})
    _RADIO["queue"] = radio_fill(_RADIO["station"])
    task = asyncio.create_task(_radio_loop())
    _RADIO_TASK.append(task)
    return radio_state()


# --- "play <song>" ---------------------------------------------------------


def is_music_request(text: str) -> bool:
    """A play request that the local library can actually satisfy. Checked
    before the YouTube path so your own files win over a music video."""
    if not re.search(r"\b(play|put on|queue up|throw on)\b", text or "", re.I):
        return False
    # Asking for the video is asking for YouTube, not for your own copy.
    if re.search(r"\b(video|youtube|music video|on screen|on the tv)\b",
                 text or "", re.I):
        return False
    return bool(music_search(music_request_query(text), limit=1))


def music_request_query(text: str) -> str:
    query = re.sub(
        r"^\s*(hey\s+)?(pine\s*box\s*)?(can you\s+|please\s+)?"
        r"(play|put on|queue up|throw on)\s+",
        "", text or "", flags=re.I,
    )
    query = re.sub(
        r"\b(for me|please|on the (pine ?box|speaker|radio)|right now)\b",
        " ", query, flags=re.I,
    )
    return re.sub(r"\s{2,}", " ", query).strip(" .!?,")


async def play_music_request(text: str) -> str:
    """Resolve, play, and answer the way a person would."""
    query = music_request_query(text)
    hits = music_search(query, limit=3)
    if not hits:
        return f'Nothing in the library matches "{query}".'

    track = hits[0]
    played = await music_play_on_box(track)
    who = f" by {track['artist']}" if track["artist"] else ""
    where = " on the Pine Box" if played else " — it is in the panel player"
    return f"Here's {track['title']}{who}, playing{where}."



# --- Device icons and how-to video links (#87) -----------------------------
# A device icon is a monochrome SVG living next to its manual, so it inherits
# the panel's colour and stays sharp at any size. Hand-drawn beats a render:
