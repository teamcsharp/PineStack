@app.post("/v1/chat/completions")
async def chat_completions(
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    require_auth(authorization)
    incoming = await request.json()
    incoming_messages = incoming.get("messages")

    if not isinstance(incoming_messages, list):
        raise HTTPException(
            status_code=400,
            detail="messages must be an array",
        )

    user_text = latest_user_text(incoming_messages)

    # "Play Blue Monday on Pine Box FM", said out loud to the box. The
    # station takes this one; the model never sees it.
    taken = await dj_take_request(user_text)
    if taken:
        log_turn(user_text, taken["reply"],
                 {"active_prompt": "Pine Box FM", "model": "station",
                  "dj_request": taken["query"]})
        return {
            "id": f"chatcmpl-{uuid.uuid4().hex}",
            "object": "chat.completion",
            "created": int(time.time()),
            "model": "pine-box-fm",
            "choices": [{
                "index": 0,
                "message": {"role": "assistant", "content": taken["reply"]},
                "finish_reason": "stop",
            }],
            "usage": {"prompt_tokens": 0, "completion_tokens": 0,
                      "total_tokens": 0},
            "spark_agent": {"dj_request": taken},
        }

    answer, metadata = await generate_answer(
        incoming_messages,
        requested_model=incoming.get("model"),
        requested_max_tokens=(
            incoming.get("max_tokens")
            or incoming.get("max_completion_tokens")
        ),
    )

    log_turn(user_text, answer, metadata)

    if load_settings().get("openwebui_logging", True):
        fire_and_forget(
            mirror_to_openwebui(user_text, answer, metadata["model"])
        )

    return {
        "id": f"chatcmpl-{uuid.uuid4().hex}",
        "object": "chat.completion",
        "created": int(time.time()),
        "model": metadata["model"],
        "choices": [
            {
                "index": 0,
                "message": {
                    "role": "assistant",
                    "content": answer,
                },
                "finish_reason": "stop",
            }
        ],
        "usage": {
            "prompt_tokens": metadata["prompt_tokens"],
            "completion_tokens": metadata["completion_tokens"],
            "total_tokens": (
                metadata["prompt_tokens"]
                + metadata["completion_tokens"]
            ),
        },
        "spark_agent": {
            "web_search_used": metadata["web_search_used"],
            "game_lookup_used": metadata["game_lookup_used"],
            "from_library": metadata["from_library"],
            "system_status_used": metadata["system_status_used"],
            "image_requested": metadata["image_requested"],
            "openwebui_used": metadata["openwebui_used"],
            "memory_used": metadata["memory_used"],
            "memory_saved": metadata["memory_saved"],
            "active_prompt": metadata["active_prompt"],
        },
    }


