/* ---- Cover Flow (#128) ---- */

// One component, mounted twice: the DJ's running order and library browsing.
// Each cover is a DOM node so it stays clickable and the artwork stays sharp.
function coverFlow(host, options) {
  options = options || {};
  // The covers are sized from the container, so the flow always spans it.
  function pickSize() {
    const width = host.clientWidth || 620;
    return Math.round(Math.max(112, Math.min(options.max || 250, width * 0.27)));
  }
  let size = options.size || pickSize();
  const state = {tracks: [], index: 0, built: []};

  host.textContent = "";
  const stage = el("div", "cf-stage", "");
  const label = el("div", "cf-label", "");
  const rail = document.createElement("input");
  rail.type = "range";
  rail.className = "cf-rail";
  rail.min = "0";
  rail.value = "0";
  host.appendChild(stage);
  host.appendChild(label);
  host.appendChild(rail);

  function place() {
    state.built.forEach((entry, i) => {
      const offset = i - state.index;
      const away = Math.abs(offset);
      const side = Math.sign(offset);
      // The centre cover faces you; everything else turns away and stacks.
      // Tight, deep stack: the first neighbour steps well clear of the
      // centre, the rest crowd in behind it the way a rack of records does.
      const step = size * (away <= 1 ? 0.56 : 0.20);
      const shift = side * (size * 0.30 + Math.min(away, 8) * step);
      const depth = offset === 0 ? 60 : -110 - Math.min(away, 8) * 34;
      const turn = offset === 0 ? 0 : side * -66;
      entry.node.style.transform =
        "translateX(" + (shift - size / 2) + "px) translateZ(" + depth
        + "px) rotateY(" + turn + "deg) scale(" + (offset === 0 ? 1 : 0.88) + ")";
      entry.node.style.zIndex = String(100 - away);
      entry.node.style.opacity = away > 8 ? "0" : String(1 - away * 0.045);
      entry.node.classList.toggle("on", offset === 0);
    });

    const current = state.tracks[state.index];
    label.textContent = "";
    if (current) {
      const title = document.createElement("b");
      title.textContent = current.title || "";
      const who = document.createElement("span");
      who.textContent = [current.artist, current.album]
        .filter(Boolean).join(" · ");
      label.appendChild(title);
      label.appendChild(who);
    }
    rail.value = String(state.index);
    if (options.onCentre && current) options.onCentre(current, state.index);
  }

  function go(index) {
    state.index = Math.max(0, Math.min(state.tracks.length - 1, index));
    place();
  }

  function build(tracks, centre) {
    // Rebuilding on every poll would restart every image load, so only do it
    // when the running order actually changed.
    const signature = tracks.map((t) => t.id).join();
    if (signature === state.signature) {
      if (centre !== undefined && centre !== state.index) go(centre);
      return;
    }
    state.signature = signature;
    state.tracks = tracks;
    state.built = [];
    stage.textContent = "";

    if (!tracks.length) {
      const empty = el("div", "cf-empty", options.empty || "Nothing here yet.");
      stage.appendChild(empty);
      label.textContent = "";
      rail.style.display = "none";
      return;
    }
    rail.style.display = "";
    rail.max = String(tracks.length - 1);
    size = options.size || pickSize();

    tracks.forEach((track, i) => {
      const node = el("div", "cf-item", "");
      node.style.width = size + "px";

      const face = el("div", "cf-face", "");
      face.style.cssText += ";width:" + size + "px;height:" + size + "px";
      sleeveInto(face, track, size);

      // The reflection is a second, flipped sleeve under the first.
      const mirror = el("div", "cf-face cf-mirror", "");
      mirror.style.cssText += ";width:" + size + "px;height:" + size + "px";
      sleeveInto(mirror, track, size);

      node.appendChild(face);
      node.appendChild(mirror);
      node.onclick = () => {
        if (i !== state.index) { go(i); return; }
        if (options.onPick) options.onPick(track);
      };
      wireDownload(node, track);
      stage.appendChild(node);
      state.built.push({node, track});
    });

    go(centre === undefined ? Math.floor(tracks.length / 2) : centre);
  }

  // Re-cut the sleeves when the column width changes enough to matter.
  // Rebuilding restarts every image load, so only past a real threshold.
  if (!options.size && window.ResizeObserver) {
    new ResizeObserver(() => {
      if (Math.abs(pickSize() - size) < size * 0.14) return;
      const tracks = state.tracks;
      const keep = state.index;
      state.signature = null;
      build(tracks, keep);
    }).observe(host);
  }

  rail.oninput = () => go(Number(rail.value));
  host.addEventListener("wheel", (event) => {
    if (Math.abs(event.deltaX) < Math.abs(event.deltaY)) return;  // let it scroll
    event.preventDefault();
    go(state.index + (event.deltaX > 0 ? 1 : -1));
  }, {passive: false});

  let dragFrom = null;
  host.addEventListener("pointerdown", (event) => {
    dragFrom = {x: event.clientX, index: state.index};
    host.classList.add("dragging");
  });
  window.addEventListener("pointerup", () => {
    dragFrom = null;
    host.classList.remove("dragging");
  });
  host.addEventListener("pointermove", (event) => {
    if (!dragFrom) return;
    go(dragFrom.index - Math.round((event.clientX - dragFrom.x) / (size * 0.5)));
  });
  host.tabIndex = 0;
  host.addEventListener("keydown", (event) => {
    if (event.key === "ArrowRight") go(state.index + 1);
    else if (event.key === "ArrowLeft") go(state.index - 1);
    else if (event.key === "Enter" && options.onPick) {
      options.onPick(state.tracks[state.index]);
    } else return;
    event.preventDefault();
  });

  return {build, go, state};
}

/* ---- Albums drifting behind the stage (#162) ---- */

const SWIRL = {albums: [], asked: false};

async function swirlAlbums() {
  if (SWIRL.asked) return SWIRL.albums;
  SWIRL.asked = true;
  try {
    const data = await api("/api/music/albums?limit=160");
    SWIRL.albums = data.albums || [];
  } catch (error) { SWIRL.albums = []; }
  return SWIRL.albums;
}

// A fixed pool of tiles, each recycled with a fresh album when it leaves the
// frame — endless drift without endless allocation.
function swirlStart(host) {
  if (host.querySelector(".cf-swirl")) return;
  const layer = el("div", "cf-swirl", "");
  host.insertBefore(layer, host.firstChild);

  const tiles = [];
  let last = 0;

  function dress(tile) {
    if (!SWIRL.albums.length) return false;
    const album = SWIRL.albums[(Math.random() * SWIRL.albums.length) | 0];
    const box = host.getBoundingClientRect();
    const size = Math.round(64 + Math.random() * Math.min(150, box.width * 0.2));
    const fromLeft = Math.random() < 0.5;

    tile.album = album;
    tile.size = size;
    tile.node.style.width = size + "px";
    tile.node.style.height = size + "px";
    sleeveInto(tile.node, {
      artist: album.artist, album: album.album, title: album.album,
      art: album.art,
    }, size);

    tile.x = fromLeft ? -size - Math.random() * 140
                      : box.width + Math.random() * 140;
    tile.y = Math.random() * Math.max(30, box.height - size * 0.6) - size * 0.2;
    // Bigger sleeves read as nearer, so they cross faster.
    tile.vx = (fromLeft ? 1 : -1) * (7 + size * 0.16 + Math.random() * 14);
    tile.vy = (Math.random() - 0.5) * 11;
    tile.spin = (Math.random() - 0.5) * 7;
    tile.turn = (Math.random() - 0.5) * 34;
    tile.peak = 0.20 + (size / 220) * 0.30;
    tile.life = 0;
    tile.ttl = (box.width + size * 2.6) / Math.abs(tile.vx);
    return true;
  }

  function step(now) {
    requestAnimationFrame(step);
    const delta = Math.min(0.05, (now - last) / 1000 || 0);
    last = now;
    // Nothing to do while the tab is hidden or the panel is rolled up.
    if (document.hidden || !host.offsetParent) return;
    if (host.querySelector(".cf-focus")) return;

    tiles.forEach((tile) => {
      if (!tile.album && !dress(tile)) return;
      tile.life += delta;
      if (tile.life > tile.ttl) { dress(tile); return; }
      tile.x += tile.vx * delta;
      tile.y += tile.vy * delta;
      tile.turn += tile.spin * delta;
      const fade = Math.min(1, tile.life / (tile.ttl * 0.18),
                            (tile.ttl - tile.life) / (tile.ttl * 0.24));
      tile.node.style.opacity = String(tile.peak * fade);
      tile.node.style.transform = "translate3d(" + Math.round(tile.x) + "px,"
        + Math.round(tile.y) + "px,0) rotate(" + tile.turn.toFixed(1) + "deg)";
    });
  }

  const width = host.clientWidth || 620;
  const count = Math.max(5, Math.min(13, Math.round(width / 105)));
  for (let i = 0; i < count; i += 1) {
    const node = el("div", "cf-swirl-tile", "");
    const tile = {node, album: null, life: 0, ttl: 1};
    node.onclick = () => { if (tile.album) albumFocus(host, tile.album); };
    layer.appendChild(node);
    tiles.push(tile);
    // Stagger the first entrances so they do not arrive as one wave.
    tile.life = -Math.random() * 9;
  }

  swirlAlbums().then(() => { requestAnimationFrame(step); });
}

/* ---- One album, its tracks, and a way back out (#162) ---- */

async function albumFocus(host, album) {
  const open = host.querySelector(".cf-focus");
  if (open) open.remove();

  const shade = el("div", "cf-focus", "");
  shade.onclick = (event) => { if (event.target === shade) shade.remove(); };

  const sleeve = el("div", "sleeve", "");
  sleeveInto(sleeve, {
    artist: album.artist, album: album.album, title: album.album,
    art: album.art,
  }, 220);
  shade.appendChild(sleeve);

  const list = el("div", "list", "");
  const head = el("div", "row", "");
  head.style.cssText = "align-items:baseline;gap:8px";
  const title = document.createElement("b");
  title.textContent = album.album || "Unknown album";
  title.style.cssText = "font-size:15px;flex:1;min-width:0";
  const shut = el("button", "", "✕");
  shut.title = "Back to the swirl";
  shut.onclick = () => shade.remove();
  head.appendChild(title);
  head.appendChild(shut);
  list.appendChild(head);

  const who = el("div", "muted", album.artist || "");
  who.style.cssText = "font-size:12px;margin-top:2px";
  list.appendChild(who);

  const tracks = el("div", "tracks", "");
  tracks.appendChild(el("div", "muted", "Reading the album…"));
  list.appendChild(tracks);
  shade.appendChild(list);
  host.appendChild(shade);

  try {
    const data = await api("/api/music/album?artist="
      + encodeURIComponent(album.artist || "")
      + "&album=" + encodeURIComponent(album.album || ""));
    tracks.textContent = "";
    who.textContent = [album.artist, data.count + " tracks",
                       Math.round((data.seconds || 0) / 60) + " min"]
      .filter(Boolean).join(" · ");

    (data.tracks || []).forEach((track, i) => {
      const row = el("div", "", "");
      row.appendChild(el("span", "n", String(i + 1)));
      row.appendChild(el("span", "t", track.title || ""));
      row.appendChild(el("span", "d", Math.floor(track.seconds / 60) + ":"
        + String(Math.round(track.seconds % 60)).padStart(2, "0")));
      row.onclick = () => { shade.remove(); musicPlay(track.id, true); };
      wireDownload(row, track);
      tracks.appendChild(row);
    });
    if (!(data.tracks || []).length) {
      tracks.appendChild(el("div", "muted", "Nothing indexed under this album."));
    }
  } catch (error) {
    tracks.textContent = "";
    tracks.appendChild(el("div", "muted", error.message));
  }
}

let djFlow = null;
let musicFlow = null;
let musicFlowList = false;

function renderDJFlow(state) {
  const host = document.getElementById("djFlow");
  if (!host) return;
  if (!djFlow) {
    djFlow = coverFlow(host, {
      empty: "Tune in — the last five and next five appear here.",
      // Clicking the album on the stage opens it, same as clicking one of
      // the sleeves drifting behind it.
      onPick: (track) => albumFocus(host, {
        artist: track.artist, album: track.album, art: track.art,
      }),
    });
    swirlStart(host);
  }
  // Oldest played first, then what is on air, then what is queued.
  const played = (state.played || []).slice(0, 5).reverse();
  const now = state.now && state.now.id ? [state.now] : [];
  const next = (state.upcoming || []).slice(0, 5);
  djFlow.build(played.concat(now, next), played.length);
}

