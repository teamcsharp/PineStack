function writeEditorIntoSettings() {
  const prompt = currentPrompt();
  if (!prompt) return;

  prompt.name = document.getElementById("promptName").value.trim();
  prompt.prompt = document.getElementById("promptText").value.trim();

  // NOT settings.model: the field applies on change via switchModel(). If a
  // save wrote it too, a stale tab would silently revert the active model.
  settings.temperature =
    Number(document.getElementById("temperature").value);
  settings.top_p =
    Number(document.getElementById("topP").value);
  settings.max_tokens =
    Number(document.getElementById("maxTokens").value);
  settings.web_search =
    document.getElementById("webSearch").checked;
  settings.game_search =
    document.getElementById("gameSearch").checked;
  settings.gear_manuals =
    document.getElementById("gearManuals").checked;
  settings.read_back_prompts =
    document.getElementById("readBackPrompts").checked;
  settings.conversation_memory =
    document.getElementById("conversationMemory").checked;
  settings.long_term_memory =
    document.getElementById("longTermMemory").checked;
  settings.openwebui_logging =
    document.getElementById("openwebuiLogging").checked;
  settings.num_ctx =
    Number(document.getElementById("numCtx").value);
  settings.render_replies =
    document.getElementById("renderReplies").value
      .split("\n").map((s) => s.trim()).filter(Boolean);
}

function render() {
  const select = document.getElementById("promptSelect");
  select.innerHTML = "";

  settings.prompts.forEach((prompt, index) => {
    const option = document.createElement("option");
    option.value = index;
    option.textContent = prompt.name;
    option.selected = index === settings.active_prompt;
    select.appendChild(option);
  });

  const prompt = currentPrompt();
  document.getElementById("promptName").value = prompt.name;
  document.getElementById("promptText").value = prompt.prompt;
  document.getElementById("model").value = settings.model;
  document.getElementById("temperature").value =
    settings.temperature;
  document.getElementById("topP").value =
    settings.top_p;
  document.getElementById("maxTokens").value =
    settings.max_tokens;
  document.getElementById("webSearch").checked =
    settings.web_search;
  document.getElementById("gameSearch").checked =
    settings.game_search;
  document.getElementById("gearManuals").checked =
    settings.gear_manuals !== false;
  document.getElementById("readBackPrompts").checked =
    settings.read_back_prompts !== false;
  const vo = settings.voice_out || {};
  if (document.getElementById("voicePrefix")) {
    document.getElementById("voicePrefix").value = vo.personality_prefix || "";
    document.getElementById("voiceSuffix").value = vo.personality_suffix || "";
  }
  const tokenField = document.getElementById("voiceToken");
  if (tokenField) {
    tokenField.value = "";
    tokenField.placeholder = vo.ha_token === "__token_set__"
      ? "token saved — paste to replace"
      : "paste long-lived access token";
  }
  document.getElementById("conversationMemory").checked =
    settings.conversation_memory;
  document.getElementById("longTermMemory").checked =
    settings.long_term_memory;
  document.getElementById("openwebuiLogging").checked =
    settings.openwebui_logging;
  document.getElementById("numCtx").value = settings.num_ctx;
  document.getElementById("renderReplies").value =
    (settings.render_replies || []).join("\n");
  const pc = settings.pine_chat || {};
  renderPhrases("Submit",
    (pc.submit_phrases && pc.submit_phrases.length)
      ? pc.submit_phrases : [pc.submit_phrase || ""]);
  renderPhrases("Complete",
    (pc.complete_phrases && pc.complete_phrases.length)
      ? pc.complete_phrases : [pc.complete_phrase || ""]);
  document.getElementById("pineBehavior").value = pc.behavior || "";
}

