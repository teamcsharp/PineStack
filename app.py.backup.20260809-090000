# --- Pine Box inbox (pine_requests.md) --------------------------------------
# Requests submitted from any computer are PREPENDED here as markdown blocks,
# resolved behind the scenes, then removed. The .md is the canonical store so
# it is human- and Claude-readable/editable directly.

_pine_lock = asyncio.Lock()
# A request block: "## #<id> — <when> — <status>\n<body>" up to the next block.
_PINE_BLOCK_RE = re.compile(
    r"^## #(\d+) — (.*?) — (\w+)\n(.*?)(?=\n## #|\Z)",
    re.DOTALL | re.MULTILINE,
)


def _pine_next_id() -> int:
    try:
        n = int(PINE_SEQ_PATH.read_text().strip())
    except Exception:
        n = 0
    n += 1
    try:
        PINE_SEQ_PATH.parent.mkdir(parents=True, exist_ok=True)
        PINE_SEQ_PATH.write_text(str(n))
    except Exception:
        pass
    return n


def pine_read() -> list[dict[str, Any]]:
    try:
        text = PINE_REQUESTS_PATH.read_text()
    except Exception:
        return []
    out: list[dict[str, Any]] = []
    for m in _PINE_BLOCK_RE.finditer(text):
        out.append({
            "id": int(m.group(1)),
            "when": m.group(2).strip(),
            "status": m.group(3).strip(),
            "text": m.group(4).strip(),
        })
    return out


def _pine_render(items: list[dict[str, Any]]) -> str:
    header = (
        "<!-- Pine Box inbox · newest first · resolved requests are "
        "removed. Submit from the Pine Chat panel on any computer. -->\n\n"
    )
    blocks = [
        f"## #{it['id']} — {it['when']} — {it['status']}\n{it['text']}\n"
        for it in items
    ]
    return header + "\n".join(blocks) + ("\n" if blocks else "")


async def pine_append(text: str) -> dict[str, Any]:
    async with _pine_lock:
        items = pine_read()
        item = {
            "id": _pine_next_id(),
            "when": time.strftime("%Y-%m-%d %H:%M"),
            "status": "open",
            # ponytail: a body line starting with "## #" could confuse the
            # parser; strip the marker if a user pastes one.
            "text": re.sub(r"(?m)^## #", "##_#", text.strip()),
        }
        items.insert(0, item)          # newest first
        PINE_REQUESTS_PATH.parent.mkdir(parents=True, exist_ok=True)
        PINE_REQUESTS_PATH.write_text(_pine_render(items))
        return item


async def pine_remove(req_id: int) -> dict[str, Any] | None:
    async with _pine_lock:
        items = pine_read()
        found = None
        rest = []
        for it in items:
            if it["id"] == req_id and found is None:
                found = it
            else:
                rest.append(it)
        if found is not None:
            PINE_REQUESTS_PATH.write_text(_pine_render(rest))
        return found


def _comfy_output_files(history: dict[str, Any]) -> list[str]:
    """Flatten a ComfyUI /history response into a newest-first list of output
    image filenames. History is insertion-ordered oldest→newest, so a reversed
    walk with de-dup yields the most recent renders first."""
    files: list[str] = []
    for entry in (history or {}).values():
        outputs = (entry or {}).get("outputs") or {}
        for out in outputs.values():
            if not isinstance(out, dict):
                continue
            # SaveImage lists under "images", SaveVideo under "images" or
            # "video" depending on version — accept any list of outputs.
            for group in out.values():
                if not isinstance(group, list):
                    continue
                for img in group:
                    if (
                        isinstance(img, dict)
                        and img.get("type") == "output"
                        and img.get("filename")
                    ):
                        files.append(str(img["filename"]))
    seen: set[str] = set()
    unique: list[str] = []
    for name in reversed(files):
        if name in seen:
            continue
        if name.lower().endswith(
            (".png", ".jpg", ".jpeg", ".webp", ".mp4", ".webm")
        ):
            seen.add(name)
            unique.append(name)
    return unique


async def _submit_generation(
    tags: str, request_text: str, kind: str = "image"
) -> tuple[str, str]:
    """Submit one render to ComfyUI, record it (with node-graph complexity +
    a start time for the duration stat), and start tracking it. Shared by the
    voice path and the gallery 'regenerate' button. Returns (prompt_id,
    model_name); raises on submit failure."""
    workflow = (
        _comfy_video_workflow(tags) if kind == "video" else _comfy_workflow(tags)
    )
    model_name = _workflow_model_name(workflow)
    complexity = _workflow_complexity(workflow)
    async with httpx.AsyncClient(timeout=15) as client:
        response = await client.post(
            f"{COMFYUI_URL}/prompt", json={"prompt": workflow}
        )
        response.raise_for_status()
        prompt_id = str((response.json() or {}).get("prompt_id") or "")
    started_at = time.time()
    append_generation({
        "ts": int(started_at),
        "request": request_text,
        "tags": tags,
        "model": model_name,
        "prompt_id": prompt_id,
        "files": [],
        "status": "queued",
        "kind": kind,
        "stats": complexity,
    })
    if prompt_id:
        asyncio.create_task(
            _track_generation(prompt_id, started_at, complexity))
    return prompt_id, model_name


def _restyled_request(user_text: str) -> tuple[str, str]:
    """'Do that again but as X' -> previous render's subject + the new style.
    Returns (request_text, restyled_from)."""
    if not is_restyle_request(user_text):
        return user_text, ""
    last = read_generations(1)
    if not last:
        return user_text, ""
    restyled_from = str(last[0].get("request") or last[0].get("tags") or "")
    base_subject = extract_image_prompt(restyled_from)
    return f"{base_subject}. New style: {user_text}", restyled_from


async def _comfy_prompt(user_text: str, settings: dict[str, Any]) -> tuple[str, str]:
    """Final ComfyUI prompt: the literal dictated request first, tags after."""
    request_text, restyled_from = _restyled_request(user_text)
    subject = extract_image_prompt(request_text)
    tags = await image_tags(request_text, settings)
    prompt = subject if subject.lower() == tags.lower() else f"{subject}. {tags}"
    return prompt, restyled_from


async def comfyui_generate(
    user_text: str, settings: dict[str, Any], kind: str = "image"
) -> str:
    prompt, restyled_from = await _comfy_prompt(user_text, settings)
    try:
        _prompt_id, model_name = await _submit_generation(
            prompt, user_text, kind
        )
    except Exception as exc:
        return (
            f"Tell the user the {kind} could not be generated because ComfyUI "
            f"is unavailable or misconfigured. Technical error: {exc}"
        )
    reused = (
        f" It reuses the previous render's subject ('{restyled_from[:120]}') "
        "with the new style applied."
        if restyled_from
        else ""
    )
    took = (
        " Video renders take several minutes." if kind == "video" else ""
    )
    if not settings.get("read_back_prompts", True):
        return (
            f"A {kind} render was submitted to ComfyUI using {model_name}."
            f"{reused} Do NOT reveal the prompt or tag list. Instead, hype it "
            f"up in one short line — something like 'a great {kind} is "
            "cooking, you won't believe what's coming back' — and say it "
            f"will appear in the PineBox gallery when finished.{took}"
        )
    return (
        f"A {kind} render was submitted to ComfyUI using {model_name}. "
        f"The exact prompt sent was: {prompt}.{reused} Tell the user the "
        f"{kind} is rendering now, and read that prompt back to them verbatim "
        "so they know exactly what was requested. It will appear in the "
        f"PineBox gallery when finished.{took}"
    )


# --- Open WebUI passthrough ------------------------------------------------


def is_openwebui_request(text: str) -> bool:
    return bool(re.search(r"\bopen ?web ?ui\b", text, re.IGNORECASE))


def strip_openwebui_prefix(text: str) -> str:
    cleaned = re.sub(
        r"^\s*(please\s+)?(ask|use|send to|query|on)?\s*open ?web ?ui\b"
        r"[:,]?\s*(to\s+|and\s+|for\s+)?",
        "",
        text,
        flags=re.IGNORECASE,
    )
    return cleaned.strip() or text.strip()


async def ask_openwebui(text: str, model: str) -> str:
    query = strip_openwebui_prefix(text)
    headers = {"Content-Type": "application/json"}
    if OPENWEBUI_API_KEY:
        headers["Authorization"] = f"Bearer {OPENWEBUI_API_KEY}"
    try:
        async with httpx.AsyncClient(timeout=120) as client:
            response = await client.post(
                f"{OPENWEBUI_URL}/api/chat/completions",
                headers=headers,
                json={
                    "model": model,
                    "messages": [{"role": "user", "content": query}],
                    "stream": False,
                },
            )
            response.raise_for_status()
            data = response.json()
        answer = data["choices"][0]["message"]["content"]
        return str(answer).strip() or "Open WebUI returned an empty response."
    except Exception as exc:
        return (
            "Open WebUI could not be reached or is not configured. "
            f"Technical error: {exc}"
        )


# --- Mirror conversations into an Open WebUI "Pinebox" folder ---------------

_BG_TASKS: set[Any] = set()


def fire_and_forget_speech(coro: Any) -> None:
    """Speech we can later cancel from the Stop button."""
    try:
        task = asyncio.create_task(coro)
    except RuntimeError:
        return
    _SPEECH_TASKS.add(task)
    task.add_done_callback(_SPEECH_TASKS.discard)


def fire_and_forget(coro: Any) -> None:
    task = asyncio.create_task(coro)
    _BG_TASKS.add(task)
    task.add_done_callback(_BG_TASKS.discard)


def _ow_load_state() -> dict[str, Any]:
    try:
        return json.loads(OPENWEBUI_STATE.read_text())
    except Exception:
        return {}


def _ow_save_state(state: dict[str, Any]) -> None:
    try:
        OPENWEBUI_STATE.parent.mkdir(parents=True, exist_ok=True)
        OPENWEBUI_STATE.write_text(json.dumps(state))
    except Exception:
        pass


async def _ow_folder_id(client: httpx.AsyncClient) -> str | None:
    folders = (await client.get(f"{OPENWEBUI_URL}/api/v1/folders/")).json()
    for folder in folders:
        if folder.get("name") == PINEBOX_FOLDER:
            return folder["id"]
    await client.post(f"{OPENWEBUI_URL}/api/v1/folders/", json={"name": PINEBOX_FOLDER})
    folders = (await client.get(f"{OPENWEBUI_URL}/api/v1/folders/")).json()
    for folder in folders:
        if folder.get("name") == PINEBOX_FOLDER:
            return folder["id"]
    return None


async def mirror_to_openwebui(user_text: str, answer: str, model: str) -> None:
    # Best-effort: log every voice turn into the Open WebUI "Pinebox" folder.
    # ponytail: single rolling chat, read-modify-write per turn, no locking -
    # fine for one sequential speaker; add a lock if it ever runs concurrently.
    if not OPENWEBUI_API_KEY:
        return

    headers = {
        "Authorization": f"Bearer {OPENWEBUI_API_KEY}",
        "Content-Type": "application/json",
    }
    now = int(time.time())
    uid = str(uuid.uuid4())
    aid = str(uuid.uuid4())
    umsg = {
        "id": uid, "parentId": None, "childrenIds": [aid], "role": "user",
        "content": user_text, "timestamp": now, "models": [model],
    }
    amsg = {
        "id": aid, "parentId": uid, "childrenIds": [], "role": "assistant",
        "content": answer, "timestamp": now, "model": model, "modelName": model,
    }

    try:
        async with httpx.AsyncClient(timeout=15, headers=headers) as client:
            state = _ow_load_state()
            folder_id = state.get("folder_id") or await _ow_folder_id(client)
            if not folder_id:
                return

            chat_id = state.get("chat_id")
            fresh = (not chat_id) or (
                now - int(state.get("last_ts", 0)) > PINEBOX_GAP_SECONDS
            )

            if fresh:
                title = " ".join(user_text.split())[:60] or "PineBox conversation"
                chat = {
                    "id": "", "title": f"\U0001f3a4 {title}",
                    "models": [model], "messages": [umsg, amsg],
                    "history": {"currentId": aid, "messages": {uid: umsg, aid: amsg}},
                    "files": [], "tags": [], "timestamp": now * 1000, "params": {},
                }
                created = await client.post(
                    f"{OPENWEBUI_URL}/api/v1/chats/new", json={"chat": chat}
                )
                created.raise_for_status()
                chat_id = created.json().get("id")
                await client.post(
                    f"{OPENWEBUI_URL}/api/v1/chats/{chat_id}/folder",
                    json={"folder_id": folder_id},
                )
            else:
                got = (
                    await client.get(f"{OPENWEBUI_URL}/api/v1/chats/{chat_id}")
                ).json()
                chat = got.get("chat") or {}
                hist = chat.setdefault(
                    "history", {"currentId": None, "messages": {}}
                )
                prev = hist.get("currentId")
                if prev and prev in hist.get("messages", {}):
                    hist["messages"][prev].setdefault("childrenIds", []).append(uid)
                    umsg["parentId"] = prev
                hist.setdefault("messages", {})[uid] = umsg
                hist["messages"][aid] = amsg
                hist["currentId"] = aid
                chat.setdefault("messages", []).extend([umsg, amsg])
                updated = await client.post(
                    f"{OPENWEBUI_URL}/api/v1/chats/{chat_id}", json={"chat": chat}
                )
                updated.raise_for_status()

            state.update({"folder_id": folder_id, "chat_id": chat_id, "last_ts": now})
            _ow_save_state(state)
    except Exception:
        pass  # never let logging affect the voice response


