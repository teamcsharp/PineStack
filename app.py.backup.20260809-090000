@app.put("/api/phrase-sets/{name}")
async def phrase_set_save(
    name: str,
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Save a named set of spoken replies, usable from any session."""
    require_auth(authorization)
    payload = await request.json()

    def clean(raw: Any) -> list[str]:
        return [
            str(x).strip()[:300]
            for x in (raw if isinstance(raw, list) else [])
            if str(x).strip()
        ][:40]

    sets = _read_phrase_sets()
    sets[name[:60]] = {
        "submit_phrases": clean(payload.get("submit_phrases")),
        "complete_phrases": clean(payload.get("complete_phrases")),
        "saved_at": int(time.time()),
    }
    try:
        PHRASE_SETS_PATH.parent.mkdir(parents=True, exist_ok=True)
        PHRASE_SETS_PATH.write_text(json.dumps(sets, indent=1) + "\n")
    except Exception as exc:
        raise HTTPException(status_code=500, detail=str(exc)) from exc
    return {"saved": name[:60], "sets": list(sets)}


