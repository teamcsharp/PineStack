// Every entry maps to a CSS block above. The slug matches the gear corpus
// where there is one, so a theme and its manual line up.
const THEMES = [
  ["", "Pine Box (default)"],
  ["opxy", "teenage engineering OP-XY"],
  ["tp7", "teenage engineering TP-7"],
  ["op1", "teenage engineering OP-1"],
  ["ko2", "EP-133 K.O. II"],
  ["ob4", "OB-4 radio"],
  ["pocketoperator", "Pocket Operator"],
  ["mpc", "Akai MPC"],
  ["sc500", "PortablismGear SC500"],
  ["nes", "Nintendo Entertainment System"],
  ["snes", "Super Nintendo"],
  ["ps1", "Sony PlayStation"],
  ["gameboy", "Game Boy"],
];

function applyTheme(name) {
  const root = document.documentElement;
  if (name) root.setAttribute("data-theme", name);
  else root.removeAttribute("data-theme");
  localStorage.setItem("pineTheme", name || "");
  const label = document.getElementById("themeNow");
  if (label) {
    label.textContent = name
      ? "theme · " + themeName(name)
      : "PineVoice intelligence · Pine Box control";
  }
  // Some themes come with the machine behind them.
  deviceSkin(name || "").catch(() => {});
  // Sleeves bake the palette in, so make the flow repaint.
  if (djFlow) { djFlow.state.signature = ""; }
}

// Sample a theme's palette by asking the stylesheet, rather than keeping a
// second copy of every colour in JavaScript.
let themeSwatchCache = null;

function themeSwatches() {
  if (themeSwatchCache) return themeSwatchCache;
  const root = document.documentElement;
  const had = root.getAttribute("data-theme");
  themeSwatchCache = {};
  THEMES.forEach(([value]) => {
    if (value) root.setAttribute("data-theme", value);
    else root.removeAttribute("data-theme");
    const style = getComputedStyle(root);
    themeSwatchCache[value] = ["--bg", "--panel2", "--accent", "--text"]
      .map((name) => style.getPropertyValue(name).trim());
  });
  if (had) root.setAttribute("data-theme", had);
  else root.removeAttribute("data-theme");
  return themeSwatchCache;
}

function themeName(value) {
  const found = THEMES.find(([id]) => id === (value || ""));
  return found ? found[1] : "Pine Box";
}

function themeMenuClose() {
  const open = document.getElementById("themeMenu");
  if (open) open.remove();
  document.removeEventListener("click", themeMenuAway, true);
}

function themeMenuAway(event) {
  const menu = document.getElementById("themeMenu");
  const title = document.getElementById("appTitle");
  if (!menu) return;
  if (menu.contains(event.target) || title.contains(event.target)) return;
  themeMenuClose();
}

function themeMenu(event) {
  event.stopPropagation();
  if (document.getElementById("themeMenu")) { themeMenuClose(); return; }

  const swatches = themeSwatches();
  const current = localStorage.getItem("pineTheme") || "";
  const anchor = document.getElementById("appTitle").getBoundingClientRect();

  const menu = el("div", "panel", "");
  menu.id = "themeMenu";
  menu.style.cssText = "position:fixed;left:" + Math.round(anchor.left) + "px;"
    + "top:" + Math.round(anchor.bottom + 8) + "px;z-index:140;padding:8px;"
    + "min-width:290px;max-height:70vh;overflow-y:auto;box-shadow:"
    + "0 18px 44px rgba(0,0,0,.55)";

  THEMES.forEach(([value, label]) => {
    const row = el("div", "", "");
    row.style.cssText = "display:flex;align-items:center;gap:10px;"
      + "padding:7px 8px;border-radius:var(--radius-sm);cursor:pointer";
    row.onmouseenter = () => { row.style.background = "var(--panel2)"; };
    row.onmouseleave = () => { row.style.background = ""; };

    const chips = el("span", "", "");
    chips.style.cssText = "flex:0 0 auto;display:flex;border-radius:3px;"
      + "overflow:hidden;border:1px solid var(--border)";
    (swatches[value] || []).forEach((colour) => {
      const chip = document.createElement("span");
      chip.style.cssText = "width:13px;height:16px;background:" + colour;
      chips.appendChild(chip);
    });

    const name = el("span", "", label);
    name.style.cssText = "flex:1;font-size:13px";
    const tick = el("span", "", value === current ? "✓" : "");
    tick.style.cssText = "color:var(--accent);font-size:13px;width:12px";

    row.appendChild(chips);
    row.appendChild(name);
    row.appendChild(tick);
    row.onclick = () => { applyTheme(value); themeMenuClose(); };
    menu.appendChild(row);
  });

  document.body.appendChild(menu);
  // Capture phase, so a click anywhere else closes it before that click acts.
  document.addEventListener("click", themeMenuAway, true);
}

function initThemes() {
  applyTheme(localStorage.getItem("pineTheme") || "");
}

/* ---- Spectrogram (#143) ---- */

// One analyser per media element. Creating a MediaElementSource re-routes the
// element through the graph, so it must be reconnected to the destination or
// the audio goes silent — and it can only be created once per element.
const scopes = new WeakMap();

function audioScope(player) {
  if (!player) return null;
  if (scopes.has(player)) return scopes.get(player);
  try {
    const Ctx = window.AudioContext || window.webkitAudioContext;
    if (!Ctx) return null;
    const context = window.pineAudioCtx || (window.pineAudioCtx = new Ctx());
    const source = context.createMediaElementSource(player);
    const analyser = context.createAnalyser();
    analyser.fftSize = 512;
    analyser.smoothingTimeConstant = 0.78;
    source.connect(analyser);
    analyser.connect(context.destination);
    const scope = {context, analyser, bins: new Uint8Array(analyser.frequencyBinCount)};
    scopes.set(player, scope);
    return scope;
  } catch (error) {
    return null;
  }
}

function drawScope(canvas, player) {
  if (!canvas || !player) return;
  const scope = audioScope(player);
  const ctx = canvas.getContext("2d");
  const width = canvas.width = canvas.clientWidth * (window.devicePixelRatio || 1);
  const height = canvas.height = canvas.clientHeight * (window.devicePixelRatio || 1);
  ctx.clearRect(0, 0, width, height);
  if (!scope) return;
  if (scope.context.state === "suspended" && !player.paused) {
    scope.context.resume().catch(() => {});
  }

  scope.analyser.getByteFrequencyData(scope.bins);
  const bars = 64;
  const step = Math.floor(scope.bins.length / bars);
  const barWidth = width / bars;
  const accent = getComputedStyle(document.documentElement)
    .getPropertyValue("--accent").trim() || "#4bb3ff";

  for (let i = 0; i < bars; i++) {
    let sum = 0;
    for (let j = 0; j < step; j++) sum += scope.bins[i * step + j];
    const level = (sum / step) / 255;
    const barHeight = Math.max(1, level * height * 0.94);
    const gradient = ctx.createLinearGradient(0, height, 0, height - barHeight);
    gradient.addColorStop(0, accent);
    gradient.addColorStop(1, "rgba(255,255,255,.85)");
    ctx.fillStyle = gradient;
    ctx.globalAlpha = 0.35 + level * 0.65;
    ctx.fillRect(i * barWidth + 1, height - barHeight,
                 Math.max(1, barWidth - 2), barHeight);
  }
  ctx.globalAlpha = 1;
}

function scopeLoop() {
  drawScope(document.getElementById("musicScope"),
            document.getElementById("musicPlayer"));
  drawScope(document.getElementById("boothScope"),
            document.getElementById("musicPlayer"));
  requestAnimationFrame(scopeLoop);
}

/* ---- The now-playing stage (#148) ---- */

let stage = null;

async function stageStart() {
  const host = document.getElementById("nowStage");
  if (!host || stage) return;
  const THREE = await import("/vendor/three.module.js");

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
  camera.position.set(0, 0.35, 6.2);
  const renderer = new THREE.WebGLRenderer({antialias: true, alpha: true});
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(host.clientWidth, host.clientHeight);
  host.appendChild(renderer.domElement);

  scene.add(new THREE.AmbientLight(0xa8c0e0, 0.9));
  const key = new THREE.DirectionalLight(0xffffff, 1.4);
  key.position.set(3, 5, 6);
  scene.add(key);

  const pivot = new THREE.Group();
  scene.add(pivot);
  const sleeve = new THREE.Mesh(
    new THREE.PlaneGeometry(3.5, 3.5),
    new THREE.MeshStandardMaterial({roughness: 0.6, metalness: 0.05}));
  pivot.add(sleeve);

  // The sheen belongs to the album, not to the window (#150): a plane the
  // exact size of the sleeve, carrying a repeating diagonal gradient whose
  // offset is animated. Because the geometry matches the art, the band is
  // clipped to the artwork instead of sweeping across the whole scene.
  const sheenCanvas = document.createElement("canvas");
  sheenCanvas.width = 256;
  sheenCanvas.height = 256;
  const sheenCtx = sheenCanvas.getContext("2d");
  const band = sheenCtx.createLinearGradient(0, 0, 256, 256);
  band.addColorStop(0.00, "rgba(255,255,255,0)");
  band.addColorStop(0.38, "rgba(255,255,255,0)");
  band.addColorStop(0.46, "rgba(255,255,255,.55)");
  band.addColorStop(0.50, "rgba(255,255,255,.95)");
  band.addColorStop(0.54, "rgba(255,255,255,.55)");
  band.addColorStop(0.62, "rgba(255,255,255,0)");
  band.addColorStop(1.00, "rgba(255,255,255,0)");
  sheenCtx.fillStyle = band;
  sheenCtx.fillRect(0, 0, 256, 256);

  const sheenTexture = new THREE.CanvasTexture(sheenCanvas);
  sheenTexture.wrapS = THREE.RepeatWrapping;
  sheenTexture.wrapT = THREE.ClampToEdgeWrapping;

  const sheen = new THREE.Mesh(
    new THREE.PlaneGeometry(3.5, 3.5),
    new THREE.MeshBasicMaterial({
      map: sheenTexture, transparent: true, opacity: 0.0,
      blending: THREE.AdditiveBlending, depthWrite: false}));
  sheen.position.z = 0.01;
  pivot.add(sheen);

  let frame = 0;
  let sweepAt = performance.now() + 2500;
  let sweep = -1;
  let phase = "idle";     // idle | out | in
  let phaseAt = 0;
  let pending = null;

  const resize = new ResizeObserver(() => {
    if (!host.clientWidth) return;
    camera.aspect = host.clientWidth / Math.max(1, host.clientHeight);
    camera.updateProjectionMatrix();
    renderer.setSize(host.clientWidth, host.clientHeight);
  });
  resize.observe(host);

  function setSleeve(track) {
    const material = sleeve.material;
    const apply = (texture) => {
      if (material.map) material.map.dispose();
      material.map = texture;
      material.needsUpdate = true;
    };
    apply(boothSleeveTexture(THREE, track));
    if (track.art) {
      new THREE.TextureLoader().load(track.art, (texture) => {
        texture.colorSpace = THREE.SRGBColorSpace;
        apply(texture);
      }, undefined, () => {});
    }
  }

  function tick(now) {
    frame = requestAnimationFrame(tick);

    if (phase === "idle") {
      // Breathing, and a slow drift so it never looks frozen.
      const t = now / 1000;
      const breathe = 1 + Math.sin(t * 1.25) * 0.022;
      pivot.scale.set(breathe, breathe, 1);
      pivot.rotation.y = Math.sin(t * 0.5) * 0.16;
      pivot.rotation.x = Math.sin(t * 0.37) * 0.06;
      pivot.position.y = Math.sin(t * 0.8) * 0.05;

      if (now > sweepAt) { sweep = 0; sweepAt = now + 3000 + Math.random() * 2000; }
      if (sweep >= 0) {
        sweep += 0.022;
        // Slide the gradient through the sleeve's own UVs — the highlight
        // travels across the artwork and stops at its edges.
        sheenTexture.offset.x = -0.6 + sweep * 1.2;
        sheen.material.opacity = Math.sin(Math.min(1, sweep) * Math.PI) * 0.5;
        if (sweep > 1) { sweep = -1; sheen.material.opacity = 0; }
      }
    } else if (phase === "out") {
      // Lie down, then roll out of the way.
      const t = Math.min(1, (now - phaseAt) / 620);
      pivot.rotation.x = -t * Math.PI / 2;
      pivot.position.y = -t * 0.6;
      pivot.position.x = -t * t * 5.5;
      if (t >= 1) {
        if (pending) setSleeve(pending);
        phase = "in";
        phaseAt = now;
        pivot.position.x = 5.5;
      }
    } else if (phase === "in") {
      // The next one arrives and flips up into place.
      const t = Math.min(1, (now - phaseAt) / 620);
      const ease = 1 - Math.pow(1 - t, 3);
      pivot.position.x = 5.5 * (1 - ease);
      pivot.position.y = -0.6 * (1 - ease);
      pivot.rotation.x = -(Math.PI / 2) * (1 - ease);
      pivot.rotation.y = (1 - ease) * 0.9;
      if (t >= 1) { phase = "idle"; pending = null; }
    }

    renderer.render(scene, camera);
  }
  frame = requestAnimationFrame(tick);

  stage = {
    show(track) {
      if (!track || !track.id) return;
      if (stage.id === track.id) return;
      const first = !stage.id;
      stage.id = track.id;
      if (first) { setSleeve(track); return; }
      pending = track;
      phase = "out";
      phaseAt = performance.now();
    },
    id: "",
    stop() {
      cancelAnimationFrame(frame);
      resize.disconnect();
      renderer.dispose();
      host.textContent = "";
    },
  };
}

// The tag sheet beside the stage.
async function stageSheet(track) {
  const host = document.getElementById("nowSheet");
  if (!host || !track || !track.id) return;
  if (host.dataset.id === track.id) return;
  host.dataset.id = track.id;
  try {
    const info = await api("/api/music/track/" + track.id);
    host.textContent = "";
    const head = el("b", "", info.title || "");
