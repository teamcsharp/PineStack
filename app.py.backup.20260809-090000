def validate_settings(data: Any) -> dict[str, Any]:
    if not isinstance(data, dict):
        raise ValueError("Settings must be an object")

    prompts = data.get("prompts")

    if not isinstance(prompts, list) or not prompts:
        raise ValueError("At least one system prompt is required")

    normalized_prompts: list[dict[str, str]] = []
    names: set[str] = set()

    for item in prompts:
        if not isinstance(item, dict):
            raise ValueError("Every prompt must be an object")

        name = str(item.get("name") or "").strip()
        prompt = str(item.get("prompt") or "").strip()

        if not name:
            raise ValueError("Every prompt requires a name")

        if not prompt:
            raise ValueError(f'Prompt "{name}" has no prompt text')

        if name in names:
            raise ValueError(f'Duplicate prompt name: "{name}"')

        names.add(name)
        normalized_prompts.append(
            {
                "name": name[:100],
                "prompt": prompt[:20000],
            }
        )

    try:
        active_prompt = int(data.get("active_prompt", 0))
    except (TypeError, ValueError):
        active_prompt = 0

    active_prompt %= len(normalized_prompts)

    model = str(data.get("model") or "qwen3:14b").strip()
    temperature = float(data.get("temperature", 0.55))
    top_p = float(data.get("top_p", 0.9))
    max_tokens = int(data.get("max_tokens", 120))
    num_ctx = int(data.get("num_ctx", 8192))

    raw_replies = data.get("render_replies", DEFAULT_SETTINGS["render_replies"])
    render_replies: list[str] = []
    if isinstance(raw_replies, list):
        for item in raw_replies:
            text = str(item or "").strip()
            if text:
                render_replies.append(text[:300])
    render_replies = render_replies[:30]

    raw_voice = data.get("voice_out") or {}
    engine = str(raw_voice.get("engine") or "ha")
    voice_out = {
        "engine": engine if engine in VOICE_ENGINES else "ha",
        "ha_token": str(raw_voice.get("ha_token") or "")[:300],
        "media_player": str(raw_voice.get("media_player") or "")[:200],
        "voice": str(raw_voice.get("voice") or "")[:100],
        "event_voices": {
            k: str(v or "")[:100]
            for k, v in (raw_voice.get("event_voices") or {}).items()
            if k in ("default", "submit", "complete", "render", "doc", "alert")
        },
        "personality_prefix": str(raw_voice.get("personality_prefix") or "")[:200],
        "personality_suffix": str(raw_voice.get("personality_suffix") or "")[:200],
        # The lines the header's test button speaks, in order. Each may name
        # the event voice it should use: "alert|Something is wrong."
        "test_sequence": [
            str(line or "")[:300]
            for line in (raw_voice.get("test_sequence") or [])
            if str(line or "").strip()
        ][:12] or list(DEFAULT_TEST_SEQUENCE),
    }

    raw_dj = data.get("dj") or {}

    def dj_lines(key: str) -> list[str]:
        lines = [
            str(line or "").strip()[:300]
            for line in (raw_dj.get(key) or [])
            if str(line or "").strip()
        ][:40]
        return lines or list(DEFAULT_DJ[key])

    def dj_float(key: str) -> float:
        try:
            return max(0.0, min(1.0, float(raw_dj.get(key, DEFAULT_DJ[key]))))
        except (TypeError, ValueError):
            return float(DEFAULT_DJ[key])

    dj = {
        "station_name": str(
            raw_dj.get("station_name") or DEFAULT_DJ["station_name"])[:60],
        "persona": str(raw_dj.get("persona") or DEFAULT_DJ["persona"])[:2000],
        "voice": str(raw_dj.get("voice") or "")[:100],
        "intro_phrases": dj_lines("intro_phrases"),
        "open_phrases": dj_lines("open_phrases"),
        "station_ids": dj_lines("station_ids"),
        "request_phrases": dj_lines("request_phrases"),
        "interject_phrases": dj_lines("interject_phrases"),
        "sponsors": [
            str(s or "").strip()[:200]
            for s in (raw_dj.get("sponsors") or []) if str(s or "").strip()
        ][:20],
        "interject_rate": dj_float("interject_rate"),
        "chattiness": dj_float("chattiness"),
        "station_id_every": max(0, min(20, int(
            raw_dj.get("station_id_every") or DEFAULT_DJ["station_id_every"]))),
        "ad_every": max(0, min(50, int(
            raw_dj.get("ad_every", DEFAULT_DJ["ad_every"]) or 0))),
        "gallery_ads": bool(raw_dj.get("gallery_ads", True)),
        "ad_price_low": max(1, int(
            raw_dj.get("ad_price_low") or DEFAULT_DJ["ad_price_low"])),
        "ad_price_high": max(2, int(
            raw_dj.get("ad_price_high") or DEFAULT_DJ["ad_price_high"])),
        "research": bool(raw_dj.get("research", True)),
        "cohost_name": str(
            raw_dj.get("cohost_name") or DEFAULT_DJ["cohost_name"])[:40],
        "cohost_persona": str(
            raw_dj.get("cohost_persona") or DEFAULT_DJ["cohost_persona"])[:2000],
        "cohost_voice": str(raw_dj.get("cohost_voice") or "")[:100],
        "banter": bool(raw_dj.get("banter", True)),
        "banter_every": max(0, min(20, int(
            raw_dj.get("banter_every", DEFAULT_DJ["banter_every"]) or 0))),
        "art_lookup": bool(raw_dj.get("art_lookup", True)),
        "art_search": bool(raw_dj.get("art_search", False)),
    }

    raw_pc = data.get("pine_chat") or {}
    pc_default = DEFAULT_SETTINGS["pine_chat"]

    def phrase_list(raw: Any, fallback: str) -> list[str]:
        out: list[str] = []
        for item in raw if isinstance(raw, list) else []:
            text = str(item or "").strip()
            if text:
                out.append(text[:300])
        return out[:30] or ([fallback] if fallback else [])

    pine_chat = {
        "submit_phrase": str(
            raw_pc.get("submit_phrase") or pc_default["submit_phrase"]
        )[:300],
        "complete_phrase": str(
            raw_pc.get("complete_phrase") or pc_default["complete_phrase"]
        )[:300],
        # Several alternatives, spoken at random; the singular fields above
        # stay as the fallback so older clients keep working.
        "submit_phrases": phrase_list(
            raw_pc.get("submit_phrases"),
            str(raw_pc.get("submit_phrase") or pc_default["submit_phrase"]),
        ),
        "complete_phrases": phrase_list(
            raw_pc.get("complete_phrases"),
            str(raw_pc.get("complete_phrase") or pc_default["complete_phrase"]),
        ),
        "behavior": str(raw_pc.get("behavior") or "")[:4000],
    }

    return {
        "active_prompt": active_prompt,
        "model": model or "qwen3:14b",
        "temperature": max(0.0, min(2.0, temperature)),
        "top_p": max(0.0, min(1.0, top_p)),
        "max_tokens": max(20, min(1000, max_tokens)),
        "web_search": bool(data.get("web_search", True)),
        "game_search": bool(data.get("game_search", True)),
        "gear_manuals": bool(data.get("gear_manuals", True)),
        "read_back_prompts": bool(data.get("read_back_prompts", True)),
        "conversation_memory": bool(data.get("conversation_memory", True)),
        "long_term_memory": bool(data.get("long_term_memory", True)),
        "openwebui_logging": bool(data.get("openwebui_logging", True)),
        "num_ctx": max(2048, min(32768, num_ctx)),
        "render_replies": render_replies,
        "voice_out": voice_out,
        "dj": dj,
        "pine_chat": pine_chat,
        "prompts": normalized_prompts,
    }


# (mtime, size, parsed) — re-read only when the file actually changes.
_SETTINGS_CACHE: dict[str, Any] = {"key": None, "value": None}


def load_settings() -> dict[str, Any]:
    with SETTINGS_LOCK:
        try:
            stat = SETTINGS_PATH.stat()
            key = (stat.st_mtime_ns, stat.st_size)
            if _SETTINGS_CACHE["key"] == key:
                return _SETTINGS_CACHE["value"]
        except Exception:
            key = None

        try:
            raw = json.loads(SETTINGS_PATH.read_text())
            parsed = validate_settings(raw)
            if key is not None:
                _SETTINGS_CACHE.update({"key": key, "value": parsed})
            return parsed
        except Exception:
            SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
            save_settings(DEFAULT_SETTINGS)
            return validate_settings(DEFAULT_SETTINGS)


def save_settings(data: Any) -> dict[str, Any]:
    normalized = validate_settings(data)

    with SETTINGS_LOCK:
        SETTINGS_PATH.parent.mkdir(parents=True, exist_ok=True)
        temporary = SETTINGS_PATH.with_suffix(".tmp")
        temporary.write_text(
            json.dumps(normalized, indent=2) + "\n"
        )
        temporary.replace(SETTINGS_PATH)
        _SETTINGS_CACHE.update({"key": None, "value": None})

    return normalized


def latest_user_text(messages: list[dict[str, Any]]) -> str:
    for message in reversed(messages):
        if message.get("role") != "user":
            continue

        content = message.get("content")

        if isinstance(content, str):
            return content.strip()

    return ""


