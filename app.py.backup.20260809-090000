/* ================= Live activity: filmstrip + toasts ================= */
/* Reads are open, so this runs on any computer with no key required. */

let lastGenerations = [];
let lastComfyFiles = [];
let filmSignature = "";
let filmItemCount = 0;
let prevFilmFiles = new Set();
const genStatus = {};
let historyBaselineTs = null;
const seenTurnKeys = new Set();
let lastToastAt = 0;

function activityImages() {
  // Merge PineBox generations (with prompt captions) and raw ComfyUI
  // outputs, newest first, de-duped by filename. Generations win so their
  // captions/models survive the merge.
  const byFile = new Map();
  (lastGenerations || []).forEach((g) => {
    const f = (g.files || [])[0];
    if (f && !byFile.has(f)) {
      byFile.set(f, {
        f: f,
        cap: g.tags || g.request || "",
        model: g.model || "",
        ts: g.ts || 0,
      });
    }
  });
  (lastComfyFiles || []).forEach((f) => {
    if (f && !byFile.has(f)) byFile.set(f, { f: f, cap: "", model: "", ts: 0 });
  });
  return [...byFile.values()].slice(0, 24);
}

function currentFilmScale() {
  const v = parseFloat(localStorage.getItem("filmScale"));
  return v > 0 ? v : 4;   // default: 4× bigger
}

function applyFilmScale(scale) {
  scale = Math.max(1, Math.min(6, scale || 4));
  document.documentElement.style.setProperty("--film-scale", scale);
  const track = document.getElementById("filmTrack");
  if (track && filmItemCount) {
    // Keep the scroll SPEED constant as size changes: a bigger (wider) strip
    // gets a proportionally longer cycle so pixels/second stays readable.
    track.style.animationDuration =
      Math.max(24, Math.round(filmItemCount * 4 * scale)) + "s";
  }
  const out = document.getElementById("filmScaleVal");
  if (out) out.textContent = scale + "×";
}

function buildFilmstrip() {
  const items = activityImages();
  const sig = items.map((i) => i.f).join(",");
  if (sig === filmSignature) return;
  filmSignature = sig;

  const track = document.getElementById("filmTrack");
  const count = document.getElementById("actCount");
  if (!items.length) {
    filmItemCount = 0;
    track.style.animation = "none";
    track.innerHTML =
      '<div class="film-empty">Images you generate will scroll by here…</div>';
    count.textContent = "";
    return;
  }
  count.textContent = items.length + " images";
  // Animate ONLY genuinely-new images (not every image on first load).
  const firstBuild = prevFilmFiles.size === 0;
  // Duplicate the sequence so the marquee loops seamlessly (0 → -50%).
  track.innerHTML = "";
  const addCells = () =>
    items.forEach((it, idx) => {
      const cell = document.createElement("div");
      cell.className = "film-item";
      if (!firstBuild && !prevFilmFiles.has(it.f)) cell.classList.add("enter");
      cell.title = it.cap || it.f;
      const img = mediaElement(it.f);
      fetchImageInto(img, it.f);
      cell.appendChild(img);
      if (idx === 0) {
        // items[0] is the newest render — always badge it "NEW".
        const badge = document.createElement("div");
        badge.className = "newbadge";
        badge.textContent = "NEW";
        cell.appendChild(badge);
      }
      cell.onclick = () => openFilmLightbox(it);
      track.appendChild(cell);
    });
  addCells();
  addCells();
  prevFilmFiles = new Set(items.map((i) => i.f));
  filmItemCount = items.length;
  track.style.animation = "scroll-film 60s linear infinite";
  applyFilmScale(currentFilmScale());
}

function openFilmLightbox(it) {
  showLightbox(it.f, it);
}

// Manual rescue for a stalled/blank strip: drop the cached blob URLs (dead
// after a ComfyUI restart or a key change), force a full rebuild, restart
// the marquee animation, and reload the grid below.
async function refreshFilmstrip() {
  const btn = document.getElementById("filmRefresh");
  if (btn) { btn.disabled = true; btn.textContent = "↻ Refreshing…"; }
  Object.keys(galleryURLs).forEach((f) => {
    try { URL.revokeObjectURL(galleryURLs[f]); } catch (e) {}
    delete galleryURLs[f];
  });
  filmSignature = "";
  prevFilmFiles = new Set();
  const track = document.getElementById("filmTrack");
  if (track) track.style.animation = "none";   // so the re-set below restarts it
  try {
    await refreshActivityImages();
    loadGallery();
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = "↻ Refresh gallery"; }
  }
}

function updateActivityStatus() {
  const el = document.getElementById("actStatus");
  const rendering = (lastGenerations || []).find((g) => g.status === "queued");
  el.innerHTML = "";
  if (rendering) {
    const b = document.createElement("span");
    b.className = "busy";
    b.textContent = "● Rendering image";
    el.appendChild(b);
    el.appendChild(
      document.createTextNode(
        " · " + (rendering.tags || rendering.request || "")
      )
    );
    return;
  }
  if (Date.now() - lastToastAt < 9000) {
    const b = document.createElement("span");
    b.className = "busy";
    b.textContent = "● Responding";
    el.appendChild(b);
    return;
  }
  el.textContent = "Idle · listening for Pine Box activity";
}

async function refreshActivityImages() {
  try {
    lastGenerations = (await api("/api/generations?limit=60")).generations || [];
  } catch (error) {
    /* keep last */
  }
  try {
    lastComfyFiles = (await api("/api/comfy-outputs?limit=60")).files || [];
  } catch (error) {
    /* keep last */
  }
  trackGenerationEvents();
  buildFilmstrip();
  updateActivityStatus();
}

function trackGenerationEvents() {
  // Log a "render complete" console line the moment a generation flips to
  // done. First sighting of each id is baselined silently so old renders
  // don't replay on load.
  (lastGenerations || []).forEach((g) => {
    const id = g.prompt_id || String(g.ts || "");
    const prev = genStatus[id];
    if (prev === undefined) {
      genStatus[id] = g.status;
      return;
    }
    if (prev !== "done" && g.status === "done" && (g.files || []).length) {
      consoleAddRender(g);
    }
    genStatus[id] = g.status;
  });
}

function typewriter(node, text, delayMs) {
  let i = 0;
  const step = () => {
    i += 2;
    node.textContent = text.slice(0, i);
    if (i < text.length) setTimeout(step, delayMs);
  };
  step();
}

function showToast(turn) {
  const host = document.getElementById("toasts");
  const el = document.createElement("div");
  el.className = "toast";

  const q = document.createElement("div");
  q.className = "q";
  const who = document.createElement("span");
  who.className = "who";
  who.textContent =
    "You asked" + (turn.model ? " · " + turn.model : "");
  const qtext = document.createElement("span");
  qtext.textContent = turn.user || "(image request)";
  q.appendChild(who);
  q.appendChild(qtext);

  const a = document.createElement("div");
  a.className = "a";
  el.appendChild(q);
  el.appendChild(a);

  if (turn.prompt) {
    const badge = document.createElement("div");
    badge.className = "badge";
    badge.textContent = turn.prompt;
    el.appendChild(badge);
  }

  host.appendChild(el);
  requestAnimationFrame(() => el.classList.add("in"));
  typewriter(a, turn.answer || "", 22);
  lastToastAt = Date.now();
  updateActivityStatus();

  const life = Math.min(18000, 7000 + (turn.answer || "").length * 26);
  setTimeout(() => {
    el.classList.remove("in");
    el.classList.add("out");
    setTimeout(() => el.remove(), 600);
  }, life);

  while (host.children.length > 4) host.removeChild(host.firstChild);
  // A query may have just produced an image — refresh soon to catch it.
  setTimeout(refreshActivityImages, 6000);
}

/* ---- Behind-the-scenes activity console ---- */

function clearConsolePlaceholder() {
  const empty = document.querySelector("#consoleFeed .cx-empty");
  if (empty) empty.remove();
}

function featClass(feature) {
  if (feature.indexOf("image") >= 0) return "img";
  if (feature.indexOf("web") >= 0 || feature.indexOf("weather") >= 0)
    return "web";
  if (feature.indexOf("memory") >= 0) return "mem";
  return "";
}

function findGenForTurn(turn) {
  // Correlate an image-generation turn to its generation record by timestamp.
  if (!(turn.features || []).some((f) => f.indexOf("image") >= 0)) return null;
  let best = null;
  let bestDelta = 1e9;
  (lastGenerations || []).forEach((g) => {
    const d = Math.abs((g.ts || 0) - (turn.ts || 0));
    if (d < 180 && d < bestDelta) {
      best = g;
      bestDelta = d;
    }
  });
  return best;
}

function updateConsoleMarquee() {
  const mq = document.querySelector(".cx-marquee span");
  if (!mq) return;
  const entries = Array.from(document.querySelectorAll("#consoleFeed .cx-entry"))
    .slice(-8).reverse();
  const lines = entries.map((entry) => {
    const q = entry.querySelector(".cx-q");
    const reply = entry.querySelector(".cx-reply");
    const head = entry.querySelector(".cx-head span");
    return ((head && head.textContent) || "") + " " +
      ((q && q.textContent) || (reply && reply.textContent) || "").slice(0, 90);
  }).filter((l) => l.trim());
  const text = lines.join("   ·   ") || "watching Pine Box activity…";
  // Doubled so the loop never shows a gap.
  mq.textContent = text + "   ·   " + text;
}

function trimAndScrollConsole(feed) {
  while (feed.children.length > 60) feed.removeChild(feed.firstChild);
  feed.scrollTop = feed.scrollHeight;
}

function consoleAddTurn(turn) {
  lastReplyText = turn.answer || lastReplyText;
  const feed = document.getElementById("consoleFeed");
  clearConsolePlaceholder();
  const entry = document.createElement("div");
  entry.className = "cx-entry";

  const head = document.createElement("div");
  head.className = "cx-head";
  const label = document.createElement("span");
  label.textContent = "▸ QUERY";
  const time = document.createElement("span");
  time.className = "cx-time";
  time.textContent = new Date((turn.ts || 0) * 1000).toLocaleTimeString();
  head.appendChild(label);
  head.appendChild(time);
  entry.appendChild(head);

  const q = document.createElement("div");
  q.className = "cx-q";
  q.textContent = turn.user || "(voice image request)";
  q.style.cursor = "pointer";
  q.title = "Show what this referenced";
  q.onclick = () => {
    const feats2 = turn.features || [];
    if (feats2.some((f) => f.indexOf("gear") >= 0)) openDocBrowser(null, 0, true);
    else if (feats2.some((f) => f.indexOf("memory") >= 0)) openMemoryPopup();
    else if (feats2.some((f) => f.indexOf("image") >= 0)) showLastRender();
    else openModelPopup(turn);
  };
  entry.appendChild(q);

  const feats = turn.features || [];
  if (feats.length || turn.model) {
    const steps = document.createElement("div");
    steps.className = "cx-steps";
    feats.forEach((f) => {
      const chip = document.createElement("span");
      chip.className = "cx-chip " + featClass(f);
      chip.textContent = f;
      chip.style.cursor = "pointer";
      chip.onclick = () => {
        if (f.indexOf("memory") >= 0) openMemoryPopup();
        else if (f.indexOf("gear") >= 0) openDocBrowser(null, 0, true);
        else if (f.indexOf("image") >= 0 || f.indexOf("video") >= 0)
          showLastRender();
        else openModelPopup(turn);
      };
      steps.appendChild(chip);
    });
    if (turn.model) {
      const chip = document.createElement("span");
      chip.className = "cx-chip";
      chip.textContent = turn.model;
      chip.style.cursor = "pointer";
      chip.onclick = () => openModelPopup(turn);
      steps.appendChild(chip);
    }
    entry.appendChild(steps);
  }

  const gen = turn._gen;
  if (gen && gen.tags) {
    const tags = document.createElement("div");
    tags.className = "cx-tags";
    tags.textContent = "tags → " + gen.tags;
    entry.appendChild(tags);
  }

  const reply = document.createElement("div");
  reply.className = "cx-reply";
  entry.appendChild(reply);
  feed.appendChild(entry);
  typewriter(reply, turn.answer || "", 16);
  trimAndScrollConsole(feed);
  bumpBadge(feed);
  updateConsoleMarquee();
}

// A name pulled from the request itself — "mobsters extorting a trout",
// not another anonymous "Render delivered" (#71).
function genLabel(g) {
  const text = (g.request || g.tags || "").replace(/\s+/g, " ").trim();
  const words = text.split(" ").slice(0, 6).join(" ");
  return words ? words.slice(0, 60) : "Render delivered";
}

function consoleAddRender(g) {
  trayPush(isVideoFile((g.files || [])[0]) ? "video" : "image", genLabel(g),
    "Render delivered",
    () => { const f = (g.files || [])[0]; if (f) showLightbox(f, g); },
    {file: (g.files || [])[0], gen: {tags: g.tags, request: g.request}});
  const feed = document.getElementById("consoleFeed");
  clearConsolePlaceholder();
  const entry = document.createElement("div");
  entry.className = "cx-entry";

  const head = document.createElement("div");
  head.className = "cx-head render";
  const label = document.createElement("span");
  label.textContent = "✓ IMAGE DELIVERED";
  const time = document.createElement("span");
  time.className = "cx-time";
  time.textContent = new Date().toLocaleTimeString();
  head.appendChild(label);
  head.appendChild(time);
  entry.appendChild(head);

  const line = document.createElement("div");
  line.className = "cx-tags";
  const file = (g.files || [])[0] || "";
  line.textContent =
    (g.model ? g.model + " · " : "") + file + (g.tags ? " · " + g.tags : "");
  entry.appendChild(line);

  feed.appendChild(entry);
  trimAndScrollConsole(feed);
}

