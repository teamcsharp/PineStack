@app.post("/api/conversations/title")
async def conversation_title(
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """One short title summarising a conversation."""
    require_auth(authorization)
    payload = await request.json()
    turns = payload.get("turns") or []
    sample = "\n".join(
        f"You: {str(t.get('user') or '')[:200]}\n"
        f"Pine: {str(t.get('answer') or '')[:200]}"
        for t in turns[:6]
    )[:4000]
    if not sample.strip():
        return {"title": "Empty conversation"}
    settings = load_settings()
    try:
        result = await call_ollama(
            model=settings["model"],
            messages=[
                {"role": "system", "content":
                 "You name conversations. Reply with a 2-5 word label for "
                 "what the conversation is about — like a file name. Never "
                 "reply with a sentence, never copy wording from the "
                 "conversation, never add quotes or punctuation.\n"
                 "Examples:\n"
                 "chat about the OP-XY filter -> OP-XY filter section\n"
                 "asking to render a duck picture -> Duck image render\n"
                 "questions about war news -> Iran war update"},
                {"role": "user", "content": sample},
            ],
            temperature=0.3,
            max_tokens=24,
            num_ctx=4096,
        )
        title = " ".join(
            str(result.get("message", {}).get("content") or "").split()
        ).strip().strip('"').rstrip(".")
        if _title_is_sane(title, sample):
            return {"title": title}
    except Exception:
        pass
    return {"title": _fallback_title(turns)}


_TITLE_NOISE = re.compile(
    r"^(generate|make|create|show|give|tell|find|play|render|draw)\s+"
    r"(me\s+|us\s+)?(an?\s+|the\s+|some\s+)?",
    re.IGNORECASE,
)


def _title_is_sane(title: str, sample: str) -> bool:
    """Reject sentences and echoes of the conversation itself."""
    if not title or len(title) > 60:
        return False
    words = title.split()
    if not 1 < len(words) <= 8:
        return False
    if _TAG_JUNK.search(title):
        return False
    # An echo: most of the title lifted verbatim from the text it summarises.
    return title.lower() not in sample.lower()


def _fallback_title(turns: list[dict[str, Any]]) -> str:
    first = str((turns[0] or {}).get("user") or "").strip()
    if not first:
        return "Conversation"
    trimmed = _TITLE_NOISE.sub("", first)
    words = trimmed.split()[:6]
    label = " ".join(words).strip(" ,.?!")
    return (label[:1].upper() + label[1:]) if label else first[:50]


