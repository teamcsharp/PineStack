/* ---- Preset voice sequence (#98) ---- */

// Speaks the saved sequence line by line. Each line may carry the event voice
// it should use, as "event|line", so one press walks the whole chain.
let voicePresetBusy = false;

async function voicePresetRun() {
  if (voicePresetBusy) return;
  const button = document.getElementById("voicePresetBtn");
  voicePresetBusy = true;
  const was = button.textContent;
  try {
    const settings = await api("/api/settings");
    const lines = ((settings.voice_out || {}).test_sequence) || [];
    if (!lines.length) { setStatus("No test sequence saved."); return; }

    for (let i = 0; i < lines.length; i++) {
      const raw = String(lines[i]);
      const cut = raw.indexOf("|");
      const event = cut > 0 ? raw.slice(0, cut).trim() : "default";
      const text = (cut > 0 ? raw.slice(cut + 1) : raw).trim();
      if (!text) continue;
      button.textContent = (i + 1) + "/" + lines.length;
      setStatus("Speech test " + (i + 1) + "/" + lines.length + " · " + event);
      const result = await api("/api/say", {
        method: "POST", body: JSON.stringify({text, event}),
      });
      speakResult(result);
      // Let each line land before the next; a file engine knows its own
      // length, the HA engine does not, so estimate from the text.
      await new Promise((done) => setTimeout(done, 900 + text.length * 55));
    }
    setStatus("Speech test finished — " + lines.length + " lines.");
  } catch (error) {
    setStatus(error.message, true);
  } finally {
    button.textContent = was;
    voicePresetBusy = false;
  }
}

