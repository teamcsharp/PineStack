    return "-".join(significant)[:120] or "misc"


def library_get(key: str) -> dict[str, Any] | None:
    try:
        return json.loads((CHEATS_DIR / f"{key}.json").read_text())
    except Exception:
        return None


def library_put(key: str, entry: dict[str, Any]) -> None:
    # Best-effort: never break the answer over a write failure.
    try:
        CHEATS_DIR.mkdir(parents=True, exist_ok=True)
        path = CHEATS_DIR / f"{key}.json"
        tmp = path.with_suffix(".tmp")
        tmp.write_text(json.dumps(entry, indent=2) + "\n")
        tmp.replace(path)
    except Exception:
        pass


class _TextExtractor(HTMLParser):
    _SKIP = {"script", "style", "head", "nav", "footer", "noscript", "svg"}

    def __init__(self) -> None:
        super().__init__()
        self._parts: list[str] = []
        self._skip_depth = 0

    def handle_starttag(self, tag: str, attrs: Any) -> None:
        if tag in self._SKIP:
            self._skip_depth += 1

    def handle_endtag(self, tag: str) -> None:
        if tag in self._SKIP and self._skip_depth:
            self._skip_depth -= 1

    def handle_data(self, data: str) -> None:
        if self._skip_depth == 0:
            text = data.strip()
            if text:
                self._parts.append(text)

    def text(self) -> str:
        return re.sub(r"\s+", " ", " ".join(self._parts)).strip()


def html_to_text(html_str: str) -> str:
    # ponytail: stdlib HTMLParser strip; upgrade to beautifulsoup4/trafilatura
    # only if boilerplate noise degrades answers.
    parser = _TextExtractor()
    try:
        parser.feed(html_str)
    except Exception:
        pass
    return parser.text()


FETCH_HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
        "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    ),
    "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
    "Accept-Language": "en-US,en;q=0.9",
}


_PAGE_IMG_RE = re.compile(
    r'<(?:img[^>]+src|meta[^>]+property="og:image"[^>]+content)'
    r'="(https?://[^"]+?\.(?:png|jpe?g|webp)(?:\?[^"]*)?)"',
    re.IGNORECASE,
)
_IMG_SKIP = re.compile(
    r"(logo|icon|avatar|sprite|badge|button|advert|1x1|pixel|favicon)",
    re.IGNORECASE,
)


def _page_images(html_str: str, limit: int = 3) -> list[str]:
    """Content images from a page — the closest thing to a snapshot without a
    browser. og:image first, obvious chrome skipped."""
    out: list[str] = []
    for url in _PAGE_IMG_RE.findall(html_str):
        if _IMG_SKIP.search(url) or url in out:
            continue
        out.append(url)
        if len(out) >= limit:
            break
    return out


async def fetch_page_text(
    client: httpx.AsyncClient, url: str
) -> tuple[str, list[str]]:
    """(text, content image urls) for one page."""
    if not url:
        return "", []
    try:
        response = await client.get(
            url,
            headers=FETCH_HEADERS,
            follow_redirects=True,
        )
        response.raise_for_status()
        ctype = response.headers.get("content-type", "")
        if "html" not in ctype and "text" not in ctype:
            return "", []
        return (
            html_to_text(response.text)[:GAME_PAGE_CHARS],
            _page_images(response.text),
        )
    except Exception:
        return "", []


def enrich_game_query(text: str) -> str:
    query = clean_search_query(text)
    lowered = query.lower()
    if re.search(
        r"\b(cheat|code|level select|unlock|secret|password|fatalit|"
        r"finishing move|move list|combo|moves)\b",
        lowered,
    ):
        return f"{query} cheat codes"
    if re.search(r"\b(walkthrough|guide|quest|boss|beat|defeat|how|level|mission)\b", lowered):
        return f"{query} walkthrough guide IGN"
    return query


