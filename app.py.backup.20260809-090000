async function saveVoiceField(field, value) {
  const settings = await api("/api/settings");
  const voice = Object.assign({}, settings.voice_out || {});
  voice[field] = value;
  delete voice.ha_token;      // it comes back masked; the server keeps the real one
  settings.voice_out = voice;
  await api("/api/settings", {method: "PUT", body: JSON.stringify(settings)});
}

async function switchVoiceEngine(engine) {
  try {
    await saveVoiceField("engine", engine);
    const panel = document.getElementById("voiceEngine");
    if (panel && panel.value !== engine) { panel.value = engine; describeEngine(); }
    const chosen = voiceEngines.find((e) => e.id === engine);
    if (chosen) setStatus("Voice system: " + chosen.name);
  } catch (error) {
    alert("Voice system switch failed: " + error.message);
  }
}

async function switchVoice(voice) {
  try {
    await saveVoiceField("voice", voice);
    const panel = document.getElementById("voiceName");
    if (panel && panel.value !== voice) panel.value = voice;
    setStatus("Voice: " + (voice || "engine default"));
  } catch (error) {
    alert("Voice switch failed: " + error.message);
  }
}

async function populateHeaderVoice() {
  const engineSel = document.getElementById("headerEngine");
  const voiceSel = document.getElementById("headerVoice");
  if (!engineSel || !voiceSel) return;
  try {
    const data = await api("/api/voice/engines");
