@app.get("/api/music/albums")
async def music_albums_api(
    limit: int = 160,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """One cover per album — what drifts behind the cover flow (#162)."""
    require_read_auth(authorization)

    def collect() -> list[dict[str, Any]]:
        try:
            have = {p.stem for p in ART_DIR.iterdir() if p.suffix != ".nolocal"}
        except OSError:
            have = set()

        albums: dict[tuple[str, str], dict[str, Any]] = {}
        for track in music_index():
            name = track["album"].strip()
            if not name:
                continue
            key = (track["artist"].strip().lower(), name.lower())
            entry = albums.get(key)
            if entry is None:
                entry = albums[key] = {
                    "artist": track["artist"], "album": name,
                    "id": track["id"], "count": 0, "cached": False,
                }
            entry["count"] += 1
            # Prefer the track whose sleeve is already on disk: those albums
            # appear the instant the swirl starts.
            if not entry["cached"] and track["id"] in have:
                entry["id"] = track["id"]
                entry["cached"] = True

        return sorted(albums.values(),
                      key=lambda a: (not a["cached"], -a["count"]))

    found = await asyncio.to_thread(collect)
    keep = found[:max(1, min(limit, 400))]
    return {
        "count": len(found),
        "cached": sum(1 for a in found if a["cached"]),
        "albums": [
            {**a, "art": f"/music/{a['id']}/art?t={media_sign(a['id'])}"}
            for a in keep
        ],
    }


@app.get("/api/music/album")
async def music_album_api(
    artist: str = "",
    album: str = "",
    track_id: str = "",
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Every track on an album, in track-number order where it is known."""
    require_read_auth(authorization)
    if track_id:
        seed = music_track(track_id)
        if seed:
            artist = artist or seed["artist"]
            album = album or seed["album"]

    want_artist = (artist or "").strip().lower()
    want_album = (album or "").strip().lower()
    if not want_album:
        raise HTTPException(status_code=400, detail="Name an album")

    tracks = [
        t for t in music_index()
        if t["album"].strip().lower() == want_album
        and (not want_artist or t["artist"].strip().lower() == want_artist)
    ]

    def order(track: dict[str, Any]) -> tuple[int, str]:
        # Leading track numbers are common in filenames; fall back to title.
        match = re.match(r"\s*(\d{1,3})\b", Path(track["path"]).stem)
        return (int(match.group(1)) if match else 999, track["title"].lower())

    tracks.sort(key=order)
    return {
        "artist": artist, "album": album, "count": len(tracks),
        "seconds": round(sum(t["seconds"] for t in tracks)),
        "tracks": [
            {**{k: v for k, v in t.items() if k not in ("path", "search")},
             "url": f"/music/{t['id']}?t={media_sign(t['id'])}",
             "art": f"/music/{t['id']}/art?t={media_sign(t['id'])}"}
            for t in tracks
        ],
    }


