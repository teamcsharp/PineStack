  if (s.ram_used_gb != null) {
    rows.push(["System RAM",
      s.ram_used_gb + " / " + s.ram_total_gb + " GB in use"]);
  }
  if (s.vram_used_gb != null) {
    rows.push(["VRAM", s.vram_used_gb + " / " + s.vram_total_gb + " GB in use"]);
  }
  if (s.temp_c != null) {
    rows.push(["DGX Spark heat",
      s.temp_c + " °C" + (s.temp_zone ? " (" + s.temp_zone + ")" : "")]);
  }
  if (s.device) rows.push(["Device", s.device]);
  if (item.ts) rows.push(["When", new Date(item.ts * 1000).toLocaleString()]);
