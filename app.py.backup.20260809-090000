    player.src = track.url;
    player.play().catch(() => {});
    document.getElementById("musicStatus").textContent =
      "📻 " + track.title + (track.artist ? " · " + track.artist : "");
  } catch (error) {
    musicRadioOn = false;
    document.getElementById("musicStatus").textContent = error.message;
  }
}

async function radioStop() {
  musicRadioOn = false;
  const player = document.getElementById("musicPlayer");
  if (player) player.pause();
  try {
    await api("/api/radio/tune", {
      method: "POST", body: JSON.stringify({stop: true}),
    });
    document.getElementById("musicStatus").textContent = "Radio off.";
  } catch (error) {
    document.getElementById("musicStatus").textContent = error.message;
