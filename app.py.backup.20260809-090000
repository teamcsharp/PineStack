function djClock(seconds) {
  seconds = Math.max(0, Math.round(seconds || 0));
  return Math.floor(seconds / 60) + ":" + String(seconds % 60).padStart(2, "0");
}

function djRenderQueue(state) {
  const host = document.getElementById("djQueue");
  if (host.style.display === "none") return;
  host.textContent = "";
  const head = el("div", "", (state.station_name || "Pine Box FM") + " · queue");
  head.style.cssText = "font-weight:700;color:#7fd1ff;margin-bottom:6px";
  host.appendChild(head);
  if (!state.upcoming.length) {
    host.appendChild(el("div", "muted", "Nothing queued."));
