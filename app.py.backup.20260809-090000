async function musicSearch(query) {
  const host = document.getElementById("musicResults");
  const q = query !== undefined ? query
    : document.getElementById("musicQuery").value.trim();
  if (!q) { host.textContent = ""; return []; }
  try {
    const data = await api("/api/music/search?limit=25&q="
      + encodeURIComponent(q));
    const results = data.results || [];
    host.textContent = "";
    if (!results.length) {
      host.textContent = "Nothing in the library matches that.";
      renderMusicFlow([]);
      return [];
    }
    results.forEach((track) => host.appendChild(musicRow(track)));
    renderMusicFlow(results);
    return results;
  } catch (error) {
    host.textContent = error.message;
    return [];
  }
}

async function musicPlay(id, here) {
  const status = document.getElementById("musicStatus");
  try {
    const track = await api("/api/music/play", {
      method: "POST", body: JSON.stringify({id, here: !!here}),
    });
    const player = document.getElementById("musicPlayer");
    rememberSig(track.url);
    musicLastId = track.id;
    musicNowArt(track);
    if (stage) stage.show(track);
    stageSheet(track);
    player.src = track.url;
    player.play().catch(() => {});    // autoplay may be blocked; controls stay
    musicRadioOn = false;             // a hand-picked track ends the station
    status.textContent = track.title
      + (track.artist ? " · " + track.artist : "")
      + (track.played_on ? " · on " + track.played_on : " · in this page");
    return track;
  } catch (error) {
    status.textContent = error.message;
    return null;
  }
}

async function musicReindex() {
