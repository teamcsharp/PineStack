# Questions that want to be shown, not told.
TE_SHOW_ME = re.compile(
    r"\b(how (do|can|would) (i|you)|how to|show me|teach me|tutorial|"
    r"demo|walkthrough|technique|get started|learn|practice|tips?)\b", re.I)


async def te_media(device: dict[str, Any], question: str) -> list[dict[str, str]]:
    """Videos that show how to use the device. Manuals describe controls;
    watching someone do it is what a question like "how do I scratch" wants."""
    title = str(device.get("title") or device.get("slug") or "")
    name = title.split(" user")[0].split(" manual")[0].strip()
    topic = " ".join(
        w for w in re.findall(r"[A-Za-z0-9-]+", question)
        if len(w) > 3 and w.lower() not in
        ("how", "what", "does", "with", "this", "that", "your", "into")
    )[:60]
    try:
        return await search_videos(f"{name} {topic} tutorial", limit=4)
    except Exception:
        return []



async def pine_speak_ack(request_text: str, phrase: str) -> None:
    """Say something back after a Pine Chat submission (#104). The stored
    phrase is the floor; when the model is reachable it acknowledges what was
    actually asked, so the box sounds like it heard you rather than like a
    doorbell."""
    line = phrase
    try:
        answer = await ask_model(
            "Acknowledge this request in ONE short spoken sentence. Say "
            "what you understood it to be, then that it is queued. No "
            "markdown, no emoji, no URLs, no preamble.\n\n"
            f"Request: {request_text[:400]}"
        )
        spoken = spoken_text(answer)[:240]
        if spoken:
            line = spoken
    except Exception:
        pass          # the stored phrase always works
    try:
        await speak(line, event="submit")
    except Exception:
        pass



# --- Pine Box FM: the DJ ---------------------------------------------------
# The radio session from #88 with a person in front of it. One object holds
# the whole show: what is playing, what is queued, what was requested, and
# what the DJ and the host have said to each other.

_RADIO.update({
    "history": [], "requests": [], "chat": [], "since_id": 0, "on": False,
    # Two independent outputs (#115). The Pine Box is the AI, so the AI's
    # voice comes out of it by default even when the music is in the browser.
    "music_to": "here", "voice_to": "box", "voice_clips": [],
})
_DJ_SKIP: list[Any] = []          # an asyncio.Event, created on the loop


def dj_settings() -> dict[str, Any]:
    return load_settings().get("dj") or dict(DEFAULT_DJ)


def settings_web_search() -> bool:
    return bool(load_settings().get("web_search", True))


def _dj_fill(template: str, track: dict[str, Any] | None = None) -> str:
    dj = dj_settings()
    track = track or {}
    return (
        str(template)
        .replace("{station}", dj["station_name"])
        .replace("{title}", str(track.get("title") or "this one"))
        .replace("{artist}", str(track.get("artist") or ""))
        .replace("{by}", f" by {track['artist']}" if track.get("artist") else "")
        .strip()
    )


async def dj_line(kind: str, track: dict[str, Any] | None = None,
                  extra: str = "") -> str:
    """One spoken line. The phrase bank is the fallback AND the style guide:
    the model is asked to riff in the same register, so a broken or slow model
    degrades to a phrase rather than to silence."""
    dj = dj_settings()
    bank = {
        "open": dj["open_phrases"],
        "intro": dj["intro_phrases"],
        "request": dj["request_phrases"],
        "station_id": dj["station_ids"],
        "interject": dj["interject_phrases"],
        "media": dj["interject_phrases"],
    }.get(kind, dj["intro_phrases"])
    fallback = _dj_fill(random.choice(bank) if bank else "{title}", track)

    # Chattiness gates only the model call, never the fallback — the show
    # always has a voice.
    if kind in ("intro", "interject") and random.random() > dj["chattiness"]:
        return fallback

    asks = {
        "open": (extra or
                 "open the show and say you are waiting on the first caller"),
        "intro": (
            "introduce the next track, working in what listeners make of it"
            if extra else "introduce the next track"
        ),
        "request": ("announce that a listener requested this track"
                    + (f". {extra}" if extra else "")),
        "station_id": "give a station identification",
        "interject": (extra or
                      "say one short thing about the track playing right now"),
        "media": f"react to what the host just showed you: {extra}",
        "ad": f"read a short, enthusiastic advert for: {extra}",
        "reply": f"reply to what the host just said to you: {extra}",
    }
    task = asks.get(kind, asks["intro"])
    context = ""
    if track:
        context = (
            f"\nTrack: {track.get('title')}"
            f"{' by ' + track['artist'] if track.get('artist') else ''}"
            f"{' from ' + track['album'] if track.get('album') else ''}"
        )
    if kind == "intro" and extra:
        context += (
            f"\nWhat listeners say about it: {extra}\n"
            "Mention that reception naturally, as something people say, not "
            "as fact."
        )

    try:
        answer = await ask_model(
            (
                f"{dj['persona']}\n\nIn ONE or TWO short spoken sentences, "
                f"{task}. Stay in character. Never use markdown, emoji, URLs "
                f"or stage directions. Refer to the station as "
                f"{dj['station_name']}.{context}\n\n"
                f"For tone, here is how you usually put it: \"{fallback}\""
            )
        )
        return answer or fallback
    except Exception:
        return fallback


SPOKEN_NOISE = re.compile(r"[*_`#]+|\((?:[^()]{0,60})\)|\[[^\]]{0,60}\]")


def spoken_text(line: str) -> str:
    """Everything here is read aloud, and a model that is told not to use
    markdown still does. Asterisks become audible pauses and bracketed stage
    directions get read out, so strip both before they reach the voice."""
    clean = SPOKEN_NOISE.sub(" ", str(line or ""))
    clean = re.sub(r"https?://\S+", "", clean)
    return re.sub(r"\s{2,}", " ", clean).strip()


# Why the last line did not reach the box. A silent speaker and a working
# one look the same from here otherwise.
_SPEAK_LAST: dict[str, Any] = {"why": "", "at": 0.0}


def speak_health() -> dict[str, Any]:
    return dict(_SPEAK_LAST)


async def dj_speak(kind: str, track: dict[str, Any] | None = None,
                   extra: str = "", line: str = "",
                   who: str = "dj", voice: str | None = None) -> str:
    """Say it, log it to the chat channel so the panel can show the patter.
    `who` is "dj" or "cohost" — the co-host has his own voice so the two are
    told apart by ear, not only by the transcript."""
    spoken = spoken_text(line or await dj_line(kind, track, extra))
    if not spoken:
        return ""
    settings_dj = dj_settings()
    forced = voice or (settings_dj["cohost_voice"] if who == "cohost"
                       else settings_dj["voice"]) or None
    voice_to = _RADIO.get("voice_to") or "box"

    if voice_to in ("box", "both"):
        try:
            result = await speak(spoken, event="default", voice=forced)
            # home_assistant_say declines rather than raising when the
            # satellite is not ready, so an empty return is not success.
            why = str((result or {}).get("skipped") or "")
            _SPEAK_LAST.update({"why": why, "at": time.time()})
        except Exception as exc:
            _SPEAK_LAST.update({
                "why": f"{type(exc).__name__}: {exc}"[:200],
                "at": time.time(),
            })
    else:
        _SPEAK_LAST.update({
            "why": f"voice output is routed to {voice_to!r}, not the box",
            "at": time.time(),
        })

    # Always synthesise: a browser listener has no other way to hear the DJ,
    # and there can be listeners even when the box is the primary output.
    if True:
        try:
            clip = await voice_generate(
                spoken, forced or _event_voice("default"), "piper")
            _RADIO["voice_clips"].append({
                "ts": int(time.time() * 1000),
                "url": f"{clip['path']}?t={clip['sig']}",
                "text": spoken,
            })
            del _RADIO["voice_clips"][:-20]
        except Exception:
            pass
    entry = {
        "ts": int(time.time()), "who": who, "kind": kind, "text": spoken,
        "name": (dj_settings()["cohost_name"] if who == "cohost" else "DJ"),
    }
    _RADIO["chat"].append(entry)
    _RADIO["last_said"] = {**entry, "voice": forced or ""}
    del _RADIO["chat"][:-120]          # bounded — this runs for hours
    return spoken


# What the output selectors were before the offline fallback touched them.
_OUTPUT_BEFORE: dict[str, str] = {}

_LISTENERS: dict[str, float] = {}


def _radio_listeners(seen: str = "") -> int:
    """Anyone who polled in the last 30 seconds is listening.
    ponytail: a dict of last-seen stamps, not sessions — this is a house
    radio, not an audience metric."""
    now = time.time()
    if seen:
        _LISTENERS[seen] = now
    for who, when in list(_LISTENERS.items()):
        if now - when > 30:
            _LISTENERS.pop(who, None)
    return len(_LISTENERS)


def dj_last_said() -> dict[str, Any]:
    return _RADIO.get("last_said") or {}


def dj_state() -> dict[str, Any]:
    base = radio_state()
    track = _RADIO.get("now") or {}
    elapsed = base.get("elapsed") or 0.0
    now = None
    if track:
        now = {k: v for k, v in track.items() if k not in ("path", "search")}
        now["url"] = f"/music/{track['id']}?t={media_sign(track['id'])}"
        now["art"] = f"/music/{track['id']}/art?t={media_sign(track['id'])}"
    return {
        **base,
        "now": now,
        "on": bool(_RADIO["on"]),
        "station_name": dj_settings()["station_name"],
        "remaining": max(0.0, round(float(track.get("seconds") or 0) - elapsed, 1)),
        "upcoming": [
            {**{k: v for k, v in t.items() if k not in ("path", "search")},
             "url": f"/music/{t['id']}?t={media_sign(t['id'])}",
             "art": f"/music/{t['id']}/art?t={media_sign(t['id'])}"}
            for t in (_RADIO["requests"] + _RADIO["queue"])[:20]
        ],
        "requests": len(_RADIO["requests"]),
        "music_to": _RADIO.get("music_to") or "here",
        "voice_to": _RADIO.get("voice_to") or "box",
        # Kept so older clients still read something sensible.
        "output": _RADIO.get("music_to") or "here",
        "listeners": _radio_listeners(),
        "history": _RADIO["history"][-10:],
        "played": list(reversed(_RADIO["history"][-10:])),
        "last_said": dj_last_said(),
        "chat": _RADIO["chat"][-40:],
    }


def dj_skip() -> None:
    for event in _DJ_SKIP:
        try:
            event.set()
        except Exception:
            pass


def dj_next_track() -> dict[str, Any] | None:
    """Requests jump the queue; that is the whole point of a request line."""
    if _RADIO["requests"]:
        track = _RADIO["requests"].pop(0)
        track = {**track, "requested": True}
    else:
        if not _RADIO["queue"]:
            _RADIO["queue"] = radio_fill(_RADIO["station"])
        if not _RADIO["queue"]:
            return None
        track = _RADIO["queue"].pop(0)
    if _RADIO.get("now"):
        previous = _RADIO["now"]
        _RADIO["history"].append({
            **{k: v for k, v in previous.items()
               if k in ("id", "title", "artist", "album", "seconds")},
            "url": f"/music/{previous['id']}?t={media_sign(previous['id'])}",
            "art": f"/music/{previous['id']}/art?t={media_sign(previous['id'])}",
        })
        del _RADIO["history"][:-40]
    _RADIO["now"] = track
    _RADIO["started"] = time.time()
    return track


async def _dj_loop() -> None:
    """The show. Talk, play, sometimes talk over it, repeat."""
    skip = asyncio.Event()
    _DJ_SKIP.append(skip)
    played = 0
    try:
        while _RADIO["on"]:
            track = dj_next_track()
            if not track:
                break

            dj = dj_settings()
            played += 1
            if dj["station_id_every"] and played % dj["station_id_every"] == 1:
                await dj_speak("station_id")
                await asyncio.sleep(1.0)

            # What people make of it, if we can find out (#121).
            notes = ""
            if dj["research"] and settings_web_search():
                try:
                    notes = await track_notes(track)
                except Exception:
                    notes = ""

            await dj_speak(
                "request" if track.get("requested") else "intro",
                track, extra=notes)
            await asyncio.sleep(1.0)

            if dj["ad_every"] and played % dj["ad_every"] == 0:
                try:
                    await dj_ad_break()
                    await asyncio.sleep(1.0)
                except Exception:
                    pass

            if dj["banter_every"] and played % dj["banter_every"] == 0:
                try:
                    await dj_banter(track)
                    await asyncio.sleep(0.8)
                except Exception:
                    pass

            # A skip pressed while the DJ was still talking must not be
            # thrown away by the clear() below — honour it before playing.
            if skip.is_set():
                skip.clear()
                continue

            _RADIO["started"] = time.time()
            if (_RADIO.get("music_to") or "here") in ("box", "both"):
                await music_play_on_box(track)

            async def _hold(seconds: float) -> bool:
                """Wait out the track. True means someone skipped."""
                try:
                    await asyncio.wait_for(skip.wait(), timeout=seconds)
                    skip.clear()
                    return True
                except asyncio.TimeoutError:
                    return False

            length = max(20.0, float(track.get("seconds") or 210))
            # Maybe say something in the middle, then wait out the rest.
            if random.random() < dj["interject_rate"]:
                cut = length * random.uniform(0.3, 0.7)
                skip.clear()
                if await _hold(cut):
                    continue                     # skipped before the interject
                await dj_speak("interject", track)
                length -= cut
                if skip.is_set():                # skipped while talking again
                    skip.clear()
                    continue
            else:
                skip.clear()

            await _hold(length + 1.5)
    except asyncio.CancelledError:
        raise
    except Exception as exc:
        # Going off air silently is indistinguishable from never starting.
        _RADIO["died"] = {
            "at": int(time.time()),
            "why": f"{type(exc).__name__}: {exc}"[:300],
            "where": traceback.format_exc()[-1200:],
        }
    finally:
        if skip in _DJ_SKIP:
            _DJ_SKIP.remove(skip)
        _RADIO["now"] = None
        _RADIO["on"] = False


def dj_best_station(preferred: str = "") -> str:
    """A station that actually has tracks in it. #108 asks for the show to
    start no matter what, and 'no matter what' includes an empty index."""
    stations = {s["id"]: s["tracks"] for s in music_stations()}
    if preferred and stations.get(preferred):
        return preferred
    for name, count in stations.items():
        if name != "all" and count:
            return name
    return "all"


async def dj_go(station: str = "") -> dict[str, Any]:
    """The one-button path: index if we must, pick something playable, go on
    air, and open the lines.

    It also refuses to fail because the Pine Box is off: if the satellite is
    unavailable the show moves to the browser rather than starting silent
    (#139-#142). Whatever can play, plays."""
    if not music_index():
        music_index(force=True)
        for _ in range(60):            # give the scan a chance to publish
            await asyncio.sleep(1)
            if music_index():
                break
    # If the box is not there, keep the user's choice and just make sure
    # something can actually be heard: "box" becomes "both" rather than being
    # replaced, so the page carries it and the speaker picks up the moment it
    # comes back (#152). Whatever we change here is remembered so stopping the
    # show puts the setting back exactly as it was found.
    fallback = ""
    try:
        link = await satellite_status()
        if not link["online"]:
            _OUTPUT_BEFORE.clear()
            for axis in ("music_to", "voice_to"):
                if (_RADIO.get(axis) or "box") == "box":
                    _OUTPUT_BEFORE[axis] = _RADIO.get(axis) or "box"
                    _RADIO[axis] = "both"
            fallback = (
                f"The Pine Box ({link.get('entity') or 'satellite'}) is "
                f"{link.get('entity_state') or 'offline'} — the show is "
                "coming out of this page as well so you can hear it, and it "
                "will use the speaker again as soon as it reconnects."
            )
            # Reconnecting sweeps 254 addresses and sleeps; going on air must
            # not wait for a device that is switched off.
            fire_and_forget(satellite_reconnect())
    except Exception:
        pass

    chosen = dj_best_station(station)
    state = dj_start(chosen)
    await dj_speak("open")
    return {**state, "station": chosen, "tracks": len(music_index()),
            "fallback": fallback}


def dj_start(station: str) -> dict[str, Any]:
    radio_stop()
    _RADIO.update({
        "station": station or "all", "on": True,
        "queue": radio_fill(station or "all"),
        "requests": [], "history": [], "chat": [],
    })
    task = asyncio.create_task(_dj_loop())
    _RADIO_TASK.append(task)
    return dj_state()


def dj_stop() -> None:
    _RADIO["on"] = False
    dj_skip()
    radio_stop()
    _RADIO.update({"requests": [], "history": []})
    # Put back anything the offline-fallback changed, so starting and
    # stopping a show never leaves a setting altered behind your back.
    for axis, value in _OUTPUT_BEFORE.items():
        _RADIO[axis] = value
    _OUTPUT_BEFORE.clear()


# --- "request a song for Pine Box FM" --------------------------------------

DJ_REQUEST = re.compile(
    r"\b(request|dedicate)\b.{0,40}\b(song|track|tune)\b"
    r"|\brequest\b.{0,30}\bfor\b.{0,20}\b(pine ?box ?fm|the (radio|station|dj))\b"
    r"|\b(hey |ok |okay )?(dj|pine ?box ?fm)\b.{0,30}\b(play|put on|request)\b",
    re.I,
)


def is_dj_request(text: str) -> bool:
    """Spoken requests aimed at the station rather than at the box."""
    return bool(_RADIO["on"]) and bool(DJ_REQUEST.search(text or ""))


def dj_request_query(text: str) -> str:
    query = re.sub(
        r"^.*?\b(request|dedicate|play|put on)\b\s*", "", text or "",
        flags=re.I | re.S,
    )
    query = re.sub(
        r"\b(a |the )?(song|track|tune)\b|\bfor (pine ?box ?fm|the "
        r"(radio|station|dj))\b|\bplease\b|\bcalled\b|\bnamed\b",
        " ", query, flags=re.I,
    )
    return re.sub(r"\s{2,}", " ", query).strip(" .!?,")


# --- Every request ever made -----------------------------------------------
# The show's chat log is cleared on each dj_start, so nothing the pair said
# could ever be remembered. This outlives the show: one row per track, with
# the tally and the words you used to ask for it.

REQUESTS_PATH = Path("/app/data/requests.json")
_REQUESTS_LOCK = RLock()
_ASKED_KEPT = 8                   # bounded — this file lives for years


def read_requests() -> dict[str, dict[str, Any]]:
    try:
        data = json.loads(REQUESTS_PATH.read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def request_remember(track: dict[str, Any], query: str = "") -> int:
    """Count this request. Returns how many times it has now been asked for."""
    with _REQUESTS_LOCK:
        log = read_requests()
        row = log.get(track["id"]) or {
            "title": track.get("title") or "",
            "artist": track.get("artist") or "",
            "count": 0, "first": int(time.time()), "asked": [],
        }
        row["count"] = int(row.get("count") or 0) + 1
        row["last"] = int(time.time())
        row["title"] = track.get("title") or row["title"]
        row["artist"] = track.get("artist") or row["artist"]
        if query:
            row.setdefault("asked", []).append(query[:80])
            del row["asked"][:-_ASKED_KEPT]
        log[track["id"]] = row
        try:
            REQUESTS_PATH.parent.mkdir(parents=True, exist_ok=True)
            REQUESTS_PATH.write_text(json.dumps(log, indent=2))
        except Exception:
            pass                  # a lost tally must never lose the song
        return int(row["count"])


def request_history(track_id: str = "") -> dict[str, Any]:
    log = read_requests()
    ranked = sorted(log.values(), key=lambda r: -int(r.get("count") or 0))
    return {
        "total": sum(int(r.get("count") or 0) for r in log.values()),
        "songs": len(log),
        "top": ranked[:12],
        "this": log.get(track_id) or {},
    }


_NTH = {2: "second", 3: "third", 4: "fourth", 5: "fifth", 6: "sixth",
        7: "seventh", 8: "eighth", 9: "ninth", 10: "tenth",
        11: "eleventh", 12: "twelfth"}


def request_brief(count: int) -> str:
    """What to tell the DJ about how often this one comes round."""
    if count <= 1:
        return ""
    nth = _NTH.get(count, f"{count}th")
    if count >= 5:
        return (f"He has now asked for this {count} times — this is the {nth}. "
                "Make something of it: mock disbelief, a running joke, act "
                "like the station has given up resisting.")
    return (f"He has asked for this {count} times now — this is the {nth}. "
            "Mention the number and rib him lightly about it.")


async def dj_request(query: str, now: bool = False) -> dict[str, Any]:
    """Queue it or cut to it, and have the DJ acknowledge either way."""
    hits = music_search(query, limit=1)
    if not hits:
        return {"ok": False, "detail": f'Nothing in the library matches "{query}".'}
    track = hits[0]

    if now:
        _RADIO["requests"].insert(0, track)
        dj_skip()                       # cut the current song short
    else:
        _RADIO["requests"].append(track)

    count = request_remember(track, query)
    _RADIO["chat"].append({
        "ts": int(time.time()), "who": "host", "kind": "request",
        "text": f"Request: {track['title']}"
                + (f" by {track['artist']}" if track["artist"] else "")
                + (f" (asked {count} times)" if count > 1 else ""),
    })

    # Every request gets acknowledged out loud. A repeat gets the tally with
    # it, which is the whole point of keeping one.
    line = await dj_speak("request", track, extra=request_brief(count))
    return {
        "ok": True, "queued": not now, "line": line, "times_asked": count,
        **{k: v for k, v in track.items() if k not in ("path", "search")},
    }


# Worth trying the station on anything that sounds like a request. A miss
# costs nothing — if the library has no such song we fall through and the
# model answers normally — so the pattern can afford to be generous where
# DJ_REQUEST above is deliberately strict.
DJ_ASKED = re.compile(
    r"\b(play|put on|queue|spin|request|dedicate|hear)\b", re.I)


# Words that never name a song. Stripping them before the search is what
# stops "put on some Bassnectar" matching a track whose only claim is the
# word "some".
DJ_FILLER = {
    "a", "an", "the", "some", "any", "me", "us", "my", "you", "please",
    "song", "songs", "track", "tracks", "tune", "tunes", "music",
    "something", "anything", "stuff", "by", "from", "for", "on", "off",
    "in", "at", "to", "of", "and", "with", "radio", "station", "pine",
    "box", "fm", "dj", "hey", "ok", "okay", "next", "now", "up", "band",
    "artist", "album", "called", "named", "that", "this", "does", "do",
    "not", "exist", "here", "there", "want", "like", "would", "could",
    "can", "will", "let", "lets", "hear", "listen", "again",
}


def dj_request_terms(text: str) -> list[str]:
    """The words in a spoken request that could plausibly name a song."""
    query = dj_request_query(text)
    return [word for word in re.findall(r"[a-z0-9']+", query.lower())
            if len(word) > 1 and word not in DJ_FILLER]


def dj_request_match(terms: list[str]) -> dict[str, Any] | None:
    """The track someone actually asked for, or None.

    music_search always answers with its best effort, so its top hit has to
    be checked against the distinctive words before it can be trusted."""
    if not terms:
        return None
    hits = music_search(" ".join(terms), limit=1)
    if not hits:
        return None

    hay = hits[0]["search"]
    strong = [word for word in terms if len(word) >= 4]
    if strong:
        return hits[0] if any(word in hay for word in strong) else None
    # Nothing distinctive to go on, so every short word has to be there.
    return hits[0] if all(word in hay for word in terms) else None


async def dj_take_request(text: str) -> dict[str, Any]:
    """A song asked for out loud. Returns {} when it was not one we can fill.

    The station is started if it is off, because "play me a song" implies it,
    and the track is cut to rather than queued — you asked for it now."""
    if not DJ_ASKED.search(text or ""):
        return {}

    terms = dj_request_terms(text)
    wanted = dj_request_match(terms)
    if wanted is None:
        return {}                       # not in the library — let the model talk
    query = " ".join(terms)

    started = False
    if not _RADIO["on"]:
        dj_start(dj_best_station(""))
        started = True

    result = await dj_request(query, now=True)
    if not result.get("ok"):
        return {}

    # The DJ introduces it himself when the loop reaches the track, so this
    # is only the "heard you" — kept short so it does not tread on him.
    title = result.get("title") or query
    artist = result.get("artist") or ""
    station = dj_settings()["station_name"]
    reply = (f"You got it. {title}" + (f" by {artist}" if artist else "")
             + f", coming up on {station}.")
    return {"reply": reply, "track": title, "artist": artist,
            "started": started, "query": query}


async def dj_chat(message: str) -> dict[str, Any]:
    """Talk to the DJ mid-song; he answers about what is playing."""
    _RADIO["chat"].append(
        {"ts": int(time.time()), "who": "host", "kind": "chat", "text": message})
    line = await dj_speak("reply", _RADIO.get("now"), extra=message)
    return {"reply": line, "now": _RADIO.get("now")}



