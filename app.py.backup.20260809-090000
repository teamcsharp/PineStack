// Canvas "mosaic dissolve": progressively coarsen the image into blocks,
// knocking out random tiles, while fading — then run `done`.
function mosaicDissolve(imgEl, done) {
  const w = imgEl.naturalWidth || imgEl.clientWidth;
  const h = imgEl.naturalHeight || imgEl.clientHeight;
  if (!w || !h) { done(); return; }
  const canvas = document.createElement("canvas");
  canvas.className = "lb-mosaic";
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext("2d");
  const tmp = document.createElement("canvas");
  const tctx = tmp.getContext("2d");
  imgEl.parentNode.insertBefore(canvas, imgEl);
  imgEl.style.display = "none";
  let start = null;
  const DUR = 950;
  function frame(now) {
    if (start === null) start = now;
    const p = Math.min(1, (now - start) / DUR);
    const block = Math.max(1, Math.floor(2 + p * p * 64));
    const sw = Math.max(1, Math.floor(w / block));
    const sh = Math.max(1, Math.floor(h / block));
    tmp.width = sw; tmp.height = sh;
    tctx.drawImage(imgEl, 0, 0, sw, sh);
    ctx.clearRect(0, 0, w, h);
    ctx.globalAlpha = 1 - p * 0.85;
    ctx.imageSmoothingEnabled = false;
    ctx.drawImage(tmp, 0, 0, sw, sh, 0, 0, w, h);
    if (p > 0.25) {
      ctx.globalAlpha = 1;
      ctx.fillStyle = "#05070b";
      const knock = Math.floor(p * 60);
      for (let i = 0; i < knock; i++) {
        const bx = Math.floor(Math.random() * sw) * block;
        const by = Math.floor(Math.random() * sh) * block;
        ctx.fillRect(bx, by, block, block);
      }
    }
    if (p < 1) requestAnimationFrame(frame);
    else { canvas.remove(); done(); }
  }
  requestAnimationFrame(frame);
}

