PINE_UPLOADS_DIR = Path("/app/data/pine_uploads")


def _save_pine_images(images: list[Any]) -> list[str]:
    """Persist pasted data-URL images; returns saved filenames."""
    saved: list[str] = []
    PINE_UPLOADS_DIR.mkdir(parents=True, exist_ok=True)
    for data_url in images[:6]:
        m = re.match(
            r"data:image/(png|jpe?g|webp);base64,(.+)", str(data_url)[:8_000_000]
        )
        if not m:
            continue
        ext = "jpg" if m.group(1).startswith("jp") else m.group(1)
        name = f"{int(time.time())}-{uuid.uuid4().hex[:8]}.{ext}"
        try:
            (PINE_UPLOADS_DIR / name).write_bytes(
                base64.b64decode(m.group(2), validate=False)
            )
            saved.append(name)
        except Exception:
            continue
    return saved


@app.get("/api/pine-uploads/{name}")
async def pine_upload_file(
    name: str,
    authorization: str | None = Header(default=None),
) -> Response:
    require_read_auth(authorization)
    clean = re.sub(r"[^A-Za-z0-9.\-]", "", name)
    path = PINE_UPLOADS_DIR / clean
    try:
        data = path.read_bytes()
    except Exception:
        raise HTTPException(status_code=404, detail="No such upload")
    kinds = {".png": "image/png", ".jpg": "image/jpeg", ".webp": "image/webp"}
    return Response(
        content=data,
        media_type=kinds.get(path.suffix.lower(), "application/octet-stream"),
        headers={"Cache-Control": "private, max-age=86400"},
    )


@app.post("/api/pine-requests")
async def pine_submit(
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    require_auth(authorization)
    payload = await request.json()
    text = str(payload.get("text") or "").strip()
    images = payload.get("images") or []
    saved = _save_pine_images(images) if isinstance(images, list) else []
    if saved:
        # Markdown paths so whoever resolves the request can actually open
        # the file (data/pine_uploads/ is on the share), plus the [img:] ref
        # the panel uses to render thumbnails.
        refs = "\n".join(
            f"![pasted image](data/pine_uploads/{n}) [img:{n}]" for n in saved
        )
        text = f"{text}\n\nAttached images:\n{refs}".strip()
    if not text:
        raise HTTPException(status_code=400, detail="Enter a request")
    item = await pine_append(text)
    # Speak "your reply has been submitted" (customizable; silent w/o HA_TOKEN).
    try:
        pc = load_settings()["pine_chat"]
        phrase = random.choice(
            pc.get("submit_phrases") or [pc["submit_phrase"]])
        if phrase and _ha_creds()[0]:
            # Speak back what was actually asked, not just a fixed chime.
            fire_and_forget_speech(pine_speak_ack(text, phrase))
    except Exception:
        pass
    return {"submitted": item, "count": len(pine_read())}


@app.post("/api/pine-requests/{req_id}/resolve")
async def pine_resolve(
    req_id: int,
    request: Request,
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """Complete a request: log it to the prompt history, remove it from
    pine_requests.md, and speak the completion phrase. This is what the
    behind-the-scenes resolver calls for each request it settles."""
    require_auth(authorization)
    payload = await request.json()
    reply = str(payload.get("reply") or "").strip()
    item = await pine_remove(req_id)
    if item is None:
        raise HTTPException(status_code=404, detail="No such request")
    log_turn(
        item["text"],
        reply or "(resolved)",
        {"active_prompt": "Pine Chat", "model": "resolver", "pine_chat": True},
    )
    try:
        pc = load_settings()["pine_chat"]
        phrase = random.choice(
            pc.get("complete_phrases") or [pc["complete_phrase"]])
        if phrase and _ha_creds()[0]:
            fire_and_forget_speech(
                speak(phrase, event="complete"))
    except Exception:
        pass
    return {"resolved": item, "reply": reply}


