@app.get("/api/radio/next")
async def radio_next_api(
    station: str = "all",
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """What the panel player pulls when a track ends, so the browser can run
    the same station without the box being involved."""
    require_read_auth(authorization)
    # While the DJ is on air he owns the running order. A browser asking for
    # "next" here would consume a second track and the show would appear to
    # skip — so hand back what is actually playing instead (#122).
    if _RADIO["on"]:
        current = _RADIO.get("now")
        if current:
            return {
                **{k: v for k, v in current.items()
                   if k not in ("path", "search")},
                "url": f"/music/{current['id']}?t={media_sign(current['id'])}",
                "art": f"/music/{current['id']}/art"
                       f"?t={media_sign(current['id'])}",
                "following": True,
            }

    if _RADIO["station"] != station:
        _RADIO.update({"station": station, "queue": radio_fill(station)})
    track = radio_next_track()
    if not track:
        raise HTTPException(status_code=404, detail="That station is empty")
    return {**{k: v for k, v in track.items() if k not in ("path", "search")},
            "url": f"/music/{track['id']}?t={media_sign(track['id'])}"}


