def _art_from_tags(path: Path) -> tuple[bytes, str] | None:
    """Embedded artwork. Every container hides it somewhere different."""
    try:
        from mutagen import File as MutagenFile        # type: ignore

        audio = MutagenFile(path)
        if audio is None:
            return None

        # FLAC / OGG keep a picture list.
        pictures = getattr(audio, "pictures", None)
        if pictures:
            first = pictures[0]
            return bytes(first.data), str(first.mime or "image/jpeg")

        tags = getattr(audio, "tags", None)
        if not tags:
            return None

        # ID3 (mp3): APIC frames, possibly several.
        for key in list(tags.keys()):
            if str(key).startswith("APIC"):
                frame = tags[key]
                return bytes(frame.data), str(
                    getattr(frame, "mime", "") or "image/jpeg")

        # MP4 / M4A: 'covr' atoms, format is a small int, not a mime type.
        covers = tags.get("covr") if hasattr(tags, "get") else None
        if covers:
            cover = covers[0]
            fmt = getattr(cover, "imageformat", 13)
            return bytes(cover), "image/png" if fmt == 14 else "image/jpeg"
    except Exception:
        pass
    return None


def _art_from_folder(path: Path) -> tuple[bytes, str] | None:
    """A lot of libraries keep cover.jpg beside the audio instead."""
    try:
        for entry in path.parent.iterdir():
            if not entry.is_file() or entry.suffix.lower() not in (
                    ".jpg", ".jpeg", ".png", ".webp"):
                continue
            if entry.stem.lower() in COVER_NAMES:
                mime = "image/png" if entry.suffix.lower() == ".png" else (
                    "image/webp" if entry.suffix.lower() == ".webp"
                    else "image/jpeg")
                return entry.read_bytes(), mime
    except Exception:
        pass
    return None



# An asyncio lock, not a threading one: the old version slept inside a
# worker thread, and enough of those in parallel exhausted the pool and hung
# the whole server.
_MB_LOCK = asyncio.Lock()
_MB_LAST = [0.0]

# Cover Art Archive lookups: one at a time, and a hard cap on how many may be
# waiting. Beyond that we simply skip — a missing sleeve is a generated one,
# which is not worth stalling the panel for.
_ART_GATE = asyncio.Semaphore(1)
_ART_INFLIGHT: set[str] = set()
_ART_MAX_WAITING = 6


async def _mb_wait() -> None:
    """One request per second, shared across every caller."""
    async with _MB_LOCK:
        gap = time.time() - _MB_LAST[0]
        if gap < MB_GAP:
            await asyncio.sleep(MB_GAP - gap)
        _MB_LAST[0] = time.time()


def _mb_term(value: str) -> str:
    """Lucene-escape a field value. Quoting the whole phrase is what made the
    first attempt return zero results for records that plainly exist."""
    cleaned = re.sub(r'[+\-&|!(){}\[\]^"~*?:\\/]', " ", str(value or ""))
    return " ".join(cleaned.split())


async def _art_from_caa(track: dict[str, Any]) -> tuple[bytes, str] | None:
    """Look the record up in MusicBrainz, then pull its front cover."""
    artist = _mb_term(track.get("artist"))
    album = _mb_term(track.get("album"))
    title = _mb_term(track.get("title"))
    if not artist or not (album or title):
        return None

    query = f"release:{album or title}"
    if artist and artist.lower() not in ("various artists", "unknown"):
        query += f" AND artist:{artist}"

    headers = {"User-Agent": MB_AGENT}
    try:
        async with httpx.AsyncClient(
            timeout=20, follow_redirects=True, headers=headers
        ) as client:
            await _mb_wait()
            found = await client.get(
                f"{MB_URL}/release/",
                params={"query": query, "fmt": "json", "limit": 5},
            )
            found.raise_for_status()
            releases = (found.json() or {}).get("releases") or []

            for release in releases[:5]:
                # Below ~85 the match is a different record with a similar
                # name, and a wrong cover is worse than none.
                if int(release.get("score") or 0) < 85:
                    break
                for kind, ident in (
                    ("release", release.get("id")),
                    ("release-group",
                     (release.get("release-group") or {}).get("id")),
                ):
                    if not ident:
                        continue
                    try:
                        art = await client.get(
                            f"{CAA_URL}/{kind}/{ident}/front-500")
                        if art.status_code != 200:
                            continue
                    except Exception:
                        continue
                    mime = str(
                        art.headers.get("content-type", "")).split(";")[0]
                    if mime in ART_TYPES and 2_000 < len(art.content) < 6_000_000:
                        return art.content, mime
    except Exception:
        pass
    return None


async def _art_from_web(track: dict[str, Any]) -> tuple[bytes, str] | None:
    """Last resort: find a cover online (#123). Only ever called once per
    track — the result, or the absence of one, is cached."""
    artist = str(track.get("artist") or "").strip()
    album = str(track.get("album") or "").strip()
    if not (artist and (album or track.get("title"))):
        return None
    query = f"{artist} {album or track['title']} album cover"

    try:
        async with httpx.AsyncClient(
            timeout=12, follow_redirects=True
        ) as client:
            found = await client.get(
                f"{SEARXNG_URL}/search",
                params={"q": query, "categories": "images", "format": "json",
                        "safesearch": 1},
            )
            found.raise_for_status()
            results = (found.json() or {}).get("results") or []

            # Words the result must mention, and hosts that never carry
            # album art but do rank for "cover" and "album".
            wanted = [w for w in re.findall(r"[a-z0-9]+", f"{artist} {album}".lower())
                      if len(w) > 2]
            junk = ("artic.edu", "wikiart", "metmuseum", "getty", "pexels",
                    "unsplash", "shutterstock", "istockphoto", "openverse",
                    "deviantart")

            for result in results[:8]:
                source = str(result.get("img_src") or "")
                if not source.startswith("http"):
                    continue
                blob = " ".join([
                    str(result.get("title") or ""),
                    str(result.get("url") or ""), source]).lower()
                if any(host in blob for host in junk):
                    continue
                # At least half the artist/album words have to appear, or it
                # is not this record.
                if wanted and sum(1 for w in wanted if w in blob) < max(
                        1, len(wanted) // 2):
                    continue
                try:
                    image = await client.get(source)
                    image.raise_for_status()
                except Exception:
                    continue
                mime = str(image.headers.get("content-type", "")).split(";")[0]
                # Trust our own type table, not the remote server's word, and
                # refuse anything implausible for a cover.
                if mime not in ART_TYPES or not (2_000 < len(image.content)
                                                 < 6_000_000):
                    continue
                return image.content, mime
    except Exception:
        pass
    return None


def track_art(track_id: str) -> tuple[bytes, str] | None:
    """Cached album art for a track, or None if it simply has none."""
    ART_DIR.mkdir(parents=True, exist_ok=True)
    # "We already looked locally and there is nothing." Without this the
    # CIFS walk below is repeated on every single request, for every track
    # that has no embedded art — which is nearly all of them.
    if (ART_DIR / f"{track_id}.nolocal").is_file():
        return None

    for suffix in set(ART_TYPES.values()):
        cached = ART_DIR / f"{track_id}{suffix}"
        if cached.is_file() and cached.stat().st_size:
            mime = next(m for m, s in ART_TYPES.items() if s == suffix)
            return cached.read_bytes(), mime

    track = music_track(track_id)
    if not track:
        return None
    path = Path(track["path"])
    found = _art_from_tags(path) or _art_from_folder(path)
    if not found:
        # Remember the miss, or we pay ~574 ms of CIFS for it again next time.
        try:
            (ART_DIR / f"{track_id}.nolocal").write_bytes(b"")
        except Exception:
            pass
        return None          # the web lookup is async; see track_art_async

    suffix = ART_TYPES.get(found[1], ".jpg")
    try:
        # A zero-byte file is the "no art here" marker, so a track without a
        # picture is not re-opened on every scroll.
        (ART_DIR / f"{track_id}{suffix}").write_bytes(found[0] if found else b"")
    except Exception:
        pass
    return found


async def track_art_async(track_id: str) -> tuple[bytes, str] | None:
    """The part of the art lookup that needs the network. Kept separate so
    the fast local path stays synchronous.

    Bounded on purpose: the deck asks for every visible tile on every poll,
    so without a gate this becomes hundreds of concurrent lookups."""
    ART_DIR.mkdir(parents=True, exist_ok=True)
    marker = ART_DIR / f"{track_id}.none"
    if marker.is_file():
        return None                      # already looked; there is no cover

    if track_id in _ART_INFLIGHT:
        return None                      # someone is already fetching it
    if len(_ART_INFLIGHT) >= _ART_MAX_WAITING:
        return None                      # queue is full; try again later
    _ART_INFLIGHT.add(track_id)

    track = music_track(track_id)
    if not track:
        return None
    settings = load_settings()
    dj = settings.get("dj") or {}
    if not (dj.get("art_lookup", True) or dj.get("art_search", False)):
        return None

    found = None
    try:
        async with _ART_GATE:
            settings = load_settings()
            dj = settings.get("dj") or {}
            if dj.get("art_lookup", True):
                found = await asyncio.wait_for(_art_from_caa(track), 30)
            if not found and dj.get("art_search", False):
                found = await asyncio.wait_for(_art_from_web(track), 30)
    except Exception:
        found = None
    finally:
        _ART_INFLIGHT.discard(track_id)

    try:
        if found:
            suffix = ART_TYPES.get(found[1], ".jpg")
            (ART_DIR / f"{track_id}{suffix}").write_bytes(found[0])
        else:
            marker.write_bytes(b"")
    except Exception:
        pass
    return found


def track_tags(path: Path) -> dict[str, str]:
    """Every tag the file carries, flattened to strings for display."""
    out: dict[str, str] = {}
    try:
        from mutagen import File as MutagenFile        # type: ignore

        audio = MutagenFile(path, easy=False)
        if audio is None:
            return out

        info = getattr(audio, "info", None)
        if info is not None:
            for name, label in (
                ("length", "duration_seconds"), ("bitrate", "bitrate"),
                ("sample_rate", "sample_rate"), ("channels", "channels"),
                ("bits_per_sample", "bit_depth"), ("codec", "codec"),
            ):
                value = getattr(info, name, None)
                if value:
                    out[label] = str(round(value, 2)
                                     if isinstance(value, float) else value)

        tags = getattr(audio, "tags", None) or {}
        for key in list(tags.keys())[:80]:
            name = str(key)
            if name.startswith("APIC") or name in ("covr",):
                out["artwork"] = "embedded"
                continue
            try:
                value = tags[key]
            except Exception:
                continue
            if isinstance(value, list):
                value = ", ".join(str(v) for v in value[:6])
            text = " ".join(str(value).split())[:400]
            if text:
                out[name] = text
    except Exception:
        pass
    return out


def library_stats(artist: str, album: str) -> dict[str, Any]:
    """How much of this artist and album the library actually holds."""
    artist_key = (artist or "").strip().lower()
    album_key = (album or "").strip().lower()
    by_artist = [t for t in music_index()
                 if t["artist"].strip().lower() == artist_key and artist_key]
    on_album = [t for t in by_artist
                if t["album"].strip().lower() == album_key and album_key]
    return {
        "artist_tracks": len(by_artist),
        "artist_albums": len({t["album"] for t in by_artist if t["album"]}),
        "artist_seconds": round(sum(t["seconds"] for t in by_artist)),
        "album_tracks": len(on_album),
        "album_seconds": round(sum(t["seconds"] for t in on_album)),
    }



# --- Ad reads and track research (#119, #120, #121) ------------------------
# Every ad the DJ writes is kept, so the station can run it again later and
# you can rewrite it. Track notes are cached the same way: researching the
# same song twice is wasted network and a slower show.

ADS_PATH = Path("/app/data/ad_reads.json")
NOTES_PATH = Path("/app/data/track_notes.json")
_ADS_LOCK = RLock()


def ad_list() -> list[dict[str, Any]]:
    try:
        rows = json.loads(ADS_PATH.read_text())
        return [r for r in rows if isinstance(r, dict)]
    except Exception:
        return []


def _ads_write(rows: list[dict[str, Any]]) -> None:
    with _ADS_LOCK:
        ADS_PATH.parent.mkdir(parents=True, exist_ok=True)
        temporary = ADS_PATH.with_suffix(".tmp")
        temporary.write_text(json.dumps(rows[-200:], indent=1) + "\n")
        temporary.replace(ADS_PATH)


def ad_save(product: str, text: str, kind: str = "sponsor") -> dict[str, Any]:
    with _ADS_LOCK:
        rows = ad_list()
        entry = {
            "id": uuid.uuid4().hex[:12],
            "product": product[:200],
            "text": text[:1200],
            "kind": kind,
            "ts": int(time.time()),
            "uses": 0,
        }
        rows.append(entry)
        _ads_write(rows)
        return entry


def ad_update(ad_id: str, **fields: Any) -> dict[str, Any] | None:
    with _ADS_LOCK:
        rows = ad_list()
        for row in rows:
            if row.get("id") == ad_id:
                for key, value in fields.items():
                    if key in ("product", "text", "kind"):
                        row[key] = str(value)[:1200]
                    elif key == "uses":
                        row["uses"] = int(value)
                _ads_write(rows)
                return row
    return None


def ad_delete(ad_id: str) -> None:
    with _ADS_LOCK:
        _ads_write([r for r in ad_list() if r.get("id") != ad_id])


def ad_pick() -> dict[str, Any] | None:
    """Prefer the reads that have run least, so the rotation stays wide."""
    rows = ad_list()
    if not rows:
        return None
    fewest = min(r.get("uses", 0) for r in rows)
    return random.choice([r for r in rows if r.get("uses", 0) == fewest])


def gallery_product() -> str:
    """A product string built from something you actually generated (#120)."""
    gens = [
        g for g in read_generations(120)
        if (g.get("tags") or g.get("request"))
    ]
    if not gens:
        return ""
    pick = random.choice(gens)
    subject = " ".join(str(
        pick.get("request") or pick.get("tags") or "").split())[:90]
    dj = dj_settings()
    price = random.randint(dj["ad_price_low"], dj["ad_price_high"])
    return (
        f'the original painting "{subject}", from the Pine Box gallery, '
        f"yours for {price} dollars"
    )


async def dj_ad(product: str, remember: bool = True) -> dict[str, Any]:
    """Write, speak and keep an ad read."""
    line = await dj_speak("ad", _RADIO.get("now"), extra=product)
    entry = ad_save(product, line) if (remember and line) else None
    back = ""
    if _RADIO["on"] and _RADIO.get("now"):
        back = await dj_speak(
            "interject", _RADIO["now"],
            line=_dj_fill("And now, back to the music on {station}."))
    return {"ad": line, "back": back, "product": product,
            "id": (entry or {}).get("id", "")}


async def dj_ad_break() -> str:
    """The between-tracks ad. Reuses a stored read most of the time so the
    station repeats itself the way real ones do; otherwise writes a new one
    about one of your paintings."""
    dj = dj_settings()
    stored = ad_pick()

    if stored and random.random() < 0.6:
        ad_update(stored["id"], uses=stored.get("uses", 0) + 1)
        return await dj_speak("ad", _RADIO.get("now"), line=stored["text"])

    product = ""
    if dj["gallery_ads"]:
        product = gallery_product()
    if not product and dj["sponsors"]:
        product = random.choice(dj["sponsors"])
    if not product and stored:
        ad_update(stored["id"], uses=stored.get("uses", 0) + 1)
        return await dj_speak("ad", _RADIO.get("now"), line=stored["text"])
    if not product:
        return ""
    return (await dj_ad(product))["ad"]


# --- What people say about the track (#121) --------------------------------


def _notes_read() -> dict[str, Any]:
    try:
        data = json.loads(NOTES_PATH.read_text())
        return data if isinstance(data, dict) else {}
    except Exception:
        return {}


def _notes_write(notes: dict[str, Any]) -> None:
    try:
        NOTES_PATH.parent.mkdir(parents=True, exist_ok=True)
        temporary = NOTES_PATH.with_suffix(".tmp")
        # Bounded: the newest 400 tracks are plenty for one station.
        trimmed = dict(sorted(notes.items(),
                              key=lambda kv: kv[1].get("ts", 0))[-400:])
        temporary.write_text(json.dumps(trimmed))
        temporary.replace(NOTES_PATH)
    except Exception:
        pass


async def track_notes(track: dict[str, Any]) -> str:
    """One or two lines on how this song lands with people. Cached per track:
    researching the same song every rotation is wasted network and a slower
    show. Empty string when nothing useful came back — the DJ then just
    introduces the track normally rather than inventing a reception."""
    if not track:
        return ""
    key = track["id"]
    notes = _notes_read()
    if key in notes:
        return str(notes[key].get("text") or "")

    who = f" {track['artist']}" if track.get("artist") else ""
    query = f'"{track["title"]}"{who} song reception review what people think'
    try:
        results = await _tv_search_angle(query)
    except Exception:
        results = []

    lines = []
    for result in results[:5]:
        title = str(result.get("title") or "").strip()
        body = " ".join(str(
            result.get("snippet") or result.get("content") or "").split())
        if title or body:
            lines.append(f"- {title}: {body[:400]}")

    text = ""
    if lines:
        try:
            text = await ask_model(
                "From these search results, say in ONE or TWO sentences how "
                "people actually receive this song — loved, divisive, a "
                "sleeper, whatever the sources support. Attribute it as what "
                "listeners say. If the results are clearly about a different "
                "song, reply with exactly: NONE\n\n"
                f"Song: {track['title']}{who}\n\n" + "\n".join(lines),
                limit=320,
            )
        except Exception:
            text = ""
    if text.strip().upper().startswith("NONE"):
        text = ""

    notes[key] = {"text": text, "ts": int(time.time())}
    _notes_write(notes)
    return text



# --- Two in the booth (#133) -----------------------------------------------


def banter_material(limit: int = 12) -> str:
    """What the pair have to work with: the things you have actually asked
    for. Requests on air first, then what you have been asking the Pine Box
    generally — that is where the running jokes come from."""
    bits: list[str] = []

    # What he keeps coming back to, across every show there has ever been.
    try:
        for row in request_history()["top"][:4]:
            times = int(row.get("count") or 0)
            if times > 1:
                bits.append(
                    f'he has asked for "{row.get("title")}"'
                    + (f' by {row.get("artist")}' if row.get("artist") else "")
                    + f" {times} times now")
    except Exception:
        pass

    for line in reversed(_RADIO.get("chat") or []):
        if line.get("kind") == "request" and line.get("who") == "host":
            bits.append(str(line.get("text") or ""))
        if len(bits) >= 5:
            break

    try:
        for turn in reversed(read_history(limit=40)):
            text = " ".join(str(turn.get("user") or "").split())
            if len(text) > 12:
                bits.append(text[:160])
            if len(bits) >= limit:
                break
    except Exception:
        pass

    try:
        for memory in read_memories(limit=6):
            note = " ".join(str(memory.get("text") or "").split())
            if note:
                bits.append("he once told us: " + note[:140])
    except Exception:
        pass

    return "\n".join(f"- {b}" for b in bits[:limit])


def banter_pictures(limit: int = 6) -> str:
    """The images he has had the box generate — the richest material in the
    building, and the only one they can be genuinely scandalised by."""
    lines: list[str] = []
    try:
        for gen in read_generations(60):
            subject = " ".join(str(
                gen.get("request") or gen.get("tags") or "").split())
            if len(subject) > 8:
                lines.append(f"- he had us generate: {subject[:170]}")
            if len(lines) >= limit:
                break
    except Exception:
        pass
    return "\n".join(lines)



# Piper's English voices, split by the voice's apparent gender. Only names
