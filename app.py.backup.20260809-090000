const FONT_CANDIDATES = ["Arial", "Helvetica", "Verdana", "Tahoma",
  "Trebuchet MS", "Georgia", "Times New Roman", "Courier New", "Menlo",
  "Consolas", "Monaco", "Comic Sans MS", "Impact", "Segoe UI", "Roboto",
  "Ubuntu", "Cantarell", "DejaVu Sans", "Liberation Sans", "Noto Sans",
  "Fira Sans", "Inter"];
let fontsScanned = false;

function fillFontSelect(names) {
  const sel = document.getElementById("fontSelect");
  const saved = localStorage.getItem("pineFont") || "system-ui";
  sel.innerHTML = "";
  names.forEach((n) => {
    const o = document.createElement("option");
    o.value = n;
    o.textContent = n;
    o.style.fontFamily = n;
    if (n === saved) o.selected = true;
    sel.appendChild(o);
  });
}

async function scanLocalFonts() {
  // Full system list needs Chromium's Local Font Access, which requires a
  // user gesture — so this runs on the first click of the picker.
  if (fontsScanned || !window.queryLocalFonts) return;
  fontsScanned = true;
  try {
    const fonts = await queryLocalFonts();
    const names = [...new Set(fonts.map((f) => f.family))].sort();
    if (names.length) fillFontSelect(["system-ui"].concat(names));
  } catch (e) { /* permission denied — probed list stays */ }
}

function applyFont(name) {
  localStorage.setItem("pineFont", name);
  document.body.style.fontFamily = name === "system-ui"
    ? "system-ui, sans-serif"
    : '"' + name + '", system-ui, sans-serif';
}

function initFontPicker() {
  fillFontSelect(["system-ui"].concat(FONT_CANDIDATES.filter((f) =>
    document.fonts.check('12px "' + f + '"'))));
  document.getElementById("fontSelect")
    .addEventListener("pointerdown", scanLocalFonts);
  applyFont(localStorage.getItem("pineFont") || "system-ui");
}

