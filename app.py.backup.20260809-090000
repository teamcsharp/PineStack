@app.get("/api/serial/ports")
async def serial_ports_api(
    authorization: str | None = Header(default=None),
) -> dict[str, Any]:
    """What is plugged into the server right now."""
    require_read_auth(authorization)
    ports = await asyncio.to_thread(serial_ports)
    devices = await asyncio.to_thread(usb_devices)

    usb_ports = [p for p in ports
                 if "ttyUSB" in p["device"] or "ttyACM" in p["device"]]
    candidates = [d for d in devices if d["serial_like"]]

    if usb_ports:
        state, hint = "ready", "The box is enumerated. Connect to it."
    elif candidates:
        state = "no-driver"
        hint = ("A serial bridge is plugged in but the kernel bound no tty to "
                "it. Check that the usbserial driver for it is present.")
    else:
        state = "absent"
        hint = ("The server sees no serial device. If the cable is in, it is "
                "almost certainly a charge-only cable, or it is in a port on "
                "the box that carries power but not data. Try a different "
                "cable — one you know moves files — and the box's other port.")

    return {
        "ports": ports,
        "usb": devices,
        "state": state,
        "candidates": candidates,
        "open": bool(_SERIAL["link"]),
        "port": _SERIAL["port"],
        "baud": SERIAL_BAUD,
        "hint": hint,
    }


