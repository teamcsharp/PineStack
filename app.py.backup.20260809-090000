async function openHealthPopup() {
  const body = openModal();
  const wrap = el("div", "hp-wrap");
  wrap.appendChild(el("b", "", "Pine Box services & load"));
  body.appendChild(wrap);
  const holder = el("div", "muted", "Loading…");
  wrap.appendChild(holder);

  let d;
  try { d = await api("/api/health/details"); }
  catch (error) { holder.textContent = error.message; return; }
  holder.remove();

  if ((d.marquee || []).length) {
    const mq = el("div", "hp-marquee");
    mq.appendChild(el("span", "", d.marquee.join("   ·   ")));
    wrap.appendChild(mq);
  }

  const grid = el("div", "hp-grid");
  wrap.appendChild(grid);

  Object.entries(d.services || {}).forEach(([name, svc]) => {
    const card = el("div", "hp-card");
    const head = el("h3");
    head.appendChild(el("span", "", name));
    head.appendChild(el("span", svc.ok ? "hp-ok" : "hp-bad",
      svc.ok ? "● ok" : "● down"));
    card.appendChild(head);
    card.appendChild(el("div", "muted",
      (svc.detail || "") + (svc.url ? " · " + svc.url : "")));
    (svc.facts || []).forEach((f) => {
      const line = el("div", "", "› " + f);
      line.style.cssText = "font-size:12px;color:#c3cfdd;margin-top:3px";
      card.appendChild(line);
    });
    const ops = name === "comfyui" ? d.ops.comfyui
      : (name === "ollama" || name === "spark-agent") ? d.ops.agent : null;
    if (ops && ops.length)
      card.appendChild(el("div", "hp-term", ops.join("\n")));
    if (svc.virtual) { grid.appendChild(card); return; }   // nothing to restart
    const restart = el("button", "hp-restart", "Restart");
    restart.style.marginTop = "8px";
    const restartable = (d.restartable || []).indexOf(name) >= 0;
    if (name === "spark-agent" || restartable) {
      restart.onclick = async () => {
        restart.textContent = "Restarting…";
        try { await api("/api/service/restart", {
          method: "POST", body: JSON.stringify({name: "spark-agent"})}); }
        catch (e) {}
        setTimeout(() => location.reload(), 6000);
      };
    } else {
      restart.disabled = true;
      restart.title = "Managed by docker on the host — restart from there.";
    }
    card.appendChild(restart);
    grid.appendChild(card);
  });

  // Loaded models, each with an eject button (#56).
  const memCard = el("div", "hp-card");
  memCard.appendChild(el("h3", "", "Models in memory"));
  const memList = el("div");
  memCard.appendChild(memList);
  grid.appendChild(memCard);

  async function refreshLoaded() {
    memList.textContent = "";
    let loaded = [];
    try { loaded = (await api("/api/models/loaded")).models || []; }
    catch (error) { memList.appendChild(el("div", "muted", error.message)); return; }
    if (!loaded.length) {
      memList.appendChild(el("div", "muted", "Nothing resident right now."));
      return;
    }
    loaded.forEach((m) => {
      const row = el("div");
      row.style.cssText =
        "display:flex;align-items:center;gap:8px;margin-top:7px;font-size:12px";
      const label = el("span", "", m.name + " · " + m.gb + " GB");
      label.style.cssText = "flex:1;color:#c3cfdd;overflow:hidden;" +
        "text-overflow:ellipsis;white-space:nowrap";
      label.title = m.host + (m.expires ? " · expires " + m.expires : "");
      const eject = el("button", "hp-restart", "⏏");
      eject.title = "Offload " + m.name + " from memory";
      eject.onclick = async () => {
        eject.textContent = "…";
        try {
          await api("/api/models/unload", {
            method: "POST",
            body: JSON.stringify({host: m.host, name: m.name}),
          });
        } catch (error) { eject.title = error.message; }
        setTimeout(refreshLoaded, 1200);
      };
      row.appendChild(label);
      row.appendChild(eject);
      memList.appendChild(row);
    });
  }
  refreshLoaded();

  // Load: RAM pie + bars.
  const load = el("div", "hp-card");
  load.appendChild(el("h3", "", "System load"));
  const totalKb = (d.ram || {}).total_kb || 0;
  const availKb = (d.ram || {}).available_kb || 0;
  if (totalKb) {
    const usedPct = Math.round(100 * (totalKb - availKb) / totalKb);
    const pie = el("div", "hp-pie");
    pie.style.background =
      "conic-gradient(var(--accent) 0 " + usedPct + "%, #1d2330 " +
      usedPct + "% 100%)";
    load.appendChild(pie);
    load.appendChild(el("div", "hp-legend",
      "RAM " + usedPct + "% used · " +
      (availKb / 1048576).toFixed(1) + " GB free of " +
      (totalKb / 1048576).toFixed(1) + " GB"));
    const bars = el("div", "hp-bars");
    bars.appendChild(makeBar("RAM", usedPct));
    const stats = d.stats_text || "";
    const loadM = stats.match(/load average[^0-9]*([\d.]+)/i);
    if (loadM) bars.appendChild(
      makeBar("CPU load (1m)", Math.min(100, Math.round(parseFloat(loadM[1]) * 5))));
    const vramM = stats.match(/(\d+)\s*MiB\s*\/\s*(\d+)\s*MiB/);
    if (vramM) bars.appendChild(makeBar("GPU memory",
      Math.round(100 * parseInt(vramM[1], 10) / parseInt(vramM[2], 10))));
    load.appendChild(bars);
  }
  load.appendChild(el("div", "hp-term", d.stats_text || ""));
  grid.appendChild(load);

  function makeBar(label, pct) {
    const bar = el("div", "hp-bar", label + " · " + pct + "%");
    const track = el("div", "track");
    const fill = el("div", "fill");
    fill.style.width = pct + "%";
    track.appendChild(fill);
    bar.appendChild(track);
    return bar;
  }
}

