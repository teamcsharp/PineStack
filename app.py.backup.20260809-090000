  status.textContent = "Rescanning…";
  try {
    const data = await api("/api/music/reindex", {method: "POST"});
    status.textContent = data.scanning
      ? "reading the library…"
      : data.tracks + " tracks under " + (data.roots || []).join(", ");
    loadStations();
  } catch (error) {
    status.textContent = error.message;
  }
}

async function loadStations() {
  const select = document.getElementById("radioStation");
  if (!select) return;
  try {
    const data = await api("/api/music/stations");
    select.textContent = "";
    (data.stations || []).forEach((station) => {
      const option = document.createElement("option");
      option.value = station.id;
      option.textContent = station.name + " (" + station.tracks + ")";
      select.appendChild(option);
    });
    const status = document.getElementById("musicStatus");
    if (!status.textContent || /tracks|reading/.test(status.textContent)) {
      status.textContent = data.scanning
        ? "reading the library… " + data.scanned + " tracks so far"
        : data.tracks + " tracks indexed";
    }
    if (data.scanning) setTimeout(loadStations, 5000);   // follow the scan
  } catch (error) { /* the panel works without it */ }
}

async function radioTune() {
  const status = document.getElementById("musicStatus");
  const station = document.getElementById("radioStation").value || "all";
  try {
    await api("/api/radio/tune", {
      method: "POST",
      body: JSON.stringify({
        station, dj: document.getElementById("radioDJ").checked,
      }),
    });
    musicRadioOn = true;
    status.textContent = "Tuned to " + station + " — playing on the box.";
    if (!djOn) radioNext();            // the DJ, if on, drives it instead
  } catch (error) {
    status.textContent = error.message;
  }
}

async function radioNext() {
  // The DJ sequences the show; asking for "next" here would skip a track.
  if (djOn) return;
  if (!musicRadioOn) return;
  const station = document.getElementById("radioStation").value || "all";
  try {
    const track = await api("/api/radio/next?station="
      + encodeURIComponent(station));
