  deck.add(new THREE.Mesh(
    new THREE.CylinderGeometry(0.06, 0.06, 0.9, 12),
    new THREE.MeshStandardMaterial({color: 0xc8ccd4, metalness: 1,
                                    roughness: 0.25})));

  const arm = new THREE.Group();
  arm.position.set(3.5, 0.75, -2.4);
  deck.add(arm);
  const armTube = new THREE.Mesh(
    new THREE.CylinderGeometry(0.055, 0.055, 4.6, 12),
    new THREE.MeshStandardMaterial({color: 0xd6dae2, metalness: 1,
                                    roughness: 0.3}));
  armTube.rotation.z = Math.PI / 2;
  armTube.position.set(-1.9, 0, 1.1);
  arm.add(armTube);
  arm.rotation.y = -0.5;

  // The running order, standing in an arc behind the deck.
  const shelf = new THREE.Group();
  shelf.position.set(0, 2.5, -6.5);
  scene.add(shelf);

  const raycaster = new THREE.Raycaster();
  const pointer = new THREE.Vector2();
  let covers = [];
  let signature = "";
  let hovered = null;
  let spin = 0;
  let frame = 0;

  let flowIndex = 0;

  // The arc becomes a cover flow: one record faces you, the rest fan away,
  // and the wheel or a drag walks through the queue (#138).
  function placeCovers() {
    covers.forEach((mesh, i) => {
      const offset = i - flowIndex;
      const away = Math.abs(offset);
      const side = Math.sign(offset);
      mesh.position.set(
        side * (2.0 + Math.min(away, 7) * 1.15), 0,
        offset === 0 ? 1.6 : -0.9 - Math.min(away, 7) * 0.55);
      mesh.rotation.y = offset === 0 ? 0 : side * -1.05;
      const scale = offset === 0 ? 1.34 : 1;
      mesh.scale.set(scale, scale, scale);
      mesh.material.opacity = away > 7 ? 0 : 1 - away * 0.05;
      mesh.material.transparent = true;
      mesh.userData.centre = offset === 0;
    });
    const centre = covers[flowIndex] && covers[flowIndex].userData.track;
    const label = document.getElementById("boothFlowLabel");
    if (label && centre) {
      label.textContent = centre.title
        + (centre.artist ? " · " + centre.artist : "");
    }
  }

  function flowTo(index) {
    if (!covers.length) return;
    flowIndex = Math.max(0, Math.min(covers.length - 1, index));
    placeCovers();
  }

  function setCovers(tracks, centreOn) {
    const next = tracks.map((t) => t.id).join();
    if (next === signature) {
      if (centreOn !== undefined) flowTo(centreOn);
      return;
    }
    signature = next;
    covers.forEach((mesh) => {
      shelf.remove(mesh);
      mesh.material.map && mesh.material.map.dispose();
      mesh.material.dispose();
      mesh.geometry.dispose();
    });
    covers = [];

    const loader = new THREE.TextureLoader();
    tracks.slice(0, 11).forEach((track, i) => {
      const spread = tracks.length > 1 ? (i / (tracks.length - 1)) - 0.5 : 0;
      const angle = spread * 1.5;
      const material = new THREE.MeshStandardMaterial({
        map: boothSleeveTexture(THREE, track),
        roughness: 0.65, metalness: 0.05,
      });
      if (track.art) {
        // Real artwork replaces the generated face once it decodes.
        loader.load(track.art, (texture) => {
          texture.colorSpace = THREE.SRGBColorSpace;
          material.map = texture;
          material.needsUpdate = true;
        }, undefined, () => {});
      }
      const mesh = new THREE.Mesh(new THREE.PlaneGeometry(2.5, 2.5), material);
      mesh.userData.track = track;
      shelf.add(mesh);
      covers.push(mesh);
    });
    flowTo(centreOn === undefined ? Math.floor(covers.length / 2) : centreOn);
  }

  function onMove(event) {
    const box = renderer.domElement.getBoundingClientRect();
    pointer.x = ((event.clientX - box.left) / box.width) * 2 - 1;
    pointer.y = -((event.clientY - box.top) / box.height) * 2 + 1;
  }
  function onClick() {
    // Clicking a cover off to the side walks to it; the front one gets cued.
    if (hovered && !hovered.userData.centre) {
      flowTo(covers.indexOf(hovered));
      return;
    }
    if (!hovered) return;
    const track = hovered.userData.track;
    // Requesting it is what "picking a record in the booth" means.
    api("/api/dj/request", {
      method: "POST", body: JSON.stringify({q: track.title, now: true}),
    }).then(() => boothLog("You: cue " + track.title)).catch(() => {});
  }
  renderer.domElement.addEventListener("pointermove", onMove);
  renderer.domElement.addEventListener("click", onClick);

  function onWheel(event) {
    event.preventDefault();
    flowTo(flowIndex + (event.deltaY > 0 || event.deltaX > 0 ? 1 : -1));
  }
  renderer.domElement.addEventListener("wheel", onWheel, {passive: false});

  let flowDrag = null;
  renderer.domElement.addEventListener("pointerdown", (event) => {
    flowDrag = {x: event.clientX, index: flowIndex};
  });
  window.addEventListener("pointerup", () => { flowDrag = null; });
  renderer.domElement.addEventListener("pointermove", (event) => {
    if (!flowDrag) return;
    flowTo(flowDrag.index - Math.round((event.clientX - flowDrag.x) / 70));
  });

  // Drop anything on the booth and he reacts to it.
  function onDragOver(event) { event.preventDefault(); }
  async function onDrop(event) {
    event.preventDefault();
    const asAd = event.shiftKey;
    const file = (event.dataTransfer.files || [])[0];
    if (!file || !file.type.startsWith("image/")) return;
    boothLog("You dropped " + file.name + (asAd ? " (as an ad)" : ""));
    const data = await new Promise((done) => {
      const reader = new FileReader();
      reader.onload = () => done(reader.result);
      reader.readAsDataURL(file);
    });
    try {
      const result = await api("/api/dj/media", {
        method: "POST",
        body: JSON.stringify({
          images: [data], name: file.name, mode: asAd ? "ad" : "mention",
        }),
      });
      boothLog("DJ: " + result.line + "  (" + result.known_from + ")");
    } catch (error) {
      boothLog("DJ: " + error.message);
    }
  }
  shade.addEventListener("dragover", onDragOver);
  shade.addEventListener("drop", onDrop);

  const resize = new ResizeObserver(() => {
    const w = stage.clientWidth, h = Math.max(1, stage.clientHeight);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
    renderer.setSize(w, h);
  });
  resize.observe(stage);

  function tick() {
    frame = requestAnimationFrame(tick);
    if (djOn) { spin += 0.012; record.rotation.y = spin; }

    raycaster.setFromCamera(pointer, camera);
    const hit = raycaster.intersectObjects(covers, false)[0];
    const next = hit ? hit.object : null;
    if (next !== hovered) {
      if (hovered) hovered.scale.set(1, 1, 1);
      hovered = next;
      if (hovered) hovered.scale.set(1.12, 1.12, 1.12);
      renderer.domElement.style.cursor = hovered ? "pointer" : "default";
    }
    shelf.rotation.y = Math.sin(Date.now() / 6000) * 0.06;
    renderer.render(scene, camera);
  }
  tick();

  booth = {
    setCovers, flowTo,
    labelMesh,
    THREE,
    stop() {
      cancelAnimationFrame(frame);
      resize.disconnect();
      renderer.domElement.removeEventListener("pointermove", onMove);
      renderer.domElement.removeEventListener("click", onClick);
      shade.removeEventListener("dragover", onDragOver);
      shade.removeEventListener("drop", onDrop);
      covers.forEach((mesh) => {
        mesh.material.map && mesh.material.map.dispose();
        mesh.material.dispose();
        mesh.geometry.dispose();
      });
      renderer.dispose();
    },
  };

  boothRefresh();
}

function boothLog(text) {
  const log = document.getElementById("boothChat");
  if (!log) return;
  const line = document.createElement("div");
  line.textContent = text;
  log.appendChild(line);
  log.scrollTop = log.scrollHeight;
}

async function boothSend(asRequest) {
  const input = document.getElementById("boothSay");
  const text = input.value.trim();
  if (!text) return;
  input.value = "";
  boothLog("You: " + text);
  try {
    if (asRequest) {
      const result = await api("/api/dj/request", {
        method: "POST", body: JSON.stringify({q: text}),
      });
      boothLog("DJ: queued " + result.title
        + (result.line ? " — " + result.line : ""));
    } else {
      const result = await api("/api/dj/say", {
        method: "POST", body: JSON.stringify({text}),
      });
      boothLog("DJ: " + (result.reply || ""));
    }
  } catch (error) {
    boothLog("DJ: " + error.message);
  }
}

// The booth follows the same state the rest of the panel does.
async function boothRefresh() {
  if (!booth) return;
  try {
    const state = await api("/api/dj");
    const now = state.now || {};
    const line = document.getElementById("boothNow");
    if (line) {
      line.textContent = state.on
        ? (now.title || "…") + (now.artist ? " · " + now.artist : "")
        : "off air — start a session from the Music panel";
    }
    const played = (state.played || []).slice(0, 3).reverse();
    const queue = (state.upcoming || []).slice(0, 7);
    // Centre on whatever is on air.
    booth.setCovers(played.concat(now.id ? [now] : [], queue), played.length);

    const start = document.getElementById("boothStart");
    if (start) {
      start.textContent = state.on ? "■ Stop" : "▶ Start";
      start.title = state.on ? "Send the DJ home" : "Put Pine Box FM on air";
    }

    // The record on the deck wears the current sleeve.
    if (now.art && booth.labelMesh.userData.art !== now.art) {
      booth.labelMesh.userData.art = now.art;
      new booth.THREE.TextureLoader().load(now.art, (texture) => {
        texture.colorSpace = booth.THREE.SRGBColorSpace;
        booth.labelMesh.material.map = texture;
        booth.labelMesh.material.needsUpdate = true;
      }, undefined, () => {});
    }
  } catch (error) { /* the booth keeps turning */ }
  setTimeout(boothRefresh, 4000);
}

/* ---- USB console (the Pine Box's only real debug channel) ---- */

let usbTimer = null;
let usbSince = 0;

function usbLog(text, tone) {
  const out = document.getElementById("usbOut");
  if (!out) return;
  const line = document.createElement("div");
  line.textContent = text;
  if (tone) line.style.color = tone;
  out.appendChild(line);
  // Only follow the tail if you are already at it.
  const near = out.scrollHeight - out.scrollTop - out.clientHeight < 60;
  while (out.childElementCount > 900) out.removeChild(out.firstChild);
  if (near) out.scrollTop = out.scrollHeight;
}

let usbSeen = "";

async function usbPoll() {
  try {
    const data = await api("/api/serial/read?since=" + usbSince);
    usbSince = data.now || usbSince;
    (data.lines || []).forEach((line) => usbLog(line.text));
    const badge = document.getElementById("usbState");
    if (badge) {
      badge.textContent = data.open ? "● " + data.port : "○ not connected";
      badge.style.color = data.open ? "#43d17c" : "";
    }
  } catch (error) { /* the window stays up */ }
}

// Watch for the box arriving. Until it enumerates there is nothing to open,
// and the reason it has not is the thing worth saying out loud.
async function usbWatch() {
  let data;
  try {
    data = await api("/api/serial/ports");
  } catch (error) { return; }

  const signature = (data.ports || []).map((p) => p.device).join()
    + "|" + (data.usb || []).map((d) => d.vid_pid).join();
  if (signature === usbSeen) return;
  const first = !usbSeen;
  usbSeen = signature;

  usbPorts(data);
  const watch = document.getElementById("usbWatch");
  if (watch) {
    watch.textContent = data.hint || "";
    watch.style.color = data.state === "ready" ? "#43d17c"
      : data.state === "no-driver" ? "#ffd479" : "";
  }
  if (first) {
    usbLog((data.usb || []).length + " USB devices attached to the server, "
      + (data.candidates || []).length + " of them a serial bridge.", "#9ba6b7");
    usbLog(data.hint, data.state === "ready" ? "#43d17c" : "#ffd479");
    return;
  }

  // Something changed while you were standing there with the cable.
  usbLog("— USB changed —", "#4bb3ff");
  (data.candidates || []).forEach((d) => {
    usbLog("  " + d.vid_pid + "  " + (d.product || d.maker || "") + "  ("
      + d.note + ")", "#43d17c");
  });
  if (data.state === "ready") {
    usbLog("Serial port available: "
      + (data.ports || []).map((p) => p.device).join(", "), "#43d17c");
    usbLog("Connecting…", "#43d17c");
    usbOpen();
  } else {
    usbLog(data.hint, "#ffd479");
  }
}

async function usbPorts(known) {
  const select = document.getElementById("usbPort");
  if (!select) return;
  try {
    const data = known || await api("/api/serial/ports");
    const had = select.value;
    select.textContent = "";
    (data.ports || []).forEach((port) => {
      const option = document.createElement("option");
      option.value = port.device;
      option.textContent = port.device
        + (port.description ? " · " + port.description : "")
        + (port.vid_pid ? " [" + port.vid_pid + "]" : "");
      select.appendChild(option);
    });
    if (!(data.ports || []).length) {
      const option = document.createElement("option");
      option.textContent = "nothing plugged into the server";
      select.appendChild(option);
    }
    if (had) select.value = had;          // do not fight your selection
  } catch (error) { /* leave it empty */ }
}

async function usbOpen() {
  const port = document.getElementById("usbPort").value;
  if (!port || !port.startsWith("/dev/")) {
    usbLog("Plug the Pine Box into the server first.", "#ef6461");
    return;
  }
  try {
    const data = await api("/api/serial/open", {
      method: "POST", body: JSON.stringify({port}),
    });
    usbLog("— opened " + data.port + " at " + data.baud + " 8N1 —", "#43d17c");
    usbLog("Power-cycle the Pine Box now and watch what it says.", "#9ba6b7");
  } catch (error) {
    usbLog(error.message, "#ef6461");
  }
}

async function usbClose() {
  try {
    await api("/api/serial/close", {method: "POST"});
    usbLog("— closed —", "#9ba6b7");
  } catch (error) { usbLog(error.message, "#ef6461"); }
}

async function usbSend(text) {
  const input = document.getElementById("usbInput");
  const line = text !== undefined ? text : input.value;
  if (!line) return;
  if (text === undefined) input.value = "";
  usbLog("> " + line, "#ffd479");
  try {
    await api("/api/serial/write", {
      method: "POST", body: JSON.stringify({text: line}),
    });
  } catch (error) {
    usbLog(error.message, "#ef6461");
  }
}

// Firmware differs, so offer the forms that actually appear on BL-series
// builds rather than pretending there is one command.
function usbProvision() {
  const ssid = document.getElementById("usbSsid").value.trim();
  const pass = document.getElementById("usbPass").value;
  if (!ssid) { usbLog("Give it an SSID first.", "#ef6461"); return; }
  usbLog("Trying the usual provisioning commands — watch which one it "
    + "answers.", "#9ba6b7");
  [
    "wifi_sta_connect " + ssid + " " + pass,
    "sta_connect " + ssid + " " + pass,
    'AT+CWJAP="' + ssid + '","' + pass + '"',
  ].forEach((command, i) => setTimeout(() => usbSend(command), i * 1200));
}

