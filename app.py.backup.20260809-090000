function makeCollapsible(container, head, bodyEls, key) {
  if (!container || !head) return;
  key = key || "sec:" + (head.textContent || "").trim();
  const wrap = el("div", "sec-body");
  bodyEls.forEach((c) => wrap.appendChild(c));
  container.appendChild(wrap);
  const tri = el("span", "tri", "▾");
  head.prepend(tri);
  const badge = el("span", "sec-badge", "");
  badge.id = "badge-" + key.replace(/[^a-z0-9]/gi, "");
  head.appendChild(badge);
  head.classList.add("sec-title");
  container.classList.add("pb-collapsible");
  container.dataset.badge = badge.id;
  if (localStorage.getItem(key) === "1") container.classList.add("collapsed");
  head.addEventListener("click", (e) => {
    if (e.target.closest("button,input,select,a")) return;
    container.classList.toggle("collapsed");
    localStorage.setItem(key, container.classList.contains("collapsed") ? "1" : "0");
    if (!container.classList.contains("collapsed")) badge.textContent = "";
  });
}

function bumpBadge(sectionEl) {
  const container = sectionEl && sectionEl.closest
    ? sectionEl.closest(".pb-collapsible") : null;
  if (!container || !container.classList.contains("collapsed")) return;
  const badge = document.getElementById(container.dataset.badge || "");
  if (badge) badge.textContent = String((parseInt(badge.textContent, 10) || 0) + 1);
}

