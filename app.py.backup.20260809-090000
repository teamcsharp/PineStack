/* ---- Voices grouped by the server that serves them (#111) ---- */

const VOICE_LANGS = {
  en_US: "English · US", en_GB: "English · UK", ar_JO: "Arabic",
  bg_BG: "Bulgarian", ca_ES: "Catalan", cs_CZ: "Czech", cy_GB: "Welsh",
  da_DK: "Danish", de_DE: "German", el_GR: "Greek", es_ES: "Spanish",
  es_MX: "Spanish · MX", fa_IR: "Persian", fi_FI: "Finnish", fr_FR: "French",
  hu_HU: "Hungarian", is_IS: "Icelandic", it_IT: "Italian", ka_GE: "Georgian",
  kk_KZ: "Kazakh", lb_LU: "Luxembourgish", ne_NP: "Nepali", nl_BE: "Dutch · BE",
  nl_NL: "Dutch", no_NO: "Norwegian", pl_PL: "Polish", pt_BR: "Portuguese · BR",
  pt_PT: "Portuguese", ro_RO: "Romanian", ru_RU: "Russian", sk_SK: "Slovak",
  sl_SI: "Slovenian", sr_RS: "Serbian", sv_SE: "Swedish", sw_CD: "Swahili",
  tr_TR: "Turkish", uk_UA: "Ukrainian", vi_VN: "Vietnamese", zh_CN: "Chinese",
};

function voiceLabel(name) {
  return name.replace(/^[a-z]{2}_[A-Z]{2}-/, "").replace(/-([a-z_]+)$/, " ($1)");
}

// Everything Piper serves comes from one container; the split that actually
// helps you choose is language. Browser voices are a different server
// entirely, so they get their own section.
function voiceGroups(voices) {
  const byLang = {};
  voices.forEach((name) => {
    const code = (name.match(/^([a-z]{2}_[A-Z]{2})-/) || [])[1] || "other";
    (byLang[code] = byLang[code] || []).push(name);
  });
  // English first — it is what the box actually speaks.
  const order = Object.keys(byLang).sort((a, b) => {
    const ea = a.startsWith("en_") ? 0 : 1, eb = b.startsWith("en_") ? 0 : 1;
    return ea - eb || (VOICE_LANGS[a] || a).localeCompare(VOICE_LANGS[b] || b);
  });
  return order.map((code) => [
    "wyoming-piper :10200 · " + (VOICE_LANGS[code] || code),
    byLang[code],
  ]);
}

function fillVoiceSelect(select, voices, current, includeBrowser) {
  select.textContent = "";
  const fallback = document.createElement("option");
  fallback.value = "";
  fallback.textContent = "— engine default —";
  select.appendChild(fallback);

  voiceGroups(voices).forEach(([label, names]) => {
    const group = document.createElement("optgroup");
    group.label = label;
    names.forEach((name) => {
      const option = document.createElement("option");
      option.value = name;
      option.textContent = voiceLabel(name);
      option.title = name;
      if (name === current) option.selected = true;
      group.appendChild(option);
    });
    select.appendChild(group);
  });

  if (includeBrowser && "speechSynthesis" in window) {
    const local = speechSynthesis.getVoices() || [];
    if (local.length) {
      const group = document.createElement("optgroup");
      group.label = "this browser · your OS, not the Spark";
      local.slice(0, 60).forEach((voice) => {
        const option = document.createElement("option");
        option.value = "browser:" + voice.name;
        option.textContent = voice.name + " (" + voice.lang + ")";
        if (option.value === current) option.selected = true;
        group.appendChild(option);
      });
      select.appendChild(group);
    }
  }
}

