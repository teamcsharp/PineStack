/* ---- Word cloud: closed → half → full, from the header ---- */

function cloudCycle() {
  const dock = document.getElementById("cloudDock");
  const open = dock.style.display !== "none";
  const full = dock.dataset.full === "1";

  if (!open) {                       // closed → half
    dock.dataset.full = "0";
    dock.style.width = "50%";
    cloudDockToggle();
  } else if (!full) {                // half → full
    dock.dataset.full = "1";
    dock.style.width = "100%";
    if (cloud) cloud.renderer.setSize(dock.clientWidth, dock.clientHeight);
  } else {                           // full → closed
    dock.dataset.full = "0";
    dock.style.width = "50%";
    cloudDockToggle();
  }
  const button = document.getElementById("cloudHeadBtn");
  if (button) {
    const state = !open ? "half" : (!full ? "full" : "closed");
    button.title = "Word cloud is " + (state === "closed" ? "closed"
      : state === "half" ? "half width — click to fill" : "full width")
      + " · click to cycle";
  }
}

// The MiniPlayer's transport acts on this page's audio; the server owns the
// running order, so ⏮/⏭ ask the DJ while play/pause and the scrubber are
// local. There is no seeking the box — the satellite has no transport.
function djMiniPlayPause() {
  const player = document.getElementById("musicPlayer");
  const button = document.getElementById("djMiniPlay");
  if (!player) return;
  if (player.paused) {
    player.play().catch(() => {});
    button.textContent = "⏸";
    button.title = "Pause";
  } else {
    player.pause();
    button.textContent = "▶";
    button.title = "Play";
  }
}

function djSeekTo() {
  const player = document.getElementById("musicPlayer");
  const seek = document.getElementById("djSeek");
  if (!player || !player.duration || !isFinite(player.duration)) return;
  player.currentTime = (Number(seek.value) / 1000) * player.duration;
}

function djMiniRender(state) {
  const now = state.now || {};
  const art = document.getElementById("djMiniArt");
  if (art && now.id && art.dataset.id !== now.id) {
    art.dataset.id = now.id;
    sleeveInto(art, now, 38);
    art.onclick = () => trackCard(now.id);
  }

  const player = document.getElementById("musicPlayer");
  const local = player && player.duration && isFinite(player.duration);
  const at = local ? player.currentTime : (state.elapsed || 0);
  const total = local ? player.duration : (now.seconds || 0);

  const seek = document.getElementById("djSeek");
  if (seek && total) seek.value = String(Math.round((at / total) * 1000));

  const clock = document.getElementById("djClock");
  // Remaining, the way iTunes shows it.
  if (clock) clock.textContent = total ? "-" + djClock(Math.max(0, total - at)) : "";

  const button = document.getElementById("djMiniPlay");
  if (button && player) {
    button.textContent = player.paused ? "▶" : "⏸";
    button.title = player.paused ? "Play" : "Pause";
  }
}

