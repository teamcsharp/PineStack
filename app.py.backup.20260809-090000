def _read_meminfo() -> dict[str, int]:
    info: dict[str, int] = {}
    try:
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, _, rest = line.partition(":")
            info[key.strip()] = int(rest.strip().split()[0])  # kB
    except Exception:
        pass
    return info


def _gpu_stats() -> str:
    # ponytail: best-effort nvidia-smi; skip silently if unavailable in container.
    try:
        import subprocess

        out = subprocess.run(
            [
                "nvidia-smi",
                "--query-gpu=name,memory.used,memory.total,"
                "utilization.gpu,temperature.gpu",
                "--format=csv,noheader,nounits",
            ],
            capture_output=True,
            text=True,
            timeout=5,
        )
        row = out.stdout.strip().splitlines()
        if out.returncode != 0 or not row:
            return ""
        name, used, total, util, temp = [c.strip() for c in row[0].split(",")]
        return f"GPU: {name}, {util}% utilization, {used} of {total} MB VRAM, {temp} C."
    except Exception:
        return ""


def system_stats() -> str:
    import shutil

    parts: list[str] = []

    mem = _read_meminfo()
    if mem.get("MemTotal"):
        total = mem["MemTotal"] / 1024 / 1024
        avail = mem.get("MemAvailable", 0) / 1024 / 1024
        used = total - avail
        pct = (used / total * 100) if total else 0
        parts.append(
            f"Memory: {used:.1f} GB used of {total:.1f} GB "
            f"({pct:.0f}% used, {avail:.1f} GB free)."
        )

    cpus = os.cpu_count() or 0
    try:
        load1, load5, load15 = os.getloadavg()
        parts.append(
            f"CPU: {cpus} cores, load average {load1:.2f}, {load5:.2f}, "
            f"{load15:.2f} over 1, 5 and 15 minutes."
        )
    except Exception:
        if cpus:
            parts.append(f"CPU: {cpus} cores.")

    try:
        usage = shutil.disk_usage("/")
        parts.append(
            f"Disk: {usage.used / 1e9:.0f} GB used of {usage.total / 1e9:.0f} GB "
            f"({usage.free / 1e9:.0f} GB free)."
        )
    except Exception:
        pass

    try:
        uptime_s = float(Path("/proc/uptime").read_text().split()[0])
        parts.append(f"Uptime: {int(uptime_s // 3600)} hours.")
    except Exception:
        pass

    gpu = _gpu_stats()
    if gpu:
        parts.append(gpu)

    return " ".join(parts) or "System statistics are unavailable right now."


