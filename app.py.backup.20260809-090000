  }
  state.upcoming.forEach((track, index) => {
    const row = el("div", "", "");
    row.style.cssText = "display:flex;gap:8px;padding:2px 0";
    const n = el("span", "muted", String(index + 1));
    n.style.cssText = "flex:0 0 18px;text-align:right";
