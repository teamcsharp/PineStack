_TOKEN_MASK = "__token_set__"


def _mask_voice(settings: dict[str, Any]) -> dict[str, Any]:
    """Reads are open, so never hand the HA token back out."""
    masked = json.loads(json.dumps(settings))
    if (masked.get("voice_out") or {}).get("ha_token"):
        masked["voice_out"]["ha_token"] = _TOKEN_MASK
    return masked


