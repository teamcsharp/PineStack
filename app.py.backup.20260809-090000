<script>
let settings = null;
// Injected by the server so any computer on the LAN is authenticated without
// pasting the key. Empty string if SPARK_AGENT_AUTOFILL_KEY is disabled.
const SERVER_KEY = __SERVER_KEY__;

function key() {
  return document.getElementById("apiKey").value.trim() || SERVER_KEY;
}

async function api(path, options = {}) {
  options.headers = {
    ...(options.headers || {}),
    "Authorization": "Bearer " + key()
  };

  if (options.body) {
    options.headers["Content-Type"] = "application/json";
  }

  const response = await fetch(path, options);
  const data = await response.json().catch(() => ({}));

  if (!response.ok) {
    throw new Error(data.detail || "Request failed");
  }

  return data;
}

function setStatus(message, error = false) {
  const target = document.getElementById("status");
  target.textContent = message;
  target.style.color = error ? "#ef6461" : "#9ba6b7";
}

async function connect() {
  localStorage.setItem("sparkAgentKey", key());

  try {
    settings = await api("/api/settings");
    render();
    loadModels();
    loadMemories();
    loadGallery();
    setStatus("Connected.");
    refreshKeyChip();
    toggleKeyRow(false);   // key accepted: fold it back into the icon
  } catch (error) {
    setStatus(error.message, true);
    toggleKeyRow(true);
  }
}

let galleryItems = [];
const galleryURLs = {};
let galleryTimer = null;

async function imageURL(filename) {
  if (galleryURLs[filename]) return galleryURLs[filename];
  try {
    const response = await fetch(
      "/api/generations/image/" + encodeURIComponent(filename),
      { headers: { "Authorization": "Bearer " + key() } }
    );
    if (!response.ok) return null;
    const url = URL.createObjectURL(await response.blob());
    galleryURLs[filename] = url;
    return url;
  } catch (error) {
    return null;
  }
}

async function fetchImageInto(img, filename) {
  const url = await imageURL(filename);
  if (url) img.src = url;
}

function isVideoFile(f) { return /\.(mp4|webm)$/i.test(f || ""); }

// <img> or autoplaying <video>, matching the file. Both take .src, so
// fetchImageInto works on either.
function mediaElement(filename) {
  if (isVideoFile(filename)) {
    const vid = document.createElement("video");
    vid.muted = true;
    vid.loop = true;
    vid.autoplay = true;
    vid.playsInline = true;
    return vid;
  }
  const img = document.createElement("img");
  img.loading = "lazy";
  return img;
}

async function loadGallery() {
  const grid = document.getElementById("galleryGrid");
  try {
    // Repairs renders orphaned by a restart before we draw the grid.
    await api("/api/generations/reconcile", {method: "POST"});
  } catch (error) { /* listing still works */ }
  try {
    const data = await api("/api/generations?limit=200");
    galleryItems = data.generations || [];
  } catch (error) {
    grid.textContent = error.message;
    return;
  }
  grid.innerHTML = "";
  if (!galleryItems.length) {
    const empty = document.createElement("div");
    empty.style.cssText = "color:#9ba6b7;grid-column:1/-1";
    empty.textContent =
      "No images yet — ask the PineBox to generate one.";
    grid.appendChild(empty);
  }

  function makeTile(item) {
    const tile = document.createElement("div");
    tile.style.cssText =
      "position:relative;aspect-ratio:1;border:1px solid #2c3a4f;" +
      "border-radius:8px;overflow:hidden;cursor:pointer;background:#0b1016";
    const file = (item.files || [])[0];
    if (file) {
      const img = mediaElement(file);
      img.style.cssText = "width:100%;height:100%;object-fit:cover";
      fetchImageInto(img, file);
      tile.appendChild(img);
      if (isVideoFile(file)) {
        const vb = document.createElement("div");
        vb.style.cssText = "position:absolute;top:5px;left:5px;font-size:12px";
        vb.textContent = "🎬";
        tile.appendChild(vb);
      }
    } else {
      const badge = document.createElement("div");
      badge.style.cssText =
        "position:absolute;inset:0;display:flex;align-items:center;" +
        "justify-content:center;color:#9ba6b7;font-size:11px;" +
        "text-align:center;padding:4px";
      badge.textContent =
        item.status === "queued" ? "rendering…"
        : item.status === "lost" ? "render lost"
        : item.status === "unknown" ? "unconfirmed"
        : "no image";
      tile.appendChild(badge);
    }
    tile.title = item.tags || item.request || "";
    tile.onclick = () => { if (file) showLightbox(file, item); };
    return tile;
  }

  // Days: today's media in the main grid, earlier days as expandable ticks.
  const todayKey = new Date().toDateString();
  const byDay = new Map();
  galleryItems.forEach((item) => {
    const day = new Date((item.ts || 0) * 1000).toDateString();
    if (!byDay.has(day)) byDay.set(day, []);
    byDay.get(day).push(item);
  });

  (byDay.get(todayKey) || []).forEach((item) => grid.appendChild(makeTile(item)));

  const days = el("div");
  days.style.cssText = "grid-column:1/-1";
  byDay.forEach((items, day) => {
    if (day === todayKey) return;
    const tick = document.createElement("details");
    tick.className = "day-tick";
    const sum = document.createElement("summary");
    sum.appendChild(document.createTextNode(day));
    const small = document.createElement("small");
    const vids = items.filter((i) => isVideoFile((i.files || [])[0])).length;
    small.textContent = items.length + " renders" +
      (vids ? " · " + vids + " video" + (vids > 1 ? "s" : "") : "");
    sum.appendChild(small);
    tick.appendChild(sum);
    const dayGrid = el("div", "day-grid");
    items.forEach((item) => dayGrid.appendChild(makeTile(item)));
    tick.appendChild(dayGrid);
    days.appendChild(tick);
  });
  if (days.children.length) grid.appendChild(days);
  clearTimeout(galleryTimer);
  if (galleryItems.some((g) => g.status === "queued")) {
    galleryTimer = setTimeout(loadGallery, 15000);
  }

  // #33: collapsed gallery still shows a marquee of recent renders.
  const panel = grid.closest("section");
  if (panel) {
    let mini = panel.querySelector(".mini-marquee");
    if (!mini) {
      mini = el("div", "mini-marquee");
      const span = document.createElement("span");
      mini.appendChild(span);
      panel.appendChild(mini);
    }
    const span = mini.querySelector("span");
    span.textContent = "";
    galleryItems.slice(0, 20).forEach((item) => {
      const file = (item.files || [])[0];
      if (!file || isVideoFile(file)) return;
      const img = document.createElement("img");
      fetchImageInto(img, file);
      span.appendChild(img);
    });
  }
}

function metaRow(label, value) {
  const row = document.createElement("div");
  const tag = document.createElement("b");
  tag.textContent = label + ": ";
  row.appendChild(tag);
  row.appendChild(document.createTextNode(value));
  return row;
}

