) -> dict[str, Any]:
    """Every beacon is recorded here so the bell survives reloads."""
    require_auth(authorization)
    payload = await request.json()
    item = {
        "ts": int(time.time()),
        "kind": str(payload.get("kind") or "doc")[:20],
        "title": str(payload.get("title") or "")[:200],
        "subtitle": str(payload.get("subtitle") or "")[:200],
        "ref": payload.get("ref") or {},
    }
    try:
        NOTIFICATIONS_PATH.parent.mkdir(parents=True, exist_ok=True)
        lines = []
        if NOTIFICATIONS_PATH.exists():
            lines = NOTIFICATIONS_PATH.read_text().splitlines()[
                -(NOTIFICATIONS_KEEP - 1):
            ]
        lines.append(json.dumps(item))
        NOTIFICATIONS_PATH.write_text("\n".join(lines) + "\n")
    except Exception:
        pass
    return {"stored": item}


